Функция ЗанятыеУзлыКаскадов(Запуск, Снимок)

	Ключи = Новый ТаблицаЗначений;
	ТипКлюча = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Ключи.Колонки.Добавить("Узел", ТипКлюча);
	Ключи.Колонки.Добавить("Единица", ТипКлюча);
	Для Каждого Пара Из Снимок.Узлы Цикл
		СтрокаКлючей = Ключи.Добавить();
		СтрокаКлючей.Узел = ХешКлюча(Пара.Ключ);
		СтрокаКлючей.Единица = ХешКлюча(Пара.Значение.Единица);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ключи.Узел КАК Узел, Ключи.Единица КАК Единица ПОМЕСТИТЬ ВТ_КлючиКаскада
		|ИЗ &Ключи КАК Ключи;
		|ВЫБРАТЬ Узлы.Запуск КАК Задание, Узлы.Локатор КАК Локатор, Узлы.ЕдиницаЗаписи КАК ЕдиницаЗаписи
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		| (ВЫБРАТЬ РАЗЛИЧНЫЕ План.Задание КАК Задание ИЗ РегистрСведений.Cutter3000_План КАК План
		|  ГДЕ План.Запуск = &Запуск И НЕ План.Пропущено) КАК Группы ПО Узлы.Запуск = Группы.Задание
		|ГДЕ Узлы.Узел В (ВЫБРАТЬ Ключи.Узел КАК Узел ИЗ ВТ_КлючиКаскада КАК Ключи)
		| ИЛИ Узлы.КлючЕдиницы В (ВЫБРАТЬ Ключи.Единица КАК Единица ИЗ ВТ_КлючиКаскада КАК Ключи)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Результаты[1].Выбрать();

КонецФункции

Процедура ИсключитьЗанятыеУзлы(Запуск, Снимок)

	Выборка = ЗанятыеУзлыКаскадов(Запуск, Снимок);
	Пока Выборка.Следующий() Цикл
		Снимок.Узлы.Удалить(Выборка.Локатор);
		Снимок.Ссылки.Удалить(Выборка.Локатор);
	КонецЦикла;
	Пропуски = ПропускиСнимка(Снимок, Запуск);
	Для Каждого Пара Из Пропуски Цикл
		Снимок.Узлы.Удалить(Пара.Ключ);
		Снимок.Ссылки.Удалить(Пара.Ключ);
	КонецЦикла;

КонецПроцедуры

Функция ПересекающиесяЗаданияКаскадов(Запуск, Снимок)

	Задания = Новый Соответствие;
	Единицы = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Единицы.Вставить(Пара.Значение.Единица, Истина);
	КонецЦикла;
	Выборка = ЗанятыеУзлыКаскадов(Запуск, Снимок);
	Пока Выборка.Следующий() Цикл
		Если Снимок.Узлы.Получить(Выборка.Локатор) <> Неопределено
			Или Единицы.Получить(Выборка.ЕдиницаЗаписи) <> Неопределено Тогда
			Задания.Вставить(Выборка.Задание, Истина);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Результат.Добавить(Задание.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ИсключитьОтложенныеКорни(Контекст, Семена)

	Удаляемые = Новый Массив;
	Для Каждого Пара Из Семена.Узлы Цикл
		Если Контекст.ОтложенныеЕдиницы.Получить(Пара.Значение.Единица) <> Неопределено Тогда
			Удаляемые.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из Удаляемые Цикл
		Семена.Узлы.Удалить(Ключ);
		Семена.Ссылки.Удалить(Ключ);
	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьСтарыеЕдиницы(Контекст, Семена)

	// После записи подчиненного набора платформа перенумеровывает оставшиеся строки.
	// Все старые строки выбранной единицы включаются до продвижения курсора страницы.
	Полный = СнимокГруппы(ЭлементыСнимкаКаскада(Семена), Контекст);
	ВладельцыНарушений = ВладельцыБитыхСсылок(Полный);
	Для Каждого Пара Из Полный.Узлы Цикл
		Узел = Пара.Значение;
		Поле = ПолеПериода(Узел.Таблица);
		Если (Поле <> "" И Узел.Поля[Поле] < Контекст.Граница)
			Или ВладельцыНарушений.Получить(Пара.Ключ) <> Неопределено Тогда
			СлитьУзелКаскада(Семена, Узел, Полный.Ссылки.Получить(Пара.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоискКаскада(Снимок, Кандидаты, Контекст, Запуск, Задание, Контроль, БлокировкиУстановлены = Ложь)

	Ссылки = Новый Массив;
	Для Каждого Пара Из Снимок.Ссылки Цикл
		Если Кандидаты.Получить(Пара.Ключ) <> Неопределено Тогда
			Ссылки.Добавить(Пара.Значение);
		КонецЕсли;
	КонецЦикла;
	Группы = ГруппыТиповЦелей(Ссылки);
	Прогресс = Новый Структура("Запуск,Задание,Контроль", Запуск, Задание, Контроль);
	УскоренныйРежим = Ложь;
	Контекст.Свойство("УскоренныйРежим", УскоренныйРежим);
	Если Не УскоренныйРежим Тогда
		ПроверитьОбычныеВходящие(Снимок, Кандидаты, Контекст, Группы, Прогресс, БлокировкиУстановлены);
	КонецЕсли;
	// МоментВремени требует извлечения ссылки; остальные исключенные контейнеры не читаются.
	ПроверитьОсобыеВходящие(Контекст, Ссылки, Группы, Кандидаты, Прогресс);
	// Системные таблицы журналов не входят в каталог прикладных строк.
	Если Метаданные.ЖурналыДокументов.Количество() > 0 И Ссылки.Количество() > 0 Тогда
		СообщитьЭтапУдаления(Запуск, Задание, "Проверка входящих ссылок: журналы документов", 0, Контроль);
	КонецЕсли;
	ПорцияСсылок = Новый Массив;
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		ПорцияСсылок.Добавить(СсылкаОбъекта);
		Если ПорцияСсылок.Количество() = РазмерПорции() Тогда
			Найденные = ПлатформенныйПоискПоКарте(Контекст, ПорцияСсылок, Истина);
			ПроверитьПлатформенныйПоиск(Снимок, Кандидаты, Найденные);
			ПроверитьНайденныеКаскада(Снимок, Кандидаты, Найденные);
			ПорцияСсылок.Очистить();
		КонецЕсли;
	КонецЦикла;
	Если ПорцияСсылок.Количество() > 0 Тогда
		Найденные = ПлатформенныйПоискПоКарте(Контекст, ПорцияСсылок, Истина);
		ПроверитьПлатформенныйПоиск(Снимок, Кандидаты, Найденные);
		ПроверитьНайденныеКаскада(Снимок, Кандидаты, Найденные);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОбычныеВходящие(Снимок, Кандидаты, Контекст, Группы, Прогресс, БлокировкиУстановлены)

	Перем Покрытие, Покрытые;
	Покрытие = ПокрытиеРегистраторовПорции(Снимок, Кандидаты, БлокировкиУстановлены);
	Проверки = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Таблицы = Контекст.КартаВходящих.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Пара Из Таблицы Цикл
			Таблица = Контекст.ТаблицыПоИменам[Пара.Ключ];
			Если Контекст.НепрозрачныеПоИменам.Получить(Таблица.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Покрытые = Покрытие.Получить(Таблица.Имя);
			Для Каждого Поле Из Пара.Значение Цикл
				// Владелец удаляется целиком; строки его табличных частей не образуют внешнего владельца.
				Если Таблица.Вид = "ТабличнаяЧасть" И Поле.Ключ = "Ссылка" Тогда
					Продолжить;
				КонецЕсли;
				Поля = Проверки.Получить(Таблица.Имя);
				Если Поля = Неопределено Тогда
					Поля = Новый Соответствие;
					Проверки.Вставить(Таблица.Имя, Поля);
				КонецЕсли;
				ЦелиПоля = Поля.Получить(Поле.Ключ);
				Если ЦелиПоля = Неопределено Тогда
					ЦелиПоля = Новый Массив;
					Поля.Вставить(Поле.Ключ, ЦелиПоля);
				КонецЕсли;
				Для Каждого СсылкаОбъекта Из Группа.Значение Цикл
					Если Поле.Ключ = "Регистратор" И Покрытые <> Неопределено
						И Покрытые.Получить(СсылкаОбъекта) = Истина Тогда
						Продолжить;
					КонецЕсли;
					ЦелиПоля.Добавить(СсылкаОбъекта);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ПоКорням = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Узел = Снимок.Узлы[Кандидат.Ключ];
		УзлыКорня = ПоКорням.Получить(Узел.Таблица.Корень);
		Если УзлыКорня = Неопределено Тогда
			УзлыКорня = Новый Массив;
			ПоКорням.Вставить(Узел.Таблица.Корень, УзлыКорня);
		КонецЕсли;
		УзлыКорня.Добавить(Узел);
	КонецЦикла;
	ПоОтборам = Новый Соответствие;
	Для Каждого Проверка Из Проверки Цикл
		Таблица = Контекст.ТаблицыПоИменам[Проверка.Ключ];
		КлючОтбора = КлючОтбораКаскада(Таблица);
		ПроверкиОтбора = ПоОтборам.Получить(КлючОтбора);
		Если ПроверкиОтбора = Неопределено Тогда
			ПроверкиОтбора = Новый Массив;
			ПоОтборам.Вставить(КлючОтбора, ПроверкиОтбора);
		КонецЕсли;
		ПроверкиОтбора.Добавить(Проверка);
	КонецЦикла;
	Для Каждого ГруппаОтбора Из ПоОтборам Цикл
		Отборы = Новый Соответствие;
		Попытка
			Для Каждого Проверка Из ГруппаОтбора.Значение Цикл
				Таблица = Контекст.ТаблицыПоИменам[Проверка.Ключ];
				ПроверитьТаблицуВходящих(Таблица, Проверка.Значение, Контекст.Чтения[Таблица.Имя],
					ПоКорням.Получить(Таблица.Корень), Прогресс, Отборы);
			КонецЦикла;
		Исключение
			ЗакрытьОтборыКаскада(Отборы);
			ВызватьИсключение;
		КонецПопытки;
		ЗакрытьОтборыКаскада(Отборы);
	КонецЦикла;

КонецПроцедуры

Процедура ЗакрытьОтборыКаскада(Отборы)

	Для Каждого Отбор Из Отборы Цикл
		Отбор.Значение.Временные.Закрыть();
	КонецЦикла;

КонецПроцедуры

Функция КлючОтбораКаскада(Таблица)

	Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
		// У табличных частей одного владельца одинаковый состав ссылок-кандидатов.
		Возврат Таблица.Корень + "|" + Таблица.Вид;
	КонецЕсли;
	Возврат Таблица.Имя;

КонецФункции

Процедура ПроверитьТаблицуВходящих(Таблица, Поля, Чтение, Узлы, Прогресс, Отборы)

	Перем ГруппыПроверок, КлючОтбора, Отбор, Запрос, Группа, Условия, ВариантыПоля, ИменаПолей;
	Перем Поле, ИмяПараметра, Условие, Выборка, ОписаниеПроверки;
	ГруппыПроверок = ГруппыОбычныхПроверок(Поля, Чтение);
	Если ГруппыПроверок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КлючОтбора = КлючОтбораКаскада(Таблица);
	Отбор = Отборы.Получить(КлючОтбора);
	Если Отбор = Неопределено Тогда
		ЗамерОтбора = Cutter3000_ЗаданияСервер.НачатьЗамер(Прогресс.Контроль, "Подготовка отбора входящих ссылок", Таблица.Имя);
		Отбор = ПодготовитьОтборКаскада(Таблица, Чтение, Узлы);
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерОтбора);
		Отборы.Вставить(КлючОтбора, Отбор);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Отбор.Временные;
	Для Каждого Группа Из ГруппыПроверок Цикл
		КоличествоЦелей = 0;
		Условия = Новый Массив;
		ВариантыПоля = Новый Массив;
		ИменаПолей = Новый Массив;
		Для Каждого Поле Из Группа Цикл
			ИмяПараметра = "ЦелиОбрезки" + Формат(Условия.Количество() + 1, "ЧГ=0");
			Условие = "ИсточникОбрезки." + Поле.Ключ + " В (&" + ИмяПараметра + ")";
			Условия.Добавить(Условие);
			ВариантыПоля.Добавить("КОГДА " + Условие + " ТОГДА """ + Поле.Ключ + """");
			ИменаПолей.Добавить(Поле.Ключ);
			Запрос.УстановитьПараметр(ИмяПараметра, Поле.Значение);
			КоличествоЦелей = КоличествоЦелей + Поле.Значение.Количество();
		КонецЦикла;
		ОписаниеПроверки = Таблица.Имя + "." + ИменаПолей[0];
		Если ИменаПолей.Количество() > 1 Тогда
			ОписаниеПроверки = Таблица.Имя + "; полей: " + Формат(ИменаПолей.Количество(), "ЧГ=0");
		КонецЕсли;
		СообщитьЭтапУдаления(Прогресс.Запуск, Прогресс.Задание,
			"Проверка входящих ссылок: " + ОписаниеПроверки, 0, Прогресс.Контроль);
		// Каждый предикат сохраняет собственные цели. NULL в соседнем поле не скрывает нарушение.
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ВЫБОР " + СтрСоединить(ВариантыПоля, " ")
			+ " ИНАЧЕ """" КОНЕЦ КАК Поле ИЗ " + Таблица.Имя + " КАК ИсточникОбрезки"
			+ " ЛЕВОЕ СОЕДИНЕНИЕ ОтборКаскада КАК ОтборКаскада ПО " + Отбор.Соединение
			+ " ГДЕ ОтборКаскада.ВходитВКаскад ЕСТЬ NULL И (" + СтрСоединить(Условия, " ИЛИ ") + ")";
		Пакетная = ПакетнаяПроверкаВходящих(Группа, Чтение);
		Если Пакетная Тогда
			Запрос.Текст = ТекстПакетнойПроверки(Таблица, Отбор, Условия, ВариантыПоля);
		КонецЕсли;
		ЗамерЗапроса = Cutter3000_ЗаданияСервер.НачатьЗамер(Прогресс.Контроль,
			"Запрос входящих ссылок", Таблица.Имя, КоличествоЦелей, Запрос.Текст);
		Если Пакетная Тогда
			РезультатыПроверки = Запрос.ВыполнитьПакет();
			РезультатПроверки = РезультатыПроверки[1];
		Иначе
			РезультатПроверки = Запрос.Выполнить();
		КонецЕсли;
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерЗапроса);
		Выборка = РезультатПроверки.Выбрать();
		Если Выборка.Следующий() Тогда
			ВызватьИсключение "После планирования появилась новая входящая ссылка: " + Таблица.Имя
				+ "." + Выборка.Поле + ". Каскад отменен.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПакетнаяПроверкаВходящих(Группа, Чтение)

	Объединяемые = Неопределено;
	Если Не Чтение.Свойство("ОбъединяемыеПоля", Объединяемые) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Объединяемые.Получить(Группа[0].Ключ) <> Неопределено;

КонецФункции

Функция ТекстПакетнойПроверки(Таблица, Отбор, Условия, ВариантыПоля)

	// Сначала СУБД отбирает только ссылающиеся строки, затем сравнивает их ключи с каскадом.
	// Прикладные значения остаются в СУБД; обе стадии выполняются в транзакции удаления.
	ПроекцияКлючей = Отбор.ПроекцияВходящих;
	Если ПроекцияКлючей <> "" Тогда
		ПроекцияКлючей = ПроекцияКлючей + ", ";
	КонецЕсли;
	Возврат "ВЫБРАТЬ " + ПроекцияКлючей
		+ "ВЫБОР " + СтрСоединить(ВариантыПоля, " ") + " ИНАЧЕ """" КОНЕЦ КАК Поле"
		+ " ПОМЕСТИТЬ ВТ_ВходящиеОбрезки ИЗ " + Таблица.Имя + " КАК ИсточникОбрезки"
		+ " ГДЕ (" + СтрСоединить(Условия, " ИЛИ ") + ");"
		+ " ВЫБРАТЬ ПЕРВЫЕ 1 ВходящиеОбрезки.Поле КАК Поле"
		+ " ИЗ ВТ_ВходящиеОбрезки КАК ВходящиеОбрезки"
		+ " ЛЕВОЕ СОЕДИНЕНИЕ ОтборКаскада КАК ОтборКаскада ПО " + Отбор.СоединениеВходящих
		+ " ГДЕ ОтборКаскада.ВходитВКаскад ЕСТЬ NULL; УНИЧТОЖИТЬ ВТ_ВходящиеОбрезки";

КонецФункции

Функция ГруппыОбычныхПроверок(Поля, Чтение)

	Перем Результат, Объединяемые, Текущая, Поле, Отдельная, КоличествоЦелей;
	Результат = Новый Массив;
	Объединяемые = Новый Соответствие;
	Если Не Чтение.Свойство("ОбъединяемыеПоля", Объединяемые) Тогда
		Объединяемые = Новый Соответствие;
	КонецЕсли;
	Текущая = Неопределено;
	КоличествоЦелей = 0;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Значение.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Объединяемые.Получить(Поле.Ключ) = Истина И Поле.Значение.Количество() <= 4096 Тогда
			// Ограничение размера не дает превратить запрос большой конфигурации в огромный ИЛИ.
			Если Текущая = Неопределено Или Текущая.Количество() = 8
				Или КоличествоЦелей + Поле.Значение.Количество() > 4096 Тогда
				Текущая = Новый Массив;
				КоличествоЦелей = 0;
				Результат.Добавить(Текущая);
			КонецЕсли;
			Текущая.Добавить(Поле);
			КоличествоЦелей = КоличествоЦелей + Поле.Значение.Количество();
		Иначе
			Отдельная = Новый Массив;
			Отдельная.Добавить(Поле);
			Результат.Добавить(Отдельная);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПокрытиеРегистраторовПорции(Снимок, Кандидаты, БлокировкиУстановлены)

	Перем Результат, Пара, Узел, Вид, Регистратор, Покрытые;
	Результат = Новый Соответствие;
	Если Не БлокировкиУстановлены Или Не ТранзакцияАктивна()
		Или РежимБлокировок() <> РежимУправленияБлокировкойДанных.Управляемый Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Вид = Узел.Таблица.Вид;
		Если Вид <> "Сведения" И Вид <> "Накопление" И Вид <> "Бухгалтерия" И Вид <> "Расчет" Тогда
			Продолжить;
		КонецЕсли;
		Регистратор = Неопределено;
		Если Не Узел.Локатор.Ключи.Свойство("Регистратор", Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		Регистратор = ДекодироватьКлюч(Регистратор);
		Покрытые = Результат.Получить(Узел.Таблица.Имя);
		Если Покрытые = Неопределено Тогда
			Покрытые = Новый Соответствие;
			Результат.Вставить(Узел.Таблица.Имя, Покрытые);
		КонецЕсли;
		Если Покрытые.Получить(Регистратор) = Неопределено Тогда
			Покрытые.Вставить(Регистратор, Истина);
		КонецЕсли;
		Если Кандидаты.Получить(Пара.Ключ) = Неопределено Тогда
			Покрытые.Вставить(Регистратор, Ложь);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОбъединяемыеПоляТаблицы(Таблица)

	Перем Результат, Коллекции, Коллекция, Части, Часть, Реквизит;
	Результат = Новый Соответствие;
	Коллекции = Новый Массив;
	Если Таблица.Вид = "ТабличнаяЧасть" Тогда
		Части = СтрРазделить(Таблица.Имя, ".");
		Часть = Таблица.Описание.ТабличныеЧасти.Найти(Части[2]);
		Коллекции.Добавить(Часть.Реквизиты);
	ИначеЕсли Таблица.Вид = "Объект" Тогда
		Коллекции.Добавить(Таблица.Описание.Реквизиты);
	ИначеЕсли Таблица.Вид = "Сведения" Или Таблица.Вид = "Накопление"
		Или Таблица.Вид = "Бухгалтерия" Или Таблица.Вид = "Расчет" Тогда
		Коллекции.Добавить(Таблица.Описание.Измерения);
		Коллекции.Добавить(Таблица.Описание.Реквизиты);
		Если Таблица.Вид = "Сведения" Тогда
			Коллекции.Добавить(Таблица.Описание.Ресурсы);
		КонецЕсли;
	Иначе
		// Стандартные поля и неизвестные классы сохраняют отдельную проверку.
		Возврат Результат;
	КонецЕсли;
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Реквизит Из Коллекция Цикл
			Если Реквизит.Индексирование = Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать Тогда
				Результат.Вставить(Реквизит.Имя, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции
Функция ПодготовитьОтборКаскада(Таблица, Чтение, Узлы)

	Ключи = Чтение.Ключи;
	Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
		Ключи = СтрРазделить("Ссылка", ",");
	КонецЕсли;
	Локаторы = Новый ТаблицаЗначений;
	Проекция = Новый Массив;
	ПроекцияВходящих = Новый Массив;
	Условия = Новый Массив;
	УсловияВходящих = Новый Массив;
	ПоляЛокаторов = Новый Соответствие;
	ПоляИндекса = Новый Массив;
	Псевдоним = "ИсточникОбрезки";
	Для Каждого Ключ Из Ключи Цикл
		Типы = Чтение.Колонки.Найти(Ключ).ТипЗначения;
		// Собственные имена колонок исключают конфликт ключей со служебным маркером и псевдонимами.
		ПолеЛокатора = "КлючОбрезки" + Формат(ПоляЛокаторов.Количество() + 1, "ЧГ=0");
		ПоляЛокаторов.Вставить(Ключ, ПолеЛокатора);
		Локаторы.Колонки.Добавить(ПолеЛокатора, Типы);
		Проекция.Добавить("КандидатыОбрезки." + ПолеЛокатора);
		ПроекцияВходящих.Добавить(СтрШаблон("ИсточникОбрезки.%1 КАК %2", Ключ, ПолеЛокатора));
		Если ДопустимТипИндекса(Типы) Тогда
			ПоляИндекса.Добавить(ПолеЛокатора);
		КонецЕсли;
		Условие = Псевдоним + "." + Ключ + " = ОтборКаскада." + ПолеЛокатора;
		УсловиеВходящих = "ВходящиеОбрезки." + ПолеЛокатора + " = ОтборКаскада." + ПолеЛокатора;
		Если Типы.СодержитТип(Тип("Null")) Тогда
			Условие = "(" + Условие + " ИЛИ " + Псевдоним + "." + Ключ
				+ " ЕСТЬ NULL И ОтборКаскада." + ПолеЛокатора + " ЕСТЬ NULL)";
			УсловиеВходящих = "(" + УсловиеВходящих + " ИЛИ ВходящиеОбрезки." + ПолеЛокатора
				+ " ЕСТЬ NULL И ОтборКаскада." + ПолеЛокатора + " ЕСТЬ NULL)";
		КонецЕсли;
		Условия.Добавить(Условие);
		УсловияВходящих.Добавить(УсловиеВходящих);
	КонецЦикла;
	Локаторы.Колонки.Добавить("ВходитВКаскад", Новый ОписаниеТипов("Булево"));
	Проекция.Добавить("КандидатыОбрезки.ВходитВКаскад");
	Если Узлы <> Неопределено Тогда
		Для Каждого Узел Из Узлы Цикл
			Если Узел.Таблица.Вид <> Таблица.Вид И Таблица.Вид <> "ТабличнаяЧасть" Тогда
				Продолжить;
			КонецЕсли;
			СтрокаКлючей = Локаторы.Добавить();
			Для Каждого Ключ Из Ключи Цикл
				СтрокаКлючей[ПоляЛокаторов[Ключ]] = ДекодироватьКлюч(Узел.Локатор.Ключи[Ключ]);
			КонецЦикла;
			СтрокаКлючей.ВходитВКаскад = Истина;
		КонецЦикла;
	КонецЕсли;
	Соединение = "ИСТИНА";
	Если Условия.Количество() > 0 Тогда
		Соединение = СтрСоединить(Условия, " И ");
	КонецЕсли;
	Временные = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Временные;
	Попытка
		Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(Проекция, ", ")
			+ " ПОМЕСТИТЬ ОтборКаскада ИЗ &Кандидаты КАК КандидатыОбрезки";
		// Индекс ускоряет соединение, но полное сравнение ключей ниже от его состава не зависит.
		Если ПоляИндекса.Количество() > 0 Тогда
			Запрос.Текст = Запрос.Текст + " ИНДЕКСИРОВАТЬ ПО " + СтрСоединить(ПоляИндекса, ", ");
		КонецЕсли;
		Запрос.УстановитьПараметр("Кандидаты", Локаторы);
		Запрос.Выполнить();
	Исключение
		Временные.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	СоединениеВходящих = "ИСТИНА";
	Если УсловияВходящих.Количество() > 0 Тогда
		СоединениеВходящих = СтрСоединить(УсловияВходящих, " И ");
	КонецЕсли;
	Возврат Новый Структура("Временные,Соединение,ПроекцияВходящих,СоединениеВходящих",
		Временные, Соединение, СтрСоединить(ПроекцияВходящих, ", "), СоединениеВходящих);

КонецФункции
Функция ДопустимТипИндекса(Типы)

	СоставТипов = Типы.Типы();
	ИндексNull = СоставТипов.Найти(Тип("Null"));
	Если ИндексNull <> Неопределено Тогда
		СоставТипов.Удалить(ИндексNull);
	КонецЕсли;
	Если СоставТипов.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипПоля = СоставТипов[0];
	Если ТипПоля = Тип("Строка") Тогда
		Возврат Типы.КвалификаторыСтроки.Длина > 0;
	КонецЕсли;
	Возврат ТипПоля = Тип("Число") Или ТипПоля = Тип("Дата") Или ТипПоля = Тип("Булево")
		Или Метаданные.НайтиПоТипу(ТипПоля) <> Неопределено;

КонецФункции

Процедура ПроверитьОсобыеВходящие(Контекст, Ссылки, Группы, Кандидаты, Прогресс)

	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Цели = Новый Соответствие;
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		Цели.Вставить(КлючСсылки(СсылкаОбъекта), Истина);
	КонецЦикла;
	Особые = НовыйСнимок(Контекст.Каталог);
	КонтекстЧтения = КонтекстКонтроляКаскадов(Контекст);
	// Текущую транзакцию удаления завершаем даже после запроса остановки.
	КонтекстЧтения.Вставить("Запуск", "");
	Работы = Новый Массив;
	Для Каждого Таблица Из Контекст.НепрозрачныеТаблицы Цикл
		СообщитьЭтапУдаления(Прогресс.Запуск, Прогресс.Задание,
			"Проверка входящих ссылок: " + Таблица.Имя + "; МоментВремени", 0, Прогресс.Контроль);
		Работы.Очистить();
		ДобавитьЧтениеВолны(Работы, Таблица,
			Новый Структура("Условие,Параметры,Цели", "ИСТИНА", Неопределено, Цели));
		ВыполнитьЧтенияВолны(КонтекстЧтения, Особые, Работы);
	КонецЦикла;
	Для Каждого Описание Из Метаданные.Константы Цикл
		Если КонстантаПодходитВолне(Описание, Группы) Тогда
			СообщитьЭтапУдаления(Прогресс.Запуск, Прогресс.Задание,
				"Проверка входящих ссылок: " + Описание.ПолноеИмя(), 0, Прогресс.Контроль);
			ДобавитьОднуКонстанту(Особые, Описание);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Пара Из Особые.Узлы Цикл
		Для Каждого СсылкаУзла Из Пара.Значение.Ссылки Цикл
			Если Цели.Получить(СсылкаУзла.Ключ) <> Неопределено
				И Кандидаты.Получить(Пара.Ключ) = Неопределено Тогда
				ВызватьИсключение "После планирования появилась новая входящая ссылка: "
					+ Пара.Значение.Таблица.Имя + ". Каскад отменен.";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНайденныеКаскада(Снимок, Кандидаты, Найденные)

	Для Каждого Найденная Из Найденные Цикл
		Если ПокрытаЗависимостьРегистратора(Снимок, Кандидаты, Найденная) Тогда
			Продолжить;
		КонецЕсли;
		Цель = КлючСсылки(Найденная[0]);
		Описание = МетаданныеСсылки(Найденная[1]);
		Если Описание <> Неопределено И Кандидаты.Получить(КлючСсылки(Найденная[1])) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Покрыта = Ложь;
		Для Каждого Пара Из Снимок.Узлы Цикл
			Узел = Пара.Значение;
			Если Узел.Таблица.Корень <> Найденная[2].ПолноеИмя()
				И Узел.Таблица.Имя <> Найденная[2].ПолноеИмя() Тогда
				Продолжить;
			КонецЕсли;
			Если Узел.Ссылки.Получить(Цель) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Описание = Неопределено Тогда
				Покрыта = Истина;
			ИначеЕсли Узел.Таблица.Вид <> "Объект" И Узел.Таблица.Вид <> "ТабличнаяЧасть" Тогда
				Регистратор = Неопределено;
				Если Узел.Локатор.Ключи.Свойство("Регистратор", Регистратор) Тогда
					Покрыта = ДекодироватьКлюч(Регистратор) = Найденная[1];
				КонецЕсли;
			КонецЕсли;
			Если Покрыта Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Покрыта Тогда
			ВызватьИсключение "Платформенный поиск обнаружил зависимость вне каскада: "
				+ Найденная[2].ПолноеИмя();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПокрытаЗависимостьРегистратора(Снимок, Кандидаты, Найденная)

	// НайтиПоСсылкам может свернуть запись подчиненного регистра до документа-регистратора.
	// Достаточно удаления конкретной зависимой записи, сам регистратор может сохраняться.
	Если МетаданныеСсылки(Найденная[1]) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Владельцы = Снимок.Входящие.Получить(КлючСсылки(Найденная[0]));
	Если Владельцы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Пара Из Владельцы Цикл
		Узел = Снимок.Узлы[Пара.Ключ];
		Если Кандидаты.Получить(Пара.Ключ) = Неопределено
			Или Узел.Таблица.Вид = "Объект" Или Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Продолжить;
		КонецЕсли;
		Регистратор = Неопределено;
		Если Узел.Локатор.Ключи.Свойство("Регистратор", Регистратор)
			И ДекодироватьКлюч(Регистратор) = Найденная[1] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ПодготовитьОписанияКаскадов(Контекст)

	Контекст.Вставить("ПолныеЧтения", Новый Соответствие);
	Для Каждого Таблица Из Контекст.Каталог Цикл
		Чтение = ОписаниеЧтения(Таблица, Истина);
		Чтение.Вставить("ОбъединяемыеПоля", ОбъединяемыеПоляТаблицы(Таблица));
		Контекст.Чтения.Вставить(Таблица.Имя, Чтение);
		Контекст.ПолныеЧтения.Вставить(Таблица.Имя, ОписаниеЧтения(Таблица, Ложь, Чтение.Колонки));
	КонецЦикла;
	ПодготовитьКартуВходящих(Контекст);

КонецПроцедуры

Процедура ПодготовитьКартуВходящих(Контекст)

	Контекст.Вставить("КартаВходящих", Новый Соответствие);
	Контекст.Вставить("ТаблицыВладельцев", Новый Соответствие);
	Контекст.Вставить("ТаблицыПоИменам", Новый Соответствие);
	Контекст.Вставить("ТаблицыПоКорню", Новый Соответствие);
	Контекст.Вставить("НепрозрачныеТаблицы", Новый Массив);
	Контекст.Вставить("НепрозрачныеПоИменам", Новый Соответствие);
	Для Каждого Таблица Из Контекст.Каталог Цикл
		Контекст.ТаблицыПоИменам.Вставить(Таблица.Имя, Таблица);
		ТаблицыКорня = Контекст.ТаблицыПоКорню.Получить(Таблица.Корень);
		Если ТаблицыКорня = Неопределено Тогда
			ТаблицыКорня = Новый Массив;
			Контекст.ТаблицыПоКорню.Вставить(Таблица.Корень, ТаблицыКорня);
		КонецЕсли;
		ТаблицыКорня.Добавить(Таблица);
		Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
			Владельцы = Контекст.ТаблицыВладельцев.Получить(Таблица.Корень);
			Если Владельцы = Неопределено Тогда
				Владельцы = Новый Массив;
				Контекст.ТаблицыВладельцев.Вставить(Таблица.Корень, Владельцы);
			КонецЕсли;
			Владельцы.Добавить(Таблица);
		КонецЕсли;
		Непрозрачная = Ложь;
		Для Каждого Колонка Из Контекст.Чтения[Таблица.Имя].Колонки Цикл
			Если Таблица.Вид = "Объект" И Колонка.Имя = "Ссылка" Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ТипПоля Из Колонка.ТипЗначения.Типы() Цикл
				Если ТипПоля = Тип("МоментВремени") Тогда
					Непрозрачная = Истина;
					Продолжить;
				КонецЕсли;
				Описание = Метаданные.НайтиПоТипу(ТипПоля);
				Если Описание <> Неопределено И Не СтрНачинаетсяС(Описание.ПолноеИмя(), "Перечисление.") Тогда
					ДобавитьПолеКарты(Контекст.КартаВходящих, Описание.ПолноеИмя(), Таблица.Имя, Колонка.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если Непрозрачная Тогда
			Контекст.НепрозрачныеТаблицы.Добавить(Таблица);
			Контекст.НепрозрачныеПоИменам.Вставить(Таблица.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеКарты(Карта, Цель, ИмяТаблицы, ИмяПоля)

	Таблицы = Карта.Получить(Цель);
	Если Таблицы = Неопределено Тогда
		Таблицы = Новый Соответствие;
		Карта.Вставить(Цель, Таблицы);
	КонецЕсли;
	Поля = Таблицы.Получить(ИмяТаблицы);
	Если Поля = Неопределено Тогда
		Поля = Новый Соответствие;
		Таблицы.Вставить(ИмяТаблицы, Поля);
	КонецЕсли;
	Поля.Вставить(ИмяПоля, Истина);

КонецПроцедуры

Функция ГруппыТиповЦелей(Ссылки)

	Группы = Новый Соответствие;
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		Описание = МетаданныеСсылки(СсылкаОбъекта);
		Имя = Описание.ПолноеИмя();
		Группа = Группы.Получить(Имя);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Имя, Группа);
		КонецЕсли;
		Группа.Добавить(СсылкаОбъекта);
	КонецЦикла;
	Возврат Группы;

КонецФункции

Функция ПоляВходящихВолны(Контекст, Группы)

	Результат = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Таблицы = Контекст.КартаВходящих.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Таблица Из Таблицы Цикл
			Для Каждого Поле Из Таблица.Значение Цикл
				ДобавитьПолеКарты(Результат, "Волна", Таблица.Ключ, Поле.Ключ);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Поля = Результат.Получить("Волна");
	Если Поля = Неопределено Тогда
		Поля = Новый Соответствие;
	КонецЕсли;
	Возврат Поля;

КонецФункции

Процедура ОпределитьРаботыКаскадов(Контекст)

	Представители = Новый Соответствие;
	Для Каждого Таблица Из Контекст.Каталог Цикл
		Если ПолеПериода(Таблица) = "" Тогда
			Продолжить;
		КонецЕсли;
		Группа = Представители.Получить(Таблица.Корень);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Представители.Вставить(Таблица.Корень, Группа);
		КонецЕсли;
		Группа.Добавить(Новый Структура("Метаданные,Вид", Таблица.Корень, Таблица.Вид));
	КонецЦикла;
	Для Каждого Пара Из Представители Цикл
		Полосы = Новый Массив;
		Для Номер = 1 По Контекст.КоличествоПотоков Цикл
			Идентификатор = Лев(ХешКлюча(Пара.Ключ + "|" + Строка(Номер)), 36);
			Наименование = ИмяРаботы(Пара.Значение);
			Если Контекст.КоличествоПотоков > 1 Тогда
				Наименование = Наименование + СтрШаблон(" (поток %1)", Номер);
			КонецЕсли;
			Полосы.Добавить(Идентификатор);
			Контекст.Работы.Добавить(Новый Структура("Идентификатор,Наименование,Всего",
				Идентификатор, Наименование, 0));
		КонецЦикла;
		Контекст.ПолосыРабот.Вставить(Пара.Ключ, Полосы);
		Контекст.КартаРабот.Вставить(Пара.Ключ, Полосы[0]);
	КонецЦикла;

КонецПроцедуры

Функция ПоколениеДанныхКаскадов(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Состояния.Обработано), 0) КАК Поколение
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Запуск = &Запуск И Состояния.Задание <> &Заголовок");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Поколение;

КонецФункции

Процедура ОбновитьПоколениеКеша(Контекст)

	Поколение = ПоколениеДанныхКаскадов(Контекст.Запуск);
	Если Поколение = Контекст.ПоколениеКеша Тогда
		Возврат;
	КонецЕсли;
	// Любая фиксация могла вызвать неизвестный обработчик. Частичная инвалидация небезопасна.
	Для Каждого Пара Из Контекст.КешХранилищ Цикл
		ОчиститьИндексКаскадов(Пара.Значение);
	КонецЦикла;
	Контекст.КешХранилищ.Очистить();
	Контекст.КешКонстант.Очистить();
	Контекст.ПоколениеКеша = Поколение;

КонецПроцедуры

Процедура ОчиститьКешЗапуска(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Узлы.Запуск КАК Кеш
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Вид В (&Виды) И Узлы.Метаданные = &Запуск");
	Запрос.УстановитьПараметр("Виды", СтрРазделить("КешХранилищ,ЧерновикКаскада", ","));
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОчиститьИндексКаскадов(Выборка.Кеш);
	КонецЦикла;

КонецПроцедуры

Процедура СохранитьСтраницуКеша(Снимок, Запуск, Кеш)

	Узлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
	Связи = РегистрыСведений.Cutter3000_Связи.СоздатьНаборЗаписей();
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Если Узел.Ссылки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ХешКлюча(Пара.Ключ);
		Данные = Новый Структура("Ключ,Таблица,Локатор,Единица,Поля,Ресурс", Узел.Ключ,
			Узел.Таблица.Имя, Узел.Локатор, Узел.Единица, Узел.Поля, Узел.Ресурс);
		Запись = Узлы.Добавить();
		Запись.Запуск = Кеш;
		Запись.Узел = Ключ;
		Запись.Вид = "КешХранилищ";
		Запись.Метаданные = Запуск;
		Запись.Локатор = ЗначениеВСтрокуВнутр(Данные);
		Для Каждого СсылкаУзла Из Узел.Ссылки Цикл
			Запись = Связи.Добавить();
			Запись.Запуск = Кеш;
			Запись.Цель = ХешКлюча(СсылкаУзла.Ключ);
			Запись.УзелИсточник = Ключ;
			Запись.Вхождение = 0;
			Запись.ЛокаторЦели = СсылкаУзла.Ключ;
		КонецЦикла;
	КонецЦикла;
	Если Узлы.Количество() > 0 Тогда
		// Владелец ТЧ может встретиться на разных страницах; ссылки всех строк сохраняются отдельно.
		Узлы.Записать(РежимЗамещения.Слияние);
		Связи.Записать(РежимЗамещения.Слияние);
	КонецЕсли;

КонецПроцедуры

Процедура НайтиКешированныеВходящие(Контекст, Снимок, Кеш, Цели)

	Ключи = Новый Массив;
	Для Каждого Цель Из Цели Цикл
		Ключи.Добавить(ХешКлюча(Цель.Ключ));
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2000 Связи.УзелИсточник КАК Узел
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		|ГДЕ Связи.Запуск = &Кеш И Связи.Цель В (&Цели) И Связи.УзелИсточник > &После
		|УПОРЯДОЧИТЬ ПО Узел");
	Запрос.УстановитьПараметр("Кеш", Кеш);
	Запрос.УстановитьПараметр("Цели", Ключи);
	Последний = "";
	Пока Истина Цикл
		Результат = ПрочитатьСтраницуКеша(Запрос, Последний);
		Выборка = Результат.Выбрать();
		Владельцы = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Владельцы.Добавить(Выборка.Узел);
			Последний = Выборка.Узел;
		КонецЦикла;
		Если Владельцы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ДобавитьВладельцевКеша(Контекст, Снимок, Кеш, Владельцы);
		Если Владельцы.Количество() < РазмерПорции() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьСтраницуКеша(Запрос, После)

	// Запрос уже содержит все цели волны; курсор ограничивает страницу владельцев, а не отдельную ссылку.
	Запрос.УстановитьПараметр("После", После);
	Возврат Запрос.Выполнить();

КонецФункции

Процедура ДобавитьВладельцевКеша(Контекст, Снимок, Кеш, Владельцы)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Узлы.Узел КАК Ключ, Узлы.Локатор КАК Данные, Связи.ЛокаторЦели КАК Цель
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Связи КАК Связи
		| ПО Узлы.Запуск = Связи.Запуск И Узлы.Узел = Связи.УзелИсточник
		|ГДЕ Узлы.Запуск = &Кеш И Узлы.Узел В (&Владельцы)");
	Запрос.УстановитьПараметр("Кеш", Кеш);
	Запрос.УстановитьПараметр("Владельцы", Владельцы);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПоКлючам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Узел = ПоКлючам.Получить(Выборка.Ключ);
		Если Узел = Неопределено Тогда
			Узел = ЗначениеИзСтрокиВнутр(Выборка.Данные);
			Узел.Таблица = Контекст.ТаблицыПоИменам[Узел.Таблица];
			Узел.Вставить("Ссылки", Новый Соответствие);
			ПоКлючам.Вставить(Выборка.Ключ, Узел);
		КонецЕсли;
		Узел.Ссылки.Вставить(Выборка.Цель, Истина);
	КонецЦикла;
	Для Каждого Пара Из ПоКлючам Цикл
		Узел = Пара.Значение;
		СсылкаОбъекта = Неопределено;
		Если Узел.Таблица.Вид = "Объект" Или Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Локатор = ЗначениеИзСтрокиВнутр(Узел.Ключ);
			СсылкаОбъекта = ДекодироватьКлюч(Локатор);
		КонецЕсли;
		СлитьУзелКаскада(Снимок, Узел, СсылкаОбъекта);
	КонецЦикла;

КонецПроцедуры

Функция КонстантаПодходитВолне(Описание, Группы)

	Для Каждого ТипПоля Из Описание.Тип.Типы() Цикл
		Если ТипПоля = Тип("МоментВремени") Тогда
			Возврат Истина;
		КонецЕсли;
		ОписаниеЦели = Метаданные.НайтиПоТипу(ТипПоля);
		Если ОписаниеЦели <> Неопределено И Группы.Получить(ОписаниеЦели.ПолноеИмя()) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПодготовитьКаскады(Контекст, Семена, Задание)

	Поколение = Контекст.ПоколениеКеша;
	Снимок = НовыйСнимок(Контекст.Каталог);
	Снимок.Вставить("Индекс", "");
	Снимок.Вставить("Обработанные", Новый Соответствие);
	Снимок.Вставить("ОбъемГрафа", 0);
	Снимок.Вставить("Всего", 0);
	Снимок.Вставить("Стоимость", 0);
	Для Каждого Пара Из Семена.Узлы Цикл
		СлитьУзелКаскада(Снимок, Пара.Значение, Семена.Ссылки.Получить(Пара.Ключ));
	КонецЦикла;
	ПеренестиГрафКаскада(Контекст, Снимок);
	Пока Истина Цикл
		Волна = СледующаяВолнаГрафа(Снимок);
		Цели = Новый Соответствие;
		Для Каждого Ссылка Из Волна Цикл
			Цели.Вставить(КлючСсылки(Ссылка), Истина);
		КонецЦикла;
		Если Волна.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ПрочитатьВладельцевКаскада(Контекст, Снимок, Волна);
		НайтиВходящиеКаскада(Контекст, Снимок, Волна, Цели);
		ПеренестиГрафКаскада(Контекст, Снимок);
	КонецЦикла;
	Если Снимок.Индекс = "" Тогда
		Снимок.Всего = Снимок.Узлы.Количество();
		Снимок.Стоимость = СтоимостьКаскада(Контекст, Снимок);
		Пересечения = ПересекающиесяЗаданияКаскадов(Контекст.Запуск, Снимок);
	Иначе
		Пересечения = ПересеченияГрафаИндекса(Контекст.Запуск, Снимок.Индекс);
	КонецЕсли;
	Возврат Новый Структура("Семена,Снимок,Задание,Пересечение,Поколение,ПересекающиесяЗадания,Стоимость,Всего",
		Семена, Снимок, Задание, Пересечения.Количество() > 0, Поколение, Пересечения,
		Снимок.Стоимость, Снимок.Всего);

КонецФункции

Функция ОценкиВходящихКорней(Контекст)

	Результат = Новый Соответствие;
	Для Каждого Корень Из Контекст.КартаВходящих Цикл
		Стоимость = 1;
		Для Каждого Таблица Из Корень.Значение Цикл
			Объединяемые = Контекст.Чтения[Таблица.Ключ].ОбъединяемыеПоля;
			Для Каждого Поле Из Таблица.Значение Цикл
				Вес = 1;
				Если Объединяемые.Получить(Поле.Ключ) <> Неопределено Тогда
					Вес = 4;
				КонецЕсли;
				Стоимость = Стоимость + Вес;
			КонецЦикла;
		КонецЦикла;
		Результат.Вставить(Корень.Ключ, Стоимость);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПорядокКандидатов(Каталог, Оценки)

	Очередь = Новый ТаблицаЗначений;
	Очередь.Колонки.Добавить("Таблица");
	Очередь.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	Очередь.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Для Каждого Таблица Из Каталог Цикл
		СтрокаОчереди = Очередь.Добавить();
		СтрокаОчереди.Таблица = Таблица;
		СтрокаОчереди.Номер = Очередь.Количество();
		СтрокаОчереди.Стоимость = 1;
		Оценка = Оценки.Получить(Таблица.Корень);
		Если Оценка <> Неопределено Тогда
			СтрокаОчереди.Стоимость = Оценка;
		КонецЕсли;
	КонецЦикла;
	Очередь.Сортировать("Стоимость Убыв, Номер");
	Возврат Очередь.ВыгрузитьКолонку("Таблица");

КонецФункции

Функция СтоимостьКаскада(Контекст, Снимок)

	Стоимость = Снимок.Узлы.Количество();
	Для Каждого Пара Из Снимок.Узлы Цикл
		Оценка = Контекст.ОценкиКорней.Получить(Пара.Значение.Таблица.Корень);
		Если Оценка <> Неопределено Тогда
			Стоимость = Стоимость + Оценка;
		КонецЕсли;
	КонецЦикла;
	Возврат Стоимость;

КонецФункции

Процедура СлитьУзелКаскада(Снимок, Узел, СсылкаОбъекта = Неопределено)

	Существующий = Снимок.Узлы.Получить(Узел.Ключ);
	Если Снимок.Свойство("ОбъемГрафа") Тогда
		Если Существующий = Неопределено Тогда
			Снимок.ОбъемГрафа = Снимок.ОбъемГрафа + 2048
				+ 4 * СтрДлина(Узел.Ключ) + 2 * СтрДлина(Узел.Единица);
		КонецЕсли;
		// Оценка консервативная: повторные страницы могут вызвать более ранний перенос.
		Для Каждого Ребро Из Узел.Ссылки Цикл
			Снимок.ОбъемГрафа = Снимок.ОбъемГрафа + 512 + 2 * СтрДлина(Ребро.Ключ);
		КонецЦикла;
	КонецЕсли;
	Если Существующий <> Неопределено Тогда
		Если Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Для Каждого Пара Из Узел.Ссылки Цикл
				Существующий.Ссылки.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
			Узел = Существующий;
		Иначе
			Для Каждого Пара Из Существующий.Ссылки Цикл
				Узел.Ссылки.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Снимок.Узлы.Вставить(Узел.Ключ, Узел);
	Если СсылкаОбъекта <> Неопределено Тогда
		Снимок.Ссылки.Вставить(Узел.Ключ, СсылкаОбъекта);
	КонецЕсли;
	Если Снимок.Свойство("Обработанные") Тогда
		// При подготовке обратный граф не нужен; он читается из индекса перед удалением.
		Возврат;
	КонецЕсли;
	Для Каждого Пара Из Узел.Ссылки Цикл
		Входящие = Снимок.Входящие.Получить(Пара.Ключ);
		Если Входящие = Неопределено Тогда
			Входящие = Новый Соответствие;
			Снимок.Входящие.Вставить(Пара.Ключ, Входящие);
		КонецЕсли;
		Входящие.Вставить(Узел.Ключ, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьВладельцевКаскада(Контекст, Снимок, Ссылки)

	Работы = Новый Массив;
	Для Каждого Группа Из ГруппыТиповЦелей(Ссылки) Цикл
		Таблицы = Контекст.ТаблицыВладельцев.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Таблица Из Таблицы Цикл
			Чтение = Контекст.Чтения[Таблица.Имя];
			ДобавитьЧтениеВолны(Работы, Таблица,
				Новый Структура("Условие,Параметры,Цели",
					СтрШаблон("%1.Ссылка В (&Ссылки)", Чтение.Псевдоним),
					Новый Структура("Ссылки", Группа.Значение), Неопределено));
		КонецЦикла;
	КонецЦикла;
	ВыполнитьЧтенияВолны(Контекст, Снимок, Работы);

КонецПроцедуры

Процедура НайтиВходящиеКаскада(Контекст, Снимок, Ссылки, Цели)

	Если Не Контекст.Свойство("КартаВходящих") Тогда
		ПодготовитьКартуВходящих(Контекст);
	КонецЕсли;
	Если Контекст.Свойство("КешХранилищ") Тогда
		ОбновитьПоколениеКеша(Контекст);
	КонецЕсли;
	Группы = ГруппыТиповЦелей(Ссылки);
	Поля = ПоляВходящихВолны(Контекст, Группы);
	Работы = Новый Массив;
	Для Каждого Пара Из Поля Цикл
		Таблица = Контекст.ТаблицыПоИменам[Пара.Ключ];
		Если Контекст.НепрозрачныеПоИменам.Получить(Таблица.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Чтение = Контекст.Чтения[Таблица.Имя];
		Для Каждого Поле Из Пара.Значение Цикл
			// Каждый отбор допускает самостоятельный план запроса и собственного читателя.
			// Совпадения разных полей объединяются по ключу узла после завершения волны.
			ДобавитьЧтениеВолны(Работы, Таблица,
				Новый Структура("Условие,Параметры,Цели",
					СтрШаблон("%1.%2 В (&Ссылки)", Чтение.Псевдоним, Поле.Ключ),
					Новый Структура("Ссылки", Ссылки), Цели));
		КонецЦикла;
	КонецЦикла;
	Для Каждого Таблица Из Контекст.НепрозрачныеТаблицы Цикл
		Если Контекст.Свойство("КешХранилищ") Тогда
			Кеш = Контекст.КешХранилищ.Получить(Таблица.Имя);
			Если Кеш = Неопределено Тогда
				ДобавитьЧтениеВолны(Работы, Таблица,
					Новый Структура("Условие,Параметры,Цели", "ИСТИНА", Неопределено, Цели),
					Строка(Новый УникальныйИдентификатор));
			Иначе
				НайтиКешированныеВходящие(Контекст, Снимок, Кеш, Цели);
			КонецЕсли;
		Иначе
			ДобавитьЧтениеВолны(Работы, Таблица,
				Новый Структура("Условие,Параметры,Цели", "ИСТИНА", Неопределено, Цели));
		КонецЕсли;
	КонецЦикла;
	ВыполнитьЧтенияВолны(Контекст, Снимок, Работы);
	Для Каждого Описание Из Метаданные.Константы Цикл
		Если Не КонстантаПодходитВолне(Описание, Группы) Тогда
			Продолжить;
		КонецЕсли;
		Страница = НовыйСнимок(Контекст.Каталог);
		Если Контекст.Свойство("КешКонстант") Тогда
			УзелКонстанты = Контекст.КешКонстант.Получить(Описание.Имя);
			Если УзелКонстанты = Неопределено Тогда
				ДобавитьОднуКонстанту(Страница, Описание);
				Для Каждого Пара Из Страница.Узлы Цикл
					УзелКонстанты = Пара.Значение;
					УзелКонстанты.Поля = Новый Структура;
				КонецЦикла;
				Контекст.КешКонстант.Вставить(Описание.Имя, УзелКонстанты);
			КонецЕсли;
			Страница.Узлы.Вставить(УзелКонстанты.Ключ, УзелКонстанты);
		Иначе
			ДобавитьОднуКонстанту(Страница, Описание);
		КонецЕсли;
		Для Каждого Пара Из Страница.Узлы Цикл
			Для Каждого СсылкаУзла Из Пара.Значение.Ссылки Цикл
				Если Цели.Получить(СсылкаУзла.Ключ) <> Неопределено Тогда
					// Константа связывает компоненту, но отказ относится только к этой компоненте.
					СлитьУзелКаскада(Снимок, Пара.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЧтениеВолны(Работы, Таблица, Отбор, Кеш = "")

	Работа = Новый Структура("Таблица,Условие,Параметры,Цели,Последний,Кеш",
		Таблица.Имя, Отбор.Условие, Отбор.Параметры, Отбор.Цели, Неопределено, Кеш);
	Работы.Добавить(Работа);

КонецПроцедуры

Процедура ВыполнитьЧтенияВолны(Контекст, Снимок, Работы)

	Если Не Контекст.Свойство("Читатели") Тогда
		Для Каждого Работа Из Работы Цикл
			Пока Истина Цикл
				Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Запрос страницы %1; отбор: %2", Работа.Таблица, Работа.Условие));
				Страница = ПрочитатьСтраницуРаботника(Контекст, Работа);
				ПринятьСтраницуВолны(Контекст, Снимок, Работа, Страница);
				Завершено = Страница.Завершено;
				Страница = Неопределено;
				Если Завершено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	ЧитателиВолны = Cutter3000_ЗаданияСервер.СлотыЧтенияПула(Контекст);
	Следующая = 0;
	Занятые = Новый Соответствие;
	Пока Следующая < Работы.Количество() Или Занятые.Количество() > 0 Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		ЕстьОтвет = Ложь;
		Для Каждого Слот Из ЧитателиВолны Цикл
			Пакет = Занятые.Получить(Слот.Идентификатор);
			Если Пакет <> Неопределено Тогда
				Ответ = Cutter3000_ЗаданияСервер.ПолучитьРезультатПула(Слот);
				Если Ответ = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЕстьОтвет = Истина;
				Пакет = ПринятьПакетВолны(Контекст, Снимок, Пакет, Ответ.Результат);
				Ответ = Неопределено;
			Иначе
				Пакет = Новый Массив;
			КонецЕсли;
			Пока Пакет.Количество() < ПределПакетаЧтения() И Следующая < Работы.Количество() Цикл
				Пакет.Добавить(Работы[Следующая]);
				Следующая = Следующая + 1;
			КонецЦикла;
			Если Пакет.Количество() > 0 Тогда
				Занятые.Вставить(Слот.Идентификатор, Пакет);
				Данные = ПараметрыПакетаЧтения(Пакет);
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Пакет чтения: таблиц %1; первая %2", Пакет.Количество(), Пакет[0].Таблица));
				Cutter3000_ЗаданияСервер.ОтправитьКомандуПула(Слот, "Чтение", Данные);
			Иначе
				Занятые.Удалить(Слот.Идентификатор);
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьОтвет И Занятые.Количество() > 0 Тогда
			ТаблицыОжидания = Новый Массив;
			Для Каждого Пара Из Занятые Цикл
				Для Каждого Работа Из Пара.Значение Цикл
					ТаблицыОжидания.Добавить(Работа.Таблица);
				КонецЦикла;
			КонецЦикла;
			СообщитьПодготовку(Контекст.Прогресс, "Ожидание страниц: " + СтрСоединить(ТаблицыОжидания, ", "));
			ЧитателиВолны[0].Фоновое.ОжидатьЗавершенияВыполнения(0.1);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПараметрыПакетаЧтения(Пакет)

	Результат = Новый Массив;
	Для Каждого Работа Из Пакет Цикл
		// Цели и кеш остаются у координатора; передаются только параметры ограниченного пакета.
		Результат.Добавить(Новый Структура("Таблица,Условие,Параметры,Последний",
			Работа.Таблица, Работа.Условие, Работа.Параметры, Работа.Последний));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПринятьПакетВолны(Контекст, Снимок, Пакет, Страницы)

	Завершенные = Новый Соответствие;
	Для Каждого Ответ Из Страницы Цикл
		Работа = Пакет[Ответ.НомерРаботы];
		ПринятьСтраницуВолны(Контекст, Снимок, Работа, Ответ.Страница);
		Если Ответ.Страница.Завершено Тогда
			Завершенные.Вставить(Ответ.НомерРаботы, Истина);
		КонецЕсли;
	КонецЦикла;
	Продолжение = Новый Массив;
	Для Индекс = 0 По Пакет.Количество() - 1 Цикл
		Если Завершенные.Получить(Индекс) = Неопределено Тогда
			Продолжение.Добавить(Пакет[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат Продолжение;

КонецФункции

Процедура ПринятьСтраницуВолны(Контекст, Снимок, Работа, Страница)

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Для Каждого Пара Из Страница.Узлы Цикл
		Узел = Пара.Значение;
		Узел.Таблица = Контекст.ТаблицыПоИменам[Узел.Таблица];
	КонецЦикла;
	Для Индекс = 1 По Страница.Прочитано Цикл
		ОтметитьЧтение(Контекст.Прогресс, Работа.Таблица);
	КонецЦикла;
	Если Работа.Кеш <> "" Тогда
		СохранитьСтраницуКеша(Страница, Контекст.Запуск, Работа.Кеш);
		Если Страница.Завершено Тогда
			Контекст.КешХранилищ.Вставить(Работа.Таблица, Работа.Кеш);
		КонецЕсли;
	КонецЕсли;
	СлитьСтраницуВолны(Снимок, Страница, Работа.Цели);
	Если Снимок.Свойство("Индекс") Тогда
		ПеренестиГрафКаскада(Контекст, Снимок);
	КонецЕсли;
	Работа.Последний = Страница.Последний;

КонецПроцедуры

Процедура СлитьСтраницуВолны(Снимок, Страница, Цели)

	Для Каждого Пара Из Страница.Узлы Цикл
		Узел = Пара.Значение;
		Подходит = Цели = Неопределено;
		Если Не Подходит Тогда
			Для Каждого СсылкаУзла Из Узел.Ссылки Цикл
				Если Цели.Получить(СсылкаУзла.Ключ) <> Неопределено Тогда
					Подходит = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Подходит Тогда
			СсылкаОбъекта = Страница.Ссылки.Получить(Пара.Ключ);
			Если Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
				Локатор = ЗначениеИзСтрокиВнутр(Пара.Ключ);
				СсылкаОбъекта = ДекодироватьКлюч(Локатор);
			КонецЕсли;
			СлитьУзелКаскада(Снимок, Узел, СсылкаОбъекта);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ВладельцыБитыхСсылок(Снимок)

	Владельцы = Новый Соответствие;
	ПоТаблицам = Новый Соответствие;
	Для Каждого Пара Из Снимок.Входящие Цикл
		Описание = ЗначениеИзСтрокиВнутр(Пара.Ключ);
		Ссылки = ПоТаблицам.Получить(Описание.Метаданные);
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Соответствие;
			ПоТаблицам.Вставить(Описание.Метаданные, Ссылки);
		КонецЕсли;
		Ссылки.Вставить(ДекодироватьКлюч(Описание), Пара.Ключ);
	КонецЦикла;
	Для Каждого Пара Из ПоТаблицам Цикл
		Ссылки = Новый Массив;
		Для Каждого СсылкаЦели Из Пара.Значение Цикл
			Ссылки.Добавить(СсылкаЦели.Ключ);
		КонецЦикла;
		Таблица = Новый Структура("Вид,Описание", "Объект", Метаданные.НайтиПоПолномуИмени(Пара.Ключ));
		Псевдоним = ПсевдонимТаблицы(Таблица);
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ %1.Ссылка ИЗ %2 КАК %1 "
			+ "ГДЕ %1.Ссылка В (&Ссылки)", Псевдоним, Пара.Ключ));
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Пара.Значение.Удалить(Выборка.Ссылка);
		КонецЦикла;
		Для Каждого Отсутствующая Из Пара.Значение Цикл
			Для Каждого Владелец Из Снимок.Входящие[Отсутствующая.Значение] Цикл
				Владельцы.Вставить(Владелец.Ключ, Истина);
			КонецЦикла;
			Если Снимок.Узлы.Получить(Отсутствующая.Значение) <> Неопределено Тогда
				// Отсутствующий владелец табличной части представлен ее собственным узлом.
				Владельцы.Вставить(Отсутствующая.Значение, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Владельцы;

КонецФункции

Функция ПропускиСнимка(Снимок, Запуск)

	// Локаторы имеют неограниченную длину и не допускают сравнения в запросе.
	// Отбор по хешу ограничивает чтение маркеров; точные единицы сопоставляются ниже.
	Единицы = Новый Массив;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Единицы.Добавить(ХешКлюча(Пара.Значение.Единица));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ План.Локатор, План.ЕдиницаЗаписи
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Пропущено
		| И План.КлючЕдиницы В (&Единицы)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Единицы", Единицы);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПропущенныеЕдиницы = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ПропущенныеЕдиницы.Вставить(Выборка.ЕдиницаЗаписи, Истина);
	КонецЦикла;
	Пропуски = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Если ПропущенныеЕдиницы.Получить(Пара.Значение.Единица) <> Неопределено Тогда
			Пропуски.Вставить(Пара.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Пропуски;

КонецФункции

Процедура ПроверитьПропускиСостава(Состав, Запуск)

	Единицы = Новый Массив;
	Для Каждого Элемент Из Состав Цикл
		Единицы.Добавить(ХешКлюча(Элемент.ЕдиницаЗаписи));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 План.Метаданные, План.Локатор
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Пропущено И План.КлючЕдиницы В (&Единицы)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Единицы", Единицы);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("Каскад пересекает ранее пропущенную зависимость %1: %2.",
			Выборка.Метаданные, Выборка.Локатор);
	КонецЕсли;

КонецПроцедуры

// Пустая область включает режим ограничения по метаданным. Неопределено означало бы поиск во всей базе.
Функция ПлатформенныйПоискПоКарте(Контекст, Ссылки, ТаблицыПроверены = Ложь)

	Группы = ГруппыТиповЦелей(Ссылки);
	Владельцы = Новый Соответствие;
	Если Не ТаблицыПроверены Тогда
		Для Каждого Пара Из ПоляВходящихВолны(Контекст, Группы) Цикл
			Таблица = Контекст.ТаблицыПоИменам[Пара.Ключ];
			Владельцы.Вставить(Таблица.Описание.ПолноеИмя(), Истина);
		КонецЦикла;
		Для Каждого Таблица Из Контекст.НепрозрачныеТаблицы Цикл
			Владельцы.Вставить(Таблица.Описание.ПолноеИмя(), Истина);
		КонецЦикла;
		Для Каждого Описание Из Метаданные.Константы Цикл
			Если КонстантаПодходитВолне(Описание, Группы) Тогда
				Владельцы.Вставить(Описание.ПолноеИмя(), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Журналы содержат системные ссылки на документы; они не входят в каталог удаляемых таблиц.
	Для Каждого Описание Из Метаданные.ЖурналыДокументов Цикл
		Владельцы.Вставить(Описание.ПолноеИмя(), Истина);
	КонецЦикла;
	Включения = Новый Массив;
	Для Каждого Пара Из Владельцы Цикл
		Включения.Добавить(Пара.Ключ);
	КонецЦикла;
	Если Включения.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	Возврат НайтиПоСсылкам(Ссылки, Новый Массив, Включения);

КонецФункции

// В малом каскаде очередь остается в памяти; после переноса ее хранит индекс.
Функция СледующаяВолнаГрафа(Снимок)

	Волна = Новый Массив;
	Если Снимок.Индекс = "" Тогда
		Для Каждого Пара Из Снимок.Ссылки Цикл
			Если Снимок.Обработанные.Получить(Пара.Ключ) = Неопределено Тогда
				Снимок.Обработанные.Вставить(Пара.Ключ, Истина);
				Волна.Добавить(Пара.Значение);
				Если Волна.Количество() = РазмерПорции() Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат Волна;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2000 Узлы.*
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Индекс И НЕ Узлы.Обработан
		| И Узлы.Вид В (&Виды) УПОРЯДОЧИТЬ ПО Узлы.Узел");
	Запрос.УстановитьПараметр("Индекс", Снимок.Индекс);
	Запрос.УстановитьПараметр("Виды", СтрРазделить("Объект,ТабличнаяЧасть", ","));
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() > 0 Тогда
		Для Каждого СтрокаУзла Из Строки Цикл
			Волна.Добавить(ДекодироватьКлюч(ЗначениеИзСтрокиВнутр(СтрокаУзла.Локатор)));
			СтрокаУзла.Обработан = Истина;
		КонецЦикла;
		Набор = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Снимок.Индекс);
		Набор.Загрузить(Строки);
		Набор.Записать(РежимЗамещения.Слияние);
	КонецЕсли;
	Возврат Волна;

КонецФункции

Процедура ПеренестиГрафКаскада(Контекст, Снимок)

	Если Снимок.Индекс = "" И Снимок.ОбъемГрафа < 32 * 1024 * 1024 Тогда
		Возврат;
	КонецЕсли;
	Если Снимок.Узлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Снимок.Индекс = "" Тогда
		Снимок.Индекс = Строка(Новый УникальныйИдентификатор);
		// Маркер нужен восстановлению после аварии, даже если план еще не опубликован.
		Маркер = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
		Маркер.Запуск = Снимок.Индекс;
		Маркер.Узел = "ЧерновикКаскада";
		Маркер.Вид = "ЧерновикКаскада";
		Маркер.Метаданные = Контекст.Запуск;
		Маркер.Обработан = Истина;
		Маркер.Записать();
	КонецЕсли;
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
		"Сохранение страницы графа", "Cutter3000_Узлы, Cutter3000_Связи", Снимок.Узлы.Количество());
	Пакет = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Пакет.Вставить(Пара.Ключ, Пара.Значение);
		Если Пакет.Количество() = 500 Тогда
			ЗаписатьУзлыГрафа(Контекст, Снимок, Пакет);
			Пакет.Очистить();
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		ЗаписатьУзлыГрафа(Контекст, Снимок, Пакет);
	КонецЕсли;
	Снимок.Узлы.Очистить();
	Снимок.Ссылки.Очистить();
	Снимок.Входящие.Очистить();
	Снимок.КлючиСсылок.Очистить();
	Снимок.Обработанные.Очистить();
	Снимок.ОбъемГрафа = 0;
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Снимок.Всего);
	СообщитьПодготовку(Контекст.Прогресс,
		СтрШаблон("Граф каскада в служебном индексе: узлов %1", Снимок.Всего));

КонецПроцедуры

Процедура ЗаписатьУзлыГрафа(Контекст, Снимок, Пакет)

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Если ТранзакцияАктивна() Тогда
		ЗаписатьПакетГрафа(Контекст, Снимок, Пакет);
		Возврат;
	КонецЕсли;
	НачатьТранзакцию(РежимБлокировок());
	Попытка
		ЗаписатьПакетГрафа(Контекст, Снимок, Пакет);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьПакетГрафа(Контекст, Снимок, Пакет)

	Хеши = Новый Соответствие;
	Ключи = Новый Массив;
	Для Каждого Пара Из Пакет Цикл
		Хеш = ХешКлюча(Пара.Ключ);
		Хеши.Вставить(Пара.Ключ, Хеш);
		Ключи.Добавить(Хеш);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Узлы.Узел, Узлы.Локатор, Узлы.Вид, Узлы.Обработан
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Индекс И Узлы.Узел В (&Ключи)");
	Запрос.УстановитьПараметр("Индекс", Снимок.Индекс);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Существующие = Новый Соответствие;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Существующие.Вставить(Выборка.Узел,
			Новый Структура("Локатор,Вид,Обработан", Выборка.Локатор, Выборка.Вид, Выборка.Обработан));
	КонецЦикла;
	Узлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
	Узлы.Отбор.Запуск.Установить(Снимок.Индекс);
	Связи = НоваяПорцияСвязейГрафа();
	Объем = 0;
	ПределСтрок = 1000;
	ПределОбъема = 2 * 1024 * 1024;
	Для Каждого Пара Из Пакет Цикл
		Узел = Пара.Значение;
		Ключ = Хеши[Пара.Ключ];
		Старый = Существующие.Получить(Ключ);
		Если Старый <> Неопределено И Старый.Локатор <> Пара.Ключ Тогда
			ВызватьИсключение "Коллизия ключей чернового индекса. Каскад не опубликован.";
		КонецЕсли;
		Если Старый = Неопределено Или (Старый.Вид = "ТабличнаяЧасть" И Узел.Таблица.Вид <> "ТабличнаяЧасть") Тогда
			Запись = Узлы.Добавить();
			Запись.Запуск = Снимок.Индекс;
			Запись.Узел = Ключ;
			Запись.Локатор = Пара.Ключ;
			Запись.Таблица = Узел.Таблица.Имя;
			Запись.Метаданные = Узел.Таблица.Корень;
			Запись.Вид = Узел.Таблица.Вид;
			Запись.ЕдиницаЗаписи = Узел.Единица;
			Запись.КлючЕдиницы = ХешКлюча(Узел.Единица);
			Запись.Ресурс = Узел.Ресурс;
			Если Узел.Таблица.Вид <> "ТабличнаяЧасть" Тогда
				Поле = ПолеПериода(Узел.Таблица);
				Запись.Первичный = Поле <> "" И Узел.Поля[Поле] < Контекст.Граница;
			КонецЕсли;
			Запись.Обработан = Снимок.Обработанные.Получить(Пара.Ключ) <> Неопределено;
			Если Старый <> Неопределено Тогда
				Запись.Обработан = Старый.Обработан;
			Иначе
				Снимок.Всего = Снимок.Всего + 1;
				Вес = Контекст.ОценкиКорней.Получить(Узел.Таблица.Корень);
				Если Вес = Неопределено Тогда
					Вес = 0;
				КонецЕсли;
				Снимок.Стоимость = Снимок.Стоимость + 1 + Вес;
			КонецЕсли;
		КонецЕсли;
		Для Каждого Ребро Из Узел.Ссылки Цикл
			СтрокаСвязи = Связи.Добавить();
			СтрокаСвязи.УзелИсточник = Ключ;
			СтрокаСвязи.ЛокаторЦели = Ребро.Ключ;
			Объем = Объем + 1024 + 2 * СтрДлина(Ребро.Ключ);
			Если Связи.Количество() >= ПределСтрок Или Объем >= ПределОбъема Тогда
				СохранитьПорциюСвязейГрафа(Снимок.Индекс, Связи);
				Объем = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Узлы.Количество() > 0 Тогда
		Узлы.Записать(РежимЗамещения.Слияние);
	КонецЕсли;
	СохранитьПорциюСвязейГрафа(Снимок.Индекс, Связи);

КонецПроцедуры

Функция НоваяПорцияСвязейГрафа(ДляЗапроса = Ложь)

	Связи = Новый ТаблицаЗначений;
	КороткаяСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Связи.Колонки.Добавить("УзелИсточник", КороткаяСтрока);
	Связи.Колонки.Добавить("ЛокаторЦели", Новый ОписаниеТипов("Строка"));
	Если ДляЗапроса Тогда
		Связи.Колонки.Добавить("Цель", КороткаяСтрока);
		Связи.Колонки.Добавить("Вхождение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	КонецЕсли;
	Возврат Связи;

КонецФункции

Процедура СохранитьПорциюСвязейГрафа(Индекс, Связи)

	Если Связи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Черновик хранит ограниченную порцию целиком; индекс каждой связи нужен только при группировке.
	Порция = РегистрыСведений.Cutter3000_Связи.СоздатьМенеджерЗаписи();
	Порция.Запуск = Индекс;
	Порция.Цель = "ПорцияГрафа";
	Порция.УзелИсточник = Строка(Новый УникальныйИдентификатор);
	Порция.Вхождение = 0;
	Порция.ЛокаторЦели = ЗначениеВСтрокуВнутр(Связи);
	Порция.Записать();
	Связи.Очистить();

КонецПроцедуры

Процедура ЗагрузитьСвязиГрафа(Запрос, Контекст)

	Связи = НоваяПорцияСвязейГрафа(Истина);
	Запрос.УстановитьПараметр("Связи", Связи);
	Запрос.Текст = "ВЫБРАТЬ Связи.* ПОМЕСТИТЬ РебраГрафа ИЗ &Связи КАК Связи ИНДЕКСИРОВАТЬ ПО Вхождение";
	Запрос.Выполнить();
	Чтение = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Связи.УзелИсточник КАК Порция, Связи.ЛокаторЦели КАК Данные
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		|ГДЕ Связи.Запуск = &Индекс И Связи.Цель = &Вид И Связи.УзелИсточник > &После
		|УПОРЯДОЧИТЬ ПО Связи.УзелИсточник");
	Чтение.УстановитьПараметр("Индекс", Запрос.Параметры.Запуск);
	Чтение.УстановитьПараметр("Вид", "ПорцияГрафа");
	Последняя = "";
	Вхождение = 0;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Чтение.УстановитьПараметр("После", Последняя);
		Результат = Чтение.Выполнить();
		Выборка = Результат.Выбрать();
		Если Не Выборка.Следующий() Тогда
			Прервать;
		КонецЕсли;
		Последняя = Выборка.Порция;
		Порция = ЗначениеИзСтрокиВнутр(Выборка.Данные);
		Хеши = Новый Соответствие;
		Для Каждого Ребро Из Порция Цикл
			СтрокаСвязи = Связи.Добавить();
			СтрокаСвязи.УзелИсточник = Ребро.УзелИсточник;
			СтрокаСвязи.ЛокаторЦели = Ребро.ЛокаторЦели;
			Хеш = Хеши.Получить(Ребро.ЛокаторЦели);
			Если Хеш = Неопределено Тогда
				Хеш = ХешКлюча(Ребро.ЛокаторЦели);
				Хеши.Вставить(Ребро.ЛокаторЦели, Хеш);
			КонецЕсли;
			СтрокаСвязи.Цель = Хеш;
			Вхождение = Вхождение + 1;
			СтрокаСвязи.Вхождение = Вхождение;
		КонецЦикла;
		Запрос.УстановитьПараметр("Связи", Связи);
		Запрос.Текст = "ВЫБРАТЬ Связи.УзелИсточник КАК УзелИсточник, Связи.ЛокаторЦели КАК ЛокаторЦели,
			| Связи.Цель КАК Цель, Связи.Вхождение КАК Вхождение ДОБАВИТЬ РебраГрафа ИЗ &Связи КАК Связи";
		Запрос.Выполнить();
		Связи.Очистить();
	КонецЦикла;
	Запрос.УстановитьПараметр("Связи", Неопределено);

КонецПроцедуры

Процедура СвернутьСвязиГрафа(Запрос)

	// Повторы владельца и его табличных частей объединяются в СУБД без полного графа в BSL.
	Запрос.Текст =
		"ВЫБРАТЬ Ребра.Цель КАК Цель, Ребра.УзелИсточник КАК УзелИсточник,
		| МИНИМУМ(Ребра.Вхождение) КАК Вхождение ПОМЕСТИТЬ УникальныеСвязи
		|ИЗ РебраГрафа КАК Ребра СГРУППИРОВАТЬ ПО Ребра.Цель, Ребра.УзелИсточник;
		|ВЫБРАТЬ Ребра.Цель КАК Цель, Ребра.УзелИсточник КАК УзелИсточник,
		| Ребра.ЛокаторЦели КАК ЛокаторЦели ПОМЕСТИТЬ СвязиГрафа
		|ИЗ РебраГрафа КАК Ребра ВНУТРЕННЕЕ СОЕДИНЕНИЕ УникальныеСвязи КАК Уникальные
		| ПО Ребра.Вхождение = Уникальные.Вхождение ИНДЕКСИРОВАТЬ ПО Цель, УзелИсточник;
		|УНИЧТОЖИТЬ УникальныеСвязи; УНИЧТОЖИТЬ РебраГрафа";
	Запрос.ВыполнитьПакет();

КонецПроцедуры


Функция ПересеченияГрафаИндекса(Запуск, Индекс)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ План.Задание ПОМЕСТИТЬ Задания
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И НЕ План.Пропущено
		|СГРУППИРОВАТЬ ПО План.Задание ИНДЕКСИРОВАТЬ ПО Задание;
		|ВЫБРАТЬ Свои.КлючЕдиницы КАК КлючЕдиницы, МИНИМУМ(Свои.Узел) КАК Опора
		|ПОМЕСТИТЬ ЕдиницыГрафа ИЗ РегистрСведений.Cutter3000_Узлы КАК Свои
		|ГДЕ Свои.Запуск = &Индекс И Свои.Вид <> &Маркер
		|СГРУППИРОВАТЬ ПО Свои.КлючЕдиницы ИНДЕКСИРОВАТЬ ПО КлючЕдиницы");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Индекс", Индекс);
	Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	Задания = Новый Соответствие;
	Попытка
		Запрос.ВыполнитьПакет();
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Занятые.Запуск КАК Задание, Занятые.Узел КАК Узел,
			| Занятые.Локатор КАК Занятый,
			| Занятые.ЕдиницаЗаписи КАК ЗанятаяЕдиница,
			| Свои.Локатор КАК Свой, Единица.ЕдиницаЗаписи КАК СвояЕдиница
			|ИЗ РегистрСведений.Cutter3000_Узлы КАК Занятые
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задания КАК Задания ПО Занятые.Запуск = Задания.Задание
			| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Свои
			| ПО Занятые.Узел = Свои.Узел И Свои.Запуск = &Индекс
			| ЛЕВОЕ СОЕДИНЕНИЕ ЕдиницыГрафа КАК Единицы ПО Занятые.КлючЕдиницы = Единицы.КлючЕдиницы
			| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Единица
			| ПО Единица.Запуск = &Индекс И Единица.Узел = Единицы.Опора
			|ГДЕ (Свои.Узел ЕСТЬ НЕ NULL ИЛИ Единицы.Опора ЕСТЬ НЕ NULL)
			| И (Занятые.Запуск > &Задание ИЛИ (Занятые.Запуск = &Задание И Занятые.Узел > &Узел))
			|УПОРЯДОЧИТЬ ПО Занятые.Запуск, Занятые.Узел";
		ПоследнееЗадание = "";
		ПоследнийУзел = "";
		Пока Истина Цикл
			Запрос.УстановитьПараметр("Задание", ПоследнееЗадание);
			Запрос.УстановитьПараметр("Узел", ПоследнийУзел);
			Строки = Запрос.Выполнить().Выгрузить();
			Если Строки.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			Для Каждого СтрокаУзла Из Строки Цикл
				Если СтрокаУзла.Занятый = СтрокаУзла.Свой Или СтрокаУзла.ЗанятаяЕдиница = СтрокаУзла.СвояЕдиница Тогда
					Задания.Вставить(СтрокаУзла.Задание, Истина);
				КонецЕсли;
				ПоследнееЗадание = СтрокаУзла.Задание;
				ПоследнийУзел = СтрокаУзла.Узел;
			КонецЦикла;
		КонецЦикла;
	Исключение
		ВременныеТаблицы.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ВременныеТаблицы.Закрыть();
	Результат = Новый Массив;
	Для Каждого Пара Из Задания Цикл
		Результат.Добавить(Пара.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СохранитьГрафИзИндекса(Контекст, Порция)

	Снимок = Порция.Снимок;
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
		"Группировка графа в базе данных", "Cutter3000_Узлы, Cutter3000_Связи", Снимок.Всего);
	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	Снимок.Вставить("ТаблицыПубликации", ВременныеТаблицы);
	Попытка
		Запрос = ЗапросИндекса(Снимок.Индекс, ВременныеТаблицы);
		Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
		ЗагрузитьСвязиГрафа(Запрос, Контекст);
		ПроверитьКлючиГрафа(Запрос);
		СвернутьСвязиГрафа(Запрос);
		Запрос.Текст =
			"ВЫБРАТЬ Узлы.Узел КАК Узел, Узлы.КлючЕдиницы КАК КлючЕдиницы
			|ПОМЕСТИТЬ Узлы ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
			|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид <> &Маркер ИНДЕКСИРОВАТЬ ПО Узел";
		Запрос.Выполнить();
		ПостроитьСмежностьГрафа(Запрос);
		СгруппироватьГрафИндекса(Запрос, Контекст);
		Запрос.Текст = "УНИЧТОЖИТЬ Смежность";
		Запрос.Выполнить();
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
		Группы = Новый Соответствие;
		Последний = "";
		Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
			"Публикация графа из индекса", "Cutter3000_План", Снимок.Всего);
		Пока Истина Цикл
			Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
			Запрос.УстановитьПараметр("Последний", Последний);
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 500 Узлы.*, Метки.Метка
				|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
				| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Метки КАК Метки ПО Узлы.Узел = Метки.Узел
				|ГДЕ Узлы.Запуск = &Запуск И Узлы.Узел > &Последний УПОРЯДОЧИТЬ ПО Узлы.Узел";
			Строки = Запрос.Выполнить().Выгрузить();
			Если Строки.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			ОпубликоватьУзлыГрафа(Контекст, Порция.Задание, Строки, Группы);
			Последний = Строки[Строки.Количество() - 1].Узел;
		КонецЦикла;
		ОпубликоватьСвязиГрафа(Контекст, ВременныеТаблицы, Порция.Задание);
		// Удаление черновика тоже входит во внешнюю транзакцию публикации.
		ОчиститьИндексКаскадов(Снимок.Индекс);
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Снимок.Всего);
	Исключение
		// После ошибки записи сначала откатывается внешняя транзакция.
		// Снимок удерживает менеджер до очистки вызывающим кодом после отката.
		ВызватьИсключение;
	КонецПопытки;
	ВременныеТаблицы.Закрыть();
	Снимок.Удалить("ТаблицыПубликации");
	Идентификаторы = Новый Массив;
	Для Каждого Пара Из Группы Цикл
		Идентификаторы.Добавить(Пара.Значение);
	КонецЦикла;
	Возврат Новый Структура("Группы,Всего,Задание", Идентификаторы, Снимок.Всего, Порция.Задание);

КонецФункции

Процедура ПостроитьСмежностьГрафа(Запрос)

	// Весь индекс уже относится к каскаду; дополнительные копии кандидатов и ребер не нужны.
	Запрос.Текст =
		"ВЫБРАТЬ Узлы.КлючЕдиницы КАК КлючЕдиницы, МИНИМУМ(Узлы.Узел) КАК Опора
		|ПОМЕСТИТЬ Единицы ИЗ Узлы КАК Узлы
		|СГРУППИРОВАТЬ ПО Узлы.КлючЕдиницы ИНДЕКСИРОВАТЬ ПО КлючЕдиницы;
		|ВЫБРАТЬ Связи.УзелИсточник КАК Первый, Связи.Цель КАК Второй ПОМЕСТИТЬ Смежность
		|ИЗ СвязиГрафа КАК Связи
		|ГДЕ Связи.УзелИсточник <> Связи.Цель
		| И Связи.УзелИсточник В (ВЫБРАТЬ Узел ИЗ Узлы) И Связи.Цель В (ВЫБРАТЬ Узел ИЗ Узлы)
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Связи.Цель, Связи.УзелИсточник
		|ИЗ СвязиГрафа КАК Связи
		|ГДЕ Связи.УзелИсточник <> Связи.Цель
		| И Связи.УзелИсточник В (ВЫБРАТЬ Узел ИЗ Узлы) И Связи.Цель В (ВЫБРАТЬ Узел ИЗ Узлы)
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Узлы.Узел, Единицы.Опора ИЗ Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Единицы КАК Единицы ПО Узлы.КлючЕдиницы = Единицы.КлючЕдиницы
		|ГДЕ Узлы.Узел <> Единицы.Опора
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Единицы.Опора, Узлы.Узел ИЗ Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Единицы КАК Единицы ПО Узлы.КлючЕдиницы = Единицы.КлючЕдиницы
		|ГДЕ Узлы.Узел <> Единицы.Опора;
		|ВЫБРАТЬ Узел КАК Узел, Узел КАК Метка ПОМЕСТИТЬ Метки ИЗ Узлы ИНДЕКСИРОВАТЬ ПО Узел;
		|УНИЧТОЖИТЬ Единицы; УНИЧТОЖИТЬ Узлы";
	Запрос.ВыполнитьПакет();

КонецПроцедуры

Процедура СгруппироватьГрафИндекса(Запрос, Контекст)

	Проход = 0;
	Пока Истина Цикл
		Проход = Проход + 1;
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		// Предложения адресуются общей метке, а не отдельному концу ребра:
		// компоненты объединяются по меньшей метке, в том числе у длинной цепочки.
		Запрос.Текст =
			"ВЫБРАТЬ Свои.Метка КАК Идентификатор, МИНИМУМ(ВЫБОР
			| КОГДА Свои.Метка < ЕСТЬNULL(Соседи.Метка, Свои.Метка) ТОГДА Свои.Метка
			| ИНАЧЕ ЕСТЬNULL(Соседи.Метка, Свои.Метка) КОНЕЦ) КАК Метка ПОМЕСТИТЬ Предложения
			|ИЗ Метки КАК Свои
			| ЛЕВОЕ СОЕДИНЕНИЕ Смежность КАК Ребра ПО Свои.Узел = Ребра.Первый
			| ЛЕВОЕ СОЕДИНЕНИЕ Метки КАК Соседи ПО Ребра.Второй = Соседи.Узел
			|СГРУППИРОВАТЬ ПО Свои.Метка ИНДЕКСИРОВАТЬ ПО Идентификатор;
			|ВЫБРАТЬ Старые.Узел КАК Узел, ВЫБОР
			| КОГДА Старые.Метка < ЕСТЬNULL(Предложения.Метка, Старые.Метка) ТОГДА Старые.Метка
			| ИНАЧЕ ЕСТЬNULL(Предложения.Метка, Старые.Метка) КОНЕЦ КАК Метка ПОМЕСТИТЬ Промежуточные
			|ИЗ Метки КАК Старые
			| ЛЕВОЕ СОЕДИНЕНИЕ Предложения КАК Предложения ПО Старые.Узел = Предложения.Идентификатор
			|ИНДЕКСИРОВАТЬ ПО Узел;
			|ВЫБРАТЬ Свои.Узел КАК Узел, Родители.Метка КАК Метка ПОМЕСТИТЬ НовыеМетки
			|ИЗ Промежуточные КАК Свои
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Промежуточные КАК Родители ПО Свои.Метка = Родители.Узел
			|ИНДЕКСИРОВАТЬ ПО Узел;
			|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Изменено
			|ИЗ НовыеМетки КАК Новые ВНУТРЕННЕЕ СОЕДИНЕНИЕ Метки КАК Старые
			| ПО Новые.Узел = Старые.Узел ГДЕ Новые.Метка <> Старые.Метка";
		Результаты = Запрос.ВыполнитьПакет();
		Выборка = Результаты[3].Выбрать();
		Выборка.Следующий();
		Изменено = Выборка.Изменено;
		Результаты = Неопределено;
		Выборка = Неопределено;
		Запрос.Текст =
			"УНИЧТОЖИТЬ Метки;
			|ВЫБРАТЬ Узел КАК Узел, Метка КАК Метка ПОМЕСТИТЬ Метки ИЗ НовыеМетки ИНДЕКСИРОВАТЬ ПО Узел;
			|УНИЧТОЖИТЬ Предложения; УНИЧТОЖИТЬ Промежуточные; УНИЧТОЖИТЬ НовыеМетки";
		Запрос.ВыполнитьПакет();
		Если Изменено = 0 Тогда
			Прервать;
		КонецЕсли;
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Объединение компонент каскада: проход %1, изменено меток %2", Проход, Изменено));
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьКлючиГрафа(Запрос)

	// Сокращенные идентификаторы используются для поиска; равенство подтверждается полными ключами.
	Запрос.Текст =
		"ВЫБРАТЬ Узлы.Узел КАК Узел, Узлы.КлючЕдиницы КАК КлючЕдиницы ПОМЕСТИТЬ КлючиЕдиниц
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид <> &Маркер ИНДЕКСИРОВАТЬ ПО КлючЕдиницы, Узел";
	Запрос.Выполнить();
	ПоследняяЕдиница = "";
	ПоследнийУзел = "";
	ПредыдущаяЕдиница = Неопределено;
	ПредыдущийКлюч = "";
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Единица", ПоследняяЕдиница);
		Запрос.УстановитьПараметр("Узел", ПоследнийУзел);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Ключи.Узел, Ключи.КлючЕдиницы, Узлы.ЕдиницаЗаписи
			|ИЗ КлючиЕдиниц КАК Ключи
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
			| ПО Ключи.Узел = Узлы.Узел И Узлы.Запуск = &Запуск
			|ГДЕ Ключи.КлючЕдиницы > &Единица ИЛИ (Ключи.КлючЕдиницы = &Единица И Ключи.Узел > &Узел)
			|УПОРЯДОЧИТЬ ПО Ключи.КлючЕдиницы, Ключи.Узел";
		Строки = Запрос.Выполнить().Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого СтрокаУзла Из Строки Цикл
			Если СтрокаУзла.КлючЕдиницы = ПредыдущийКлюч
				И СтрокаУзла.ЕдиницаЗаписи <> ПредыдущаяЕдиница Тогда
				ВызватьИсключение "Коллизия единиц чернового индекса. Каскад не опубликован.";
			КонецЕсли;
			ПредыдущийКлюч = СтрокаУзла.КлючЕдиницы;
			ПредыдущаяЕдиница = СтрокаУзла.ЕдиницаЗаписи;
			ПоследняяЕдиница = СтрокаУзла.КлючЕдиницы;
			ПоследнийУзел = СтрокаУзла.Узел;
		КонецЦикла;
	КонецЦикла;
	Запрос.Текст = "УНИЧТОЖИТЬ КлючиЕдиниц";
	Запрос.Выполнить();
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 Связи.Вхождение КАК КлючЦели, Связи.УзелИсточник КАК Источник,
		| Связи.ЛокаторЦели КАК Цель, Узлы.Локатор КАК Узел
		|ИЗ РебраГрафа КАК Связи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ПО Узлы.Запуск = &Запуск И Связи.Цель = Узлы.Узел
		|ГДЕ Связи.Вхождение > &Цель
		|УПОРЯДОЧИТЬ ПО Связи.Вхождение";
	ПоследняяЦель = 0;
	ПоследнийИсточник = "";
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Цель", ПоследняяЦель);
		Запрос.УстановитьПараметр("Источник", ПоследнийИсточник);
		Строки = Запрос.Выполнить().Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого СтрокаСвязи Из Строки Цикл
			Если СтрокаСвязи.Цель <> СтрокаСвязи.Узел Тогда
				ВызватьИсключение "Коллизия ссылок чернового индекса. Каскад не опубликован.";
			КонецЕсли;
			ПоследняяЦель = СтрокаСвязи.КлючЦели;
			ПоследнийИсточник = СтрокаСвязи.Источник;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОпубликоватьУзлыГрафа(Контекст, Задание, Строки, Группы)

	План = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
	План.Отбор.Запуск.Установить(Контекст.Запуск);
	Узлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
	Узлы.Отбор.Запуск.Установить(Задание);
	ОбъемПлана = 0;
	ОбъемУзлов = 0;
	Для Каждого СтрокаУзла Из Строки Цикл
		Группа = Группы.Получить(СтрокаУзла.Метка);
		Если Группа = Неопределено Тогда
			Группа = Строка(Новый УникальныйИдентификатор);
			Группы.Вставить(СтрокаУзла.Метка, Группа);
		КонецЕсли;
		Запись = План.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаУзла, "Метаданные,Вид,Локатор,ЕдиницаЗаписи,КлючЕдиницы");
		Запись.Запуск = Контекст.Запуск;
		Запись.Задание = Задание;
		Запись.Группа = Группа;
		Запись.Элемент = Строка(Новый УникальныйИдентификатор);
		Объем = 1024 + 2 * (СтрДлина(СтрокаУзла.Локатор) + СтрДлина(СтрокаУзла.ЕдиницаЗаписи));
		ОбъемПлана = ОбъемПлана + Объем;
		СохранитьПакетСлужебныхЗаписей(План, ОбъемПлана);
		Если СтрокаУзла.Вид <> "ТабличнаяЧасть" Тогда
			Запись = Узлы.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаУзла);
			Запись.Запуск = Задание;
			Запись.Обработан = Истина;
			ОбъемУзлов = ОбъемУзлов + Объем;
			СохранитьПакетСлужебныхЗаписей(Узлы, ОбъемУзлов);
		КонецЕсли;
	КонецЦикла;
	СохранитьПакетСлужебныхЗаписей(План, ОбъемПлана, Истина);
	СохранитьПакетСлужебныхЗаписей(Узлы, ОбъемУзлов, Истина);

КонецПроцедуры

Процедура ОпубликоватьСвязиГрафа(Контекст, ВременныеТаблицы, Задание)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 500 Связи.Цель, Связи.УзелИсточник, Связи.ЛокаторЦели
		|ИЗ СвязиГрафа КАК Связи
		|ГДЕ (Связи.Цель > &Цель ИЛИ (Связи.Цель = &Цель И Связи.УзелИсточник > &Источник))
		|УПОРЯДОЧИТЬ ПО Связи.Цель, Связи.УзелИсточник");
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	ПоследняяЦель = "";
	ПоследнийИсточник = "";
	Вхождение = 0;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Запрос.УстановитьПараметр("Цель", ПоследняяЦель);
		Запрос.УстановитьПараметр("Источник", ПоследнийИсточник);
		Строки = Запрос.Выполнить().Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Связи = РегистрыСведений.Cutter3000_Связи.СоздатьНаборЗаписей();
		Связи.Отбор.Запуск.Установить(Задание);
		Объем = 0;
		Для Каждого СтрокаСвязи Из Строки Цикл
			Вхождение = Вхождение + 1;
			Запись = Связи.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаСвязи);
			Запись.Запуск = Задание;
			Запись.Вхождение = Вхождение;
			Объем = Объем + 1024 + 2 * СтрДлина(СтрокаСвязи.ЛокаторЦели);
			СохранитьПакетСлужебныхЗаписей(Связи, Объем);
			ПоследняяЦель = СтрокаСвязи.Цель;
			ПоследнийИсточник = СтрокаСвязи.УзелИсточник;
		КонецЦикла;
		СохранитьПакетСлужебныхЗаписей(Связи, Объем, Истина);
	КонецЦикла;

КонецПроцедуры


#КонецОбласти
