#Область ПрограммныйИнтерфейс

// Нормализует обязательную дату до начала дня.
// Параметры:
//  ДатаОбрезки - Дата - первый сохраняемый день.
// Возвращаемое значение:
//  Дата - исключительная верхняя граница удаляемых периодов.
Функция ГраницаОбрезки(ДатаОбрезки) Экспорт

	Если Не ЗначениеЗаполнено(ДатаОбрезки) Тогда
		ВызватьИсключение "Укажите дату обрезки.";
	КонецЕсли;

	Возврат НачалоДня(ДатаОбрезки);

КонецФункции

// Строит полный план без изменения прикладных данных.
// Параметры:
//  Граница - Дата - начало первого сохраняемого дня.
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Массив из Структура - Идентификатор, Наименование, Всего для каждой работы;
//   строки плана и общий индекс сохранены в базе порциями.
Функция ПланОбрезки(Граница, Запуск) Экспорт

	Граница = ГраницаОбрезки(Граница);
	Контроль = Новый Структура("ПоследнееСообщение", Дата(1, 1, 1));
	Cutter3000_ЗаданияСервер.СообщитьПрогресс(Запуск, "Запуск", "Чтение метаданных и данных", 0, Контроль);
	// Плану нужны локаторы и связи; полные поля сохраняются только для контроля удаления.
	Прогресс = Новый Структура("Запуск,Контроль,Прочитано", Запуск, Контроль, 0);
	Попытка
		ОчиститьСлужебныеДанные(Запуск);
		ПостроитьИндексПорциями(Граница, Запуск, Прогресс);
		СообщитьПодготовку(Прогресс, "Расчет каскадов в базе данных");
		Возврат СохранитьКаскадыИРаботы(Запуск, Прогресс);
	Исключение
		ОчиститьСлужебныеДанные(Запуск);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Удаляет одну группу внутри транзакции, открытой координатором.
// Параметры:
//  Состав - ТаблицаЗначений - сохраненные строки плана группы.
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор логической работы.
//  КонтекстПроверки - Структура, Неопределено - описания метаданных, совместимость регистров
//   и служебные данные текущей попытки, без кеша прикладных данных.
//   КлючиПорцииПлана потребляются при входе и не сохраняются между попытками.
Процедура УдалитьГруппу(Состав, Запуск, Задание, КонтекстПроверки = Неопределено) Экспорт

	КлючиПорции = Неопределено;
	Если КонтекстПроверки <> Неопределено Тогда
		КонтекстПроверки.Свойство("КлючиПорцииПлана", КлючиПорции);
		КонтекстПроверки.Удалить("КлючиПорцииПлана");
	КонецЕсли;
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Удаление группы требует внешней транзакции.";
	КонецЕсли;
	Если КонтекстПроверки = Неопределено Тогда
		КонтекстПроверки = КонтекстКонтроляКаскадов();
	КонецЕсли;
	КонтекстПроверки.Вставить("ПовторУдаленияРегистра", "");
	КонтекстПроверки.Вставить("ПланУстарел", Ложь);
	Если Не КонтекстПроверки.Свойство("СовместимоеУдалениеРегистров") Тогда
		КонтекстПроверки.Вставить("СовместимоеУдалениеРегистров", Новый Соответствие);
	КонецЕсли;

	ПроверитьПропускиСостава(Состав, Запуск);
	Для Каждого ЭлементПлана Из Состав Цикл
		Если ЭлементПлана.Вид = "Константа" Тогда
			ВызватьИсключение "Каскад затрагивает неудаляемую константу " + ЭлементПлана.Метаданные;
		КонецЕсли;
	КонецЦикла;
	Контроль = Новый Структура("ПоследнееСообщение", Дата(1, 1, 1));
	Контроль.Вставить("КонтекстПроверки", КонтекстПроверки);
	Фоновое = Неопределено;
	КонтекстПроверки.Свойство("ФоновоеПрогресса", Фоновое);
	Контроль.Вставить("ФоновоеПрогресса", Фоновое);
	ОшибокДо = 0;
	КонтекстПроверки.Свойство("ОшибокДо", ОшибокДо);
	Контроль.Вставить("ОшибокДо", ОшибокДо);
	Если КонтекстПроверки <> Неопределено И КонтекстПроверки.Свойство("ЗафиксированоДо") Тогда
		Контроль.Вставить("ЗафиксированоДо", КонтекстПроверки.ЗафиксированоДо);
	КонецЕсли;
	Трассировка = Неопределено;
	Если КонтекстПроверки <> Неопределено Тогда
		КонтекстПроверки.Свойство("Трассировка", Трассировка);
	КонецЕсли;
	Контроль.Вставить("Трассировка", Трассировка);
	СообщитьЭтапУдаления(Запуск, Задание, "Блокировка каскада", 0, Контроль);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Блокировка каскада", "", Состав.Количество());
	ЗаблокироватьГруппу(Состав);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	СообщитьЭтапУдаления(Запуск, Задание, "Перечитывание каскада", 0, Контроль);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Перечитывание каскада", "", Состав.Количество());
	Снимок = СнимокГруппы(Состав, КонтекстПроверки);
	ПроверитьКорниОчереди(Снимок, КонтекстПроверки);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Чтение входящих из служебного индекса", "", Состав.Количество());
	ВладелецПлана = Задание;
	Если Не КонтекстПроверки.Свойство("ВладелецПлана", ВладелецПлана) Тогда
		ВладелецПлана = Задание;
	КонецЕсли;
	ДобавитьИндексированныеВходящие(Снимок, Запуск, Состав, ВладелецПлана, Трассировка, КлючиПорции);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Сопоставление снимка и плана", "", Состав.Количество());
	Кандидаты = КандидатыСохраненногоПлана(Состав, Снимок, КонтекстПроверки);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Проверка границ каскада", "", Состав.Количество());
	ПроверитьВходящиеГраницы(Снимок, Кандидаты);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Проверка прав и защищенных объектов", "", Состав.Количество());
	ПроверитьУдаляемость(Снимок, Кандидаты, Трассировка);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	СообщитьЭтапУдаления(Запуск, Задание, "Проверка входящих ссылок", 0, Контроль);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Проверка входящих ссылок", "", Состав.Количество());
	ПроверитьПоискКаскада(Снимок, Кандидаты, КонтекстПроверки, Запуск, Задание, Контроль, Истина);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	СообщитьЭтапУдаления(Запуск, Задание, "Удаление записей", 0, Контроль);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Удаление записей регистров", "", Состав.Количество());
	УдалитьЗаписиРегистров(Состав, Снимок, Запуск, Задание, Контроль);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Удаление ссылочных объектов", "", Состав.Количество());
	УдалитьСсылочныеОбъекты(Снимок, Кандидаты, Запуск, Задание, Контроль);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	СообщитьЭтапУдаления(Запуск, Задание, "Проверка сохранности записей",
		Состав.Количество(), Контроль);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Перечитывание сохраненных записей", "", Состав.Количество());
	Остаток = СнимокГруппы(Состав, КонтекстПроверки);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Сопоставление сохраненных записей", "", Состав.Количество());
	ПроверитьСохранностьЗаписей(Снимок, Остаток, Кандидаты);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Для Каждого ЭлементПлана Из Состав Цикл

		Если ЭлементПлана.Вид = "Объект" И Остаток.Узлы.Получить(ЭлементПлана.Локатор) <> Неопределено Тогда
			ВызватьИсключение "Удаляемый объект остался после выполнения обработчиков.";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Проверяет только остаток временного отбора без обхода ссылок после удаления.
// Параметры:
//  Граница - Дата - начало первого сохраняемого дня.
//  ПолныйКонтроль - Булево - сохранен для совместимости вызовов; проверка ссылок отключена.
// Возвращаемое значение:
//  Число - количество оставшихся кандидатов.
Функция ПроверитьРезультат(Граница, ПолныйКонтроль = Ложь) Экспорт

	Возврат КоличествоИсходныхКандидатов(Граница);

КонецФункции

// Создает серверный контекст порционного планирования без общего индекса базы.
// Параметры:
//  Граница - Дата - первый сохраняемый день.
//  Запуск - Строка - идентификатор запуска.
//  КоличествоПотоков - Число - число полос очереди, от 1 до 4; файловая база использует 1.
// Возвращаемое значение:
//  Структура - каталог, чтения, работы, курсоры и прогресс; только для серверного координатора.
Функция НачатьПланированиеКаскадов(Граница, Запуск, КоличествоПотоков = 1) Экспорт

	ПроверитьОбласть();
	Каталог = КаталогТаблиц();
	Контекст = Новый Структура("Граница,Запуск,Каталог,Чтения,Курсоры,Таблица,КартаРабот,Работы,Прогресс",
		ГраницаОбрезки(Граница), Запуск, Каталог, Новый Соответствие, Новый Соответствие, 0,
		Новый Соответствие, Новый Массив,
		Новый Структура("Запуск,Контроль,Прочитано", Запуск,
			Новый Структура("ПоследнееСообщение", Дата(1, 1, 1)), 0));
	ПодготовитьОписанияКаскадов(Контекст);
	Контекст.Вставить("КоличествоПотоков", Мин(4, Макс(1, КоличествоПотоков)));
	Контекст.Вставить("ПолосыРабот", Новый Соответствие);
	Контекст.Вставить("НомерПорции", 0);
	Контекст.Вставить("ОтложенныеЕдиницы", Новый Соответствие);
	Контекст.Вставить("КешХранилищ", Новый Соответствие);
	Контекст.Вставить("КешКонстант", Новый Соответствие);
	Контекст.Вставить("ПоколениеКеша", ПоколениеДанныхКаскадов(Запуск));
	Контекст.Вставить("ОценкиКорней", ОценкиВходящихКорней(Контекст));
	Контекст.Вставить("ПорядокКандидатов", ПорядокКандидатов(Каталог, Контекст.ОценкиКорней));
	ОпределитьРаботыКаскадов(Контекст);
	Возврат Контекст;

КонецФункции

// Перестраивает только изменившуюся компоненту из сохранённых исходных корней.
// Параметры:
//  Контекст - Структура - контекст планирования текущего сеанса.
//  Перестроение - Структура - сохранённые исходные корни и счётчик повторов.
// Возвращаемое значение:
//  Структура - новая порция с прежними полосами.
Функция ПерестроитьКомпонентуОчереди(Контекст, Перестроение) Экспорт

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	ОбновитьПоколениеКеша(Контекст);
	Актуальные = СнимокГруппы(Перестроение.Семена, Контекст);
	Семена = НовыйСнимок(Контекст.Каталог);
	ВладельцыНарушений = ВладельцыБитыхСсылок(Актуальные);
	Для Каждого Пара Из Актуальные.Узлы Цикл
		Узел = Пара.Значение;
		Поле = ПолеПериода(Узел.Таблица);
		Если (Поле <> "" И Узел.Поля[Поле] < Контекст.Граница)
			Или ВладельцыНарушений.Получить(Пара.Ключ) <> Неопределено Тогда
			СлитьУзелКаскада(Семена, Узел, Актуальные.Ссылки.Получить(Пара.Ключ));
		КонецЕсли;
	КонецЦикла;
	ИсключитьЗанятыеУзлы(Контекст.Запуск, Семена);
	Порция = ПодготовитьКаскады(Контекст, Семена, Строка(Новый УникальныйИдентификатор));
	Порция.Вставить("Полосы", Перестроение.Полосы);
	Порция.Вставить("ПовторыПерестроения", Перестроение.Повторы);
	Возврат Порция;

КонецФункции

// Создает контекст свежего контроля, содержащий только неизменяемые описания метаданных.
// Параметры:
//  Планирование - Структура, Неопределено - готовый контекст того же серверного сеанса.
// Возвращаемое значение:
//  Структура - карта типов и описания чтения без ссылок и содержимого прикладных данных.
Функция КонтекстКонтроляКаскадов(Планирование = Неопределено) Экспорт

	Контекст = Новый Структура("Каталог,Чтения,Прогресс", Неопределено, Неопределено, Неопределено);
	Если Планирование = Неопределено Тогда
		Контекст.Каталог = КаталогТаблиц();
		Контекст.Чтения = Новый Соответствие;
		ПодготовитьОписанияКаскадов(Контекст);
	Иначе
		Для Каждого Имя Из СтрРазделить("Каталог,Чтения,КартаВходящих,ТаблицыВладельцев,"
			+ "ТаблицыПоИменам,НепрозрачныеТаблицы,НепрозрачныеПоИменам,ТаблицыПоКорню,ПолныеЧтения", ",") Цикл
			Контекст.Вставить(Имя, Планирование[Имя]);
		КонецЦикла;
		Трассировка = Неопределено;
		Планирование.Свойство("Трассировка", Трассировка);
		Контекст.Вставить("Трассировка", Трассировка);
	КонецЕсли;
	Возврат Контекст;

КонецФункции

// Читает и разбирает одну страницу таблицы в сеансе постоянного работника.
// Параметры:
//  Контекст - Структура - описания метаданных работника, без кеша прикладных данных.
//  Работа - Структура - Таблица (имя), Условие, Параметры и Последний (ключ продолжения).
// Возвращаемое значение:
//  Структура - сериализуемые узлы, ссылки, курсор и количество прочитанных строк.
Функция ПрочитатьСтраницуРаботника(Контекст, Работа) Экспорт

	Таблица = Контекст.ТаблицыПоИменам[Работа.Таблица];
	Чтение = Контекст.Чтения[Таблица.Имя];
	РазмерСтраницы = РазмерСтраницыРаботника(Чтение);
	ЧтениеСтраницы = Новый Структура("Псевдоним,Поля,Ключи,РазмерСтраницы",
		Чтение.Псевдоним, Чтение.Поля, Чтение.Ключи, РазмерСтраницы);
	Результат = ПрочитатьПорцию(Таблица, ЧтениеСтраницы, Работа.Последний,
		Работа.Условие, Работа.Параметры, Контекст);
	ЗамерРазбора = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Разбор страницы данных", Таблица.Имя);
	Выборка = Результат.Выбрать();
	Страница = НовыйСнимок(Контекст.Каталог);
	Прочитано = 0;
	Последний = Работа.Последний;
	ОбъемСтраницы = 0;
	ОграниченаОбъемом = Ложь;
	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуПорции(Страница, Таблица, Выборка, Результат.Колонки);
		Последний = КлючПродолжения(Выборка, Чтение.Ключи);
		Прочитано = Прочитано + 1;
		ОбъемСтраницы = ОбъемСтраницы + ОценкаОбъемаСтроки(Выборка, Чтение.ОценкиОбъемаПолейРаботника);
		Если ОбъемСтраницы >= ПределОбъемаСтраницыЧтения() И Чтение.Ключи.Количество() > 0 Тогда
			ОграниченаОбъемом = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерРазбора, Прочитано);
	Для Каждого Пара Из Страница.Узлы Цикл
		Пара.Значение.Таблица = Пара.Значение.Таблица.Имя;
	КонецЦикла;
	Возврат Новый Структура("Узлы,Ссылки,Последний,Прочитано,Завершено",
		Страница.Узлы, Страница.Ссылки, Последний, Прочитано,
		(Не ОграниченаОбъемом И Прочитано < РазмерСтраницы) Или Чтение.Ключи.Количество() = 0);

КонецФункции

// Читает ограниченный пакет страниц разных таблиц без обмена после каждой страницы.
// Параметры:
//  Контекст - Структура - описания метаданных работника.
//  Работы - Массив - параметры таблиц, отборов и курсоров; не изменяются.
//  Запуск - Строка - идентификатор запуска для проверки остановки между страницами.
// Возвращаемое значение:
//  Массив - записи НомерРаботы, Страница; курсор хранится в каждой странице.
Функция ПрочитатьПакетСтраницРаботника(Контекст, Работы, Запуск) Экспорт

	ПределВремениМс = 1000;
	НачалоПакета = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Страницы = Новый Массив;
	Если Работы.Количество() > ПределПакетаЧтения() Тогда
		ВызватьИсключение "Превышено число заданий пакета чтения.";
	КонецЕсли;
	Ожидающие = Новый Массив;
	Для Индекс = 0 По Работы.Количество() - 1 Цикл
		Работа = Работы[Индекс];
		Ожидающие.Добавить(Новый Структура("Таблица,Условие,Параметры,Последний,НомерРаботы",
			Работа.Таблица, Работа.Условие, Работа.Параметры, Работа.Последний, Индекс));
	КонецЦикла;
	Индекс = 0;
	Пока Страницы.Количество() < ПределПакетаЧтения() И Ожидающие.Количество() > 0 Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Запуск);
		ПараметрыЧтения = Ожидающие[Индекс];
		Страница = ПрочитатьСтраницуРаботника(Контекст, ПараметрыЧтения);
		Страницы.Добавить(Новый Структура("НомерРаботы,Страница", ПараметрыЧтения.НомерРаботы, Страница));
		Если Страница.Завершено Тогда
			Ожидающие.Удалить(Индекс);
		Иначе
			ПараметрыЧтения.Последний = Страница.Последний;
			Индекс = Индекс + 1;
		КонецЕсли;
		Если Индекс >= Ожидающие.Количество() Тогда
			Индекс = 0;
		КонецЕсли;
		// Пустые проверки объединяются; графы непустых страниц не накапливаются в ответе.
		Если Страница.Прочитано > 0
			Или ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПакета >= ПределВремениМс Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Страницы;

КонецФункции

Функция ПределПакетаЧтения()

	Возврат 4;

КонецФункции

// Готовит полные входящие каскады очередной страницы кандидатов.
// Параметры:
//  Контекст - Структура - результат НачатьПланированиеКаскадов.
// Возвращаемое значение:
//  Структура, Неопределено - семена, снимок, работа, Всего и признак пересечения; пустой результат означает конец.
//   Всего содержит размер каскада; большой снимок хранит область индекса вместо коллекции Узлы.
Функция СледующаяПорцияКаскадов(Контекст) Экспорт

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);

	Пока Контекст.Таблица < Контекст.ПорядокКандидатов.Количество() Цикл
		Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);
		ОбновитьПоколениеКеша(Контекст);
		Таблица = Контекст.ПорядокКандидатов[Контекст.Таблица];
		Поле = ПолеПериода(Таблица);
		Если Поле = "" Тогда
			Контекст.Таблица = Контекст.Таблица + 1;
			Продолжить;
		КонецЕсли;
		Чтение = Контекст.Чтения[Таблица.Имя];
		Последний = Контекст.Курсоры.Получить(Таблица.Имя);
		СообщитьПодготовку(Контекст.Прогресс, "Запрос кандидатов " + Таблица.Имя);
		Результат = ПрочитатьПорцию(Таблица, Чтение, Последний,
			СтрШаблон("%1.%2 < &Граница", Чтение.Псевдоним, Поле),
			Новый Структура("Граница", Контекст.Граница), Контекст);
		ЗамерРазбора = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Разбор кандидатов", Таблица.Имя);
		Выборка = Результат.Выбрать();
		Семена = НовыйСнимок(Контекст.Каталог);
		Прочитано = 0;
		Пока Выборка.Следующий() Цикл
			ДобавитьСтрокуПорции(Семена, Таблица, Выборка, Результат.Колонки);
			Последний = КлючПродолжения(Выборка, Чтение.Ключи);
			Прочитано = Прочитано + 1;
			ОтметитьЧтение(Контекст.Прогресс, Таблица.Имя);
		КонецЦикла;
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерРазбора, Прочитано);
		Контекст.Курсоры.Вставить(Таблица.Имя, Последний);
		Если Прочитано < РазмерПорции() Тогда
			Контекст.Таблица = Контекст.Таблица + 1;
		КонецЕсли;
		ИсключитьЗанятыеУзлы(Контекст.Запуск, Семена);
		ИсключитьОтложенныеКорни(Контекст, Семена);
		Если Семена.Узлы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДополнитьСтарыеЕдиницы(Контекст, Семена);
		Полосы = Контекст.ПолосыРабот[Таблица.Корень];
		Задание = Полосы[Контекст.НомерПорции % Полосы.Количество()];
		Контекст.НомерПорции = Контекст.НомерПорции + 1;
		Порция = ПодготовитьКаскады(Контекст, Семена, Задание);
		Порция.Вставить("Полосы", Полосы);
		Возврат Порция;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Перечитывает каскад после изменения данных или пересечения; актуальную порцию возвращает без чтения.
// Параметры:
//  Контекст - Структура - серверный контекст планировщика.
//  Порция - Структура - подготовленная порция.
// Возвращаемое значение:
//  Структура - актуальная порция; снимок может оказаться пустым.
Функция ПеречитатьКаскады(Контекст, Порция) Экспорт

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);

	Поколение = ПоколениеДанныхКаскадов(Контекст.Запуск);
	Если ЕстьСохраненныйГраф(Порция) Тогда
		Пересечения = ПересеченияГрафаИндекса(Контекст.Запуск, Порция.Снимок.Индекс, Контекст.Прогресс);
		Порция.ПересекающиесяЗадания = Пересечения;
		Порция.Пересечение = Пересечения.Количество() > 0;
		Если Порция.Пересечение Тогда
			Возврат Порция;
		КонецЕсли;
		Если ЕстьПропускиГрафа(Контекст.Запуск, Порция.Снимок.Индекс) Тогда
			// Отказ мог не увеличить счетчик удаленных строк, но его единицы повторно выдавать нельзя.
			ОсвободитьГрафКаскада(Порция);
			Порция.Снимок = Неопределено;
			Порция.Пересечение = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Не Порция.Пересечение И Контекст.Свойство("ОбщаяОчередь") Тогда
		// Свежий состав каждой порции проверяет работник. Общий счетчик соседних удалений
		// не требует повторного обхода всех независимых компонент опубликованного графа.
		Возврат Порция;
	КонецЕсли;
	Если Не Порция.Пересечение И Порция.Поколение = Поколение Тогда
		Возврат Порция;
	КонецЕсли;
	Если ЕстьСохраненныйГраф(Порция) И СохраненныйГрафАктуален(Контекст, Порция) Тогда
		// Проверенное поколение фиксируется до выдачи; поздние изменения проверит работник.
		Порция.Поколение = Поколение;
		Возврат Порция;
	КонецЕсли;
	ОсвободитьГрафКаскада(Порция);
	ОбновитьПоколениеКеша(Контекст);
	Семена = НовыйСнимок(Контекст.Каталог);
	Состав = ЭлементыСнимкаКаскада(Порция.Семена);
	Актуальные = СнимокГруппы(Состав, Контекст);
	ВладельцыНарушений = ВладельцыБитыхСсылок(Актуальные);
	Для Каждого Пара Из Актуальные.Узлы Цикл
		Узел = Пара.Значение;
		Поле = ПолеПериода(Узел.Таблица);
		Если (Поле <> "" И Узел.Поля[Поле] < Контекст.Граница)
			Или ВладельцыНарушений.Получить(Пара.Ключ) <> Неопределено Тогда
			СлитьУзелКаскада(Семена, Узел, Актуальные.Ссылки.Получить(Пара.Ключ));
		КонецЕсли;
	КонецЦикла;
	ИсключитьЗанятыеУзлы(Контекст.Запуск, Семена);
	Актуальная = ПодготовитьКаскады(Контекст, Семена, Порция.Задание);
	Актуальная.Вставить("Полосы", Порция.Полосы);
	Возврат Актуальная;

КонецФункции

// Сохраняет проверенные неделимые компоненты очередной порции в транзакции координатора.
// Параметры:
//  Контекст - Структура - контекст планирования.
//  Порция - Структура - полные входящие каскады порции.
// Возвращаемое значение:
//  Структура - идентификаторы групп, количество и работа.
Функция СохранитьКаскады(Контекст, Порция) Экспорт

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Публикация каскада требует транзакции координатора.";
	КонецЕсли;
	Снимок = Порция.Снимок;
	Если Снимок.Свойство("Индекс") И Снимок.Индекс <> "" Тогда
		Возврат СохранитьГрафИзИндекса(Контекст, Порция);
	КонецЕсли;
	Всего = Снимок.Узлы.Количество();
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Группировка узлов каскада", "", Всего);
	Метки = Новый Соответствие;
	Единицы = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Метки.Вставить(Пара.Ключ, Пара.Ключ);
	КонецЦикла;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Первый = Единицы.Получить(Узел.Единица);
		Если Первый <> Неопределено Тогда
			СоединитьМеткиКаскада(Метки, Пара.Ключ, Первый);
		Иначе
			Единицы.Вставить(Узел.Единица, Пара.Ключ);
		КонецЕсли;
		Для Каждого СсылкаУзла Из Узел.Ссылки Цикл
			Если Снимок.Узлы.Получить(СсылкаУзла.Ключ) <> Неопределено Тогда
				СоединитьМеткиКаскада(Метки, Пара.Ключ, СсылкаУзла.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Единицы = Неопределено;
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Запись плана каскада", "", Всего);
	Группы = Новый Соответствие;
	План = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
	План.Отбор.Запуск.Установить(Контекст.Запуск);
	СеменаОчереди = ПодготовитьСеменаОчереди(Контекст, Порция);
	ОбъемПлана = 0;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Метка = КореньМеткиКаскада(Метки, Пара.Ключ);
		Группа = Группы.Получить(Метка);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Идентификатор,Всего", Строка(Новый УникальныйИдентификатор), 0);
			Группы.Вставить(Метка, Группа);
		КонецЕсли;
		Группа.Всего = Группа.Всего + 1;
		Узел = Пара.Значение;
		СтрокаПлана = План.Добавить();
		СтрокаПлана.Запуск = Контекст.Запуск;
		СтрокаПлана.Группа = Группа.Идентификатор;
		СтрокаПлана.Элемент = Строка(Новый УникальныйИдентификатор);
		СтрокаПлана.Задание = Порция.Задание;
		Если Контекст.Свойство("ОбщаяОчередь") Тогда
			СтрокаПлана.Граф = Порция.Задание;
			ДобавитьСемяГруппы(СеменаОчереди, Пара.Ключ, Группа.Идентификатор);
		КонецЕсли;
		СтрокаПлана.Метаданные = Узел.Таблица.Корень;
		СтрокаПлана.Вид = Узел.Таблица.Вид;
		СтрокаПлана.Локатор = Пара.Ключ;
		СтрокаПлана.ЕдиницаЗаписи = Узел.Единица;
		СтрокаПлана.КлючЕдиницы = ХешКлюча(Узел.Единица);
		ОбъемПлана = ОбъемПлана + 1024 + 2 * (СтрДлина(Пара.Ключ) + СтрДлина(Узел.Единица)
			+ СтрДлина(Узел.Таблица.Корень));
		СохранитьПакетСлужебныхЗаписей(План, ОбъемПлана);
	КонецЦикла;
	СохранитьПакетСлужебныхЗаписей(План, ОбъемПлана, Истина);
	План = Неопределено;
	Метки = Неопределено;
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	Идентификаторы = Новый Массив;
	РазмерыГрупп = Новый Соответствие;
	Для Каждого Пара Из Группы Цикл
		Идентификаторы.Добавить(Пара.Значение.Идентификатор);
		РазмерыГрупп.Вставить(Пара.Значение.Идентификатор, Пара.Значение.Всего);
	КонецЦикла;
	Группы = Неопределено;
	Если Всего > 0 Тогда
		Вхождение = 0;
		// У одной работы опубликована только одна порция; индекс относится лишь к ее каскадам.
		Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Запись индекса каскада", "", Всего);
		СохранитьПорциюИндекса(Снимок, Порция.Задание, Контекст.Граница, Вхождение);
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
	КонецЕсли;
	Возврат Новый Структура("Группы,Всего,Задание,СеменаГрупп,РазмерыГрупп", Идентификаторы, Всего,
		Порция.Задание, СеменаОчереди.Группы, РазмерыГрупп);

КонецФункции


#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Удаляет тяжелые временные данные только указанного запуска; итоги и ошибки сохраняются.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ОчиститьСлужебныеДанные(Запуск) Экспорт

	ОчиститьКешЗапуска(Запуск);
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ План.Задание ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОчиститьИндексКаскадов(Выборка.Задание);
	КонецЦикла;
	Для Каждого ИмяРегистра Из СтрРазделить(
		"Cutter3000_Узлы,Cutter3000_Связи,Cutter3000_План,Cutter3000_Пакеты,Cutter3000_Очередь,Cutter3000_Управление", ",") Цикл
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Удаляет индекс завершенной порции в транзакции работника; итоги работы сохраняются.
// Параметры:
//  Задание - Строка - идентификатор работы с единственной опубликованной порцией.
Процедура ОчиститьИндексКаскадов(Задание) Экспорт

	Если Cutter3000_ОчередьКаскадов.ЭтоПакет(Задание) Тогда
		// Пакет не владеет графом. Его очистит координатор после завершения всех потребителей.
		Возврат;
	КонецЕсли;

	Индексы = Новый Массив;
	Индексы.Добавить(Задание);
	Индекс = ОпубликованныйИндексЗадания(Задание);
	Если Индекс <> "" И Индекс <> Задание Тогда
		Индексы.Добавить(Индекс);
	КонецЕсли;
	Для Каждого КлючИндекса Из Индексы Цикл
		Для Каждого ИмяРегистра Из СтрРазделить("Cutter3000_Узлы,Cutter3000_Связи", ",") Цикл
			Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			Набор.Отбор.Запуск.Установить(КлючИндекса);
			Набор.Записать();
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Сохраняет отложенный граф на диске без удержания полного снимка в памяти.
// Параметры:
//  Контекст - Структура - контекст планировщика.
//  Порция - Структура - подготовленная порция с полным графом.
Процедура СохранитьОтложенныйГраф(Контекст, Порция) Экспорт

	Если Порция.Снимок.Индекс = "" Тогда
		// При переносе счетчики рассчитываются заново, а не прибавляются к памяти.
		Порция.Снимок.Всего = 0;
		Порция.Снимок.Стоимость = 0;
	КонецЕсли;
	ПеренестиГрафКаскада(Контекст, Порция.Снимок, Истина);

КонецПроцедуры

// Выделяет независимые компоненты порции, сохраняя исходный граф до успешной выдачи.
// Параметры:
//  Контекст - Структура - серверный контекст планирования.
//  Порция - Структура - порция с полным входящим графом и полосами работ.
// Возвращаемое значение:
//  Структура - Готовая, Ожидающая (порции или Неопределено), Разделено (Булево).
//   При Разделено исходный граф освобождает вызывающий после успешной выдачи готовой части.
Функция РазделитьПорциюКаскадов(Контекст, Порция) Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Разделение каскадов выполняется до транзакции публикации.";
	КонецЕсли;
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	СохранитьОтложенныйГраф(Контекст, Порция);
	ВременныеТаблицы = Неопределено;
	ГруппыПодготовлены = Порция.Снимок.Свойство("ТаблицыПубликации", ВременныеТаблицы);
	Если ГруппыПодготовлены Тогда
		Порция.Снимок.Удалить("ТаблицыПубликации");
	Иначе
		ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	Готовая = Неопределено;
	Ожидающая = Неопределено;
	СозданыЧасти = Ложь;
	Попытка
		Если ГруппыПодготовлены Тогда
			Запрос = ЗапросИндекса(Порция.Снимок.Индекс, ВременныеТаблицы);
			Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
		Иначе
			Запрос = ЗапросГруппГрафа(Контекст, Порция.Снимок.Индекс, ВременныеТаблицы);
		КонецЕсли;
		Занятые = РазметитьЗанятыеКомпоненты(Контекст, Порция, Запрос);
		Если Занятые.Узлов = 0 Тогда
			Порция.Пересечение = Ложь;
			Порция.ПересекающиесяЗадания = Новый Массив;
			Готовая = Порция;
		ИначеЕсли Занятые.Узлов = Порция.Всего Тогда
			Порция.Пересечение = Истина;
			Порция.ПересекающиесяЗадания = Занятые.Задания;
			Ожидающая = Порция;
		Иначе
			СозданыЧасти = Истина;
			Готовая = НоваяЧастьПорции(Контекст, Порция, Ложь, Новый Массив);
			Ожидающая = НоваяЧастьПорции(Контекст, Порция, Истина, Занятые.Задания);
			СкопироватьУзлыЧастей(Контекст, Порция, Запрос, Готовая, Ожидающая);
			СкопироватьСвязиЧастей(Контекст, Запрос, Готовая, Ожидающая);
			Если Готовая.Всего + Ожидающая.Всего <> Порция.Всего Тогда
				ВызватьИсключение "При разделении изменилось количество узлов каскада.";
			КонецЕсли;
			Если Готовая.Семена.Узлы.Количество() + Ожидающая.Семена.Узлы.Количество()
				<> Порция.Семена.Узлы.Количество() Тогда
				ВызватьИсключение "При разделении изменился состав корней каскада.";
			КонецЕсли;
		КонецЕсли;
		Запрос.Текст = "УНИЧТОЖИТЬ ВТ_АктивныеЗадания; УНИЧТОЖИТЬ ВТ_ЕдиницыРазделения;
			|УНИЧТОЖИТЬ ВТ_ЗанятыеКомпоненты; УНИЧТОЖИТЬ ВТ_ОжидающиеМетки; УНИЧТОЖИТЬ ВТ_РазделениеГрафа";
		Запрос.ВыполнитьПакет();
	Исключение
		ВременныеТаблицы.Закрыть();
		Если СозданыЧасти И Готовая <> Неопределено Тогда
			ОсвободитьГрафКаскада(Готовая);
		КонецЕсли;
		Если СозданыЧасти И Ожидающая <> Неопределено Тогда
			ОсвободитьГрафКаскада(Ожидающая);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Готовая <> Неопределено Тогда
		Готовая.Снимок.Вставить("ТаблицыПубликации", ВременныеТаблицы);
	Иначе
		Ожидающая.Снимок.Вставить("ТаблицыПубликации", ВременныеТаблицы);
	КонецЕсли;
	Разделено = Готовая <> Неопределено И Ожидающая <> Неопределено;
	Если Разделено Тогда
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Порция разделена: свободных узлов %1, ожидающих %2", Готовая.Всего, Ожидающая.Всего));
	КонецЕсли;
	Возврат Новый Структура("Готовая,Ожидающая,Разделено", Готовая, Ожидающая, Разделено);

КонецФункции

// Группирует большой граф до транзакции публикации; результат живёт только у координатора.
// Параметры:
//  Контекст - Структура - серверный контекст планирования.
//  Порция - Структура - проверенная порция; малый граф в памяти обрабатывается прежним путём.
Процедура ПодготовитьПубликациюКаскадов(Контекст, Порция) Экспорт

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Если Порция.Снимок.Индекс = "" Или Порция.Снимок.Свойство("ТаблицыПубликации") Тогда
		Возврат;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Подготовка групп каскада выполняется до транзакции публикации.";
	КонецЕсли;
	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	Попытка
		ЗапросГруппГрафа(Контекст, Порция.Снимок.Индекс, ВременныеТаблицы);
	Исключение
		ВременныеТаблицы.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Порция.Снимок.Вставить("ТаблицыПубликации", ВременныеТаблицы);

КонецПроцедуры

// Освобождает черновой индекс порции перед повторной подготовкой или после ошибки.
// После ошибки публикации вызывается только после отката внешней транзакции.
// Параметры:
//  Порция - Структура - порция планировщика; пустой снимок допускается.
Процедура ОсвободитьГрафКаскада(Порция) Экспорт

	Если Порция.Снимок <> Неопределено И Порция.Снимок.Свойство("ТаблицыПубликации") Тогда
		Если ТранзакцияАктивна() Тогда
			ВызватьИсключение "Перед освобождением графа завершите транзакцию публикации.";
		КонецЕсли;
		Порция.Снимок.ТаблицыПубликации.Закрыть();
		Порция.Снимок.Удалить("ТаблицыПубликации");
	КонецЕсли;
	Если Порция.Снимок <> Неопределено И Порция.Снимок.Свойство("Индекс")
		И Порция.Снимок.Индекс <> "" Тогда
		Если Не ИндексИспользуетсяЗаданием(Порция.Снимок.Индекс) Тогда
			ОчиститьИндексКаскадов(Порция.Снимок.Индекс);
		КонецЕсли;
		Порция.Снимок.Индекс = "";
	КонецЕсли;

КонецПроцедуры

// Выбирает режим транзакции без изменения основной конфигурации.
// Возвращаемое значение:
//  РежимУправленияБлокировкойДанных - режим, разрешенный настройкой конфигурации.
Функция РежимБлокировок() Экспорт

	Если Метаданные.РежимУправленияБлокировкойДанных =
		Метаданные.СвойстваОбъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.Управляемый Тогда
		Возврат РежимУправленияБлокировкойДанных.Управляемый;
	КонецЕсли;
	Возврат РежимУправленияБлокировкойДанных.Автоматический;

КонецФункции

// Кодирует значение ключа без хранения типизированной ссылки.
// Параметры:
//  ЗначениеКлюча - Произвольный - значение поля ключа.
// Возвращаемое значение:
//  Структура - описание типа и примитивные значения.
Функция КодироватьКлюч(ЗначениеКлюча) Экспорт

	ОписаниеСсылки = МетаданныеСсылки(ЗначениеКлюча);
	Если ОписаниеСсылки <> Неопределено Тогда

		Возврат Новый Структура("Вид,Метаданные,Значение", "Ссылка", ОписаниеСсылки.ПолноеИмя(),
			Строка(ЗначениеКлюча.УникальныйИдентификатор()));

	КонецЕсли;

	Возврат Новый Структура("Вид,Метаданные,Значение", "Значение", "",
		ЗначениеВСтрокуВнутр(ЗначениеКлюча));

КонецФункции

// Восстанавливает значение ключа в текущей информационной базе.
// Параметры:
//  ОписаниеКлюча - Структура - примитивное описание ключа.
// Возвращаемое значение:
//  Произвольный - восстановленное значение.
Функция ДекодироватьКлюч(ОписаниеКлюча) Экспорт

	Если ОписаниеКлюча.Вид = "Ссылка" Тогда

		Менеджер = МенеджерТаблицы(ОписаниеКлюча.Метаданные);
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ОписаниеКлюча.Значение));

	КонецЕсли;

	Возврат ЗначениеИзСтрокиВнутр(ОписаниеКлюча.Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьЭтапУдаления(Запуск, Задание, Этап, Обработано, Контроль)

	// Фиксированный этап перед долгой операцией нужен сразу. Сообщения чтения строк остаются редкими.
	Контроль.ПоследнееСообщение = Дата(1, 1, 1);
	Cutter3000_ЗаданияСервер.СообщитьПрогресс(Запуск, Задание, Этап, Обработано, Контроль);

КонецПроцедуры

Процедура ПроверитьСохранностьЗаписей(Исходный, Остаток, Кандидаты)

	Единицы = Новый Соответствие;
	Для Каждого Пара Из Кандидаты Цикл
		Узел = Исходный.Узлы.Получить(Пара.Ключ);
		Если Узел.Таблица.Вид <> "Объект" И Узел.Таблица.Вид <> "ГраницаПоследовательности" Тогда
			Единицы.Вставить(Узел.Единица, Истина);
		КонецЕсли;
	КонецЦикла;
	Ожидаемые = СоставРегистров(Исходный, Единицы, Кандидаты);
	Фактические = СоставРегистров(Остаток, Единицы, Новый Соответствие);
	Если Ожидаемые.Количество() <> Фактические.Количество() Тогда
		ВызватьИсключение "Обработчики изменили состав сохраняемых записей регистра. Группа отменена.";
	КонецЕсли;
	Для Каждого Пара Из Ожидаемые Цикл
		Если Фактические.Получить(Пара.Ключ) <> Пара.Значение Тогда
			ВызватьИсключение "Удаляемые записи восстановлены или сохраняемые строки изменены. Группа отменена.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СоставРегистров(Снимок, Единицы, Исключения)

	Состав = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Если Единицы.Получить(Узел.Единица) = Неопределено Или Исключения.Получить(Пара.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поля = Новый Структура;
		Для Каждого Поле Из Узел.Поля Цикл
			// Замещение набора может перенумеровать строки; данные остальных полей должны совпасть.
			Если Поле.Ключ <> "НомерСтроки" Тогда
				Поля.Вставить(Поле.Ключ, Поле.Значение);
			КонецЕсли;
		КонецЦикла;
		Ключ = Узел.Единица + "|" + ЗначениеВСтрокуВнутр(Поля);
		Количество = Состав.Получить(Ключ);
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		Состав.Вставить(Ключ, Количество + 1);
	КонецЦикла;
	Возврат Состав;

КонецФункции

Функция КаталогТаблиц()

	Каталог = Новый Массив;
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.Документы);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.Справочники);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.ПланыВидовХарактеристик);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.ПланыСчетов);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.ПланыВидовРасчета);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.ПланыОбмена);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.БизнесПроцессы);
	ДобавитьОбъектныеТаблицы(Каталог, Метаданные.Задачи);
	ДобавитьРегистры(Каталог, Метаданные.РегистрыСведений, "Сведения");
	ДобавитьРегистры(Каталог, Метаданные.РегистрыНакопления, "Накопление");
	ДобавитьРегистры(Каталог, Метаданные.РегистрыБухгалтерии, "Бухгалтерия");
	ДобавитьРегистры(Каталог, Метаданные.РегистрыРасчета, "Расчет");
	ДобавитьЗависимыеТаблицы(Каталог);
	Возврат Каталог;

КонецФункции

Процедура ДобавитьЗависимыеТаблицы(Каталог)

	Для Каждого Описание Из Метаданные.Последовательности Цикл

		ПроверитьПраво("Чтение", Описание);
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Описание", Описание.ПолноеИмя(),
			Описание.ПолноеИмя(), "Последовательность", Описание));
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Описание", Описание.ПолноеИмя() + ".Границы",
			Описание.ПолноеИмя(), "ГраницаПоследовательности", Описание));

	КонецЦикла;
	Для Каждого ОписаниеРегистра Из Метаданные.РегистрыРасчета Цикл
		Для Каждого Описание Из ОписаниеРегистра.Перерасчеты Цикл

			Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Описание,Права", 
				ОписаниеРегистра.ПолноеИмя() + "." + Описание.Имя, Описание.ПолноеИмя(),
				"Перерасчет", Описание, ОписаниеРегистра));

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОбъектныеТаблицы(Каталог, КоллекцияМетаданных)

	Для Каждого Описание Из КоллекцияМетаданных Цикл

		ПроверитьПраво("Чтение", Описание);
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Описание",
			Описание.ПолноеИмя(), Описание.ПолноеИмя(), "Объект", Описание));
		Для Каждого Часть Из Описание.ТабличныеЧасти Цикл

			ИмяТаблицы = СтрШаблон("%1.%2", Описание.ПолноеИмя(), Часть.Имя);
			Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Описание",
				ИмяТаблицы, Описание.ПолноеИмя(), "ТабличнаяЧасть", Описание));

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРегистры(Каталог, КоллекцияМетаданных, Вид)

	Для Каждого Описание Из КоллекцияМетаданных Цикл

		Если СлужебныйРегистр(Описание) Тогда
			Продолжить;
		КонецЕсли;

		ПроверитьПраво("Чтение", Описание);
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Описание",
			Описание.ПолноеИмя(), Описание.ПолноеИмя(), Вид, Описание));

	КонецЦикла;

КонецПроцедуры

Функция СлужебныйРегистр(Описание)

	СвойОбъект = Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_Задания.ПолноеИмя()
		Или Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_План.ПолноеИмя()
		Или Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_Узлы.ПолноеИмя()
		Или Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_Связи.ПолноеИмя()
		Или Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_Ошибки.ПолноеИмя()
		Или Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_Очередь.ПолноеИмя()
		Или Описание.ПолноеИмя() = Метаданные.РегистрыСведений.Cutter3000_Управление.ПолноеИмя();
	Если Не СвойОбъект Тогда
		Возврат Ложь;
	КонецЕсли;

	ВладелецРасширения = Метаданные.Обработки.Cutter3000_ОбрезкаБазы.РасширениеКонфигурации();
	РасширениеРегистра = Описание.РасширениеКонфигурации();
	Возврат РасширениеРегистра <> Неопределено И ВладелецРасширения <> Неопределено
		И РасширениеРегистра.Имя = ВладелецРасширения.Имя;

КонецФункции

Процедура ПроверитьОбласть()

	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл

		Если ОбщийРеквизит.РазделениеДанных <>
			Метаданные.СвойстваОбъектов.РазделениеДанныхОбщегоРеквизита.НеИспользовать Тогда

			ВызватьИсключение СтрШаблон(
				"Полный охват областей разделения не подтвержден: %1. Прикладные данные не изменены.",
				ОбщийРеквизит.Имя);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьЧтение(Прогресс, ИмяТаблицы)

	Если Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Прогресс.Прочитано = Прогресс.Прочитано + 1;
	СтрокМеждуСообщениями = 1000;
	Если Прогресс.Прочитано % СтрокМеждуСообщениями = 0 Тогда
		СообщитьПодготовку(Прогресс, "Чтение " + ИмяТаблицы);
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьПодготовку(Прогресс, Этап)

	Если Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПредыдущийЭтап = "";
	Прогресс.Контроль.Свойство("ЭтапЧтения", ПредыдущийЭтап);
	Если ПредыдущийЭтап <> Этап Тогда
		Прогресс.Контроль.Вставить("ЭтапЧтения", Этап);
		Прогресс.Контроль.ПоследнееСообщение = Дата(1, 1, 1);
	КонецЕсли;
	Cutter3000_ЗаданияСервер.СообщитьПрогресс(Прогресс.Запуск, "Запуск",
		СтрШаблон("%1; прочитано строк: %2", Этап, Прогресс.Прочитано), 0, Прогресс.Контроль);

КонецПроцедуры

Функция ПсевдонимТаблицы(Таблица)

	// Имя реквизита может совпасть с псевдонимом (например, «Данные») и сделать запрос неоднозначным.
	Имена = Новый Соответствие;
	Если ЗависимаяТаблица(Таблица.Вид) Тогда
		ДобавитьИменаПолей(Имена, Таблица.Описание.Измерения);
		Возврат СвободныйПсевдоним(Имена);
	КонецЕсли;
	ДобавитьИменаПолей(Имена, Таблица.Описание.Реквизиты);
	Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
		Для Каждого Часть Из Таблица.Описание.ТабличныеЧасти Цикл
			Имена.Вставить(НРег(Часть.Имя), Истина);
			ДобавитьИменаПолей(Имена, Часть.Реквизиты);
		КонецЦикла;
	Иначе
		ДобавитьИменаПолей(Имена, Таблица.Описание.Измерения);
		ДобавитьИменаПолей(Имена, Таблица.Описание.Ресурсы);
	КонецЕсли;
	Возврат СвободныйПсевдоним(Имена);

КонецФункции

Функция СвободныйПсевдоним(Имена)

	Псевдоним = "ИсточникОбрезки";
	Пока Имена.Получить(НРег(Псевдоним)) <> Неопределено Цикл
		Псевдоним = Псевдоним + "1";
	КонецЦикла;
	Возврат Псевдоним;

КонецФункции

Функция ЗависимаяТаблица(Вид)

	Возврат Вид = "ГраницаПоследовательности" Или Вид = "Последовательность" Или Вид = "Перерасчет";

КонецФункции

Процедура ДобавитьИменаПолей(Имена, Коллекция)

	Для Каждого Поле Из Коллекция Цикл
		Имена.Вставить(НРег(Поле.Имя), Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуСнимка(Снимок, Таблица, СтрокаДанных, Колонки)

	Если Таблица.Вид = "ТабличнаяЧасть" Тогда

		Ключ = КлючСсылки(СтрокаДанных.Ссылка);
		Узел = Снимок.Узлы.Получить(Ключ);
		Если Узел = Неопределено Тогда
			ВызватьИсключение "Табличная часть имеет отсутствующего владельца.";
		КонецЕсли;

	Иначе

		Локатор = ЛокаторСтроки(Таблица, СтрокаДанных);
		Ключ = ЗначениеВСтрокуВнутр(Локатор);
		Если Таблица.Вид = "Объект" Тогда
			Ключ = КлючСсылки(СтрокаДанных.Ссылка);
		КонецЕсли;

		Узел = Новый Структура("Ключ,Таблица,Локатор,Единица,Поля,Ссылки,Ресурс", Ключ, Таблица,
			Локатор, ЕдиницаЗаписи(Таблица, Локатор), Новый Структура, Новый Соответствие,
			РесурсРегистра(Таблица));
		Снимок.Узлы.Вставить(Ключ, Узел);
		Если Таблица.Вид = "Объект" Тогда
			Снимок.Ссылки.Вставить(Ключ, СтрокаДанных.Ссылка);
			Снимок.КлючиСсылок.Вставить(СтрокаДанных.Ссылка, Ключ);
		КонецЕсли;

	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл

		ЗначениеПоля = СтрокаДанных[Колонка.Имя];
		// Выборка возвращает табличные части вложенными результатами запроса.
		Если ТипЗнч(ЗначениеПоля) = Тип("РезультатЗапроса") Тогда
			ЗначениеПоля = ЗначениеПоля.Выгрузить();
		КонецЕсли;
		Если Таблица.Вид <> "ТабличнаяЧасть"
			И (Снимок.ПолныеПоля Или Колонка.Имя = Таблица.ПолеПериода) Тогда
			Узел.Поля.Вставить(Колонка.Имя, ЗначениеПоля);
		КонецЕсли;
		Если Колонка.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;

		ОбойтиЗначение(Снимок, Узел, ЗначениеПоля, Новый Массив);

	КонецЦикла;

КонецПроцедуры

Функция ЛокаторСтроки(Таблица, СтрокаДанных)

	Ключи = Новый Структура;
	Если ЗависимаяТаблица(Таблица.Вид) Тогда

		Возврат ЛокаторЗависимойСтроки(Таблица, СтрокаДанных);

	ИначеЕсли Таблица.Вид = "Объект" Тогда

		Ключи.Вставить("Ссылка", КодироватьКлюч(СтрокаДанных.Ссылка));

	ИначеЕсли ПодчиненныйРегистр(Таблица) Тогда

		Ключи.Вставить("Регистратор", КодироватьКлюч(СтрокаДанных.Регистратор));
		Ключи.Вставить("НомерСтроки", КодироватьКлюч(СтрокаДанных.НомерСтроки));

	Иначе

		Если Таблица.Описание.ПериодичностьРегистраСведений <>
			Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Ключи.Вставить("Период", КодироватьКлюч(СтрокаДанных.Период));
		КонецЕсли;

		Для Каждого Измерение Из Таблица.Описание.Измерения Цикл
			Ключи.Вставить(Измерение.Имя, КодироватьКлюч(СтрокаДанных[Измерение.Имя]));
		КонецЦикла;

	КонецЕсли;

	Возврат Новый Структура("Метаданные,Вид,Ключи", Таблица.Корень, Таблица.Вид, Ключи);

КонецФункции

Функция ЛокаторЗависимойСтроки(Таблица, СтрокаДанных)

	Ключи = Новый Структура;
	Если Таблица.Вид = "Последовательность" Тогда
		Ключи.Вставить("Регистратор", КодироватьКлюч(СтрокаДанных.Регистратор));
		Ключи.Вставить("Период", КодироватьКлюч(СтрокаДанных.Период));
	ИначеЕсли Таблица.Вид = "Перерасчет" Тогда
		Ключи.Вставить("ОбъектПерерасчета", КодироватьКлюч(СтрокаДанных.ОбъектПерерасчета));
		Ключи.Вставить("ВидРасчета", КодироватьКлюч(СтрокаДанных.ВидРасчета));
	КонецЕсли;
	Для Каждого Измерение Из Таблица.Описание.Измерения Цикл
		Ключи.Вставить(Измерение.Имя, КодироватьКлюч(СтрокаДанных[Измерение.Имя]));
	КонецЦикла;
	Возврат Новый Структура("Метаданные,Вид,Ключи", Таблица.Корень, Таблица.Вид, Ключи);

КонецФункции

Функция ПодчиненныйРегистр(Таблица)

	Если Таблица.Вид <> "Сведения" Тогда
		Возврат Таблица.Вид <> "Объект";
	КонецЕсли;

	Возврат Таблица.Описание.РежимЗаписи =
		Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;

КонецФункции

Функция ЕдиницаЗаписи(Таблица, Локатор)

	Если Таблица.Вид = "ГраницаПоследовательности" Тогда
		Возврат "Граница|" + ЗначениеВСтрокуВнутр(Локатор);
	КонецЕсли;
	Если Таблица.Вид = "Перерасчет" Тогда
		Возврат Таблица.Корень + "|" + ЗначениеВСтрокуВнутр(Локатор.Ключи.ОбъектПерерасчета);
	КонецЕсли;
	Если Таблица.Вид <> "Объект" И ПодчиненныйРегистр(Таблица) Тогда

		Возврат СтрШаблон("%1|%2", Таблица.Корень, ЗначениеВСтрокуВнутр(Локатор.Ключи.Регистратор));

	КонецЕсли;

	Возврат ЗначениеВСтрокуВнутр(Локатор);

КонецФункции

Функция РесурсРегистра(Таблица)

	Если Таблица.Вид = "Перерасчет" Тогда
		Возврат Таблица.Права.ПолноеИмя();
	КонецЕсли;
	// Перерасчет использует родительский ресурс; неделимость определяется единицей записи.
	Возврат Таблица.Корень;

КонецФункции

Функция МетаданныеСсылки(ЗначениеПоля)

	Описание = Метаданные.НайтиПоТипу(ТипЗнч(ЗначениеПоля));
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЧастиИмени = СтрРазделить(Описание.ПолноеИмя(), ".");
	Если ЧастиИмени.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СсылочныеВиды = СтрРазделить("БизнесПроцесс,Документ,Задача,ПланВидовРасчета,"
		+ "ПланВидовХарактеристик,ПланОбмена,ПланСчетов,Справочник", ",");
	Если СсылочныеВиды.Найти(ЧастиИмени[0]) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// НайтиПоТипу также находит ключи записей и объекты; UUID есть только у типа ссылки.
	ИмяТипаСсылки = ЧастиИмени[0] + "Ссылка." + ЧастиИмени[1];
	Если ТипЗнч(ЗначениеПоля) <> Тип(ИмяТипаСсылки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Описание;

КонецФункции

Функция КлючСсылки(СсылкаОбъекта)

	Возврат ЗначениеВСтрокуВнутр(КодироватьКлюч(СсылкаОбъекта));

КонецФункции

Функция КлассификацияТипа(Снимок, ЗначениеПоля)

	ТипПоля = ТипЗнч(ЗначениеПоля);
	Классификация = Снимок.ТипыЗначений.Получить(ТипПоля);
	Если Классификация = Неопределено Тогда

		ОписаниеСсылки = МетаданныеСсылки(ЗначениеПоля);
		Примитивный = Ложь;
		Если ОписаниеСсылки = Неопределено Тогда
			Примитивный = ПримитивноеЗначение(ЗначениеПоля);
		КонецЕсли;
		Примитивный = Примитивный Или ИсключенныйТипЗначения(ТипПоля);
		// Кешируется вид типа, а исключенные значения остаются атомарными без чтения содержимого.
		Классификация = Новый Структура("Ссылка,Примитивный", ОписаниеСсылки, Примитивный);
		Снимок.ТипыЗначений.Вставить(ТипПоля, Классификация);

	КонецЕсли;
	Возврат Классификация;

КонецФункции

Процедура ОбойтиЗначение(Снимок, Узел, ЗначениеПоля, Посещенные)

	Классификация = КлассификацияТипа(Снимок, ЗначениеПоля);
	Если Классификация.Примитивный Тогда
		Возврат;
	КонецЕсли;
	ОписаниеСсылки = Классификация.Ссылка;
	Если ОписаниеСсылки <> Неопределено Тогда

		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			Ключ = Снимок.КлючиСсылок.Получить(ЗначениеПоля);
			Если Ключ = Неопределено Тогда
				Ключ = КлючСсылки(ЗначениеПоля);
				Снимок.КлючиСсылок.Вставить(ЗначениеПоля, Ключ);
			КонецЕсли;
			Узел.Ссылки.Вставить(Ключ, ЗначениеПоля);
			Входящие = Снимок.Входящие.Получить(Ключ);
			Если Входящие = Неопределено Тогда
				Входящие = Новый Соответствие;
				Снимок.Входящие.Вставить(Ключ, Входящие);
			КонецЕсли;
			Входящие.Вставить(Узел.Ключ, Истина);
		КонецЕсли;
		Возврат;

	КонецЕсли;

	ТипПоля = ТипЗнч(ЗначениеПоля);
	Если ТипПоля = Тип("МоментВремени") Тогда
		ОбойтиЗначение(Снимок, Узел, ЗначениеПоля.Ссылка, Посещенные);
		Возврат;
	КонецЕсли;

	Если Посещенные.Найти(ЗначениеПоля) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Посещенные.Добавить(ЗначениеПоля);
	ОбойтиКонтейнер(Снимок, Узел, ЗначениеПоля, Посещенные);

КонецПроцедуры

Процедура ОбойтиКонтейнер(Снимок, Узел, ЗначениеПоля, Посещенные)

	ТипПоля = ТипЗнч(ЗначениеПоля);
	Если ТипПоля = Тип("ТаблицаЗначений") Тогда
		ОбойтиСтрокиКонтейнера(Снимок, Узел, ЗначениеПоля, Посещенные);
		Возврат;
	КонецЕсли;
	Если ТипПоля = Тип("ДеревоЗначений") Тогда
		ОбойтиСтрокиДерева(Снимок, Узел, ЗначениеПоля.Строки,
			Новый Структура("Колонки,Посещенные", ЗначениеПоля.Колонки, Посещенные));
		Возврат;
	КонецЕсли;
	Если ТипПоля = Тип("Массив") Или ТипПоля = Тип("ФиксированныйМассив") Тогда

		Для Каждого Вложение Из ЗначениеПоля Цикл
			ОбойтиЗначение(Снимок, Узел, Вложение, Посещенные);
		КонецЦикла;

	ИначеЕсли КонтейнерПар(ТипПоля) Тогда

		Для Каждого Пара Из ЗначениеПоля Цикл
			ОбойтиЗначение(Снимок, Узел, Пара.Ключ, Посещенные);
			ОбойтиЗначение(Снимок, Узел, Пара.Значение, Посещенные);
		КонецЦикла;

	ИначеЕсли ТипПоля = Тип("СписокЗначений") Тогда

		Для Каждого Позиция Из ЗначениеПоля Цикл
			ОбойтиЗначение(Снимок, Узел, Позиция.Значение, Посещенные);
		КонецЦикла;

	Иначе

		Если ТипПоля = Тип("ОбъектXDTO") Или ТипПоля = Тип("ЗначениеXDTO") Тогда
			Данные = ЗначениеПоля;
		Иначе
			// Платформа описывает состав значения, включая вложенные прикладные ссылки.
			Данные = СериализаторXDTO.ЗаписатьXDTO(ЗначениеПоля);
		КонецЕсли;
		ОбойтиДанныеXDTO(Снимок, Узел, Данные, Новый Массив);

	КонецЕсли;

КонецПроцедуры



Процедура ОбойтиДанныеXDTO(Снимок, Узел, Данные, Посещенные)

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("ОбъектXDTO") И ТипЗнч(Данные) <> Тип("ЗначениеXDTO") Тогда
		ОбойтиЗначение(Снимок, Узел, Данные, Новый Массив);
		Возврат;
	КонецЕсли;
	ТипДанных = Данные.Тип();
	Если СтрНайти(ТипДанных.URIПространстваИмен, "data-composition-system") > 0
		Или ТипДанных.Имя = "ValueStorage" Или ТипДанных.Имя = "SpreadsheetDocument" Тогда
		Возврат;
	КонецЕсли;
	Если ТипДанных.URIПространстваИмен = "http://v8.1c.ru/8.1/data/enterprise/current-config" Тогда
		ЗначениеПриложения = СериализаторXDTO.ПрочитатьXDTO(Данные);
		Если МетаданныеСсылки(ЗначениеПриложения) <> Неопределено Тогда
			ОбойтиЗначение(Снимок, Узел, ЗначениеПриложения, Новый Массив);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("ЗначениеXDTO") Тогда
		// Простой тип XDTO атомарен: строка, число, перечисление, QName, двоичное значение.
		// Типизированные прикладные ссылки обработаны до этой проверки.
		Возврат;
	КонецЕсли;
	// Скаляры не образуют циклов; поиск среди них делал обход больших значений квадратичным.
	Если Посещенные.Найти(Данные) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Посещенные.Добавить(Данные);
	Для Каждого Свойство Из Данные.Свойства() Цикл
		Если Не Данные.Установлено(Свойство) Тогда
			Продолжить;
		КонецЕсли;
		Если Свойство.ВерхняяГраница = 1 Тогда
			ОбойтиДанныеXDTO(Снимок, Узел, Данные.ПолучитьXDTO(Свойство), Посещенные);
		Иначе
			Элементы = Данные.ПолучитьСписок(Свойство);
			// Прямой перебор списка возвращает нативные скаляры и теряет их XDTO-обертку.
			Для Индекс = 0 По Элементы.Количество() - 1 Цикл
				ОбойтиДанныеXDTO(Снимок, Узел, Элементы.ПолучитьXDTO(Индекс), Посещенные);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбойтиСтрокиКонтейнера(Снимок, Узел, Таблица, Посещенные)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ОбойтиЗначение(Снимок, Узел, СтрокаТаблицы[Колонка.Имя], Посещенные);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОбойтиСтрокиДерева(Снимок, Узел, Строки, Контекст)

	Для Каждого СтрокаДерева Из Строки Цикл
		Для Каждого Колонка Из Контекст.Колонки Цикл
			ОбойтиЗначение(Снимок, Узел, СтрокаДерева[Колонка.Имя], Контекст.Посещенные);
		КонецЦикла;
		ОбойтиСтрокиДерева(Снимок, Узел, СтрокаДерева.Строки, Контекст);
	КонецЦикла;

КонецПроцедуры

Функция ПримитивноеЗначение(ЗначениеПоля)

	ТипПоля = ТипЗнч(ЗначениеПоля);
	// Типы описывают допустимые значения и не содержат экземпляров прикладных ссылок.
	Если ТипПоля = Тип("Тип") Или ТипПоля = Тип("ОписаниеТипов") Тогда
		Возврат Истина;
	КонецЕсли;
	Описание = Метаданные.НайтиПоТипу(ТипПоля);
	Если Описание <> Неопределено Тогда
		Возврат СтрНачинаетсяС(Описание.ПолноеИмя(), "Перечисление.");
	КонецЕсли;
	Возврат ТипПоля = Тип("Строка") Или ТипПоля = Тип("Число") Или ТипПоля = Тип("Дата")
		Или ТипПоля = Тип("Булево") Или ТипПоля = Тип("Неопределено") Или ТипПоля = Тип("Null")
		Или ТипПоля = Тип("УникальныйИдентификатор") Или ТипПоля = Тип("ВидДвиженияНакопления")
		Или ТипПоля = Тип("ВидСчета") Или ТипПоля = Тип("ВидДвиженияБухгалтерии");

КонецФункции

Функция КонтейнерПар(ТипПоля)

	Возврат ТипПоля = Тип("Структура") Или ТипПоля = Тип("ФиксированнаяСтруктура")
		Или ТипПоля = Тип("Соответствие") Или ТипПоля = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ПолеПериода(Таблица)

	Если Таблица.Вид = "Объект" И СтрНачинаетсяС(Таблица.Корень, "Документ.") Тогда
		Возврат "Дата";
	КонецЕсли;
	Если Таблица.Вид = "Расчет" Тогда
		Возврат "ПериодРегистрации";
	КонецЕсли;
	Если Таблица.Вид = "Накопление" Или Таблица.Вид = "Бухгалтерия" Тогда
		Возврат "Период";
	КонецЕсли;
	Если Таблица.Вид = "Сведения" И Таблица.Описание.ПериодичностьРегистраСведений <>
		Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Возврат "Период";
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ПроверитьУдаляемость(Снимок, Кандидаты, Трассировка = Неопределено)

	ИмяТаблицы = "";
	Замер = Неопределено;
	Проверено = 0;
	Для Каждого Пара Из Кандидаты Цикл

		Узел = Снимок.Узлы.Получить(Пара.Ключ);
		Если ИмяТаблицы <> Узел.Таблица.Имя Тогда
			Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Проверено);
			ИмяТаблицы = Узел.Таблица.Имя;
			Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Проверка удаляемости таблицы", ИмяТаблицы);
			Проверено = 0;
		КонецЕсли;
		Если Узел.Таблица.Вид = "Константа" Тогда
			ВызватьИсключение СтрШаблон("Каскад затрагивает неудаляемую константу %1.", Узел.Таблица.Имя);
		КонецЕсли;

		Если Узел.Таблица.Вид = "Объект" Тогда

			ПроверитьПраво("Удаление", Узел.Таблица.Описание);
			Объект = Снимок.Ссылки.Получить(Пара.Ключ).ПолучитьОбъект();
			Если ЗащищенныйОбъект(Объект, Узел.Таблица.Корень) Тогда
				ВызватьИсключение СтрШаблон("Каскад затрагивает защищенный объект %1.", Пара.Ключ);
			КонецЕсли;

		Иначе

			ПроверитьПраво("Изменение", МетаданныеПрав(Узел.Таблица));

		КонецЕсли;

		Проверено = Проверено + 1;
	КонецЦикла;
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Проверено);

КонецПроцедуры

Функция МетаданныеПрав(Таблица)

	Если Таблица.Свойство("Права") Тогда
		Возврат Таблица.Права;
	КонецЕсли;
	Возврат Таблица.Описание;

КонецФункции

Функция ЗащищенныйОбъект(Объект, ИмяТаблицы)

	Если СтрНачинаетсяС(ИмяТаблицы, "Справочник.") Или СтрНачинаетсяС(ИмяТаблицы, "План") Тогда

		Если СтрНачинаетсяС(ИмяТаблицы, "ПланОбмена.") Тогда
			Возврат Объект.Ссылка = МенеджерТаблицы(ИмяТаблицы).ЭтотУзел();
		КонецЕсли;
		Возврат Объект.Предопределенный;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьПраво(Право, Описание)

	Если Не ПравоДоступа(Право, Описание) Тогда
		ВызватьИсключение СтрШаблон("Нет права %1 для %2.", Право, Описание.ПолноеИмя());
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПлатформенныйПоиск(Снимок, Кандидаты, Найденные, Контекст = Неопределено)

	Для Каждого Найденная Из Найденные Цикл
		// Общий поиск охватывает весь снимок; эта проверка относится к удаляемым объектам.
		Если Кандидаты.Получить(КлючСсылки(Найденная[0])) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПокрытаЗависимостьРегистратора(Снимок, Кандидаты, Найденная) Тогда
			Продолжить;
		КонецЕсли;

		Владельцы = Снимок.Входящие.Получить(КлючСсылки(Найденная[0]));
		Если Владельцы = Неопределено Тогда
			ОтметитьУстаревшийПлан(Контекст);
			ВызватьИсключение "Платформенный поиск обнаружил зависимость вне каталога данных.";
		КонецЕсли;

		Если МетаданныеСсылки(Найденная[1]) <> Неопределено Тогда

			Если Кандидаты.Получить(КлючСсылки(Найденная[1])) = Неопределено Тогда
				ОтметитьУстаревшийПлан(Контекст);
				ВызватьИсключение "Платформенный поиск обнаружил объект вне каскада.";
			КонецЕсли;

		Иначе

			ПроверитьНеобъектнуюЗависимость(Снимок, Владельцы, Найденная[2]);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНеобъектнуюЗависимость(Снимок, Владельцы, Описание)

	Для Каждого Владелец Из Владельцы Цикл

		Узел = Снимок.Узлы.Получить(Владелец.Ключ);
		Если Узел.Таблица.Описание.ПолноеИмя() = Описание.ПолноеИмя() Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение СтрШаблон("Неизвестный адаптер необъектной зависимости: %1.", Описание.ПолноеИмя());

КонецПроцедуры

Функция ИмяРаботы(Элементы)

	Первый = Элементы[0];
	ТипыОбъектов = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Вид = "Объект" Тогда
			ТипыОбъектов.Вставить(Элемент.Метаданные, Истина);
		КонецЕсли;
	КонецЦикла;
	Если ТипыОбъектов.Количество() > 1 Тогда
		Представления = Новый Массив;
		Для Каждого ТипОбъекта Из ТипыОбъектов Цикл
			Описание = Метаданные.НайтиПоПолномуИмени(ТипОбъекта.Ключ);
			Представления.Добавить(Описание.Синоним);
		КонецЦикла;
		Возврат Лев("Обрезка связанной группы: " + СтрСоединить(Представления, ", "), 250);
	КонецЕсли;
	Описание = Метаданные.НайтиПоПолномуИмени(Первый.Метаданные);
	Представление = Описание.Синоним;
	Если ПустаяСтрока(Представление) Тогда
		Представление = Описание.Имя;
	КонецЕсли;

	Если СтрНачинаетсяС(Первый.Метаданные, "Документ.") Тогда
		Возврат СтрШаблон("Обрезка документа %1 и связанных ссылок", Представление);
	КонецЕсли;
	Возврат СтрШаблон("Обрезка %1 и связанных данных", Представление);

КонецФункции

Функция МенеджерТаблицы(ИмяТаблицы)

	Части = СтрРазделить(ИмяТаблицы, ".");
	Вид = Части[0];
	Имя = Части[1];
	Если Вид = "Документ" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Вид = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Имя];
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[Имя];
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возврат РегистрыСведений[Имя];
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Возврат РегистрыНакопления[Имя];
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат РегистрыБухгалтерии[Имя];
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Если Части.Количество() > 2 Тогда
			Возврат РегистрыРасчета[Имя].Перерасчеты[Части[3]];
		КонецЕсли;
		Возврат РегистрыРасчета[Имя];
	ИначеЕсли Вид = "Последовательность" Тогда
		Возврат Последовательности[Имя];
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный адаптер таблицы %1.", ИмяТаблицы);
	КонецЕсли;

КонецФункции

Функция ЛокаторЭлемента(ЭлементПлана)

	Локатор = ЗначениеИзСтрокиВнутр(ЭлементПлана.Локатор);
	Если ЭлементПлана.Вид = "Объект" Тогда
		Локатор = Новый Структура("Метаданные,Вид,Ключи", ЭлементПлана.Метаданные,
			"Объект", Новый Структура("Ссылка", Локатор));
	КонецЕсли;
	Возврат Локатор;

КонецФункции

Процедура ЗаблокироватьГруппу(Состав)

	Ресурсы = Состав.Скопировать();
	Ресурсы.Сортировать("Метаданные, ЕдиницаЗаписи");
	Если РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		ЗаблокироватьГруппуАвтоматически(Ресурсы);
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Посещенные = Новый Соответствие;
	Для Каждого ЭлементПлана Из Ресурсы Цикл

		Если Посещенные.Получить(ЭлементПлана.ЕдиницаЗаписи) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Посещенные.Вставить(ЭлементПлана.ЕдиницаЗаписи, Истина);
		Локатор = ЛокаторЭлемента(ЭлементПлана);
		Подчиненный = Локатор.Ключи.Свойство("Регистратор");
		Пространство = Локатор.Метаданные;
		Если Локатор.Вид = "Перерасчет" Тогда
			Части = СтрРазделить(Локатор.Метаданные, ".");
			Пространство = СтрШаблон("Перерасчет.%1.НаборЗаписей", Части[3]);
		ИначеЕсли Подчиненный Тогда
			Пространство = Пространство + ".НаборЗаписей";
		КонецЕсли;
		Ресурс = Блокировка.Добавить(Пространство);
		Ресурс.Режим = РежимБлокировкиДанных.Исключительный;
		Для Каждого ПолеКлюча Из Локатор.Ключи Цикл

			РазрешенноеПоле = ПолеКлюча.Ключ <> "НомерСтроки";
			Если Локатор.Вид = "Последовательность" Тогда
				РазрешенноеПоле = ПолеКлюча.Ключ = "Регистратор";
			ИначеЕсли Локатор.Вид = "Перерасчет" Тогда
				РазрешенноеПоле = ПолеКлюча.Ключ = "ОбъектПерерасчета";
			КонецЕсли;
			Если РазрешенноеПоле Тогда
				Ресурс.УстановитьЗначение(ПолеКлюча.Ключ, ДекодироватьКлюч(ПолеКлюча.Значение));
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаблокироватьГруппуАвтоматически(Ресурсы)

	Запрос = Новый Запрос;
	Пакет = Новый Массив;
	Посещенные = Новый Соответствие;
	Для Каждого ЭлементПлана Из Ресурсы Цикл

		Если Посещенные.Получить(ЭлементПлана.ЕдиницаЗаписи) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Посещенные.Вставить(ЭлементПлана.ЕдиницаЗаписи, Истина);
		Локатор = ЛокаторЭлемента(ЭлементПлана);
		Условия = Новый Массив;
		Для Каждого ПолеКлюча Из Локатор.Ключи Цикл

			Если ПолеКлюча.Ключ = "НомерСтроки" Тогда
				Продолжить;
			КонецЕсли;
			ИмяПараметра = СтрШаблон("Ключ%1_%2", Формат(Пакет.Количество(), "ЧГ=0"), ПолеКлюча.Ключ);
			Запрос.УстановитьПараметр(ИмяПараметра, ДекодироватьКлюч(ПолеКлюча.Значение));
			Условия.Добавить(СтрШаблон("Блокируемые.%1 = &%2", ПолеКлюча.Ключ, ИмяПараметра));

		КонецЦикла;
		Условие = "ИСТИНА";
		Если Условия.Количество() > 0 Тогда
			Условие = СтрСоединить(Условия, " И ");
		КонецЕсли;
		Пакет.Добавить(СтрШаблон("ВЫБРАТЬ Блокируемые.* ИЗ %1 КАК Блокируемые ГДЕ %2 ДЛЯ ИЗМЕНЕНИЯ",
			ИмяТаблицыЛокатора(Локатор), Условие));

	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		Запрос.Текст = СтрСоединить(Пакет, ";" + Символы.ПС);
		Запрос.ВыполнитьПакет();
	КонецЕсли;

КонецПроцедуры

Функция ИмяТаблицыЛокатора(Локатор)

	Если Локатор.Вид = "Перерасчет" Тогда
		Возврат СтрЗаменить(Локатор.Метаданные, ".Перерасчет.", ".");
	ИначеЕсли Локатор.Вид = "ГраницаПоследовательности" Тогда
		Возврат Локатор.Метаданные + ".Границы";
	КонецЕсли;
	Возврат Локатор.Метаданные;

КонецФункции

Функция КандидатыСохраненногоПлана(Состав, Снимок, Контекст = Неопределено)

	Кандидаты = Новый Соответствие;
	Для Каждого ЭлементПлана Из Состав Цикл

		Если Снимок.Узлы.Получить(ЭлементПлана.Локатор) = Неопределено Тогда
			ОтметитьУстаревшийПлан(Контекст);
			ВызватьИсключение "Данные изменились после построения плана. Группа отменена.";
		КонецЕсли;
		Кандидаты.Вставить(ЭлементПлана.Локатор, Истина);

	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

Процедура ПроверитьВходящиеГраницы(Снимок, Кандидаты)

	Для Каждого Пара Из Кандидаты Цикл

		Входящие = Снимок.Входящие.Получить(Пара.Ключ);
		Если Входящие = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Владелец Из Входящие Цикл

			Если Кандидаты.Получить(Владелец.Ключ) = Неопределено Тогда
				ВызватьИсключение "После планирования появилась новая входящая ссылка. Группа отменена.";
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;
КонецПроцедуры

Процедура УдалитьЗаписиРегистров(Состав, Снимок, Запуск, Задание, Контроль)

	Единицы = Новый Соответствие;
	Для Каждого ЭлементПлана Из Состав Цикл

		Если ЭлементПлана.Вид = "Объект" Тогда
			Продолжить;
		КонецЕсли;
		Локатор = ЛокаторЭлемента(ЭлементПлана);
		Единица = ЭлементПлана.ЕдиницаЗаписи;
		Если Локатор.Вид = "Сведения" И Не Локатор.Ключи.Свойство("Регистратор") Тогда
			Единица = Локатор.Метаданные;
		КонецЕсли;
		ГруппаЗаписей = Единицы.Получить(Единица);
		Если ГруппаЗаписей = Неопределено Тогда
			ГруппаЗаписей = Новый Массив;
			Единицы.Вставить(Единица, ГруппаЗаписей);
		КонецЕсли;
		ГруппаЗаписей.Добавить(Локатор);

	КонецЦикла;
	Обработано = 0;
	Для Каждого Пара Из Единицы Цикл

		Первый = Пара.Значение[0];
		ЗамерНабора = Cutter3000_ЗаданияСервер.НачатьЗамер(Контроль,
			"Удаление набора регистра", Первый.Метаданные, Пара.Значение.Количество());
		// Подчиненный набор замещается целиком: расширенное удаление перенумеровывает его ключи.
		ПакетноеУдаление = Первый.Вид = "Сведения" И Не Первый.Ключи.Свойство("Регистратор");
		Если ПакетноеУдаление Тогда
			Прогресс = Новый Структура("Запуск,Задание,Контроль,Обработано", Запуск, Задание, Контроль, Обработано);
			УдалитьПакетРегистра(Пара.Значение, Снимок, Прогресс);
		Иначе
			УдалитьЕдиницуРегистра(Пара.Значение);
		КонецЕсли;
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерНабора);
		Обработано = Обработано + Пара.Значение.Количество();
		Cutter3000_ЗаданияСервер.СообщитьПрогресс(Запуск, Задание, "Удаление записей", Обработано, Контроль);

	КонецЦикла;

КонецПроцедуры

Процедура УдалитьПакетРегистра(Локаторы, Снимок, Прогресс)

	Первый = Локаторы[0];
	Набор = МенеджерТаблицы(Первый.Метаданные).СоздатьНаборЗаписей();
	СовместимоеУдаление = Прогресс.Контроль.КонтекстПроверки.СовместимоеУдалениеРегистров.Получить(
		Первый.Метаданные) <> Неопределено;
	Для Каждого Локатор Из Локаторы Цикл
		Узел = Снимок.Узлы.Получить(ЗначениеВСтрокуВнутр(Локатор));
		Если Узел = Неопределено Тогда
			ВызватьИсключение "Удаляемая запись регистра отсутствует в проверенном снимке.";
		КонецЕсли;
		Если СовместимоеУдаление Тогда
			// Менеджер удаляет только полный ключ и передает обработчикам обычное булево замещение.
			Единица = Новый Массив;
			Единица.Добавить(Локатор);
			УдалитьЕдиницуРегистра(Единица);
			Прогресс.Обработано = Прогресс.Обработано + 1;
			Cutter3000_ЗаданияСервер.СообщитьПрогресс(Прогресс.Запуск, Прогресс.Задание, "Удаление записей",
				Прогресс.Обработано, Прогресс.Контроль);
			Продолжить;
		КонецЕсли;
		// Обработчики получают исходные поля, а не только ключи с пустыми ресурсами.
		Запись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Узел.Поля);
		Для Каждого Поле Из Локатор.Ключи Цикл
			Запись[Поле.Ключ] = ДекодироватьКлюч(Поле.Значение);
		КонецЦикла;
		Если Набор.Количество() = РазмерПорции() Тогда
			ЗаписатьУдалениеРегистра(Набор, Прогресс);
		КонецЕсли;
	КонецЦикла;
	Если Набор.Количество() > 0 Тогда
		ЗаписатьУдалениеРегистра(Набор, Прогресс);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьУдалениеРегистра(Набор, Прогресс)

	Количество = Набор.Количество();
	Попытка
		Набор.Записать(РежимЗамещения.Удаление);
	Исключение
		ИмяРегистра = Набор.Метаданные().ПолноеИмя();
		Если БулевоЗамещениеВОбработчике(ИнформацияОбОшибке(), ИмяРегистра) Тогда
			// Здесь транзакция еще не откатана: только запоминаем причину для внешнего повтора.
			Контекст = Прогресс.Контроль.КонтекстПроверки;
			Контекст.СовместимоеУдалениеРегистров.Вставить(ИмяРегистра, Истина);
			Контекст.ПовторУдаленияРегистра = ИмяРегистра;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Набор.Очистить();
	Прогресс.Обработано = Прогресс.Обработано + Количество;
	Cutter3000_ЗаданияСервер.СообщитьПрогресс(Прогресс.Запуск, Прогресс.Задание, "Удаление записей",
		Прогресс.Обработано, Прогресс.Контроль);

КонецПроцедуры

Функция БулевоЗамещениеВОбработчике(Ошибка, ИмяРегистра)

	Пока Ошибка.Причина <> Неопределено Цикл
		Ошибка = Ошибка.Причина;
	КонецЦикла;
	// Не принимаем ошибку преобразования другого поля за несовместимость параметра обработчика.
	СтрокаПричины = НРег(Ошибка.ИсходнаяСтрока);
	Возврат (Ошибка.ИмяМодуля = ИмяРегистра + ".МодульНабораЗаписей"
		Или Ошибка.ИмяМодуля = ИмяРегистра + ".RecordSetModule")
		И (СтрНайти(СтрокаПричины, "замещ") > 0 Или СтрНайти(СтрокаПричины, "replac") > 0)
		И (Ошибка.Описание = "Преобразование значения к типу Булево не может быть выполнено"
			Или Ошибка.Описание = "Conversion of the value to type Boolean cannot be performed");

КонецФункции

Процедура УдалитьЕдиницуРегистра(Локаторы)

	Первый = Локаторы[0];
	Менеджер = МенеджерТаблицы(Первый.Метаданные);
	Если ЗависимаяТаблица(Первый.Вид) Тогда

		УдалитьЗависимыеЗаписи(Менеджер, Локаторы);

	ИначеЕсли Первый.Ключи.Свойство("Регистратор") Тогда

		Набор = Менеджер.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДекодироватьКлюч(Первый.Ключи.Регистратор));
		Набор.Прочитать();
		УдаляемыеНомера = Новый Соответствие;
		Для Каждого Локатор Из Локаторы Цикл
			УдаляемыеНомера.Вставить(ДекодироватьКлюч(Локатор.Ключи.НомерСтроки), Истина);
		КонецЦикла;
		Индекс = Набор.Количество() - 1;
		Пока Индекс >= 0 Цикл

			Если УдаляемыеНомера.Получить(Набор[Индекс].НомерСтроки) <> Неопределено Тогда
				Набор.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;

		КонецЦикла;
		Набор.Записать(Истина);

	Иначе

		Запись = Менеджер.СоздатьМенеджерЗаписи();
		Для Каждого ПолеКлюча Из Первый.Ключи Цикл
			Запись[ПолеКлюча.Ключ] = ДекодироватьКлюч(ПолеКлюча.Значение);
		КонецЦикла;
		Запись.Прочитать();
		Запись.Удалить();

	КонецЕсли;

КонецПроцедуры

Процедура УдалитьЗависимыеЗаписи(Менеджер, Локаторы)

	Первый = Локаторы[0];
	Если Первый.Вид = "ГраницаПоследовательности" Тогда

		Отбор = Новый Структура;
		Для Каждого Поле Из Первый.Ключи Цикл
			Отбор.Вставить(Поле.Ключ, ДекодироватьКлюч(Поле.Значение));
		КонецЦикла;
		// Дата без ссылки сбрасывает недействительную границу, сохраняя ее разрез.
		Менеджер.УстановитьГраницу(Дата(1, 1, 1), Отбор);
		Возврат;

	КонецЕсли;
	Набор = Менеджер.СоздатьНаборЗаписей();
	Если Первый.Вид = "Перерасчет" Тогда
		Набор.Отбор.ОбъектПерерасчета.Установить(ДекодироватьКлюч(Первый.Ключи.ОбъектПерерасчета));
	Иначе
		Набор.Отбор.Регистратор.Установить(ДекодироватьКлюч(Первый.Ключи.Регистратор));
	КонецЕсли;
	Набор.Прочитать();
	Удаляемые = Новый Соответствие;
	Для Каждого Локатор Из Локаторы Цикл
		Удаляемые.Вставить(ЗначениеВСтрокуВнутр(Локатор.Ключи), Истина);
	КонецЦикла;
	Индекс = Набор.Количество() - 1;
	Пока Индекс >= 0 Цикл

		Ключи = Новый Структура;
		Для Каждого Поле Из Первый.Ключи Цикл
			Ключи.Вставить(Поле.Ключ, КодироватьКлюч(Набор[Индекс][Поле.Ключ]));
		КонецЦикла;
		Если Удаляемые.Получить(ЗначениеВСтрокуВнутр(Ключи)) <> Неопределено Тогда
			Набор.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;

	КонецЦикла;
	Набор.Записать(Истина);

КонецПроцедуры

Процедура УдалитьСсылочныеОбъекты(Снимок, Кандидаты, Запуск, Задание, Контроль)

	Остались = Новый Соответствие;
	Для Каждого Пара Из Кандидаты Цикл

		Если Снимок.Ссылки.Получить(Пара.Ключ) <> Неопределено Тогда
			Остались.Вставить(Пара.Ключ, Истина);
		КонецЕсли;

	КонецЦикла;
	Обработано = Кандидаты.Количество() - Остались.Количество();
	СообщитьЭтапУдаления(Запуск, Задание, "Удаление объектов", Обработано, Контроль);
	Порядок = Неопределено;
	Если Остались.Количество() > 64 Тогда
		Порядок = ПорядокУдаленияОбъектов(Снимок, Остались);
	КонецЕсли;
	НомерОбъекта = 0;
	Пока Остались.Количество() > 0 Цикл

		Если Порядок = Неопределено Тогда
			Выбранный = ОчереднойОбъект(Снимок, Остались);
		Иначе
			Выбранный = Порядок[НомерОбъекта];
		КонецЕсли;
		НомерОбъекта = НомерОбъекта + 1;
		СсылкаОбъекта = Снимок.Ссылки.Получить(Выбранный);
		Объект = СсылкаОбъекта.ПолучитьОбъект();
		Объект.Удалить();
		Остались.Удалить(Выбранный);
		Обработано = Обработано + 1;
		Cutter3000_ЗаданияСервер.СообщитьПрогресс(Запуск, Задание, "Удаление объектов", Обработано, Контроль);

	КонецЦикла;

КонецПроцедуры

// Номера сохраняют порядок обхода Остались. Куча выбирает первый доступный номер,
// а при цикле - первый оставшийся, точно как последовательный перебор ОчереднойОбъект.
// Индекс строится только для текущей транзакционной порции, без общего графа запуска.
Функция ПорядокУдаленияОбъектов(Снимок, Остались)

	Ключи = Новый Массив;
	Номера = Новый Соответствие;
	Владельцы = Новый Массив;
	Зависимые = Новый Массив;
	Для Каждого Пара Из Остались Цикл
		Номера.Вставить(Пара.Ключ, Ключи.Количество());
		Ключи.Добавить(Пара.Ключ);
		Владельцы.Добавить(0);
		Зависимые.Добавить(Новый Массив);
	КонецЦикла;
	Готовые = Новый Массив;
	Для Номер = 0 По Ключи.Количество() - 1 Цикл
		Входящие = Снимок.Входящие.Получить(Ключи[Номер]);
		Если Входящие <> Неопределено Тогда
			Для Каждого Владелец Из Входящие Цикл
				НомерВладельца = Номера.Получить(Владелец.Ключ);
				Если НомерВладельца <> Неопределено И НомерВладельца <> Номер Тогда
					Владельцы[Номер] = Владельцы[Номер] + 1;
					Зависимые[НомерВладельца].Добавить(Номер);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Владельцы[Номер] = 0 Тогда
			ДобавитьНомерОчереди(Готовые, Номер);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Массив;
	ПервыйОставшийся = 0;
	Пока Результат.Количество() < Ключи.Количество() Цикл
		Если Готовые.Количество() > 0 Тогда
			Номер = ИзвлечьНомерОчереди(Готовые);
		Иначе
			Пока Владельцы[ПервыйОставшийся] = -1 Цикл
				ПервыйОставшийся = ПервыйОставшийся + 1;
			КонецЦикла;
			Номер = ПервыйОставшийся;
		КонецЕсли;
		Результат.Добавить(Ключи[Номер]);
		Владельцы[Номер] = -1;
		Для Каждого Зависимый Из Зависимые[Номер] Цикл
			Если Владельцы[Зависимый] > 0 Тогда
				Владельцы[Зависимый] = Владельцы[Зависимый] - 1;
				Если Владельцы[Зависимый] = 0 Тогда
					ДобавитьНомерОчереди(Готовые, Зависимый);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьНомерОчереди(Очередь, Номер)

	Позиция = Очередь.Количество();
	Очередь.Добавить(Номер);
	Пока Позиция > 0 Цикл
		Родитель = Цел((Позиция - 1) / 2);
		Если Очередь[Родитель] <= Номер Тогда
			Прервать;
		КонецЕсли;
		Очередь[Позиция] = Очередь[Родитель];
		Позиция = Родитель;
	КонецЦикла;
	Очередь[Позиция] = Номер;

КонецПроцедуры

Функция ИзвлечьНомерОчереди(Очередь)

	Результат = Очередь[0];
	Последний = Очередь[Очередь.Количество() - 1];
	Очередь.Удалить(Очередь.Количество() - 1);
	Позиция = 0;
	Пока Позиция * 2 + 1 < Очередь.Количество() Цикл
		Потомок = Позиция * 2 + 1;
		Если Потомок + 1 < Очередь.Количество() И Очередь[Потомок + 1] < Очередь[Потомок] Тогда
			Потомок = Потомок + 1;
		КонецЕсли;
		Если Очередь[Потомок] >= Последний Тогда
			Прервать;
		КонецЕсли;
		Очередь[Позиция] = Очередь[Потомок];
		Позиция = Потомок;
	КонецЦикла;
	Если Очередь.Количество() > 0 Тогда
		Очередь[Позиция] = Последний;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОчереднойОбъект(Снимок, Остались)

	Первый = Неопределено;
	Для Каждого Пара Из Остались Цикл

		Если Первый = Неопределено Тогда
			Первый = Пара.Ключ;
		КонецЕсли;
		Входящие = Снимок.Входящие.Получить(Пара.Ключ);
		ЕстьВладелец = Ложь;
		Если Входящие <> Неопределено Тогда

			Для Каждого Владелец Из Входящие Цикл
				Если Владелец.Ключ <> Пара.Ключ И Остались.Получить(Владелец.Ключ) <> Неопределено Тогда
					ЕстьВладелец = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;
		Если Не ЕстьВладелец Тогда
			Возврат Пара.Ключ;
		КонецЕсли;

	КонецЦикла;

	// Цикл остается в одной транзакции; итоговый снимок проверяется перед ее фиксацией.
	Возврат Первый;

КонецФункции

Функция ПределОбъемаСтраницыЧтения()

	// Оценочный бюджет представления строки; не является лимитом памяти кластера.
	Возврат 4 * 1024 * 1024;

КонецФункции

Функция РазмерСтраницыРаботника(Чтение)

	РазмерСтраницы = 0;
	Если Чтение.Свойство("РазмерСтраницыРаботника", РазмерСтраницы) Тогда
		Возврат РазмерСтраницы;
	КонецЕсли;
	СлужебныйОбъемСтроки = 512;
	ОбъемСтроки = СлужебныйОбъемСтроки;
	ОценкиПолей = Новый Соответствие;
	Для Каждого Поле Из СтрРазделить(Чтение.Поля, ",") Цикл
		ИмяПоля = Сред(СокрЛП(Поле), СтрДлина(Чтение.Псевдоним) + 2);
		Типы = Чтение.Колонки.Найти(ИмяПоля).ТипЗначения;
		ОценкаПоля = ОценкаОбъемаПоляЧтения(Типы);
		ОценкиПолей.Вставить(ИмяПоля, ОценкаПоля);
		ОбъемСтроки = ОбъемСтроки + ОценкаПоля;
	КонецЦикла;
	РазмерСтраницы = Мин(РазмерПорции(), Макс(1, Цел(ПределОбъемаСтраницыЧтения() / ОбъемСтроки)));
	Чтение.Вставить("ОценкиОбъемаПолейРаботника", ОценкиПолей);
	Чтение.Вставить("РазмерСтраницыРаботника", РазмерСтраницы);
	Возврат РазмерСтраницы;

КонецФункции

Функция ОценкаОбъемаПоляЧтения(Типы)

	Объем = 64;
	Если ПолеМожетСодержатьСсылку(Типы) Тогда
		Объем = 1024;
	КонецЕсли;
	Если Типы.СодержитТип(Тип("Строка")) Тогда
		Длина = Типы.КвалификаторыСтроки.Длина;
		Если Длина = 0 Тогда
			Длина = 2048;
		КонецЕсли;
		Объем = Макс(Объем, Длина * 2 + 64);
	КонецЕсли;
	Возврат Объем;

КонецФункции

Функция ОценкаОбъемаСтроки(Выборка, ОценкиПолей)

	Объем = 512;
	Для Каждого Поле Из ОценкиПолей Цикл
		ЗначениеПоля = Выборка[Поле.Ключ];
		Если ТипЗнч(ЗначениеПоля) = Тип("Строка") Тогда
			Объем = Объем + СтрДлина(ЗначениеПоля) * 2 + 64;
		Иначе
			Объем = Объем + Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Объем;

КонецФункции

Функция РазмерПорции()

	Возврат 2000;

КонецФункции

Функция НовыйСнимок(Каталог, ПолныеПоля = Ложь)

	Возврат Новый Структура("Узлы,Входящие,Ссылки,Каталог,ПолныеПоля,ТипыЗначений,КлючиСсылок",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Каталог, ПолныеПоля,
		Новый Соответствие, Новый Соответствие);

КонецФункции

Функция ХешКлюча(Ключ)

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Ключ);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма);

КонецФункции

Функция ПоляКлючаТаблицы(Таблица)

	Если Таблица.Вид = "Объект" Тогда
		Возврат СтрРазделить("Ссылка", ",");
	ИначеЕсли Таблица.Вид = "ТабличнаяЧасть" Тогда
		Возврат СтрРазделить("Ссылка,НомерСтроки", ",");
	КонецЕсли;
	Поля = Новый Массив;
	Если Таблица.Вид = "Последовательность" Тогда
		Поля.Добавить("Регистратор");
		Поля.Добавить("Период");
	ИначеЕсли Таблица.Вид = "Перерасчет" Тогда
		Поля.Добавить("ОбъектПерерасчета");
		Поля.Добавить("ВидРасчета");
	ИначеЕсли Таблица.Вид <> "ГраницаПоследовательности" Тогда
		Если ПодчиненныйРегистр(Таблица) Тогда
			Возврат СтрРазделить("Регистратор,НомерСтроки", ",");
		КонецЕсли;
		Если Таблица.Описание.ПериодичностьРегистраСведений <>
			Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Поля.Добавить("Период");
		КонецЕсли;
	КонецЕсли;
	Для Каждого Измерение Из Таблица.Описание.Измерения Цикл
		Поля.Добавить(Измерение.Имя);
	КонецЦикла;
	Возврат Поля;

КонецФункции

Функция ОписаниеЧтения(Таблица, ТолькоСсылки = Ложь, Колонки = Неопределено)

	Таблица.Вставить("ПолеПериода", ПолеПериода(Таблица));
	Псевдоним = ПсевдонимТаблицы(Таблица);
	Если Колонки = Неопределено Тогда
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 0 %1.* ИЗ %2 КАК %1", Псевдоним, Таблица.Имя));
		Колонки = Запрос.Выполнить().Колонки;
	КонецЕсли;
	Поля = Новый Массив;
	Ключи = ПоляКлючаТаблицы(Таблица);
	Для Каждого Колонка Из Колонки Цикл
		Если Таблица.Вид = "Объект" И Таблица.Описание.ТабличныеЧасти.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеИсключеноИзЧтения(Колонка.ТипЗначения) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ТолькоСсылки Или Ключи.Найти(Колонка.Имя) <> Неопределено
			Или Колонка.Имя = Таблица.ПолеПериода
			Или ПолеМожетСодержатьСсылку(Колонка.ТипЗначения) Тогда
			Поля.Добавить(Псевдоним + "." + Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Псевдоним,Поля,Ключи,Колонки", Псевдоним,
		СтрСоединить(Поля, ", "), Ключи, Колонки);

КонецФункции

Функция ИсключенныйТипЗначения(ТипЗначения)

	Если ТипЗначения = Тип("ХранилищеЗначения") Или ТипЗначения = Тип("ТабличныйДокумент") Тогда
		Возврат Истина;
	КонецЕсли;
	// Имя прикладного объекта может содержать слова «компоновки данных»; его ссылка сохраняется.
	Если Метаданные.НайтиПоТипу(ТипЗначения) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяТипа = НРег(СтрЗаменить(Строка(ТипЗначения), " ", ""));
	Возврат СтрНайти(ИмяТипа, "компоновкиданных") > 0 Или СтрНайти(ИмяТипа, "datacomposition") > 0;

КонецФункции

Функция ПолеИсключеноИзЧтения(Типы)

	ЕстьИсключенныйТип = Ложь;
	Для Каждого ТипПоля Из Типы.Типы() Цикл
		Если ИсключенныйТипЗначения(ТипПоля) Тогда
			ЕстьИсключенныйТип = Истина;
		ИначеЕсли ТипПоля <> Тип("Неопределено") И ТипПоля <> Тип("Null") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьИсключенныйТип;

КонецФункции

Функция ПолеМожетСодержатьСсылку(Типы)

	Для Каждого ТипПоля Из Типы.Типы() Цикл
		Если ТипПоля = Тип("МоментВремени") Тогда
			Возврат Истина;
		КонецЕсли;
		Описание = Метаданные.НайтиПоТипу(ТипПоля);
		Если Описание <> Неопределено И Не СтрНачинаетсяС(Описание.ПолноеИмя(), "Перечисление.") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПрочитатьПорцию(Таблица, Чтение, ПоследнийКлюч, Условие = "ИСТИНА", Параметры = Неопределено,
	КонтекстТрассировки = Неопределено)

	Запрос = Новый Запрос;
	Если Параметры <> Неопределено Тогда
		Для Каждого Пара Из Параметры Цикл
			Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
		КонецЦикла;
	КонецЕсли;
	Порядок = Новый Массив;
	Равенства = Новый Массив;
	Продолжения = Новый Массив;
	Для Каждого ИмяПоля Из Чтение.Ключи Цикл
		Поле = Чтение.Псевдоним + "." + ИмяПоля;
		Порядок.Добавить(Поле);
		Если ПоследнийКлюч = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеКлюча = ПоследнийКлюч[ИмяПоля];
		Если ЗначениеКлюча = Null Тогда
			Больше = Поле + " ЕСТЬ НЕ NULL";
			Равно = Поле + " ЕСТЬ NULL";
		Иначе
			Запрос.УстановитьПараметр("После" + ИмяПоля, ЗначениеКлюча);
			Больше = Поле + " > &После" + ИмяПоля;
			Равно = Поле + " = &После" + ИмяПоля;
		КонецЕсли;
		Если Равенства.Количество() > 0 Тогда
			Больше = СтрСоединить(Равенства, " И ") + " И " + Больше;
		КонецЕсли;
		Продолжения.Добавить("(" + Больше + ")");
		Равенства.Добавить(Равно);
	КонецЦикла;
	// Условие передано из работы по ссылке: продолжение страницы не должно менять исходный отбор.
	УсловиеСтраницы = Условие;
	Если Продолжения.Количество() > 0 Тогда
		УсловиеСтраницы = "(" + Условие + ") И (" + СтрСоединить(Продолжения, " ИЛИ ") + ")";
	КонецЕсли;
	РазмерСтраницы = Неопределено;
	Если Не Чтение.Свойство("РазмерСтраницы", РазмерСтраницы) Тогда
		РазмерСтраницы = РазмерПорции();
	КонецЕсли;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1 %2 ИЗ %3 КАК %4 ГДЕ %5",
		Формат(РазмерСтраницы, "ЧГ=0"), Чтение.Поля, Таблица.Имя, Чтение.Псевдоним, УсловиеСтраницы);
	Если Порядок.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО " + СтрСоединить(Порядок, ", ");
	КонецЕсли;
	ЗамерЗапроса = Cutter3000_ЗаданияСервер.НачатьЗамер(КонтекстТрассировки, "Запрос страницы данных", Таблица.Имя, РазмерСтраницы, Запрос.Текст);
	Результат = Запрос.Выполнить();
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерЗапроса);
	Возврат Результат;

КонецФункции

Функция КлючПродолжения(Выборка, ПоляКлюча)

	Ключ = Новый Структура;
	Для Каждого ИмяПоля Из ПоляКлюча Цикл
		Ключ.Вставить(ИмяПоля, Выборка[ИмяПоля]);
	КонецЦикла;
	Возврат Ключ;

КонецФункции

Процедура ДобавитьСтрокуПорции(Снимок, Таблица, Выборка, Колонки)

	Если Таблица.Вид = "ТабличнаяЧасть" Тогда
		Ключ = КлючСсылки(Выборка.Ссылка);
		Если Снимок.Узлы.Получить(Ключ) = Неопределено Тогда
			Узел = Новый Структура("Ключ,Таблица,Локатор,Единица,Поля,Ссылки,Ресурс", Ключ, Таблица,
				Новый Структура, Ключ, Новый Структура, Новый Соответствие, "");
			Снимок.Узлы.Вставить(Ключ, Узел);
		КонецЕсли;
		// Проверяется существование владельца даже у пустой по ссылочным реквизитам строки ТЧ.
		Снимок.Узлы.Получить(Ключ).Ссылки.Вставить(Ключ, Истина);
		Если Снимок.Входящие.Получить(Ключ) = Неопределено Тогда
			Снимок.Входящие.Вставить(Ключ, Новый Соответствие);
		КонецЕсли;
	КонецЕсли;
	ДобавитьСтрокуСнимка(Снимок, Таблица, Выборка, Колонки);

КонецПроцедуры

Процедура ПостроитьИндексПорциями(Граница, Запуск, Прогресс)

	ПроверитьОбласть();
	Каталог = КаталогТаблиц();
	Вхождение = 0;
	Для Каждого Таблица Из Каталог Цикл
		Чтение = ОписаниеЧтения(Таблица);
		ПоследнийКлюч = Неопределено;
		Пока Истина Цикл
			// Цикл страниц необходим: весь результат и граф таблицы никогда не загружаются в BSL.
			Результат = ПрочитатьПорцию(Таблица, Чтение, ПоследнийКлюч);
			Выборка = Результат.Выбрать();
			Снимок = НовыйСнимок(Каталог);
			Прочитано = 0;
			Пока Выборка.Следующий() Цикл
				ДобавитьСтрокуПорции(Снимок, Таблица, Выборка, Результат.Колонки);
				ПоследнийКлюч = КлючПродолжения(Выборка, Чтение.Ключи);
				ОтметитьЧтение(Прогресс, Таблица.Имя);
				Прочитано = Прочитано + 1;
			КонецЦикла;
			СохранитьПорциюИндекса(Снимок, Запуск, Граница, Вхождение);
			Если Прочитано < РазмерПорции() Или Чтение.Ключи.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Описание Из Метаданные.Константы Цикл
		Снимок = НовыйСнимок(Каталог);
		ДобавитьОднуКонстанту(Снимок, Описание);
		СохранитьПорциюИндекса(Снимок, Запуск, Граница, Вхождение);
	КонецЦикла;
	ПроверитьИндексСсылок(Запуск);

КонецПроцедуры

Процедура ДобавитьОднуКонстанту(Снимок, Описание)

	Если ПолеИсключеноИзЧтения(Описание.Тип) Тогда
		Возврат;
	КонецЕсли;
	ПроверитьПраво("Чтение", Описание);
	Ключ = Описание.ПолноеИмя();
	Таблица = Новый Структура("Имя,Корень,Вид,Описание", Ключ, Ключ, "Константа", Описание);
	Узел = Новый Структура("Ключ,Таблица,Локатор,Единица,Поля,Ссылки,Ресурс", Ключ, Таблица,
		Новый Структура, Ключ, Новый Структура, Новый Соответствие, "");
	Снимок.Узлы.Вставить(Ключ, Узел);
	ОбойтиЗначение(Снимок, Узел, Константы[Описание.Имя].Получить(), Новый Массив);

КонецПроцедуры

Процедура СохранитьПорциюИндекса(Снимок, Запуск, Граница, Вхождение)

	Узлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
	Узлы.Отбор.Запуск.Установить(Запуск);
	Связи = РегистрыСведений.Cutter3000_Связи.СоздатьНаборЗаписей();
	Связи.Отбор.Запуск.Установить(Запуск);
	ОбъемУзлов = 0;
	ОбъемСвязей = 0;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Ключ = ХешКлюча(Пара.Ключ);
		Если Узел.Таблица.Вид <> "ТабличнаяЧасть" Тогда
			Запись = Узлы.Добавить();
			Запись.Запуск = Запуск;
			Запись.Узел = Ключ;
			Запись.Локатор = Пара.Ключ;
			Запись.Таблица = Узел.Таблица.Имя;
			Запись.Метаданные = Узел.Таблица.Корень;
			Запись.Вид = Узел.Таблица.Вид;
			Запись.ЕдиницаЗаписи = Узел.Единица;
			Запись.КлючЕдиницы = ХешКлюча(Узел.Единица);
			Запись.Ресурс = Узел.Ресурс;
			Поле = ПолеПериода(Узел.Таблица);
			Запись.Первичный = Поле <> "" И Узел.Поля[Поле] < Граница;
			ОбъемУзлов = ОбъемУзлов + 1024 + 2 * (СтрДлина(Пара.Ключ) + СтрДлина(Узел.Единица)
				+ СтрДлина(Узел.Таблица.Имя) + СтрДлина(Узел.Таблица.Корень) + СтрДлина(Узел.Ресурс));
			СохранитьПакетСлужебныхЗаписей(Узлы, ОбъемУзлов);
		КонецЕсли;
		Для Каждого СсылкаУзла Из Узел.Ссылки Цикл
			Запись = Связи.Добавить();
			Запись.Запуск = Запуск;
			Запись.Цель = ХешКлюча(СсылкаУзла.Ключ);
			Запись.УзелИсточник = Ключ;
			Вхождение = Вхождение + 1;
			Запись.Вхождение = Вхождение;
			Запись.ЛокаторЦели = СсылкаУзла.Ключ;
			ОбъемСвязей = ОбъемСвязей + 1024 + 2 * СтрДлина(СсылкаУзла.Ключ);
			СохранитьПакетСлужебныхЗаписей(Связи, ОбъемСвязей);
		КонецЦикла;
	КонецЦикла;
	СохранитьПакетСлужебныхЗаписей(Узлы, ОбъемУзлов, Истина);
	СохранитьПакетСлужебныхЗаписей(Связи, ОбъемСвязей, Истина);

КонецПроцедуры

Процедура СохранитьПакетСлужебныхЗаписей(Набор, Объем, Завершение = Ложь)

	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Оценка включает строки UTF-16 и запас на поля записи; одна строка неделима.
	ПределОбъема = 2 * 1024 * 1024;
	Если Не Завершение И Набор.Количество() < РазмерПорции() И Объем < ПределОбъема Тогда
		Возврат;
	КонецЕсли;
	// Это добавление внутри прежней внешней транзакции, без промежуточной фиксации.
	// Повтор ключа по-прежнему вызывает ошибку и откат всей публикации.
	Набор.Записать(Ложь);
	Набор.Очистить();
	Объем = 0;

КонецПроцедуры

Процедура ПроверитьИндексСсылок(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Связи.ЛокаторЦели КАК Локатор
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ПО Связи.Запуск = Узлы.Запуск И Связи.Цель = Узлы.Узел
		|ГДЕ Связи.Запуск = &Запуск И Узлы.Узел ЕСТЬ NULL");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Исходная битая ссылка или отсутствующий владелец: " + Выборка.Локатор;
	КонецЕсли;
	// Сопоставляется полный ключ: одинаковый SHA256 не считается доказательством равенства.
	Последний = 0;
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Последний", Последний);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2000 Связи.Вхождение, Связи.Цель, Связи.ЛокаторЦели КАК Локатор
			|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
			|ГДЕ Связи.Запуск = &Запуск И Связи.Вхождение > &Последний УПОРЯДОЧИТЬ ПО Связи.Вхождение";
		Порция = Запрос.Выполнить().Выгрузить();
		КлючиЦелей = Новый Соответствие;
		Для Каждого Выборка Из Порция Цикл
			КлючиЦелей.Вставить(Выборка.Цель, Истина);
		КонецЦикла;
		Цели = Новый Массив;
		Для Каждого Пара Из КлючиЦелей Цикл
			Цели.Добавить(Пара.Ключ);
		КонецЦикла;
		Запрос.УстановитьПараметр("Цели", Цели);
		Запрос.Текст = "ВЫБРАТЬ Узел, Локатор ИЗ РегистрСведений.Cutter3000_Узлы
			|ГДЕ Запуск = &Запуск И Узел В (&Цели)";
		Существующие = Запрос.Выполнить().Выбрать();
		Пока Существующие.Следующий() Цикл
			КлючиЦелей.Вставить(Существующие.Узел, Существующие.Локатор);
		КонецЦикла;
		Прочитано = 0;
		Для Каждого Выборка Из Порция Цикл
			Последний = Выборка.Вхождение;
			Прочитано = Прочитано + 1;
			Если Выборка.Локатор <> КлючиЦелей.Получить(Выборка.Цель) Тогда
				ВызватьИсключение "Коллизия ключей индекса. Прикладные данные не изменены.";
			КонецЕсли;
		КонецЦикла;
		Если Прочитано < РазмерПорции() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


Функция ЗапросИндекса(Запуск, ВременныеТаблицы)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Возврат Запрос;

КонецФункции

Процедура ЗамкнутьКандидатов(Запрос, Прогресс)

	Запрос.Текст =
		"ВЫБРАТЬ Узлы.Узел, Узлы.КлючЕдиницы, Узлы.Ресурс, Узлы.Первичный
		|ПОМЕСТИТЬ Узлы ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Запуск ИНДЕКСИРОВАТЬ ПО Узел;
		|ВЫБРАТЬ Узлы.Узел ПОМЕСТИТЬ Кандидаты ИЗ Узлы КАК Узлы
		|ГДЕ Узлы.Первичный ИНДЕКСИРОВАТЬ ПО Узел";
	Запрос.ВыполнитьПакет();
	Пока Истина Цикл
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Связи.УзелИсточник КАК Узел ПОМЕСТИТЬ Новые
			|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Цели ПО Связи.Цель = Цели.Узел
			| ЛЕВОЕ СОЕДИНЕНИЕ Кандидаты КАК Владельцы ПО Связи.УзелИсточник = Владельцы.Узел
			|ГДЕ Связи.Запуск = &Запуск И Владельцы.Узел ЕСТЬ NULL ИНДЕКСИРОВАТЬ ПО Узел;
			|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Новые";
		Результаты = Запрос.ВыполнитьПакет();
		Выборка = Результаты[1].Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Запрос.Текст = "УНИЧТОЖИТЬ Новые";
			Запрос.Выполнить();
			Прервать;
		КонецЕсли;
		СообщитьПодготовку(Прогресс, "Расширение каскада в базе данных");
		Запрос.Текст =
			"ВЫБРАТЬ Узел ПОМЕСТИТЬ Расширенные ИЗ Кандидаты
			|ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Узел ИЗ Новые;
			|УНИЧТОЖИТЬ Кандидаты;
			|ВЫБРАТЬ Узел ПОМЕСТИТЬ Кандидаты ИЗ Расширенные ИНДЕКСИРОВАТЬ ПО Узел;
			|УНИЧТОЖИТЬ Новые; УНИЧТОЖИТЬ Расширенные";
		Запрос.ВыполнитьПакет();
	КонецЦикла;

КонецПроцедуры

Процедура ПостроитьСмежность(Запрос)

	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Связи.УзелИсточник КАК Первый, Связи.Цель КАК Второй
		|ПОМЕСТИТЬ РебраСсылок ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Владельцы ПО Связи.УзелИсточник = Владельцы.Узел
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Цели ПО Связи.Цель = Цели.Узел
		|ГДЕ Связи.Запуск = &Запуск;
		|ВЫБРАТЬ Узлы.КлючЕдиницы, МИНИМУМ(Узлы.Узел) КАК Опора
		|ПОМЕСТИТЬ Единицы ИЗ Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Кандидаты ПО Узлы.Узел = Кандидаты.Узел
		|СГРУППИРОВАТЬ ПО Узлы.КлючЕдиницы ИНДЕКСИРОВАТЬ ПО КлючЕдиницы;
		|ВЫБРАТЬ Узлы.Узел КАК Первый, Единицы.Опора КАК Второй ПОМЕСТИТЬ РебраЕдиниц
		|ИЗ Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Кандидаты ПО Узлы.Узел = Кандидаты.Узел
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Единицы КАК Единицы ПО Узлы.КлючЕдиницы = Единицы.КлючЕдиницы;
		|ВЫБРАТЬ Первый, Второй ПОМЕСТИТЬ Смежность ИЗ РебраСсылок
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Второй, Первый ИЗ РебраСсылок
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Первый, Второй ИЗ РебраЕдиниц
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Второй, Первый ИЗ РебраЕдиниц;
		|ВЫБРАТЬ Кандидаты.Узел, Кандидаты.Узел КАК Метка
		|ПОМЕСТИТЬ Метки ИЗ Кандидаты КАК Кандидаты ИНДЕКСИРОВАТЬ ПО Узел";
	Запрос.ВыполнитьПакет();

КонецПроцедуры

Процедура ЗамкнутьМетки(Запрос, ИмяСмежности, Прогресс)

	Пока Истина Цикл
		Запрос.Текст = СтрШаблон(
			"ВЫБРАТЬ Свои.Узел КАК Идентификатор, МИНИМУМ(ВЫБОР
			| КОГДА Свои.Метка < ЕСТЬNULL(Соседи.Метка, Свои.Метка) ТОГДА Свои.Метка
			| ИНАЧЕ ЕСТЬNULL(Соседи.Метка, Свои.Метка) КОНЕЦ) КАК Метка ПОМЕСТИТЬ НовыеМетки
			|ИЗ Метки КАК Свои
			| ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК Ребра ПО Свои.Узел = Ребра.Первый
			| ЛЕВОЕ СОЕДИНЕНИЕ Метки КАК Соседи ПО Ребра.Второй = Соседи.Узел
			|СГРУППИРОВАТЬ ПО Свои.Узел ИНДЕКСИРОВАТЬ ПО Идентификатор;
			|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Изменено
			|ИЗ НовыеМетки КАК Новые ВНУТРЕННЕЕ СОЕДИНЕНИЕ Метки КАК Старые
			| ПО Новые.Идентификатор = Старые.Узел
			|ГДЕ Новые.Метка <> Старые.Метка", ИмяСмежности);
		Результаты = Запрос.ВыполнитьПакет();
		Выборка = Результаты[1].Выбрать();
		Выборка.Следующий();
		Если Выборка.Изменено = 0 Тогда
			Запрос.Текст = "УНИЧТОЖИТЬ НовыеМетки";
			Запрос.Выполнить();
			Прервать;
		КонецЕсли;
		СообщитьПодготовку(Прогресс, "Объединение связанных групп в базе данных");
		Запрос.Текст =
			"УНИЧТОЖИТЬ Метки;
			|ВЫБРАТЬ Идентификатор КАК Узел, Метка ПОМЕСТИТЬ Метки ИЗ НовыеМетки ИНДЕКСИРОВАТЬ ПО Узел;
			|УНИЧТОЖИТЬ НовыеМетки";
		Запрос.ВыполнитьПакет();
	КонецЦикла;

КонецПроцедуры

Процедура ОбъединитьРаботыРегистров(Запрос, Прогресс)

	Запрос.Текст =
		"ВЫБРАТЬ Узел, Метка ПОМЕСТИТЬ Компоненты ИЗ Метки ИНДЕКСИРОВАТЬ ПО Узел;
		|ВЫБРАТЬ Узлы.Ресурс, МИНИМУМ(Узлы.Узел) КАК Опора ПОМЕСТИТЬ Ресурсы
		|ИЗ Узлы КАК Узлы ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Кандидаты ПО Узлы.Узел = Кандидаты.Узел
		|ГДЕ Узлы.Ресурс <> """" СГРУППИРОВАТЬ ПО Узлы.Ресурс ИНДЕКСИРОВАТЬ ПО Ресурс;
		|ВЫБРАТЬ Узлы.Узел КАК Первый, Ресурсы.Опора КАК Второй ПОМЕСТИТЬ РебраРесурсов
		|ИЗ Узлы КАК Узлы ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Кандидаты ПО Узлы.Узел = Кандидаты.Узел
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Ресурсы КАК Ресурсы ПО Узлы.Ресурс = Ресурсы.Ресурс;
		|ВЫБРАТЬ Первый, Второй ПОМЕСТИТЬ СмежностьРабот ИЗ Смежность
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Первый, Второй ИЗ РебраРесурсов
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Второй, Первый ИЗ РебраРесурсов";
	Запрос.ВыполнитьПакет();
	ЗамкнутьМетки(Запрос, "СмежностьРабот", Прогресс);
	Запрос.Текст =
		"ВЫБРАТЬ ПОДСТРОКА(Метка, 1, 36) КАК КраткаяМетка
		|ИЗ Метки СГРУППИРОВАТЬ ПО ПОДСТРОКА(Метка, 1, 36)
		|ИМЕЮЩИЕ МИНИМУМ(Метка) <> МАКСИМУМ(Метка)
		|ОБЪЕДИНИТЬ ВЫБРАТЬ ПОДСТРОКА(Метка, 1, 36)
		|ИЗ Компоненты СГРУППИРОВАТЬ ПО ПОДСТРОКА(Метка, 1, 36)
		|ИМЕЮЩИЕ МИНИМУМ(Метка) <> МАКСИМУМ(Метка)";
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Коллизия идентификаторов групп. Прикладные данные не изменены.";
	КонецЕсли;

КонецПроцедуры

Функция СохранитьКаскадыИРаботы(Запуск, Прогресс)

	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	Запрос = ЗапросИндекса(Запуск, ВременныеТаблицы);
	ЗамкнутьКандидатов(Запрос, Прогресс);
	ПостроитьСмежность(Запрос);
	ЗамкнутьМетки(Запрос, "Смежность", Прогресс);
	ОбъединитьРаботыРегистров(Запрос, Прогресс);
	Работы = Новый Соответствие;
	Последний = "";
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Последний", Последний);
		Запрос.Текст = СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ %1 Узлы.Узел, Узлы.Локатор, Узлы.Метаданные, Узлы.Вид, Узлы.ЕдиницаЗаписи,
			| ПОДСТРОКА(Метки.Метка, 1, 36) КАК Работа, ПОДСТРОКА(Компоненты.Метка, 1, 36) КАК Группа
			|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Метки КАК Метки ПО Узлы.Узел = Метки.Узел
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Компоненты КАК Компоненты ПО Узлы.Узел = Компоненты.Узел
			|ГДЕ Узлы.Запуск = &Запуск И Узлы.Узел > &Последний УПОРЯДОЧИТЬ ПО Узлы.Узел",
			Формат(РазмерПорции(), "ЧГ=0"));
		Выборка = Запрос.Выполнить().Выбрать();
		Набор = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Пока Выборка.Следующий() Цикл
			Последний = Выборка.Узел;
			Запись = Набор.Добавить();
			Запись.Запуск = Запуск;
			Запись.Группа = Выборка.Группа;
			Запись.Элемент = Строка(Новый УникальныйИдентификатор);
			Запись.Задание = Выборка.Работа;
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.КлючЕдиницы = ХешКлюча(Запись.ЕдиницаЗаписи);
			ПроверитьЭлементИндекса(Запись);
			Работа = Работы.Получить(Выборка.Работа);
			Если Работа = Неопределено Тогда
				Работа = Новый Структура("Идентификатор,Наименование,Всего,Представители",
					Выборка.Работа, "", 0, Новый Соответствие);
				Работы.Вставить(Выборка.Работа, Работа);
			КонецЕсли;
			Работа.Всего = Работа.Всего + 1;
			Работа.Представители.Вставить(Выборка.Метаданные,
				Новый Структура("Метаданные,Вид", Выборка.Метаданные, Выборка.Вид));
		КонецЦикла;
		Если Набор.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Набор.Записать(Ложь);
		СообщитьПодготовку(Прогресс, "Сохранение порции плана");
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого Пара Из Работы Цикл
		Представители = Новый Массив;
		Для Каждого Представитель Из Пара.Значение.Представители Цикл
			Представители.Добавить(Представитель.Значение);
		КонецЦикла;
		Пара.Значение.Наименование = ИмяРаботы(Представители);
		Пара.Значение.Удалить("Представители");
		Результат.Добавить(Пара.Значение);
	КонецЦикла;
	ПроверитьПлатформенныйПоискИндекса(Запрос);
	ВременныеТаблицы.Закрыть();
	Возврат Результат;

КонецФункции

Процедура ПроверитьЭлементИндекса(Элемент)

	Если Элемент.Вид = "Константа" Тогда
		ВызватьИсключение "Каскад затрагивает неудаляемую константу " + Элемент.Метаданные;
	КонецЕсли;
	Описание = Метаданные.НайтиПоПолномуИмени(Элемент.Метаданные);
	Если Элемент.Вид = "Объект" Тогда
		ПроверитьПраво("Удаление", Описание);
		Локатор = ЛокаторЭлемента(Элемент);
		Объект = ДекодироватьКлюч(Локатор.Ключи.Ссылка).ПолучитьОбъект();
		Если ЗащищенныйОбъект(Объект, Элемент.Метаданные) Тогда
			ВызватьИсключение "Каскад затрагивает защищенный объект " + Элемент.Метаданные;
		КонецЕсли;
	Иначе
		Если Элемент.Вид = "Перерасчет" Тогда
			Части = СтрРазделить(Элемент.Метаданные, ".");
			Описание = Метаданные.РегистрыРасчета[Части[1]];
		КонецЕсли;
		ПроверитьПраво("Изменение", Описание);
	КонецЕсли;

КонецПроцедуры


Функция СнимокГруппы(Состав, Контекст = Неопределено)

	Если Контекст = Неопределено Тогда
		Контекст = КонтекстКонтроляКаскадов();
	КонецЕсли;
	Снимок = НовыйСнимок(Контекст.Каталог, Истина);
	Группы = Новый Соответствие;
	Для Каждого Элемент Из Состав Цикл
		Группа = Группы.Получить(Элемент.Метаданные);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Элемент.Метаданные, Группа);
		КонецЕсли;
		Группа.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Группа Из Группы Цикл
		Таблицы = Контекст.ТаблицыПоКорню.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Таблица Из Таблицы Цикл
			Чтение = Контекст.ПолныеЧтения[Таблица.Имя];
			Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Подготовка локаторов снимка", Таблица.Имя, Группа.Значение.Количество());
			Локаторы = ЛокаторыЧтенияГруппы(Таблица, Группа.Значение, Чтение.Колонки);
			Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Локаторы.Количество());
			Если Локаторы.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
			Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Создание временного отбора снимка", Таблица.Имя, Локаторы.Количество());
			Условие = УсловиеЧтенияГруппы(Чтение, Локаторы, ВременныеТаблицы);
			Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
			Запрос.Текст = "ВЫБРАТЬ " + Чтение.Поля + " ИЗ " + Таблица.Имя + " КАК " + Чтение.Псевдоним
				+ " ВНУТРЕННЕЕ СОЕДИНЕНИЕ Отбор КАК Отбор ПО " + Условие;
			// В память попадает только атомарная порция и сохраняемые строки ее единиц записи.
			Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Запрос снимка", Таблица.Имя, Локаторы.Количество(), Запрос.Текст);
			Результат = Запрос.Выполнить();
			Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
			Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст, "Разбор строк снимка", Таблица.Имя);
			Прочитано = 0;
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				ДобавитьСтрокуПорции(Снимок, Таблица, Выборка, Результат.Колонки);
				Прочитано = Прочитано + 1;
			КонецЦикла;
			Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Прочитано);
			ВременныеТаблицы.Закрыть();
		КонецЦикла;
	КонецЦикла;
	Возврат Снимок;

КонецФункции

Функция ЛокаторыЧтенияГруппы(Таблица, Состав, Поля)

	Результат = Новый ТаблицаЗначений;
	Посещенные = Новый Соответствие;
	КолонкиДобавлены = Ложь;
	Для Каждого Элемент Из Состав Цикл
		Если Элемент.Метаданные <> Таблица.Корень Тогда
			Продолжить;
		КонецЕсли;
		Если Таблица.Вид <> "ТабличнаяЧасть" И Элемент.Вид <> Таблица.Вид Тогда
			Продолжить;
		КонецЕсли;
		Если Посещенные.Получить(Элемент.ЕдиницаЗаписи) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Посещенные.Вставить(Элемент.ЕдиницаЗаписи, Истина);
		Локатор = ЛокаторЭлемента(Элемент);
		Ключи = Новый Структура;
		Для Каждого Поле Из Локатор.Ключи Цикл
			Если Поле.Ключ = "НомерСтроки" Тогда
				Продолжить;
			КонецЕсли;
			Если Таблица.Вид = "Последовательность" И Поле.Ключ <> "Регистратор" Тогда
				Продолжить;
			КонецЕсли;
			Если Таблица.Вид = "Перерасчет" И Поле.Ключ <> "ОбъектПерерасчета" Тогда
				Продолжить;
			КонецЕсли;
			Ключи.Вставить(Поле.Ключ, ДекодироватьКлюч(Поле.Значение));
		КонецЦикла;
		Если Не КолонкиДобавлены Тогда
			КолонкиДобавлены = Истина;
			Для Каждого Поле Из Ключи Цикл
				Результат.Колонки.Добавить(Поле.Ключ, Поля.Найти(Поле.Ключ).ТипЗначения);
			КонецЦикла;
			Если Результат.Колонки.Количество() = 0 Тогда
				Результат.Колонки.Добавить("ЕдинственнаяСтрока", Новый ОписаниеТипов("Булево"));
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Ключи);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция УсловиеЧтенияГруппы(Чтение, Локаторы, ВременныеТаблицы)

	Поля = Новый Массив;
	Условия = Новый Массив;
	Для Каждого Колонка Из Локаторы.Колонки Цикл
		Поля.Добавить("Локаторы." + Колонка.Имя);
		Если Колонка.Имя <> "ЕдинственнаяСтрока" Тогда
			Условия.Добавить(СтрШаблон("%1.%2 = Отбор.%2", Чтение.Псевдоним, Колонка.Имя));
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ " + СтрСоединить(Поля, ", ")
		+ " ПОМЕСТИТЬ Отбор ИЗ &Локаторы КАК Локаторы");
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	Запрос.УстановитьПараметр("Локаторы", Локаторы);
	Запрос.Выполнить();
	Если Условия.Количество() = 0 Тогда
		Возврат "ИСТИНА";
	КонецЕсли;
	Возврат СтрСоединить(Условия, " И ");

КонецФункции

Процедура ДобавитьИндексированныеВходящие(Снимок, Запуск, Состав, Задание, Трассировка, КлючиПорции = Неопределено)

	Если КлючиПорцииСоответствуютСоставу(КлючиПорции, Состав, Запуск, Задание) Тогда
		Ключи = КлючиПорции.Ключи;
		ИзвестныеЛокаторы = КлючиПорции.Локаторы;
	Иначе
		Ключи = Новый Массив;
		ИзвестныеЛокаторы = Новый Соответствие;
		Для Каждого Элемент Из Состав Цикл
			Ключ = ХешКлюча(Элемент.Локатор);
			Ключи.Добавить(Ключ);
			ИзвестныеЛокаторы.Вставить(Ключ, Элемент.Локатор);
		КонецЦикла;
	КонецЕсли;
	Индексы = Новый Массив;
	Индексы.Добавить(Запуск);
	Индексы.Добавить(Задание);
	Если ЕстьПлоскиеУзлыИндекса(Индексы) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Связи.ЛокаторЦели, Узлы.Локатор КАК Владелец
			|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
			| ПО Связи.Запуск = Узлы.Запуск И Связи.УзелИсточник = Узлы.Узел
			|ГДЕ Связи.Запуск В (&Индексы) И Связи.Цель В (&Ключи)");
		Запрос.УстановитьПараметр("Индексы", Индексы);
		Запрос.УстановитьПараметр("Ключи", Ключи);
		Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Трассировка, "Запрос служебного индекса", "Cutter3000_Связи, Cutter3000_Узлы", Ключи.Количество(), Запрос.Текст);
		Результат = Запрос.Выполнить();
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Входящие = Снимок.Входящие.Получить(Выборка.ЛокаторЦели);
			Если Входящие = Неопределено Тогда
				Входящие = Новый Соответствие;
				Снимок.Входящие.Вставить(Выборка.ЛокаторЦели, Входящие);
			КонецЕсли;
			Входящие.Вставить(Выборка.Владелец, Истина);
		КонецЦикла;
	
	КонецЕсли;
	ДобавитьВходящиеБлоков(Снимок, Задание, Ключи, ИзвестныеЛокаторы);

КонецПроцедуры

Функция КлючиПорцииСоответствуютСоставу(КлючиПорции, Состав, Запуск, Задание)

	Если КлючиПорции = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не КлючиПорции.Полный Или КлючиПорции.Запуск <> Запуск Или КлючиПорции.Задание <> Задание Тогда
		Возврат Ложь;
	КонецЕсли;
	Количество = Состав.Количество();
	Если Количество > 2000 Или КлючиПорции.Ключи.Количество() <> Количество
		Или КлючиПорции.Локаторы.Количество() <> Количество Или КлючиПорции.Порядок.Количество() <> Количество Тогда
		Возврат Ложь;
	КонецЕсли;
	Номер = 0;
	Для Каждого Элемент Из Состав Цикл
		Если КлючиПорции.Порядок[Номер] <> Элемент.Локатор Тогда
			Возврат Ложь;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЕстьПлоскиеУзлыИндекса(Индексы)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Узлы.Узел КАК Узел
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск В (&Индексы)
		| И НЕ (Узлы.Узел = &Маркер И Узлы.Вид = &Маркер)");
	Запрос.УстановитьПараметр("Индексы", Индексы);
	Запрос.УстановитьПараметр("Маркер", "ИндексКаскада");
	РезультатЗапроса = Запрос.Выполнить();
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

Функция КоличествоИсходныхКандидатов(Граница)

	Количество = 0;
	Для Каждого Таблица Из КаталогТаблиц() Цикл
		Поле = ПолеПериода(Таблица);
		Если Поле = "" Тогда
			Продолжить;
		КонецЕсли;
		Псевдоним = ПсевдонимТаблицы(Таблица);
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ %1 КАК %2 ГДЕ %2.%3 < &Граница",
			Таблица.Имя, Псевдоним, Поле));
		Запрос.УстановитьПараметр("Граница", Граница);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Количество = Количество + Выборка.Количество;
	КонецЦикла;
	Возврат Количество;

КонецФункции

Процедура ПроверитьПлатформенныйПоискИндекса(Запрос)

	Последний = "";
	Исключения = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Cutter3000_Задания,Cutter3000_План,Cutter3000_Узлы,Cutter3000_Связи,Cutter3000_Ошибки", ",") Цикл
		Исключения.Добавить(Метаданные.РегистрыСведений[Имя]);
	КонецЦикла;
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Последний", Последний);
		Запрос.Текст = СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ %1 Узлы.Узел, Узлы.Локатор
			|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Кандидаты ПО Узлы.Узел = Кандидаты.Узел
			|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид = &Вид И Узлы.Узел > &Последний
			|УПОРЯДОЧИТЬ ПО Узлы.Узел", Формат(РазмерПорции(), "ЧГ=0"));
		Запрос.УстановитьПараметр("Вид", "Объект");
		Выборка = Запрос.Выполнить().Выбрать();
		Ссылки = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Последний = Выборка.Узел;
			Ссылки.Добавить(ДекодироватьКлюч(ЗначениеИзСтрокиВнутр(Выборка.Локатор)));
		КонецЦикла;
		Если Ссылки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Найденные = НайтиПоСсылкам(Ссылки,,, Исключения);
		Зависимости = Новый ТаблицаЗначений;
		Зависимости.Колонки.Добавить("Цель", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(64)));
		Зависимости.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(64)));
		Зависимости.Колонки.Добавить("Метаданные", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
		Для Каждого Найденная Из Найденные Цикл
			Зависимость = Зависимости.Добавить();
			Зависимость.Цель = ХешКлюча(КлючСсылки(Найденная[0]));
			Описание = МетаданныеСсылки(Найденная[1]);
			Если Описание <> Неопределено Тогда
				Зависимость.Источник = ХешКлюча(КлючСсылки(Найденная[1]));
				Зависимость.Метаданные = Описание.ПолноеИмя();
			Иначе
				Зависимость.Метаданные = Найденная[2].ПолноеИмя();
			КонецЕсли;
			Если Зависимости.Количество() = РазмерПорции() Тогда
				ПроверитьНативныеЗависимости(Запрос, Зависимости);
				Зависимости.Очистить();
			КонецЕсли;
		КонецЦикла;
		Если Зависимости.Количество() > 0 Тогда
			ПроверитьНативныеЗависимости(Запрос, Зависимости);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНативныеЗависимости(Запрос, Зависимости)

	// В подчиненной таблице платформенный владелец может быть регистратором,
	// а не локатором строки. Проверяются включение владельца и покрытие цели индексом.
	Запрос.УстановитьПараметр("Зависимости", Зависимости);
	Запрос.Текст =
		"ВЫБРАТЬ Цель, Источник, Метаданные ПОМЕСТИТЬ Нативные ИЗ &Зависимости КАК Зависимости;
		|ВЫБРАТЬ РАЗЛИЧНЫЕ Связи.Цель, Связи.УзелИсточник КАК Владелец, Узлы.Метаданные ПОМЕСТИТЬ Покрытые
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ПО Узлы.Запуск = Связи.Запуск И Узлы.Узел = Связи.УзелИсточник
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Кандидаты КАК Кандидаты ПО Кандидаты.Узел = Узлы.Узел
		|ГДЕ Связи.Запуск = &Запуск И Связи.Цель В (ВЫБРАТЬ Цель ИЗ Нативные);
		|ВЫБРАТЬ ПЕРВЫЕ 1 Нативные.Метаданные, Нативные.Цель, Нативные.Источник ИЗ Нативные КАК Нативные
		| ЛЕВОЕ СОЕДИНЕНИЕ Покрытые КАК Покрытые
		| ПО Покрытые.Цель = Нативные.Цель
		|  И (Нативные.Источник <> """" ИЛИ Покрытые.Метаданные = Нативные.Метаданные)
		| ЛЕВОЕ СОЕДИНЕНИЕ Кандидаты КАК Владельцы ПО Нативные.Источник = Владельцы.Узел
		|ГДЕ Покрытые.Цель ЕСТЬ NULL
		| ИЛИ (Нативные.Источник <> """" И Владельцы.Узел ЕСТЬ NULL);
		|УНИЧТОЖИТЬ Нативные; УНИЧТОЖИТЬ Покрытые";
	Результаты = Запрос.ВыполнитьПакет();
	Если Не Результаты[2].Пустой() Тогда
		Выборка = Результаты[2].Выбрать();
		Выборка.Следующий();
		ВызватьИсключение СтрШаблон(
			"Платформенный поиск обнаружил зависимость вне каскада: %1; цель %2; источник %3.",
			Выборка.Метаданные, Выборка.Цель, Выборка.Источник);
	КонецЕсли;

КонецПроцедуры


Функция КореньМеткиКаскада(Метки, Ключ)

	Корень = Ключ;
	Пока Метки[Корень] <> Корень Цикл
		Корень = Метки[Корень];
	КонецЦикла;
	Метки.Вставить(Ключ, Корень);
	Возврат Корень;

КонецФункции

Процедура СоединитьМеткиКаскада(Метки, Левый, Правый)

	Первый = КореньМеткиКаскада(Метки, Левый);
	Второй = КореньМеткиКаскада(Метки, Правый);
	Если Первый < Второй Тогда
		Метки.Вставить(Второй, Первый);
	Иначе
		Метки.Вставить(Первый, Второй);
	КонецЕсли;

КонецПроцедуры

Функция ЭлементыСнимкаКаскада(Снимок)

	Результат = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Метаданные,Вид,Локатор,ЕдиницаЗаписи", ",") Цикл
		Результат.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Если Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСостава = Результат.Добавить();
		СтрокаСостава.Метаданные = Узел.Таблица.Корень;
		СтрокаСостава.Вид = Узел.Таблица.Вид;
		СтрокаСостава.Локатор = Пара.Ключ;
		СтрокаСостава.ЕдиницаЗаписи = Узел.Единица;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗанятыеУзлыКаскадов(Запуск, Снимок)

	Ключи = Новый ТаблицаЗначений;
	ТипКлюча = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Ключи.Колонки.Добавить("Узел", ТипКлюча);
	Ключи.Колонки.Добавить("Единица", ТипКлюча);
	Для Каждого Пара Из Снимок.Узлы Цикл
		СтрокаКлючей = Ключи.Добавить();
		СтрокаКлючей.Узел = ХешКлюча(Пара.Ключ);
		СтрокаКлючей.Единица = ХешКлюча(Пара.Значение.Единица);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ключи.Узел КАК Узел, Ключи.Единица КАК Единица ПОМЕСТИТЬ ВТ_КлючиКаскада
		|ИЗ &Ключи КАК Ключи;
		|ВЫБРАТЬ Узлы.Запуск КАК Задание, Узлы.Локатор КАК Локатор, Узлы.ЕдиницаЗаписи КАК ЕдиницаЗаписи
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		| (ВЫБРАТЬ РАЗЛИЧНЫЕ План.Задание КАК Задание ИЗ РегистрСведений.Cutter3000_План КАК План
		|  ГДЕ План.Запуск = &Запуск И НЕ План.Пропущено) КАК Группы ПО Узлы.Запуск = Группы.Задание
		|ГДЕ Узлы.Узел В (ВЫБРАТЬ Ключи.Узел КАК Узел ИЗ ВТ_КлючиКаскада КАК Ключи)
		| ИЛИ Узлы.КлючЕдиницы В (ВЫБРАТЬ Ключи.Единица КАК Единица ИЗ ВТ_КлючиКаскада КАК Ключи)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Результаты[1].Выбрать();

КонецФункции

Процедура ИсключитьЗанятыеУзлы(Запуск, Снимок)

	Выборка = ЗанятыеУзлыКаскадов(Запуск, Снимок);
	Пока Выборка.Следующий() Цикл
		Снимок.Узлы.Удалить(Выборка.Локатор);
		Снимок.Ссылки.Удалить(Выборка.Локатор);
	КонецЦикла;
	Пропуски = ПропускиСнимка(Снимок, Запуск);
	Для Каждого Пара Из Пропуски Цикл
		Снимок.Узлы.Удалить(Пара.Ключ);
		Снимок.Ссылки.Удалить(Пара.Ключ);
	КонецЦикла;

КонецПроцедуры

Функция ПересекающиесяЗаданияКаскадов(Запуск, Снимок)

	Задания = Новый Соответствие;
	Единицы = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Единицы.Вставить(Пара.Значение.Единица, Истина);
	КонецЦикла;
	Выборка = ЗанятыеУзлыКаскадов(Запуск, Снимок);
	Пока Выборка.Следующий() Цикл
		Если Снимок.Узлы.Получить(Выборка.Локатор) <> Неопределено
			Или Единицы.Получить(Выборка.ЕдиницаЗаписи) <> Неопределено Тогда
			Задания.Вставить(Выборка.Задание, Истина);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Результат.Добавить(Задание.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ИсключитьОтложенныеКорни(Контекст, Семена)

	Удаляемые = Новый Массив;
	Для Каждого Пара Из Семена.Узлы Цикл
		Если Контекст.ОтложенныеЕдиницы.Получить(Пара.Значение.Единица) <> Неопределено Тогда
			Удаляемые.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из Удаляемые Цикл
		Семена.Узлы.Удалить(Ключ);
		Семена.Ссылки.Удалить(Ключ);
	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьСтарыеЕдиницы(Контекст, Семена)

	// После записи подчиненного набора платформа перенумеровывает оставшиеся строки.
	// Все старые строки выбранной единицы включаются до продвижения курсора страницы.
	Полный = СнимокГруппы(ЭлементыСнимкаКаскада(Семена), Контекст);
	ВладельцыНарушений = ВладельцыБитыхСсылок(Полный);
	Для Каждого Пара Из Полный.Узлы Цикл
		Узел = Пара.Значение;
		Поле = ПолеПериода(Узел.Таблица);
		Если (Поле <> "" И Узел.Поля[Поле] < Контекст.Граница)
			Или ВладельцыНарушений.Получить(Пара.Ключ) <> Неопределено Тогда
			СлитьУзелКаскада(Семена, Узел, Полный.Ссылки.Получить(Пара.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоискКаскада(Снимок, Кандидаты, Контекст, Запуск, Задание, Контроль, БлокировкиУстановлены = Ложь)

	Ссылки = Новый Массив;
	Для Каждого Пара Из Снимок.Ссылки Цикл
		Если Кандидаты.Получить(Пара.Ключ) <> Неопределено Тогда
			Ссылки.Добавить(Пара.Значение);
		КонецЕсли;
	КонецЦикла;
	Группы = ГруппыТиповЦелей(Ссылки);
	Прогресс = Новый Структура("Запуск,Задание,Контроль", Запуск, Задание, Контроль);
	УскоренныйРежим = Ложь;
	Контекст.Свойство("УскоренныйРежим", УскоренныйРежим);
	Если Не УскоренныйРежим Тогда
		ПроверитьОбычныеВходящие(Снимок, Кандидаты, Контекст, Группы, Прогресс, БлокировкиУстановлены);
	КонецЕсли;
	// МоментВремени требует извлечения ссылки; остальные исключенные контейнеры не читаются.
	ПроверитьОсобыеВходящие(Контекст, Ссылки, Группы, Кандидаты, Прогресс);
	// Системные таблицы журналов не входят в каталог прикладных строк.
	Если Метаданные.ЖурналыДокументов.Количество() > 0 И Ссылки.Количество() > 0 Тогда
		СообщитьЭтапУдаления(Запуск, Задание, "Проверка входящих ссылок: журналы документов", 0, Контроль);
	КонецЕсли;
	ПорцияСсылок = Новый Массив;
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		ПорцияСсылок.Добавить(СсылкаОбъекта);
		Если ПорцияСсылок.Количество() = РазмерПорции() Тогда
			Найденные = ПлатформенныйПоискПоКарте(Контекст, ПорцияСсылок, Истина);
			ПроверитьПлатформенныйПоиск(Снимок, Кандидаты, Найденные, Контекст);
			ПроверитьНайденныеКаскада(Снимок, Кандидаты, Найденные, Контекст);
			ПорцияСсылок.Очистить();
		КонецЕсли;
	КонецЦикла;
	Если ПорцияСсылок.Количество() > 0 Тогда
		Найденные = ПлатформенныйПоискПоКарте(Контекст, ПорцияСсылок, Истина);
		ПроверитьПлатформенныйПоиск(Снимок, Кандидаты, Найденные, Контекст);
		ПроверитьНайденныеКаскада(Снимок, Кандидаты, Найденные, Контекст);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОбычныеВходящие(Снимок, Кандидаты, Контекст, Группы, Прогресс, БлокировкиУстановлены)

	Перем Покрытие, Покрытые;
	Покрытие = ПокрытиеРегистраторовПорции(Снимок, Кандидаты, БлокировкиУстановлены);
	Проверки = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Таблицы = Контекст.КартаВходящих.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Пара Из Таблицы Цикл
			Таблица = Контекст.ТаблицыПоИменам[Пара.Ключ];
			Если Контекст.НепрозрачныеПоИменам.Получить(Таблица.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Покрытые = Покрытие.Получить(Таблица.Имя);
			Для Каждого Поле Из Пара.Значение Цикл
				// Владелец удаляется целиком; строки его табличных частей не образуют внешнего владельца.
				Если Таблица.Вид = "ТабличнаяЧасть" И Поле.Ключ = "Ссылка" Тогда
					Продолжить;
				КонецЕсли;
				Поля = Проверки.Получить(Таблица.Имя);
				Если Поля = Неопределено Тогда
					Поля = Новый Соответствие;
					Проверки.Вставить(Таблица.Имя, Поля);
				КонецЕсли;
				ЦелиПоля = Поля.Получить(Поле.Ключ);
				Если ЦелиПоля = Неопределено Тогда
					ЦелиПоля = Новый Массив;
					Поля.Вставить(Поле.Ключ, ЦелиПоля);
				КонецЕсли;
				Для Каждого СсылкаОбъекта Из Группа.Значение Цикл
					Если Поле.Ключ = "Регистратор" И Покрытые <> Неопределено
						И Покрытые.Получить(СсылкаОбъекта) = Истина Тогда
						Продолжить;
					КонецЕсли;
					ЦелиПоля.Добавить(СсылкаОбъекта);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ПоКорням = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Узел = Снимок.Узлы[Кандидат.Ключ];
		УзлыКорня = ПоКорням.Получить(Узел.Таблица.Корень);
		Если УзлыКорня = Неопределено Тогда
			УзлыКорня = Новый Массив;
			ПоКорням.Вставить(Узел.Таблица.Корень, УзлыКорня);
		КонецЕсли;
		УзлыКорня.Добавить(Узел);
	КонецЦикла;
	ПоОтборам = Новый Соответствие;
	Для Каждого Проверка Из Проверки Цикл
		Таблица = Контекст.ТаблицыПоИменам[Проверка.Ключ];
		КлючОтбора = КлючОтбораКаскада(Таблица);
		ПроверкиОтбора = ПоОтборам.Получить(КлючОтбора);
		Если ПроверкиОтбора = Неопределено Тогда
			ПроверкиОтбора = Новый Массив;
			ПоОтборам.Вставить(КлючОтбора, ПроверкиОтбора);
		КонецЕсли;
		ПроверкиОтбора.Добавить(Проверка);
	КонецЦикла;
	Для Каждого ГруппаОтбора Из ПоОтборам Цикл
		Отборы = Новый Соответствие;
		Попытка
			Для Каждого Проверка Из ГруппаОтбора.Значение Цикл
				Таблица = Контекст.ТаблицыПоИменам[Проверка.Ключ];
				ПроверитьТаблицуВходящих(Таблица, Проверка.Значение, Контекст.Чтения[Таблица.Имя],
					ПоКорням.Получить(Таблица.Корень), Прогресс, Отборы);
			КонецЦикла;
		Исключение
			ЗакрытьОтборыКаскада(Отборы);
			ВызватьИсключение;
		КонецПопытки;
		ЗакрытьОтборыКаскада(Отборы);
	КонецЦикла;

КонецПроцедуры

Процедура ЗакрытьОтборыКаскада(Отборы)

	Для Каждого Отбор Из Отборы Цикл
		Отбор.Значение.Временные.Закрыть();
	КонецЦикла;

КонецПроцедуры

Функция КлючОтбораКаскада(Таблица)

	Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
		// У табличных частей одного владельца одинаковый состав ссылок-кандидатов.
		Возврат Таблица.Корень + "|" + Таблица.Вид;
	КонецЕсли;
	Возврат Таблица.Имя;

КонецФункции

Процедура ПроверитьТаблицуВходящих(Таблица, Поля, Чтение, Узлы, Прогресс, Отборы)

	Перем ГруппыПроверок, КлючОтбора, Отбор, Запрос, Группа, Условия, ВариантыПоля, ИменаПолей;
	Перем Поле, ИмяПараметра, Условие, Выборка, ОписаниеПроверки;
	ГруппыПроверок = ГруппыОбычныхПроверок(Поля, Чтение);
	Если ГруппыПроверок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КлючОтбора = КлючОтбораКаскада(Таблица);
	Отбор = Отборы.Получить(КлючОтбора);
	Если Отбор = Неопределено Тогда
		ЗамерОтбора = Cutter3000_ЗаданияСервер.НачатьЗамер(Прогресс.Контроль, "Подготовка отбора входящих ссылок", Таблица.Имя);
		Отбор = ПодготовитьОтборКаскада(Таблица, Чтение, Узлы);
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерОтбора);
		Отборы.Вставить(КлючОтбора, Отбор);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Отбор.Временные;
	Для Каждого Группа Из ГруппыПроверок Цикл
		КоличествоЦелей = 0;
		Условия = Новый Массив;
		ВариантыПоля = Новый Массив;
		ИменаПолей = Новый Массив;
		Для Каждого Поле Из Группа Цикл
			ИмяПараметра = "ЦелиОбрезки" + Формат(Условия.Количество() + 1, "ЧГ=0");
			Условие = "ИсточникОбрезки." + Поле.Ключ + " В (&" + ИмяПараметра + ")";
			Условия.Добавить(Условие);
			ВариантыПоля.Добавить("КОГДА " + Условие + " ТОГДА """ + Поле.Ключ + """");
			ИменаПолей.Добавить(Поле.Ключ);
			Запрос.УстановитьПараметр(ИмяПараметра, Поле.Значение);
			КоличествоЦелей = КоличествоЦелей + Поле.Значение.Количество();
		КонецЦикла;
		ОписаниеПроверки = Таблица.Имя + "." + ИменаПолей[0];
		Если ИменаПолей.Количество() > 1 Тогда
			ОписаниеПроверки = Таблица.Имя + "; полей: " + Формат(ИменаПолей.Количество(), "ЧГ=0");
		КонецЕсли;
		СообщитьЭтапУдаления(Прогресс.Запуск, Прогресс.Задание,
			"Проверка входящих ссылок: " + ОписаниеПроверки, 0, Прогресс.Контроль);
		// Каждый предикат сохраняет собственные цели. NULL в соседнем поле не скрывает нарушение.
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ВЫБОР " + СтрСоединить(ВариантыПоля, " ")
			+ " ИНАЧЕ """" КОНЕЦ КАК Поле ИЗ " + Таблица.Имя + " КАК ИсточникОбрезки"
			+ " ЛЕВОЕ СОЕДИНЕНИЕ ОтборКаскада КАК ОтборКаскада ПО " + Отбор.Соединение
			+ " ГДЕ ОтборКаскада.ВходитВКаскад ЕСТЬ NULL И (" + СтрСоединить(Условия, " ИЛИ ") + ")";
		Пакетная = ПакетнаяПроверкаВходящих(Группа, Чтение);
		Если Пакетная Тогда
			Запрос.Текст = ТекстПакетнойПроверки(Таблица, Отбор, Условия, ВариантыПоля);
		КонецЕсли;
		ЗамерЗапроса = Cutter3000_ЗаданияСервер.НачатьЗамер(Прогресс.Контроль,
			"Запрос входящих ссылок", Таблица.Имя, КоличествоЦелей, Запрос.Текст);
		Если Пакетная Тогда
			РезультатыПроверки = Запрос.ВыполнитьПакет();
			РезультатПроверки = РезультатыПроверки[1];
		Иначе
			РезультатПроверки = Запрос.Выполнить();
		КонецЕсли;
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(ЗамерЗапроса);
		Выборка = РезультатПроверки.Выбрать();
		Если Выборка.Следующий() Тогда
			ОтметитьУстаревшийПлан(Прогресс.Контроль.КонтекстПроверки);
			ВызватьИсключение "После планирования появилась новая входящая ссылка: " + Таблица.Имя
				+ "." + Выборка.Поле + ". Каскад отменен.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПакетнаяПроверкаВходящих(Группа, Чтение)

	Объединяемые = Неопределено;
	Если Не Чтение.Свойство("ОбъединяемыеПоля", Объединяемые) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Объединяемые.Получить(Группа[0].Ключ) <> Неопределено;

КонецФункции

Функция ТекстПакетнойПроверки(Таблица, Отбор, Условия, ВариантыПоля)

	// Сначала СУБД отбирает только ссылающиеся строки, затем сравнивает их ключи с каскадом.
	// Прикладные значения остаются в СУБД; обе стадии выполняются в транзакции удаления.
	ПроекцияКлючей = Отбор.ПроекцияВходящих;
	Если ПроекцияКлючей <> "" Тогда
		ПроекцияКлючей = ПроекцияКлючей + ", ";
	КонецЕсли;
	Возврат "ВЫБРАТЬ " + ПроекцияКлючей
		+ "ВЫБОР " + СтрСоединить(ВариантыПоля, " ") + " ИНАЧЕ """" КОНЕЦ КАК Поле"
		+ " ПОМЕСТИТЬ ВТ_ВходящиеОбрезки ИЗ " + Таблица.Имя + " КАК ИсточникОбрезки"
		+ " ГДЕ (" + СтрСоединить(Условия, " ИЛИ ") + ");"
		+ " ВЫБРАТЬ ПЕРВЫЕ 1 ВходящиеОбрезки.Поле КАК Поле"
		+ " ИЗ ВТ_ВходящиеОбрезки КАК ВходящиеОбрезки"
		+ " ЛЕВОЕ СОЕДИНЕНИЕ ОтборКаскада КАК ОтборКаскада ПО " + Отбор.СоединениеВходящих
		+ " ГДЕ ОтборКаскада.ВходитВКаскад ЕСТЬ NULL; УНИЧТОЖИТЬ ВТ_ВходящиеОбрезки";

КонецФункции

Функция ГруппыОбычныхПроверок(Поля, Чтение)

	Перем Результат, Объединяемые, Текущая, Поле, Отдельная, КоличествоЦелей;
	Результат = Новый Массив;
	Объединяемые = Новый Соответствие;
	Если Не Чтение.Свойство("ОбъединяемыеПоля", Объединяемые) Тогда
		Объединяемые = Новый Соответствие;
	КонецЕсли;
	Текущая = Неопределено;
	КоличествоЦелей = 0;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Значение.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Объединяемые.Получить(Поле.Ключ) = Истина И Поле.Значение.Количество() <= 4096 Тогда
			// Ограничение размера не дает превратить запрос большой конфигурации в огромный ИЛИ.
			Если Текущая = Неопределено Или Текущая.Количество() = 8
				Или КоличествоЦелей + Поле.Значение.Количество() > 4096 Тогда
				Текущая = Новый Массив;
				КоличествоЦелей = 0;
				Результат.Добавить(Текущая);
			КонецЕсли;
			Текущая.Добавить(Поле);
			КоличествоЦелей = КоличествоЦелей + Поле.Значение.Количество();
		Иначе
			Отдельная = Новый Массив;
			Отдельная.Добавить(Поле);
			Результат.Добавить(Отдельная);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПокрытиеРегистраторовПорции(Снимок, Кандидаты, БлокировкиУстановлены)

	Перем Результат, Пара, Узел, Вид, Регистратор, Покрытые;
	Результат = Новый Соответствие;
	Если Не БлокировкиУстановлены Или Не ТранзакцияАктивна()
		Или РежимБлокировок() <> РежимУправленияБлокировкойДанных.Управляемый Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Вид = Узел.Таблица.Вид;
		Если Вид <> "Сведения" И Вид <> "Накопление" И Вид <> "Бухгалтерия" И Вид <> "Расчет" Тогда
			Продолжить;
		КонецЕсли;
		Регистратор = Неопределено;
		Если Не Узел.Локатор.Ключи.Свойство("Регистратор", Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		Регистратор = ДекодироватьКлюч(Регистратор);
		Покрытые = Результат.Получить(Узел.Таблица.Имя);
		Если Покрытые = Неопределено Тогда
			Покрытые = Новый Соответствие;
			Результат.Вставить(Узел.Таблица.Имя, Покрытые);
		КонецЕсли;
		Если Покрытые.Получить(Регистратор) = Неопределено Тогда
			Покрытые.Вставить(Регистратор, Истина);
		КонецЕсли;
		Если Кандидаты.Получить(Пара.Ключ) = Неопределено Тогда
			Покрытые.Вставить(Регистратор, Ложь);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОбъединяемыеПоляТаблицы(Таблица)

	Перем Результат, Коллекции, Коллекция, Части, Часть, Реквизит;
	Результат = Новый Соответствие;
	Коллекции = Новый Массив;
	Если Таблица.Вид = "ТабличнаяЧасть" Тогда
		Части = СтрРазделить(Таблица.Имя, ".");
		Часть = Таблица.Описание.ТабличныеЧасти.Найти(Части[2]);
		Коллекции.Добавить(Часть.Реквизиты);
	ИначеЕсли Таблица.Вид = "Объект" Тогда
		Коллекции.Добавить(Таблица.Описание.Реквизиты);
	ИначеЕсли Таблица.Вид = "Сведения" Или Таблица.Вид = "Накопление"
		Или Таблица.Вид = "Бухгалтерия" Или Таблица.Вид = "Расчет" Тогда
		Коллекции.Добавить(Таблица.Описание.Измерения);
		Коллекции.Добавить(Таблица.Описание.Реквизиты);
		Если Таблица.Вид = "Сведения" Тогда
			Коллекции.Добавить(Таблица.Описание.Ресурсы);
		КонецЕсли;
	Иначе
		// Стандартные поля и неизвестные классы сохраняют отдельную проверку.
		Возврат Результат;
	КонецЕсли;
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Реквизит Из Коллекция Цикл
			Если Реквизит.Индексирование = Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать Тогда
				Результат.Вставить(Реквизит.Имя, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции
Функция ПодготовитьОтборКаскада(Таблица, Чтение, Узлы)

	Ключи = Чтение.Ключи;
	Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
		Ключи = СтрРазделить("Ссылка", ",");
	КонецЕсли;
	Локаторы = Новый ТаблицаЗначений;
	Проекция = Новый Массив;
	ПроекцияВходящих = Новый Массив;
	Условия = Новый Массив;
	УсловияВходящих = Новый Массив;
	ПоляЛокаторов = Новый Соответствие;
	ПоляИндекса = Новый Массив;
	Псевдоним = "ИсточникОбрезки";
	Для Каждого Ключ Из Ключи Цикл
		Типы = Чтение.Колонки.Найти(Ключ).ТипЗначения;
		// Собственные имена колонок исключают конфликт ключей со служебным маркером и псевдонимами.
		ПолеЛокатора = "КлючОбрезки" + Формат(ПоляЛокаторов.Количество() + 1, "ЧГ=0");
		ПоляЛокаторов.Вставить(Ключ, ПолеЛокатора);
		Локаторы.Колонки.Добавить(ПолеЛокатора, Типы);
		Проекция.Добавить("КандидатыОбрезки." + ПолеЛокатора);
		ПроекцияВходящих.Добавить(СтрШаблон("ИсточникОбрезки.%1 КАК %2", Ключ, ПолеЛокатора));
		Если ДопустимТипИндекса(Типы) Тогда
			ПоляИндекса.Добавить(ПолеЛокатора);
		КонецЕсли;
		Условие = Псевдоним + "." + Ключ + " = ОтборКаскада." + ПолеЛокатора;
		УсловиеВходящих = "ВходящиеОбрезки." + ПолеЛокатора + " = ОтборКаскада." + ПолеЛокатора;
		Если Типы.СодержитТип(Тип("Null")) Тогда
			Условие = "(" + Условие + " ИЛИ " + Псевдоним + "." + Ключ
				+ " ЕСТЬ NULL И ОтборКаскада." + ПолеЛокатора + " ЕСТЬ NULL)";
			УсловиеВходящих = "(" + УсловиеВходящих + " ИЛИ ВходящиеОбрезки." + ПолеЛокатора
				+ " ЕСТЬ NULL И ОтборКаскада." + ПолеЛокатора + " ЕСТЬ NULL)";
		КонецЕсли;
		Условия.Добавить(Условие);
		УсловияВходящих.Добавить(УсловиеВходящих);
	КонецЦикла;
	Локаторы.Колонки.Добавить("ВходитВКаскад", Новый ОписаниеТипов("Булево"));
	Проекция.Добавить("КандидатыОбрезки.ВходитВКаскад");
	Если Узлы <> Неопределено Тогда
		Для Каждого Узел Из Узлы Цикл
			Если Узел.Таблица.Вид <> Таблица.Вид И Таблица.Вид <> "ТабличнаяЧасть" Тогда
				Продолжить;
			КонецЕсли;
			СтрокаКлючей = Локаторы.Добавить();
			Для Каждого Ключ Из Ключи Цикл
				СтрокаКлючей[ПоляЛокаторов[Ключ]] = ДекодироватьКлюч(Узел.Локатор.Ключи[Ключ]);
			КонецЦикла;
			СтрокаКлючей.ВходитВКаскад = Истина;
		КонецЦикла;
	КонецЕсли;
	Соединение = "ИСТИНА";
	Если Условия.Количество() > 0 Тогда
		Соединение = СтрСоединить(Условия, " И ");
	КонецЕсли;
	Временные = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Временные;
	Попытка
		Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(Проекция, ", ")
			+ " ПОМЕСТИТЬ ОтборКаскада ИЗ &Кандидаты КАК КандидатыОбрезки";
		// Индекс ускоряет соединение, но полное сравнение ключей ниже от его состава не зависит.
		Если ПоляИндекса.Количество() > 0 Тогда
			Запрос.Текст = Запрос.Текст + " ИНДЕКСИРОВАТЬ ПО " + СтрСоединить(ПоляИндекса, ", ");
		КонецЕсли;
		Запрос.УстановитьПараметр("Кандидаты", Локаторы);
		Запрос.Выполнить();
	Исключение
		Временные.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	СоединениеВходящих = "ИСТИНА";
	Если УсловияВходящих.Количество() > 0 Тогда
		СоединениеВходящих = СтрСоединить(УсловияВходящих, " И ");
	КонецЕсли;
	Возврат Новый Структура("Временные,Соединение,ПроекцияВходящих,СоединениеВходящих",
		Временные, Соединение, СтрСоединить(ПроекцияВходящих, ", "), СоединениеВходящих);

КонецФункции
Функция ДопустимТипИндекса(Типы)

	СоставТипов = Типы.Типы();
	ИндексNull = СоставТипов.Найти(Тип("Null"));
	Если ИндексNull <> Неопределено Тогда
		СоставТипов.Удалить(ИндексNull);
	КонецЕсли;
	Если СоставТипов.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипПоля = СоставТипов[0];
	Если ТипПоля = Тип("Строка") Тогда
		Возврат Типы.КвалификаторыСтроки.Длина > 0;
	КонецЕсли;
	Возврат ТипПоля = Тип("Число") Или ТипПоля = Тип("Дата") Или ТипПоля = Тип("Булево")
		Или Метаданные.НайтиПоТипу(ТипПоля) <> Неопределено;

КонецФункции

Процедура ПроверитьОсобыеВходящие(Контекст, Ссылки, Группы, Кандидаты, Прогресс)

	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Цели = Новый Соответствие;
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		Цели.Вставить(КлючСсылки(СсылкаОбъекта), Истина);
	КонецЦикла;
	Особые = НовыйСнимок(Контекст.Каталог);
	КонтекстЧтения = КонтекстКонтроляКаскадов(Контекст);
	// Текущую транзакцию удаления завершаем даже после запроса остановки.
	КонтекстЧтения.Вставить("Запуск", "");
	Работы = Новый Массив;
	Для Каждого Таблица Из Контекст.НепрозрачныеТаблицы Цикл
		СообщитьЭтапУдаления(Прогресс.Запуск, Прогресс.Задание,
			"Проверка входящих ссылок: " + Таблица.Имя + "; МоментВремени", 0, Прогресс.Контроль);
		Работы.Очистить();
		ДобавитьЧтениеВолны(Работы, Таблица,
			Новый Структура("Условие,Параметры,Цели", "ИСТИНА", Неопределено, Цели));
		ВыполнитьЧтенияВолны(КонтекстЧтения, Особые, Работы);
	КонецЦикла;
	Для Каждого Описание Из Метаданные.Константы Цикл
		Если КонстантаПодходитВолне(Описание, Группы) Тогда
			СообщитьЭтапУдаления(Прогресс.Запуск, Прогресс.Задание,
				"Проверка входящих ссылок: " + Описание.ПолноеИмя(), 0, Прогресс.Контроль);
			ДобавитьОднуКонстанту(Особые, Описание);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Пара Из Особые.Узлы Цикл
		Для Каждого СсылкаУзла Из Пара.Значение.Ссылки Цикл
			Если Цели.Получить(СсылкаУзла.Ключ) <> Неопределено
				И Кандидаты.Получить(Пара.Ключ) = Неопределено Тогда
				ОтметитьУстаревшийПлан(Контекст);
				ВызватьИсключение "После планирования появилась новая входящая ссылка: "
					+ Пара.Значение.Таблица.Имя + ". Каскад отменен.";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНайденныеКаскада(Снимок, Кандидаты, Найденные, Контекст = Неопределено)

	Для Каждого Найденная Из Найденные Цикл
		Если ПокрытаЗависимостьРегистратора(Снимок, Кандидаты, Найденная) Тогда
			Продолжить;
		КонецЕсли;
		Цель = КлючСсылки(Найденная[0]);
		Описание = МетаданныеСсылки(Найденная[1]);
		Если Описание <> Неопределено И Кандидаты.Получить(КлючСсылки(Найденная[1])) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Покрыта = Ложь;
		Для Каждого Пара Из Снимок.Узлы Цикл
			Узел = Пара.Значение;
			Если Узел.Таблица.Корень <> Найденная[2].ПолноеИмя()
				И Узел.Таблица.Имя <> Найденная[2].ПолноеИмя() Тогда
				Продолжить;
			КонецЕсли;
			Если Узел.Ссылки.Получить(Цель) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Описание = Неопределено Тогда
				Покрыта = Истина;
			ИначеЕсли Узел.Таблица.Вид <> "Объект" И Узел.Таблица.Вид <> "ТабличнаяЧасть" Тогда
				Регистратор = Неопределено;
				Если Узел.Локатор.Ключи.Свойство("Регистратор", Регистратор) Тогда
					Покрыта = ДекодироватьКлюч(Регистратор) = Найденная[1];
				КонецЕсли;
			КонецЕсли;
			Если Покрыта Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Покрыта Тогда
			ОтметитьУстаревшийПлан(Контекст);
			ВызватьИсключение "Платформенный поиск обнаружил зависимость вне каскада: "
				+ Найденная[2].ПолноеИмя();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПокрытаЗависимостьРегистратора(Снимок, Кандидаты, Найденная)

	// НайтиПоСсылкам может свернуть запись подчиненного регистра до документа-регистратора.
	// Достаточно удаления конкретной зависимой записи, сам регистратор может сохраняться.
	Если МетаданныеСсылки(Найденная[1]) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Владельцы = Снимок.Входящие.Получить(КлючСсылки(Найденная[0]));
	Если Владельцы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Пара Из Владельцы Цикл
		Узел = Снимок.Узлы[Пара.Ключ];
		Если Кандидаты.Получить(Пара.Ключ) = Неопределено
			Или Узел.Таблица.Вид = "Объект" Или Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Продолжить;
		КонецЕсли;
		Регистратор = Неопределено;
		Если Узел.Локатор.Ключи.Свойство("Регистратор", Регистратор)
			И ДекодироватьКлюч(Регистратор) = Найденная[1] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ПодготовитьОписанияКаскадов(Контекст)

	Контекст.Вставить("ПолныеЧтения", Новый Соответствие);
	Для Каждого Таблица Из Контекст.Каталог Цикл
		Чтение = ОписаниеЧтения(Таблица, Истина);
		Чтение.Вставить("ОбъединяемыеПоля", ОбъединяемыеПоляТаблицы(Таблица));
		Контекст.Чтения.Вставить(Таблица.Имя, Чтение);
		Контекст.ПолныеЧтения.Вставить(Таблица.Имя, ОписаниеЧтения(Таблица, Ложь, Чтение.Колонки));
	КонецЦикла;
	ПодготовитьКартуВходящих(Контекст);

КонецПроцедуры

Процедура ПодготовитьКартуВходящих(Контекст)

	Контекст.Вставить("КартаВходящих", Новый Соответствие);
	Контекст.Вставить("ТаблицыВладельцев", Новый Соответствие);
	Контекст.Вставить("ТаблицыПоИменам", Новый Соответствие);
	Контекст.Вставить("ТаблицыПоКорню", Новый Соответствие);
	Контекст.Вставить("НепрозрачныеТаблицы", Новый Массив);
	Контекст.Вставить("НепрозрачныеПоИменам", Новый Соответствие);
	Для Каждого Таблица Из Контекст.Каталог Цикл
		Контекст.ТаблицыПоИменам.Вставить(Таблица.Имя, Таблица);
		ТаблицыКорня = Контекст.ТаблицыПоКорню.Получить(Таблица.Корень);
		Если ТаблицыКорня = Неопределено Тогда
			ТаблицыКорня = Новый Массив;
			Контекст.ТаблицыПоКорню.Вставить(Таблица.Корень, ТаблицыКорня);
		КонецЕсли;
		ТаблицыКорня.Добавить(Таблица);
		Если Таблица.Вид = "Объект" Или Таблица.Вид = "ТабличнаяЧасть" Тогда
			Владельцы = Контекст.ТаблицыВладельцев.Получить(Таблица.Корень);
			Если Владельцы = Неопределено Тогда
				Владельцы = Новый Массив;
				Контекст.ТаблицыВладельцев.Вставить(Таблица.Корень, Владельцы);
			КонецЕсли;
			Владельцы.Добавить(Таблица);
		КонецЕсли;
		Непрозрачная = Ложь;
		Для Каждого Колонка Из Контекст.Чтения[Таблица.Имя].Колонки Цикл
			Если Таблица.Вид = "Объект" И Колонка.Имя = "Ссылка" Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ТипПоля Из Колонка.ТипЗначения.Типы() Цикл
				Если ТипПоля = Тип("МоментВремени") Тогда
					Непрозрачная = Истина;
					Продолжить;
				КонецЕсли;
				Описание = Метаданные.НайтиПоТипу(ТипПоля);
				Если Описание <> Неопределено И Не СтрНачинаетсяС(Описание.ПолноеИмя(), "Перечисление.") Тогда
					ДобавитьПолеКарты(Контекст.КартаВходящих, Описание.ПолноеИмя(), Таблица.Имя, Колонка.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если Непрозрачная Тогда
			Контекст.НепрозрачныеТаблицы.Добавить(Таблица);
			Контекст.НепрозрачныеПоИменам.Вставить(Таблица.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеКарты(Карта, Цель, ИмяТаблицы, ИмяПоля)

	Таблицы = Карта.Получить(Цель);
	Если Таблицы = Неопределено Тогда
		Таблицы = Новый Соответствие;
		Карта.Вставить(Цель, Таблицы);
	КонецЕсли;
	Поля = Таблицы.Получить(ИмяТаблицы);
	Если Поля = Неопределено Тогда
		Поля = Новый Соответствие;
		Таблицы.Вставить(ИмяТаблицы, Поля);
	КонецЕсли;
	Поля.Вставить(ИмяПоля, Истина);

КонецПроцедуры

Функция ГруппыТиповЦелей(Ссылки)

	Группы = Новый Соответствие;
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		Описание = МетаданныеСсылки(СсылкаОбъекта);
		Имя = Описание.ПолноеИмя();
		Группа = Группы.Получить(Имя);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Имя, Группа);
		КонецЕсли;
		Группа.Добавить(СсылкаОбъекта);
	КонецЦикла;
	Возврат Группы;

КонецФункции

Функция ПоляВходящихВолны(Контекст, Группы)

	Результат = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Таблицы = Контекст.КартаВходящих.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Таблица Из Таблицы Цикл
			Поля = Результат.Получить(Таблица.Ключ);
			Если Поля = Неопределено Тогда
				Поля = Новый Соответствие;
				Результат.Вставить(Таблица.Ключ, Поля);
			КонецЕсли;
			ДополнитьЦелиПолейВолны(Поля, Таблица.Значение, Группа.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДополнитьЦелиПолейВолны(Поля, ИменаПолей, СсылкиТипа)

	Для Каждого Поле Из ИменаПолей Цикл
		СсылкиПоля = Поля.Получить(Поле.Ключ);
		Если СсылкиПоля = Неопределено Тогда
			// Массив одного типа используется совместно, без копии для каждого поля конфигурации.
			Поля.Вставить(Поле.Ключ, СсылкиТипа);
			Продолжить;
		КонецЕсли;
		Объединенные = Новый Массив;
		Для Каждого Ссылка Из СсылкиПоля Цикл
			Объединенные.Добавить(Ссылка);
		КонецЦикла;
		Для Каждого Ссылка Из СсылкиТипа Цикл
			Объединенные.Добавить(Ссылка);
		КонецЦикла;
		Поля.Вставить(Поле.Ключ, Объединенные);
	КонецЦикла;

КонецПроцедуры

Функция ГруппыЧтенияВолны(Таблица, Чтение, Поля)

	Объединяемые = Неопределено;
	Если Не Чтение.Свойство("ОбъединяемыеПоляВолны", Объединяемые) Тогда
		Объединяемые = ОбъединяемыеПоляТаблицы(Таблица);
		// Ключ может входить в составной индекс, даже если отдельный индекс не задан.
		Для Каждого Ключ Из Чтение.Ключи Цикл
			Объединяемые.Удалить(Ключ);
		КонецЦикла;
		Чтение.Вставить("ОбъединяемыеПоляВолны", Объединяемые);
	КонецЕсли;
	// Общие пределы: до восьми неиндексированных полей и 4096 целей на запрос.
	Возврат ГруппыОбычныхПроверок(Поля, Новый Структура("ОбъединяемыеПоля", Объединяемые));

КонецФункции

Процедура ОпределитьРаботыКаскадов(Контекст)

	Представители = Новый Соответствие;
	Для Каждого Таблица Из Контекст.Каталог Цикл
		Если ПолеПериода(Таблица) = "" Тогда
			Продолжить;
		КонецЕсли;
		Группа = Представители.Получить(Таблица.Корень);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Представители.Вставить(Таблица.Корень, Группа);
		КонецЕсли;
		Группа.Добавить(Новый Структура("Метаданные,Вид", Таблица.Корень, Таблица.Вид));
	КонецЦикла;
	Для Каждого Пара Из Представители Цикл
		Полосы = Новый Массив;
		Для Номер = 1 По Контекст.КоличествоПотоков Цикл
			Идентификатор = Лев(ХешКлюча(Пара.Ключ + "|" + Строка(Номер)), 36);
			Наименование = ИмяРаботы(Пара.Значение);
			Если Контекст.КоличествоПотоков > 1 Тогда
				Наименование = Наименование + СтрШаблон(" (поток %1)", Номер);
			КонецЕсли;
			Полосы.Добавить(Идентификатор);
			Контекст.Работы.Добавить(Новый Структура("Идентификатор,Наименование,Всего",
				Идентификатор, Наименование, 0));
		КонецЦикла;
		Контекст.ПолосыРабот.Вставить(Пара.Ключ, Полосы);
		Контекст.КартаРабот.Вставить(Пара.Ключ, Полосы[0]);
	КонецЦикла;

КонецПроцедуры

Функция ПоколениеДанныхКаскадов(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Состояния.Обработано), 0) КАК Поколение
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Запуск = &Запуск И Состояния.Задание <> &Заголовок");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Поколение;

КонецФункции

Процедура ОбновитьПоколениеКеша(Контекст)

	Поколение = ПоколениеДанныхКаскадов(Контекст.Запуск);
	Если Поколение = Контекст.ПоколениеКеша Тогда
		Возврат;
	КонецЕсли;
	// Любая фиксация могла вызвать неизвестный обработчик. Частичная инвалидация небезопасна.
	Для Каждого Пара Из Контекст.КешХранилищ Цикл
		ОчиститьИндексКаскадов(Пара.Значение);
	КонецЦикла;
	Контекст.КешХранилищ.Очистить();
	Контекст.КешКонстант.Очистить();
	Контекст.ПоколениеКеша = Поколение;

КонецПроцедуры

Процедура ОчиститьКешЗапуска(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Узлы.Запуск КАК Кеш
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Вид В (&Виды) И Узлы.Метаданные = &Запуск");
	Запрос.УстановитьПараметр("Виды", СтрРазделить("КешХранилищ,ЧерновикКаскада", ","));
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОчиститьИндексКаскадов(Выборка.Кеш);
	КонецЦикла;

КонецПроцедуры

Процедура СохранитьСтраницуКеша(Снимок, Запуск, Кеш)

	Узлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
	Связи = РегистрыСведений.Cutter3000_Связи.СоздатьНаборЗаписей();
	Для Каждого Пара Из Снимок.Узлы Цикл
		Узел = Пара.Значение;
		Если Узел.Ссылки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ХешКлюча(Пара.Ключ);
		Данные = Новый Структура("Ключ,Таблица,Локатор,Единица,Поля,Ресурс", Узел.Ключ,
			Узел.Таблица.Имя, Узел.Локатор, Узел.Единица, Узел.Поля, Узел.Ресурс);
		Запись = Узлы.Добавить();
		Запись.Запуск = Кеш;
		Запись.Узел = Ключ;
		Запись.Вид = "КешХранилищ";
		Запись.Метаданные = Запуск;
		Запись.Локатор = ЗначениеВСтрокуВнутр(Данные);
		Для Каждого СсылкаУзла Из Узел.Ссылки Цикл
			Запись = Связи.Добавить();
			Запись.Запуск = Кеш;
			Запись.Цель = ХешКлюча(СсылкаУзла.Ключ);
			Запись.УзелИсточник = Ключ;
			Запись.Вхождение = 0;
			Запись.ЛокаторЦели = СсылкаУзла.Ключ;
		КонецЦикла;
	КонецЦикла;
	Если Узлы.Количество() > 0 Тогда
		// Владелец ТЧ может встретиться на разных страницах; ссылки всех строк сохраняются отдельно.
		Узлы.Записать(РежимЗамещения.Слияние);
		Связи.Записать(РежимЗамещения.Слияние);
	КонецЕсли;

КонецПроцедуры

Процедура НайтиКешированныеВходящие(Контекст, Снимок, Кеш, Цели)

	Ключи = Новый Массив;
	Для Каждого Цель Из Цели Цикл
		Ключи.Добавить(ХешКлюча(Цель.Ключ));
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2000 Связи.УзелИсточник КАК Узел
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		|ГДЕ Связи.Запуск = &Кеш И Связи.Цель В (&Цели) И Связи.УзелИсточник > &После
		|УПОРЯДОЧИТЬ ПО Узел");
	Запрос.УстановитьПараметр("Кеш", Кеш);
	Запрос.УстановитьПараметр("Цели", Ключи);
	Последний = "";
	Пока Истина Цикл
		Результат = ПрочитатьСтраницуКеша(Запрос, Последний);
		Выборка = Результат.Выбрать();
		Владельцы = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Владельцы.Добавить(Выборка.Узел);
			Последний = Выборка.Узел;
		КонецЦикла;
		Если Владельцы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ДобавитьВладельцевКеша(Контекст, Снимок, Кеш, Владельцы);
		Если Владельцы.Количество() < РазмерПорции() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьСтраницуКеша(Запрос, После)

	// Запрос уже содержит все цели волны; курсор ограничивает страницу владельцев, а не отдельную ссылку.
	Запрос.УстановитьПараметр("После", После);
	Возврат Запрос.Выполнить();

КонецФункции

Процедура ДобавитьВладельцевКеша(Контекст, Снимок, Кеш, Владельцы)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Узлы.Узел КАК Ключ, Узлы.Локатор КАК Данные, Связи.ЛокаторЦели КАК Цель
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Связи КАК Связи
		| ПО Узлы.Запуск = Связи.Запуск И Узлы.Узел = Связи.УзелИсточник
		|ГДЕ Узлы.Запуск = &Кеш И Узлы.Узел В (&Владельцы)");
	Запрос.УстановитьПараметр("Кеш", Кеш);
	Запрос.УстановитьПараметр("Владельцы", Владельцы);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПоКлючам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Узел = ПоКлючам.Получить(Выборка.Ключ);
		Если Узел = Неопределено Тогда
			Узел = ЗначениеИзСтрокиВнутр(Выборка.Данные);
			Узел.Таблица = Контекст.ТаблицыПоИменам[Узел.Таблица];
			Узел.Вставить("Ссылки", Новый Соответствие);
			ПоКлючам.Вставить(Выборка.Ключ, Узел);
		КонецЕсли;
		Узел.Ссылки.Вставить(Выборка.Цель, Истина);
	КонецЦикла;
	Для Каждого Пара Из ПоКлючам Цикл
		Узел = Пара.Значение;
		СсылкаОбъекта = Неопределено;
		Если Узел.Таблица.Вид = "Объект" Или Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Локатор = ЗначениеИзСтрокиВнутр(Узел.Ключ);
			СсылкаОбъекта = ДекодироватьКлюч(Локатор);
		КонецЕсли;
		СлитьУзелКаскада(Снимок, Узел, СсылкаОбъекта);
	КонецЦикла;

КонецПроцедуры

Функция КонстантаПодходитВолне(Описание, Группы)

	Для Каждого ТипПоля Из Описание.Тип.Типы() Цикл
		Если ТипПоля = Тип("МоментВремени") Тогда
			Возврат Истина;
		КонецЕсли;
		ОписаниеЦели = Метаданные.НайтиПоТипу(ТипПоля);
		Если ОписаниеЦели <> Неопределено И Группы.Получить(ОписаниеЦели.ПолноеИмя()) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПодготовитьКаскады(Контекст, Семена, Задание)

	Поколение = Контекст.ПоколениеКеша;
	Снимок = НовыйСнимок(Контекст.Каталог);
	Снимок.Вставить("Индекс", "");
	Снимок.Вставить("Обработанные", Новый Соответствие);
	Снимок.Вставить("ОбъемГрафа", 0);
	Снимок.Вставить("Всего", 0);
	Снимок.Вставить("Стоимость", 0);
	Для Каждого Пара Из Семена.Узлы Цикл
		СлитьУзелКаскада(Снимок, Пара.Значение, Семена.Ссылки.Получить(Пара.Ключ));
	КонецЦикла;
	ПеренестиГрафКаскада(Контекст, Снимок);
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);
		СообщитьПодготовку(Контекст.Прогресс, "Поиск следующей порции ссылок графа");
		Волна = СледующаяВолнаГрафа(Снимок);
		Цели = Новый Соответствие;
		Для Каждого Ссылка Из Волна Цикл
			Цели.Вставить(КлючСсылки(Ссылка), Истина);
		КонецЦикла;
		Если Волна.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ПрочитатьВладельцевКаскада(Контекст, Снимок, Волна);
		НайтиВходящиеКаскада(Контекст, Снимок, Волна, Цели);
		ПеренестиГрафКаскада(Контекст, Снимок);
	КонецЦикла;
	Если Снимок.Индекс = "" Тогда
		Снимок.Всего = Снимок.Узлы.Количество();
		Снимок.Стоимость = СтоимостьКаскада(Контекст, Снимок);
		Пересечения = ПересекающиесяЗаданияКаскадов(Контекст.Запуск, Снимок);
	Иначе
		Пересечения = ПересеченияГрафаИндекса(Контекст.Запуск, Снимок.Индекс, Контекст.Прогресс);
	КонецЕсли;
	Возврат Новый Структура("Семена,Снимок,Задание,Пересечение,Поколение,ПересекающиесяЗадания,Стоимость,Всего",
		Семена, Снимок, Задание, Пересечения.Количество() > 0, Поколение, Пересечения,
		Снимок.Стоимость, Снимок.Всего);

КонецФункции

Функция ОценкиВходящихКорней(Контекст)

	Результат = Новый Соответствие;
	Для Каждого Корень Из Контекст.КартаВходящих Цикл
		Стоимость = 1;
		Для Каждого Таблица Из Корень.Значение Цикл
			Объединяемые = Контекст.Чтения[Таблица.Ключ].ОбъединяемыеПоля;
			Для Каждого Поле Из Таблица.Значение Цикл
				Вес = 1;
				Если Объединяемые.Получить(Поле.Ключ) <> Неопределено Тогда
					Вес = 4;
				КонецЕсли;
				Стоимость = Стоимость + Вес;
			КонецЦикла;
		КонецЦикла;
		Результат.Вставить(Корень.Ключ, Стоимость);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПорядокКандидатов(Каталог, Оценки)

	Очередь = Новый ТаблицаЗначений;
	Очередь.Колонки.Добавить("Таблица");
	Очередь.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	Очередь.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Для Каждого Таблица Из Каталог Цикл
		СтрокаОчереди = Очередь.Добавить();
		СтрокаОчереди.Таблица = Таблица;
		СтрокаОчереди.Номер = Очередь.Количество();
		СтрокаОчереди.Стоимость = 1;
		Оценка = Оценки.Получить(Таблица.Корень);
		Если Оценка <> Неопределено Тогда
			СтрокаОчереди.Стоимость = Оценка;
		КонецЕсли;
	КонецЦикла;
	Очередь.Сортировать("Стоимость Убыв, Номер");
	Возврат Очередь.ВыгрузитьКолонку("Таблица");

КонецФункции

Функция СтоимостьКаскада(Контекст, Снимок)

	Стоимость = Снимок.Узлы.Количество();
	Для Каждого Пара Из Снимок.Узлы Цикл
		Оценка = Контекст.ОценкиКорней.Получить(Пара.Значение.Таблица.Корень);
		Если Оценка <> Неопределено Тогда
			Стоимость = Стоимость + Оценка;
		КонецЕсли;
	КонецЦикла;
	Возврат Стоимость;

КонецФункции

Процедура СлитьУзелКаскада(Снимок, Узел, СсылкаОбъекта = Неопределено)

	Существующий = Снимок.Узлы.Получить(Узел.Ключ);
	Если Снимок.Свойство("ОбъемГрафа") Тогда
		Если Существующий = Неопределено Тогда
			Снимок.ОбъемГрафа = Снимок.ОбъемГрафа + 2048
				+ 4 * СтрДлина(Узел.Ключ) + 2 * СтрДлина(Узел.Единица);
		КонецЕсли;
		// Оценка консервативная: повторные страницы могут вызвать более ранний перенос.
		Для Каждого Ребро Из Узел.Ссылки Цикл
			Снимок.ОбъемГрафа = Снимок.ОбъемГрафа + 512 + 2 * СтрДлина(Ребро.Ключ);
		КонецЦикла;
	КонецЕсли;
	Если Существующий <> Неопределено Тогда
		Если Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
			Для Каждого Пара Из Узел.Ссылки Цикл
				Существующий.Ссылки.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
			Узел = Существующий;
		Иначе
			Для Каждого Пара Из Существующий.Ссылки Цикл
				Узел.Ссылки.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Снимок.Узлы.Вставить(Узел.Ключ, Узел);
	Если СсылкаОбъекта <> Неопределено Тогда
		Снимок.Ссылки.Вставить(Узел.Ключ, СсылкаОбъекта);
	КонецЕсли;
	Если Снимок.Свойство("Обработанные") Тогда
		// При подготовке обратный граф не нужен; он читается из индекса перед удалением.
		Возврат;
	КонецЕсли;
	Для Каждого Пара Из Узел.Ссылки Цикл
		Входящие = Снимок.Входящие.Получить(Пара.Ключ);
		Если Входящие = Неопределено Тогда
			Входящие = Новый Соответствие;
			Снимок.Входящие.Вставить(Пара.Ключ, Входящие);
		КонецЕсли;
		Входящие.Вставить(Узел.Ключ, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьВладельцевКаскада(Контекст, Снимок, Ссылки)

	Работы = Новый Массив;
	Для Каждого Группа Из ГруппыТиповЦелей(Ссылки) Цикл
		Таблицы = Контекст.ТаблицыВладельцев.Получить(Группа.Ключ);
		Если Таблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Таблица Из Таблицы Цикл
			Чтение = Контекст.Чтения[Таблица.Имя];
			ДобавитьЧтениеВолны(Работы, Таблица,
				Новый Структура("Условие,Параметры,Цели",
					СтрШаблон("%1.Ссылка В (&Ссылки)", Чтение.Псевдоним),
					Новый Структура("Ссылки", Группа.Значение), Неопределено));
		КонецЦикла;
	КонецЦикла;
	ВыполнитьЧтенияВолны(Контекст, Снимок, Работы);

КонецПроцедуры

Процедура НайтиВходящиеКаскада(Контекст, Снимок, Ссылки, Цели)

	Если Не Контекст.Свойство("КартаВходящих") Тогда
		ПодготовитьКартуВходящих(Контекст);
	КонецЕсли;
	Если Контекст.Свойство("КешХранилищ") Тогда
		ОбновитьПоколениеКеша(Контекст);
	КонецЕсли;
	Группы = ГруппыТиповЦелей(Ссылки);
	Поля = ПоляВходящихВолны(Контекст, Группы);
	Работы = Новый Массив;
	Для Каждого Пара Из Поля Цикл
		Таблица = Контекст.ТаблицыПоИменам[Пара.Ключ];
		Если Контекст.НепрозрачныеПоИменам.Получить(Таблица.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Чтение = Контекст.Чтения[Таблица.Имя];
		Для Каждого Группа Из ГруппыЧтенияВолны(Таблица, Чтение, Пара.Значение) Цикл
			Условия = Новый Массив;
			Параметры = Новый Структура;
			Для Каждого Поле Из Группа Цикл
				ИмяПараметра = "СсылкиВолны" + Формат(Условия.Количество() + 1, "ЧГ=0");
				Условия.Добавить(СтрШаблон("%1.%2 В (&%3)", Чтение.Псевдоним, Поле.Ключ, ИмяПараметра));
				Параметры.Вставить(ИмяПараметра, Поле.Значение);
			КонецЦикла;
			// Индексированные поля читаются отдельно; остальные не требуют повторного обхода таблицы.
			// Скобки сохраняют отбор при добавлении условия продолжения страницы.
			ДобавитьЧтениеВолны(Работы, Таблица,
				Новый Структура("Условие,Параметры,Цели",
					"(" + СтрСоединить(Условия, " ИЛИ ") + ")", Параметры, Цели));
		КонецЦикла;
	КонецЦикла;
	Для Каждого Таблица Из Контекст.НепрозрачныеТаблицы Цикл
		Если Контекст.Свойство("КешХранилищ") Тогда
			Кеш = Контекст.КешХранилищ.Получить(Таблица.Имя);
			Если Кеш = Неопределено Тогда
				ДобавитьЧтениеВолны(Работы, Таблица,
					Новый Структура("Условие,Параметры,Цели", "ИСТИНА", Неопределено, Цели),
					Строка(Новый УникальныйИдентификатор));
			Иначе
				НайтиКешированныеВходящие(Контекст, Снимок, Кеш, Цели);
			КонецЕсли;
		Иначе
			ДобавитьЧтениеВолны(Работы, Таблица,
				Новый Структура("Условие,Параметры,Цели", "ИСТИНА", Неопределено, Цели));
		КонецЕсли;
	КонецЦикла;
	ВыполнитьЧтенияВолны(Контекст, Снимок, Работы);
	Для Каждого Описание Из Метаданные.Константы Цикл
		Если Не КонстантаПодходитВолне(Описание, Группы) Тогда
			Продолжить;
		КонецЕсли;
		Страница = НовыйСнимок(Контекст.Каталог);
		Если Контекст.Свойство("КешКонстант") Тогда
			УзелКонстанты = Контекст.КешКонстант.Получить(Описание.Имя);
			Если УзелКонстанты = Неопределено Тогда
				ДобавитьОднуКонстанту(Страница, Описание);
				Для Каждого Пара Из Страница.Узлы Цикл
					УзелКонстанты = Пара.Значение;
					УзелКонстанты.Поля = Новый Структура;
				КонецЦикла;
				Контекст.КешКонстант.Вставить(Описание.Имя, УзелКонстанты);
			КонецЕсли;
			Страница.Узлы.Вставить(УзелКонстанты.Ключ, УзелКонстанты);
		Иначе
			ДобавитьОднуКонстанту(Страница, Описание);
		КонецЕсли;
		Для Каждого Пара Из Страница.Узлы Цикл
			Для Каждого СсылкаУзла Из Пара.Значение.Ссылки Цикл
				Если Цели.Получить(СсылкаУзла.Ключ) <> Неопределено Тогда
					// Константа связывает компоненту, но отказ относится только к этой компоненте.
					СлитьУзелКаскада(Снимок, Пара.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЧтениеВолны(Работы, Таблица, Отбор, Кеш = "")

	Работа = Новый Структура("Таблица,Условие,Параметры,Цели,Последний,Кеш",
		Таблица.Имя, Отбор.Условие, Отбор.Параметры, Отбор.Цели, Неопределено, Кеш);
	Работы.Добавить(Работа);

КонецПроцедуры

Процедура ВыполнитьЧтенияВолны(Контекст, Снимок, Работы)

	Если Не Контекст.Свойство("Читатели") Тогда
		Для Каждого Работа Из Работы Цикл
			Пока Истина Цикл
				Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Запрос страницы %1; отбор: %2", Работа.Таблица, Работа.Условие));
				Страница = ПрочитатьСтраницуРаботника(Контекст, Работа);
				ПринятьСтраницуВолны(Контекст, Снимок, Работа, Страница);
				Завершено = Страница.Завершено;
				Страница = Неопределено;
				Если Завершено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);
	ЧитателиВолны = Cutter3000_ЗаданияСервер.СлотыЧтенияПула(Контекст);
	Контекст.Вставить("ЧтениеПула", Истина);
	Попытка
		ВыполнитьПулЧтенийВолны(Контекст, Снимок, Работы, ЧитателиВолны);
	Исключение
		Контекст.Удалить("ЧтениеПула");
		ВызватьИсключение;
	КонецПопытки;
	Контекст.Удалить("ЧтениеПула");

КонецПроцедуры

Процедура ВыполнитьПулЧтенийВолны(Контекст, Снимок, Работы, ЧитателиВолны)

	Следующая = 0;
	Занятые = Новый Соответствие;
	Пока Следующая < Работы.Количество() Или Занятые.Количество() > 0 Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);
		ЕстьОтвет = Ложь;
		Для Каждого Слот Из ЧитателиВолны Цикл
			Если Слот.Задание <> "" Тогда
				Продолжить;
			КонецЕсли;
			Пакет = Занятые.Получить(Слот.Идентификатор);
			Если Пакет <> Неопределено Тогда
				Ответ = Cutter3000_ЗаданияСервер.ПолучитьРезультатПула(Слот);
				Если Ответ = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЕстьОтвет = Истина;
				Пакет = ПринятьПакетВолны(Контекст, Снимок, Пакет, Ответ.Результат);
				Ответ = Неопределено;
				Слот.Вставить("ЧтениеВолны", Ложь);
				Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);
				Если Слот.Задание <> "" Тогда
					// Курсоры приняты; оставшиеся страницы подхватит другой читатель.
					Для Каждого Работа Из Пакет Цикл
						Работы.Добавить(Работа);
					КонецЦикла;
					Занятые.Удалить(Слот.Идентификатор);
					Продолжить;
				КонецЕсли;
			Иначе
				Пакет = Новый Массив;
			КонецЕсли;
			Пока Пакет.Количество() < ПределПакетаЧтения() И Следующая < Работы.Количество() Цикл
				Пакет.Добавить(Работы[Следующая]);
				Следующая = Следующая + 1;
			КонецЦикла;
			Если Пакет.Количество() > 0 Тогда
				Занятые.Вставить(Слот.Идентификатор, Пакет);
				Данные = ПараметрыПакетаЧтения(Пакет);
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Пакет чтения: таблиц %1; первая %2", Пакет.Количество(), Пакет[0].Таблица));
				Слот.Вставить("ЧтениеВолны", Истина);
				Cutter3000_ЗаданияСервер.ОтправитьКомандуПула(Слот, "Чтение", Данные);
			Иначе
				Занятые.Удалить(Слот.Идентификатор);
				Слот.Вставить("ЧтениеВолны", Ложь);
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьОтвет И Занятые.Количество() > 0 Тогда
			ТаблицыОжидания = Новый Массив;
			Для Каждого Пара Из Занятые Цикл
				Для Каждого Работа Из Пара.Значение Цикл
					ТаблицыОжидания.Добавить(Работа.Таблица);
				КонецЦикла;
			КонецЦикла;
			СообщитьПодготовку(Контекст.Прогресс, "Ожидание страниц: " + СтрСоединить(ТаблицыОжидания, ", "));
			ЧитателиВолны[0].Фоновое.ОжидатьЗавершенияВыполнения(0.1);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПараметрыПакетаЧтения(Пакет)

	Результат = Новый Массив;
	Для Каждого Работа Из Пакет Цикл
		// Цели и кеш остаются у координатора; передаются только параметры ограниченного пакета.
		Результат.Добавить(Новый Структура("Таблица,Условие,Параметры,Последний",
			Работа.Таблица, Работа.Условие, Работа.Параметры, Работа.Последний));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПринятьПакетВолны(Контекст, Снимок, Пакет, Страницы)

	Завершенные = Новый Соответствие;
	Для Каждого Ответ Из Страницы Цикл
		Работа = Пакет[Ответ.НомерРаботы];
		ПринятьСтраницуВолны(Контекст, Снимок, Работа, Ответ.Страница);
		Если Ответ.Страница.Завершено Тогда
			Завершенные.Вставить(Ответ.НомерРаботы, Истина);
		КонецЕсли;
	КонецЦикла;
	Продолжение = Новый Массив;
	Для Индекс = 0 По Пакет.Количество() - 1 Цикл
		Если Завершенные.Получить(Индекс) = Неопределено Тогда
			Продолжение.Добавить(Пакет[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат Продолжение;

КонецФункции

Процедура ПринятьСтраницуВолны(Контекст, Снимок, Работа, Страница)

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Для Каждого Пара Из Страница.Узлы Цикл
		Узел = Пара.Значение;
		Узел.Таблица = Контекст.ТаблицыПоИменам[Узел.Таблица];
	КонецЦикла;
	Для Индекс = 1 По Страница.Прочитано Цикл
		ОтметитьЧтение(Контекст.Прогресс, Работа.Таблица);
	КонецЦикла;
	Если Работа.Кеш <> "" Тогда
		СохранитьСтраницуКеша(Страница, Контекст.Запуск, Работа.Кеш);
		Если Страница.Завершено Тогда
			Контекст.КешХранилищ.Вставить(Работа.Таблица, Работа.Кеш);
		КонецЕсли;
	КонецЕсли;
	СлитьСтраницуВолны(Снимок, Страница, Работа.Цели);
	Если Снимок.Свойство("Индекс") Тогда
		ПеренестиГрафКаскада(Контекст, Снимок);
	КонецЕсли;
	Работа.Последний = Страница.Последний;

КонецПроцедуры

Процедура СлитьСтраницуВолны(Снимок, Страница, Цели)

	Для Каждого Пара Из Страница.Узлы Цикл
		Узел = Пара.Значение;
		Подходит = Цели = Неопределено;
		Если Не Подходит Тогда
			Для Каждого СсылкаУзла Из Узел.Ссылки Цикл
				Если Цели.Получить(СсылкаУзла.Ключ) <> Неопределено Тогда
					Подходит = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Подходит Тогда
			СсылкаОбъекта = Страница.Ссылки.Получить(Пара.Ключ);
			Если Узел.Таблица.Вид = "ТабличнаяЧасть" Тогда
				Локатор = ЗначениеИзСтрокиВнутр(Пара.Ключ);
				СсылкаОбъекта = ДекодироватьКлюч(Локатор);
			КонецЕсли;
			СлитьУзелКаскада(Снимок, Узел, СсылкаОбъекта);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ВладельцыБитыхСсылок(Снимок)

	Владельцы = Новый Соответствие;
	ПоТаблицам = Новый Соответствие;
	Для Каждого Пара Из Снимок.Входящие Цикл
		Описание = ЗначениеИзСтрокиВнутр(Пара.Ключ);
		Ссылки = ПоТаблицам.Получить(Описание.Метаданные);
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Соответствие;
			ПоТаблицам.Вставить(Описание.Метаданные, Ссылки);
		КонецЕсли;
		Ссылки.Вставить(ДекодироватьКлюч(Описание), Пара.Ключ);
	КонецЦикла;
	Для Каждого Пара Из ПоТаблицам Цикл
		Ссылки = Новый Массив;
		Для Каждого СсылкаЦели Из Пара.Значение Цикл
			Ссылки.Добавить(СсылкаЦели.Ключ);
		КонецЦикла;
		Таблица = Новый Структура("Вид,Описание", "Объект", Метаданные.НайтиПоПолномуИмени(Пара.Ключ));
		Псевдоним = ПсевдонимТаблицы(Таблица);
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ %1.Ссылка ИЗ %2 КАК %1 "
			+ "ГДЕ %1.Ссылка В (&Ссылки)", Псевдоним, Пара.Ключ));
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Пара.Значение.Удалить(Выборка.Ссылка);
		КонецЦикла;
		Для Каждого Отсутствующая Из Пара.Значение Цикл
			Для Каждого Владелец Из Снимок.Входящие[Отсутствующая.Значение] Цикл
				Владельцы.Вставить(Владелец.Ключ, Истина);
			КонецЦикла;
			Если Снимок.Узлы.Получить(Отсутствующая.Значение) <> Неопределено Тогда
				// Отсутствующий владелец табличной части представлен ее собственным узлом.
				Владельцы.Вставить(Отсутствующая.Значение, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Владельцы;

КонецФункции

Функция ПропускиСнимка(Снимок, Запуск)

	// Локаторы имеют неограниченную длину и не допускают сравнения в запросе.
	// Отбор по хешу ограничивает чтение маркеров; точные единицы сопоставляются ниже.
	Единицы = Новый Массив;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Единицы.Добавить(ХешКлюча(Пара.Значение.Единица));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ План.Локатор, План.ЕдиницаЗаписи
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Пропущено
		| И План.КлючЕдиницы В (&Единицы)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Единицы", Единицы);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПропущенныеЕдиницы = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ПропущенныеЕдиницы.Вставить(Выборка.ЕдиницаЗаписи, Истина);
	КонецЦикла;
	Пропуски = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Если ПропущенныеЕдиницы.Получить(Пара.Значение.Единица) <> Неопределено Тогда
			Пропуски.Вставить(Пара.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Пропуски;

КонецФункции

Процедура ПроверитьПропускиСостава(Состав, Запуск)

	Единицы = Новый Массив;
	Для Каждого Элемент Из Состав Цикл
		Единицы.Добавить(ХешКлюча(Элемент.ЕдиницаЗаписи));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 План.Метаданные, План.Локатор
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Пропущено И План.КлючЕдиницы В (&Единицы)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Единицы", Единицы);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("Каскад пересекает ранее пропущенную зависимость %1: %2.",
			Выборка.Метаданные, Выборка.Локатор);
	КонецЕсли;

КонецПроцедуры

// Пустая область включает режим ограничения по метаданным. Неопределено означало бы поиск во всей базе.
Функция ПлатформенныйПоискПоКарте(Контекст, Ссылки, ТаблицыПроверены = Ложь)

	Группы = ГруппыТиповЦелей(Ссылки);
	Владельцы = Новый Соответствие;
	Если Не ТаблицыПроверены Тогда
		Для Каждого Пара Из ПоляВходящихВолны(Контекст, Группы) Цикл
			Таблица = Контекст.ТаблицыПоИменам[Пара.Ключ];
			Владельцы.Вставить(Таблица.Описание.ПолноеИмя(), Истина);
		КонецЦикла;
		Для Каждого Таблица Из Контекст.НепрозрачныеТаблицы Цикл
			Владельцы.Вставить(Таблица.Описание.ПолноеИмя(), Истина);
		КонецЦикла;
		Для Каждого Описание Из Метаданные.Константы Цикл
			Если КонстантаПодходитВолне(Описание, Группы) Тогда
				Владельцы.Вставить(Описание.ПолноеИмя(), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Журналы содержат системные ссылки на документы; они не входят в каталог удаляемых таблиц.
	Для Каждого Описание Из Метаданные.ЖурналыДокументов Цикл
		Владельцы.Вставить(Описание.ПолноеИмя(), Истина);
	КонецЦикла;
	Включения = Новый Массив;
	Для Каждого Пара Из Владельцы Цикл
		Включения.Добавить(Пара.Ключ);
	КонецЦикла;
	Если Включения.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	Возврат НайтиПоСсылкам(Ссылки, Новый Массив, Включения);

КонецФункции

// В малом каскаде очередь остается в памяти; после переноса ее хранит индекс.
Функция СледующаяВолнаГрафа(Снимок)

	Волна = Новый Массив;
	Если Снимок.Индекс = "" Тогда
		Для Каждого Пара Из Снимок.Ссылки Цикл
			Если Снимок.Обработанные.Получить(Пара.Ключ) = Неопределено Тогда
				Снимок.Обработанные.Вставить(Пара.Ключ, Истина);
				Волна.Добавить(Пара.Значение);
				Если Волна.Количество() = РазмерПорции() Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат Волна;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2000 Узлы.*
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Индекс И НЕ Узлы.Обработан
		| И Узлы.Вид В (&Виды) УПОРЯДОЧИТЬ ПО Узлы.Узел");
	Запрос.УстановитьПараметр("Индекс", Снимок.Индекс);
	Запрос.УстановитьПараметр("Виды", СтрРазделить("Объект,ТабличнаяЧасть", ","));
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() > 0 Тогда
		Для Каждого СтрокаУзла Из Строки Цикл
			Волна.Добавить(ДекодироватьКлюч(ЗначениеИзСтрокиВнутр(СтрокаУзла.Локатор)));
			СтрокаУзла.Обработан = Истина;
		КонецЦикла;
		Набор = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Снимок.Индекс);
		Набор.Загрузить(Строки);
		Набор.Записать(РежимЗамещения.Слияние);
	КонецЕсли;
	Возврат Волна;

КонецФункции

Функция ЕстьСохраненныйГраф(Порция)

	Возврат Порция.Снимок <> Неопределено И Порция.Снимок.Индекс <> "";

КонецФункции

Функция ЕстьПропускиГрафа(Запуск, Индекс)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 План.Группа КАК Группа
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ПО План.КлючЕдиницы = Узлы.КлючЕдиницы И Узлы.Запуск = &Индекс
		|ГДЕ План.Запуск = &Запуск И План.Пропущено");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Индекс", Индекс);
	Результат = Запрос.Выполнить();
	// Совпадение сокращенного ключа лишь запрещает кеш: ложное совпадение безопасно перестроит граф.
	Возврат Не Результат.Пустой();

КонецФункции

Функция СохраненныйГрафАктуален(Контекст, Порция)

	Проверка = Новый Структура;
	Для Каждого Свойство Из Контекст Цикл
		Проверка.Вставить(Свойство.Ключ, Свойство.Значение);
	КонецЦикла;
	// Чужая фиксация могла изменить и непрозрачные значения. Старые кеши не доказывают актуальность.
	Проверка.Вставить("КешХранилищ", Новый Соответствие);
	Проверка.Вставить("КешКонстант", Новый Соответствие);
	Проверка.ПоколениеКеша = ПоколениеДанныхКаскадов(Контекст.Запуск);
	Снимок = НовыйСнимок(Контекст.Каталог);
	Снимок.Вставить("Индекс", "");
	Снимок.Вставить("Обработанные", Новый Соответствие);
	Снимок.Вставить("ОбъемГрафа", 0);
	Снимок.Вставить("Всего", 0);
	Снимок.Вставить("Стоимость", 0);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
		"Проверка сохраненного графа", "", Порция.Всего);
	Попытка
		Актуален = ПроверитьСоставСохраненногоГрафа(Проверка, Порция, Снимок);
	Исключение
		ОчиститьПроверкуГрафа(Проверка, Снимок);
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьПроверкуГрафа(Проверка, Снимок);
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Порция.Всего);
	Возврат Актуален;

КонецФункции

Функция ПроверитьСоставСохраненногоГрафа(Контекст, Порция, Снимок)

	Состав = ЭлементыСнимкаКаскада(Порция.Семена);
	Корни = СнимокГруппы(Состав, Контекст);
	Для Каждого Пара Из Порция.Семена.Узлы Цикл
		Узел = Корни.Узлы.Получить(Пара.Ключ);
		Если Узел = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		СлитьУзелКаскада(Снимок, Узел, Корни.Ссылки.Получить(Пара.Ключ));
	КонецЦикла;
	Корни = Неопределено;
	ПеренестиГрафКаскада(Контекст, Снимок, Истина);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2000 Узлы.Узел КАК Узел, Узлы.Локатор КАК Локатор
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Индекс И Узлы.Вид В (&Виды) И Узлы.Узел > &После
		|УПОРЯДОЧИТЬ ПО Узлы.Узел");
	Запрос.УстановитьПараметр("Индекс", Порция.Снимок.Индекс);
	Запрос.УстановитьПараметр("Виды", СтрРазделить("Объект,ТабличнаяЧасть", ","));
	Последний = "";
	Пока Истина Цикл
		Результат = СтраницаПроверкиГрафа(Контекст, Запрос, Последний);
		Строки = Результат.Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Волна = Новый Массив;
		Цели = Новый Соответствие;
		Для Каждого СтрокаУзла Из Строки Цикл
			Волна.Добавить(ДекодироватьКлюч(ЗначениеИзСтрокиВнутр(СтрокаУзла.Локатор)));
			Цели.Вставить(СтрокаУзла.Локатор, Истина);
			Последний = СтрокаУзла.Узел;
		КонецЦикла;
		СообщитьПодготовку(Контекст.Прогресс, "Проверка сохраненного графа: известные связи");
		ПрочитатьВладельцевКаскада(Контекст, Снимок, Волна);
		НайтиВходящиеКаскада(Контекст, Снимок, Волна, Цели);
		ПеренестиГрафКаскада(Контекст, Снимок, Истина);
		// Новые владельцы требуют обычного замыкания. Здесь их ссылки не порождают новых волн.
		Если Снимок.Всего > Порция.Всего Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Снимок.Всего = Порция.Всего
		И СовпадаютУзлыГрафа(Контекст, Порция.Снимок.Индекс, Снимок.Индекс, Порция.Всего)
		И СовпадаютСвязиГрафа(Контекст, Порция.Снимок.Индекс, Снимок.Индекс);

КонецФункции

Процедура ОчиститьПроверкуГрафа(Контекст, Снимок)

	Если Снимок.Индекс <> "" Тогда
		ОчиститьИндексКаскадов(Снимок.Индекс);
	КонецЕсли;
	Для Каждого Пара Из Контекст.КешХранилищ Цикл
		ОчиститьИндексКаскадов(Пара.Значение);
	КонецЦикла;

КонецПроцедуры

Функция СовпадаютУзлыГрафа(Контекст, Исходный, Проверочный, Всего)

	ШагПрогресса = 5000;
	СообщитьПодготовку(Контекст.Прогресс, СтрШаблон("Сравнение узлов графа: 0 из %1", Всего));
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 500 Старые.Узел КАК Узел,
		| Старые.Локатор КАК СтарыйЛокатор, Новые.Локатор КАК НовыйЛокатор,
		| Старые.ЕдиницаЗаписи КАК СтараяЕдиница, Новые.ЕдиницаЗаписи КАК НоваяЕдиница,
		| Старые.Ресурс КАК СтарыйРесурс, Новые.Ресурс КАК НовыйРесурс
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Старые
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Новые
		| ПО Старые.Узел = Новые.Узел И Новые.Запуск = &Проверочный
		| И Старые.Вид = Новые.Вид И Старые.Таблица = Новые.Таблица
		| И Старые.Первичный = Новые.Первичный
		|ГДЕ Старые.Запуск = &Исходный И Старые.Вид <> &Маркер И Старые.Узел > &После
		|УПОРЯДОЧИТЬ ПО Старые.Узел");
	Запрос.УстановитьПараметр("Исходный", Исходный);
	Запрос.УстановитьПараметр("Проверочный", Проверочный);
	Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
	Последний = "";
	Совпало = 0;
	Пока Совпало < Всего Цикл
		Результат = СтраницаПроверкиГрафа(Контекст, Запрос, Последний);
		Выборка = Результат.Выбрать();
		Прочитано = 0;
		Пока Выборка.Следующий() Цикл
			Если Выборка.СтарыйЛокатор <> Выборка.НовыйЛокатор
				Или Выборка.СтараяЕдиница <> Выборка.НоваяЕдиница
				Или Выборка.СтарыйРесурс <> Выборка.НовыйРесурс Тогда
				Возврат Ложь;
			КонецЕсли;
			Последний = Выборка.Узел;
			Прочитано = Прочитано + 1;
		КонецЦикла;
		Совпало = Совпало + Прочитано;
		Если Совпало % ШагПрогресса = 0 Или Совпало = Всего Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Сравнение узлов графа: %1 из %2", Совпало, Всего));
		КонецЕсли;
		Если Прочитано = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Совпало = Всего;

КонецФункции

Функция СовпадаютСвязиГрафа(Контекст, Исходный, Проверочный)

	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	Запрос = ЗапросИндекса(Исходный, ВременныеТаблицы);
	Попытка
		ЗагрузитьСвязиГрафа(Запрос, Контекст);
		СообщитьПодготовку(Контекст.Прогресс, "Подготовка исходных связей для сравнения");
		СвернутьСвязиГрафа(Запрос);
		Запрос.Текст = "ВЫБРАТЬ Связи.* ПОМЕСТИТЬ ИсходныеСвязи ИЗ СвязиГрафа КАК Связи
			|ИНДЕКСИРОВАТЬ ПО Цель, УзелИсточник; УНИЧТОЖИТЬ СвязиГрафа";
		Запрос.ВыполнитьПакет();
		Запрос.УстановитьПараметр("Запуск", Проверочный);
		ЗагрузитьСвязиГрафа(Запрос, Контекст);
		СообщитьПодготовку(Контекст.Прогресс, "Подготовка проверочных связей для сравнения");
		СвернутьСвязиГрафа(Запрос);
		Совпали = СопоставитьСвязиГрафа(Контекст, Запрос);
	Исключение
		ВременныеТаблицы.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ВременныеТаблицы.Закрыть();
	Возврат Совпали;

КонецФункции

Функция СопоставитьСвязиГрафа(Контекст, Запрос)

	ШагПрогресса = 5000;
	СообщитьПодготовку(Контекст.Прогресс, "Подсчёт связей сравниваемых графов");
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ИсходныеСвязи КАК Связи
		|ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ СвязиГрафа КАК Связи";
	Результат = Запрос.Выполнить();
	Количество = Результат.Выгрузить();
	Всего = Количество[0].Всего;
	Если Всего <> Количество[1].Всего Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 Старые.Цель КАК Цель, Старые.УзелИсточник КАК УзелИсточник,
		| Старые.ЛокаторЦели КАК СтарыйЛокатор, Новые.ЛокаторЦели КАК НовыйЛокатор
		|ИЗ ИсходныеСвязи КАК Старые ВНУТРЕННЕЕ СОЕДИНЕНИЕ СвязиГрафа КАК Новые
		| ПО Старые.Цель = Новые.Цель И Старые.УзелИсточник = Новые.УзелИсточник
		|ГДЕ Старые.Цель > &Цель ИЛИ (Старые.Цель = &Цель И Старые.УзелИсточник > &После)
		|УПОРЯДОЧИТЬ ПО Старые.Цель, Старые.УзелИсточник";
	ПоследняяЦель = "";
	ПоследнийИсточник = "";
	Совпало = 0;
	СообщитьПодготовку(Контекст.Прогресс, СтрШаблон("Сравнение связей графа: 0 из %1", Всего));
	Пока Совпало < Всего Цикл
		Запрос.УстановитьПараметр("Цель", ПоследняяЦель);
		Результат = СтраницаПроверкиГрафа(Контекст, Запрос, ПоследнийИсточник);
		Выборка = Результат.Выбрать();
		Прочитано = 0;
		Пока Выборка.Следующий() Цикл
			Если Выборка.СтарыйЛокатор <> Выборка.НовыйЛокатор Тогда
				Возврат Ложь;
			КонецЕсли;
			ПоследняяЦель = Выборка.Цель;
			ПоследнийИсточник = Выборка.УзелИсточник;
			Прочитано = Прочитано + 1;
		КонецЦикла;
		Совпало = Совпало + Прочитано;
		Если Совпало % ШагПрогресса = 0 Или Совпало = Всего Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Сравнение связей графа: %1 из %2", Совпало, Всего));
		КонецЕсли;
		Если Прочитано = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Совпало = Всего;

КонецФункции

Функция СтраницаПроверкиГрафа(Контекст, Запрос, После)

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Запрос.УстановитьПараметр("После", После);
	Возврат Запрос.Выполнить();

КонецФункции

Процедура ПеренестиГрафКаскада(Контекст, Снимок, Принудительно = Ложь)

	Если Не Принудительно И Снимок.Индекс = "" И Снимок.ОбъемГрафа < 32 * 1024 * 1024 Тогда
		Возврат;
	КонецЕсли;
	Если Снимок.Узлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Снимок.Индекс = "" Тогда
		Снимок.Индекс = Строка(Новый УникальныйИдентификатор);
		// Маркер нужен восстановлению после аварии, даже если план еще не опубликован.
		Маркер = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
		Маркер.Запуск = Снимок.Индекс;
		Маркер.Узел = "ЧерновикКаскада";
		Маркер.Вид = "ЧерновикКаскада";
		Маркер.Метаданные = Контекст.Запуск;
		Маркер.Обработан = Истина;
		Маркер.Записать();
	КонецЕсли;
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
		"Сохранение страницы графа", "Cutter3000_Узлы, Cutter3000_Связи", Снимок.Узлы.Количество());
	Пакет = Новый Соответствие;
	Для Каждого Пара Из Снимок.Узлы Цикл
		Пакет.Вставить(Пара.Ключ, Пара.Значение);
		Если Пакет.Количество() = 500 Тогда
			ЗаписатьУзлыГрафа(Контекст, Снимок, Пакет);
			Пакет.Очистить();
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		ЗаписатьУзлыГрафа(Контекст, Снимок, Пакет);
	КонецЕсли;
	Снимок.Узлы.Очистить();
	Снимок.Ссылки.Очистить();
	Снимок.Входящие.Очистить();
	Снимок.КлючиСсылок.Очистить();
	Снимок.Обработанные.Очистить();
	Снимок.ОбъемГрафа = 0;
	Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Снимок.Всего);
	СообщитьПодготовку(Контекст.Прогресс,
		СтрШаблон("Граф каскада в служебном индексе: узлов %1", Снимок.Всего));

КонецПроцедуры

Процедура ЗаписатьУзлыГрафа(Контекст, Снимок, Пакет)

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Если ТранзакцияАктивна() Тогда
		ЗаписатьПакетГрафа(Контекст, Снимок, Пакет);
		Возврат;
	КонецЕсли;
	НачатьТранзакцию(РежимБлокировок());
	Попытка
		ЗаписатьПакетГрафа(Контекст, Снимок, Пакет);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьПакетГрафа(Контекст, Снимок, Пакет)

	Хеши = Новый Соответствие;
	Ключи = Новый Массив;
	Для Каждого Пара Из Пакет Цикл
		Хеш = ХешКлюча(Пара.Ключ);
		Хеши.Вставить(Пара.Ключ, Хеш);
		Ключи.Добавить(Хеш);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Узлы.Узел, Узлы.Локатор, Узлы.Вид, Узлы.Обработан
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Индекс И Узлы.Узел В (&Ключи)");
	Запрос.УстановитьПараметр("Индекс", Снимок.Индекс);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Существующие = Новый Соответствие;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Существующие.Вставить(Выборка.Узел,
			Новый Структура("Локатор,Вид,Обработан", Выборка.Локатор, Выборка.Вид, Выборка.Обработан));
	КонецЦикла;
	Узлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
	Узлы.Отбор.Запуск.Установить(Снимок.Индекс);
	Связи = НоваяПорцияСвязейГрафа();
	Объем = 0;
	ПределСтрок = 1000;
	ПределОбъема = 2 * 1024 * 1024;
	Для Каждого Пара Из Пакет Цикл
		Узел = Пара.Значение;
		Ключ = Хеши[Пара.Ключ];
		Старый = Существующие.Получить(Ключ);
		Если Старый <> Неопределено И Старый.Локатор <> Пара.Ключ Тогда
			ВызватьИсключение "Коллизия ключей чернового индекса. Каскад не опубликован.";
		КонецЕсли;
		Если Старый = Неопределено Или (Старый.Вид = "ТабличнаяЧасть" И Узел.Таблица.Вид <> "ТабличнаяЧасть") Тогда
			Запись = Узлы.Добавить();
			Запись.Запуск = Снимок.Индекс;
			Запись.Узел = Ключ;
			Запись.Локатор = Пара.Ключ;
			Запись.Таблица = Узел.Таблица.Имя;
			Запись.Метаданные = Узел.Таблица.Корень;
			Запись.Вид = Узел.Таблица.Вид;
			Запись.ЕдиницаЗаписи = Узел.Единица;
			Запись.КлючЕдиницы = ХешКлюча(Узел.Единица);
			Запись.Ресурс = Узел.Ресурс;
			Если Узел.Таблица.Вид <> "ТабличнаяЧасть" Тогда
				Поле = ПолеПериода(Узел.Таблица);
				Запись.Первичный = Поле <> "" И Узел.Поля[Поле] < Контекст.Граница;
			КонецЕсли;
			Запись.Обработан = Снимок.Обработанные.Получить(Пара.Ключ) <> Неопределено;
			Если Старый <> Неопределено Тогда
				Запись.Обработан = Старый.Обработан;
			Иначе
				Снимок.Всего = Снимок.Всего + 1;
				Вес = Контекст.ОценкиКорней.Получить(Узел.Таблица.Корень);
				Если Вес = Неопределено Тогда
					Вес = 0;
				КонецЕсли;
				Снимок.Стоимость = Снимок.Стоимость + 1 + Вес;
			КонецЕсли;
		КонецЕсли;
		Для Каждого Ребро Из Узел.Ссылки Цикл
			СтрокаСвязи = Связи.Добавить();
			СтрокаСвязи.УзелИсточник = Ключ;
			СтрокаСвязи.ЛокаторЦели = Ребро.Ключ;
			Объем = Объем + 1024 + 2 * СтрДлина(Ребро.Ключ);
			Если Связи.Количество() >= ПределСтрок Или Объем >= ПределОбъема Тогда
				СохранитьПорциюСвязейГрафа(Снимок.Индекс, Связи);
				Объем = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Узлы.Количество() > 0 Тогда
		Узлы.Записать(РежимЗамещения.Слияние);
	КонецЕсли;
	СохранитьПорциюСвязейГрафа(Снимок.Индекс, Связи);

КонецПроцедуры

Функция НоваяПорцияСвязейГрафа(ДляЗапроса = Ложь)

	Связи = Новый ТаблицаЗначений;
	КороткаяСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Связи.Колонки.Добавить("УзелИсточник", КороткаяСтрока);
	Связи.Колонки.Добавить("ЛокаторЦели", Новый ОписаниеТипов("Строка"));
	Если ДляЗапроса Тогда
		Связи.Колонки.Добавить("Цель", КороткаяСтрока);
		Связи.Колонки.Добавить("Вхождение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	КонецЕсли;
	Возврат Связи;

КонецФункции

Процедура СохранитьПорциюСвязейГрафа(Индекс, Связи)

	Если Связи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Черновик хранит ограниченную порцию целиком; индекс каждой связи нужен только при группировке.
	Порция = РегистрыСведений.Cutter3000_Связи.СоздатьМенеджерЗаписи();
	Порция.Запуск = Индекс;
	Порция.Цель = "ПорцияГрафа";
	Порция.УзелИсточник = Строка(Новый УникальныйИдентификатор);
	Порция.Вхождение = 0;
	Порция.ЛокаторЦели = ЗначениеВСтрокуВнутр(Связи);
	Порция.Записать();
	Связи.Очистить();

КонецПроцедуры

Процедура ЗагрузитьСвязиГрафа(Запрос, Контекст, ПроверятьКлючи = Ложь)

	ШагПрогресса = 10;
	СообщитьПодготовку(Контекст.Прогресс, "Загрузка связей графа: прочитано порций 0");
	Связи = НоваяПорцияСвязейГрафа(Истина);
	Буфер = Новый Структура("Ребра,Цели,Объем,Вхождение,ПределСтрок,ПределОбъема,ПроверятьКлючи,Хеши,ОбъемХешей,ПределХешей",
		Связи, Новый Соответствие, 0, 0, 5000, 2 * 1024 * 1024, ПроверятьКлючи, Новый Соответствие, 0, 32 * 1024 * 1024);
	Запрос.УстановитьПараметр("Связи", Связи);
	Запрос.Текст = "ВЫБРАТЬ Связи.* ПОМЕСТИТЬ РебраГрафа ИЗ &Связи КАК Связи ИНДЕКСИРОВАТЬ ПО Вхождение";
	Запрос.Выполнить();
	Чтение = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 10 Связи.УзелИсточник КАК Порция, Связи.ЛокаторЦели КАК Данные
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		|ГДЕ Связи.Запуск = &Индекс И Связи.Цель = &Вид И Связи.УзелИсточник > &После
		|УПОРЯДОЧИТЬ ПО Связи.УзелИсточник");
	Чтение.УстановитьПараметр("Индекс", Запрос.Параметры.Запуск);
	Чтение.УстановитьПараметр("Вид", "ПорцияГрафа");
	Последняя = "";
	ПрочитаноПорций = 0;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);

		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Чтение.УстановитьПараметр("После", Последняя);
		Результат = Чтение.Выполнить();
		Выборка = Результат.Выбрать();
		Прочитано = 0;
		Пока Выборка.Следующий() Цикл

			Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
			Последняя = Выборка.Порция;
			Порция = ЗначениеИзСтрокиВнутр(Выборка.Данные);
			ДобавитьРебраГрафа(Запрос, Контекст, Буфер, Порция);
			Порция = Неопределено;
			Прочитано = Прочитано + 1;
			ПрочитаноПорций = ПрочитаноПорций + 1;
			Если ПрочитаноПорций % ШагПрогресса = 0 Тогда
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Загрузка связей графа: порций %1, связей %2", ПрочитаноПорций, Буфер.Вхождение));
			КонецЕсли;

		КонецЦикла;
		Если Прочитано = 0 Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;
	СохранитьБуферРеберГрафа(Запрос, Контекст, Буфер);
	Буфер.Хеши.Очистить();
	Запрос.УстановитьПараметр("Связи", Неопределено);
	СообщитьПодготовку(Контекст.Прогресс,
		СтрШаблон("Связи графа загружены: порций %1, связей %2", ПрочитаноПорций, Буфер.Вхождение));

КонецПроцедуры

Процедура ДобавитьРебраГрафа(Запрос, Контекст, Буфер, Порция)

	ШагОстановки = 500;
	Для Каждого Ребро Из Порция Цикл

		Если Буфер.Вхождение % ШагОстановки = 0 Тогда
			Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		КонецЕсли;
		Цель = Буфер.Хеши.Получить(Ребро.ЛокаторЦели);
		Если Цель = Неопределено Тогда

			// Ключ словаря полный: разные локаторы не скрываются одинаковым хешем.
			ОбъемКлюча = 640 + 2 * СтрДлина(Ребро.ЛокаторЦели);
			Цель = Новый Структура("Ключ,Проверен", ХешКлюча(Ребро.ЛокаторЦели), Ложь);
			Если ОбъемКлюча <= Буфер.ПределХешей Тогда

				Если Буфер.ОбъемХешей + ОбъемКлюча > Буфер.ПределХешей Тогда
					Буфер.Хеши.Очистить();
					Буфер.ОбъемХешей = 0;
				КонецЕсли;
				Буфер.Хеши.Вставить(Ребро.ЛокаторЦели, Цель);
				Буфер.ОбъемХешей = Буфер.ОбъемХешей + ОбъемКлюча;

			КонецЕсли;

		КонецЕсли;
		Если Буфер.ПроверятьКлючи И Не Цель.Проверен Тогда
			Буфер.Цели.Вставить(Ребро.ЛокаторЦели, Цель.Ключ);
		КонецЕсли;
		Буфер.Вхождение = Буфер.Вхождение + 1;
		СтрокаСвязи = Буфер.Ребра.Добавить();
		СтрокаСвязи.УзелИсточник = Ребро.УзелИсточник;
		СтрокаСвязи.ЛокаторЦели = Ребро.ЛокаторЦели;
		СтрокаСвязи.Цель = Цель.Ключ;
		СтрокаСвязи.Вхождение = Буфер.Вхождение;
		Буфер.Объем = Буфер.Объем + 1024 + 2 * СтрДлина(Ребро.ЛокаторЦели);
		Если Буфер.Ребра.Количество() >= Буфер.ПределСтрок Или Буфер.Объем >= Буфер.ПределОбъема Тогда
			СохранитьБуферРеберГрафа(Запрос, Контекст, Буфер);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура СохранитьБуферРеберГрафа(Запрос, Контекст, Буфер)

	Если Буфер.Ребра.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Если Буфер.Цели.Количество() > 0 Тогда
		ПроверитьЦелиБуфераГрафа(Запрос.Параметры.Запуск, Буфер.Цели);
		Для Каждого ПараЦели Из Буфер.Цели Цикл
			Цель = Буфер.Хеши.Получить(ПараЦели.Ключ);
			Если Цель <> Неопределено Тогда
				Цель.Проверен = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Запрос.УстановитьПараметр("Связи", Буфер.Ребра);
	Запрос.Текст =
		"ВЫБРАТЬ Связи.УзелИсточник КАК УзелИсточник, Связи.ЛокаторЦели КАК ЛокаторЦели,
		| Связи.Цель КАК Цель, Связи.Вхождение КАК Вхождение ДОБАВИТЬ РебраГрафа ИЗ &Связи КАК Связи";
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Запрос.Выполнить();
	Буфер.Ребра.Очистить();
	Буфер.Цели.Очистить();
	Буфер.Объем = 0;

КонецПроцедуры

Процедура ПроверитьЦелиБуфераГрафа(Индекс, Цели)

	Ключи = Новый Массив;
	Для Каждого Цель Из Цели Цикл
		Ключи.Добавить(Цель.Значение);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Узлы.Узел КАК Узел, Узлы.Локатор КАК Локатор
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Индекс И Узлы.Узел В (&Ключи)");
	Запрос.УстановитьПараметр("Индекс", Индекс);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Локаторы = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Локаторы.Вставить(Выборка.Узел, Выборка.Локатор);
	КонецЦикла;
	Для Каждого Цель Из Цели Цикл

		Локатор = Локаторы.Получить(Цель.Значение);
		Если Локатор <> Неопределено И Локатор <> Цель.Ключ Тогда
			ВызватьИсключение "Коллизия ссылок чернового индекса. Каскад не опубликован.";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура СвернутьСвязиГрафа(Запрос)

	// Повторы владельца и его табличных частей объединяются в СУБД без полного графа в BSL.
	Запрос.Текст =
		"ВЫБРАТЬ Ребра.Цель КАК Цель, Ребра.УзелИсточник КАК УзелИсточник,
		| МИНИМУМ(Ребра.Вхождение) КАК Вхождение ПОМЕСТИТЬ УникальныеСвязи
		|ИЗ РебраГрафа КАК Ребра СГРУППИРОВАТЬ ПО Ребра.Цель, Ребра.УзелИсточник;
		|ВЫБРАТЬ Ребра.Цель КАК Цель, Ребра.УзелИсточник КАК УзелИсточник,
		| Ребра.ЛокаторЦели КАК ЛокаторЦели ПОМЕСТИТЬ СвязиГрафа
		|ИЗ РебраГрафа КАК Ребра ВНУТРЕННЕЕ СОЕДИНЕНИЕ УникальныеСвязи КАК Уникальные
		| ПО Ребра.Вхождение = Уникальные.Вхождение ИНДЕКСИРОВАТЬ ПО Цель, УзелИсточник;
		|УНИЧТОЖИТЬ УникальныеСвязи; УНИЧТОЖИТЬ РебраГрафа";
	Запрос.ВыполнитьПакет();

КонецПроцедуры


Функция ПересеченияГрафаИндекса(Запуск, Индекс, Прогресс = Неопределено)

	ШагПрогресса = 5000;
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Запуск);
	СообщитьПодготовку(Прогресс, "Проверка пересечений графа: подготовка данных");
	Запрос = Новый Запрос(
		ТекстАктивныхИндексов("Задания", "Запуск") +
		"ВЫБРАТЬ Свои.КлючЕдиницы КАК КлючЕдиницы, МИНИМУМ(Свои.Узел) КАК Опора
		|ПОМЕСТИТЬ ЕдиницыГрафа ИЗ РегистрСведений.Cutter3000_Узлы КАК Свои
		|ГДЕ Свои.Запуск = &Индекс И Свои.Вид <> &Маркер
		|СГРУППИРОВАТЬ ПО Свои.КлючЕдиницы ИНДЕКСИРОВАТЬ ПО КлючЕдиницы");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Индекс", Индекс);
	Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
	Запрос.УстановитьПараметр("МаркерИндекса", "ИндексКаскада");
	Запрос.УстановитьПараметр("ИсключенныеВиды", СтрРазделить("ЧерновикКаскада,ИндексКаскада,ТабличнаяЧасть", ","));
	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	Задания = Новый Соответствие;
	НайденныеЗадания = Новый Массив;
	Проверено = 0;
	Попытка
		Запрос.ВыполнитьПакет();
		Запрос.УстановитьПараметр("МаркерИндекса", "ИндексКаскада");
	Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Задания.Задание КАК Задание, Занятые.Узел КАК Узел,
			| Занятые.Локатор КАК Занятый,
			| Занятые.ЕдиницаЗаписи КАК ЗанятаяЕдиница,
			| Свои.Локатор КАК Свой, Единица.ЕдиницаЗаписи КАК СвояЕдиница
			|ИЗ РегистрСведений.Cutter3000_Узлы КАК Занятые
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задания КАК Задания ПО Занятые.Запуск = Задания.Индекс
			| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Свои
			| ПО Занятые.Узел = Свои.Узел И Свои.Запуск = &Индекс
			| ЛЕВОЕ СОЕДИНЕНИЕ ЕдиницыГрафа КАК Единицы ПО Занятые.КлючЕдиницы = Единицы.КлючЕдиницы
			| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Единица
			| ПО Единица.Запуск = &Индекс И Единица.Узел = Единицы.Опора
			|ГДЕ НЕ Занятые.Вид В (&ИсключенныеВиды) И (Свои.Узел ЕСТЬ НЕ NULL ИЛИ Единицы.Опора ЕСТЬ НЕ NULL)
			| И НЕ (Задания.Задание В (&НайденныеЗадания))
			| И (Задания.Задание > &Задание ИЛИ (Задания.Задание = &Задание И Занятые.Узел > &Узел))
			|УПОРЯДОЧИТЬ ПО Задания.Задание, Занятые.Узел";
		ПоследнееЗадание = "";
		ПоследнийУзел = "";
		Пока Истина Цикл
			Cutter3000_ЗаданияСервер.ПроверитьОстановку(Запуск);
			Если Проверено % ШагПрогресса = 0 Тогда
				СообщитьПодготовку(Прогресс,
					СтрШаблон("Проверка пересечений графа: узлов %1, найдено заданий %2",
						Проверено, НайденныеЗадания.Количество()));
			КонецЕсли;
			Запрос.УстановитьПараметр("Задание", ПоследнееЗадание);
			Запрос.УстановитьПараметр("Узел", ПоследнийУзел);
			Запрос.УстановитьПараметр("НайденныеЗадания", НайденныеЗадания);
			РезультатЗапроса = Запрос.Выполнить();
			Строки = РезультатЗапроса.Выгрузить();
			Если Строки.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			Для Каждого СтрокаУзла Из Строки Цикл
				ПоследнееЗадание = СтрокаУзла.Задание;
				ПоследнийУзел = СтрокаУзла.Узел;
				Если Задания.Получить(СтрокаУзла.Задание) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если СтрокаУзла.Занятый = СтрокаУзла.Свой
					Или СтрокаУзла.ЗанятаяЕдиница = СтрокаУзла.СвояЕдиница Тогда
					// Для результата достаточно одного точного совпадения на задание.
					Задания.Вставить(СтрокаУзла.Задание, Истина);
					НайденныеЗадания.Добавить(СтрокаУзла.Задание);
				КонецЕсли;
			КонецЦикла;
			Проверено = Проверено + Строки.Количество();
		КонецЦикла;
	Исключение
		ВременныеТаблицы.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ВременныеТаблицы.Закрыть();
	СообщитьПодготовку(Прогресс,
		СтрШаблон("Пересечения графа проверены: узлов %1, найдено заданий %2",
			Проверено, НайденныеЗадания.Количество()));
	Результат = Новый Массив;
	Для Каждого Пара Из Задания Цикл
		Результат.Добавить(Пара.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СохранитьГрафИзИндекса(Контекст, Порция)

	Снимок = Порция.Снимок;
	ЗакрепитьИндексЗаЗаданием(Контекст, Порция.Задание, Снимок.Индекс);
	Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
		"Группировка графа в базе данных", "Cutter3000_Узлы, Cutter3000_Связи", Снимок.Всего);
	ВременныеТаблицы = Неопределено;
	ГруппыПодготовлены = Снимок.Свойство("ТаблицыПубликации", ВременныеТаблицы);
	Если Не ГруппыПодготовлены Тогда
		ВременныеТаблицы = Новый МенеджерВременныхТаблиц;
		Снимок.Вставить("ТаблицыПубликации", ВременныеТаблицы);
	КонецЕсли;
	Попытка
		Если ГруппыПодготовлены Тогда
			Запрос = ЗапросИндекса(Снимок.Индекс, ВременныеТаблицы);
		Иначе
			Запрос = ЗапросГруппГрафа(Контекст, Снимок.Индекс, ВременныеТаблицы);
		КонецЕсли;
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер);
		Группы = Новый Соответствие;
		Последний = "";
		ПоследняяМетка = "";
		НаборПлана = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
		НаборПлана.Отбор.Запуск.Установить(Контекст.Запуск);
		БуферПлана = Новый Структура("Набор,Состав,Группа,Объем,ОбъемНабора,Индекс",
			НаборПлана, Новый Массив, "", 0, 0, Снимок.Индекс);
		СеменаОчереди = ПодготовитьСеменаОчереди(Контекст, Порция);
		БуферПлана.Вставить("СеменаОчереди", СеменаОчереди);
		БуферПлана.Вставить("ОбщаяОчередь", Контекст.Свойство("ОбщаяОчередь"));
		РазмерыГрупп = Новый Соответствие;
		БуферПлана.Вставить("РазмерыГрупп", РазмерыГрупп);
		Запрос.УстановитьПараметр("МаркерПубликации", "ЧерновикКаскада");
		Запрос.Текст =
			"ВЫБРАТЬ Узлы.Узел КАК Узел, Узлы.Вид КАК Вид ПОМЕСТИТЬ ВТ_УзлыПубликации
			|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
			|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид <> &МаркерПубликации ИНДЕКСИРОВАТЬ ПО Узел;
			|ВЫБРАТЬ Метки.Узел КАК Узел, Метки.Метка КАК Метка ПОМЕСТИТЬ ПорядокПлана
			|ИЗ Метки КАК Метки ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_УзлыПубликации КАК Узлы
			| ПО Узлы.Узел = Метки.Узел ИНДЕКСИРОВАТЬ ПО Метка, Узел";
		Запрос.ВыполнитьПакет();
		Замер = Cutter3000_ЗаданияСервер.НачатьЗамер(Контекст,
			"Публикация графа из индекса", "Cutter3000_План", Снимок.Всего);
		Опубликовано = 0;
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Запись плана каскада: узлов 0 из %1", Снимок.Всего));
		Пока Истина Цикл
			Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
			Страница = СтраницаУзловПубликации(Запрос, ПоследняяМетка, Последний);
			Строки = Страница.Строки;
			Если Строки.Количество() > 0 Тогда
				ОпубликоватьУзлыГрафа(Контекст, Порция.Задание, Строки, Группы, БуферПлана);
			КонецЕсли;
			// После разделения общие метки содержат и узлы соседней части порции.
			Последний = Страница.Последний;
			ПоследняяМетка = Страница.Метка;
			Опубликовано = Опубликовано + Строки.Количество();
			Если Опубликовано % 5000 = 0 Или Строки.Количество() < 500 Тогда
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Запись плана каскада: узлов %1 из %2", Опубликовано, Снимок.Всего));
			КонецЕсли;
			Если Страница.Завершено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Опубликовано <> Снимок.Всего Тогда
			ВызватьИсключение "При публикации изменилось количество узлов каскада.";
		КонецЕсли;
		СохранитьБлокПлана(Контекст.Запуск, Порция.Задание, БуферПлана);
		ОбъемНабора = БуферПлана.ОбъемНабора;
		СохранитьПакетСлужебныхЗаписей(НаборПлана, ОбъемНабора, Истина);
		ОпубликоватьСвязиГрафа(Контекст, ВременныеТаблицы, Порция.Задание);
		// Узлы становятся индексом задания без копирования; владение фиксируется вместе с планом.
		СообщитьПодготовку(Контекст.Прогресс, "Передача индекса каскада заданию");
		ЗарегистрироватьИндексКаскада(Контекст, Порция.Задание, Снимок.Индекс);
		ЧерновыеСвязи = РегистрыСведений.Cutter3000_Связи.СоздатьНаборЗаписей();
		ЧерновыеСвязи.Отбор.Запуск.Установить(Снимок.Индекс);
		ЧерновыеСвязи.Отбор.Цель.Установить("ПорцияГрафа");
		ЧерновыеСвязи.Записать();
		Cutter3000_ЗаданияСервер.ЗакончитьЗамер(Замер, Снимок.Всего);
	Исключение
		// После ошибки записи сначала откатывается внешняя транзакция.
		// Снимок удерживает менеджер до очистки вызывающим кодом после отката.
		ВызватьИсключение;
	КонецПопытки;
	ВременныеТаблицы.Закрыть();
	Снимок.Удалить("ТаблицыПубликации");
	Идентификаторы = Новый Массив;
	Для Каждого Пара Из Группы Цикл
		Идентификаторы.Добавить(Пара.Значение);
	КонецЦикла;
	Возврат Новый Структура("Группы,Всего,Задание,СеменаГрупп,РазмерыГрупп", Идентификаторы, Снимок.Всего,
		Порция.Задание, СеменаОчереди.Группы, РазмерыГрупп);

КонецФункции

Функция СтраницаУзловПубликации(Запрос, ПоследняяМетка, ПоследнийУзел)

	Запрос.УстановитьПараметр("МеткаПубликации", ПоследняяМетка);
	Запрос.УстановитьПараметр("УзелПубликации", ПоследнийУзел);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 Узел КАК Узел, Метка КАК Метка ИЗ ПорядокПлана
		|ГДЕ Метка = &МеткаПубликации И Узел > &УзелПубликации УПОРЯДОЧИТЬ ПО Метка, Узел";
	Результат = Запрос.Выполнить();
	Метки = Результат.Выгрузить();
	Если Метки.Количество() < 500 Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Узел КАК Узел, Метка КАК Метка ИЗ ПорядокПлана
			|ГДЕ Метка > &МеткаПубликации УПОРЯДОЧИТЬ ПО Метка, Узел";
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Метки.Количество() < 500 И Выборка.Следующий() Цикл
			Метка = Метки.Добавить();
			Метка.Узел = Выборка.Узел;
			Метка.Метка = Выборка.Метка;
		КонецЦикла;
	КонецЕсли;
	Если Метки.Количество() = 0 Тогда
		Возврат Новый Структура("Строки,Метка,Последний,Завершено", Метки, ПоследняяМетка, ПоследнийУзел, Истина);
	КонецЕсли;
	Последняя = Метки[Метки.Количество() - 1];
	Возврат Новый Структура("Строки,Метка,Последний,Завершено", Метки,
		Последняя.Метка, Последняя.Узел, Метки.Количество() < 500);

КонецФункции

Функция ЗапросГруппГрафа(Контекст, Индекс, ВременныеТаблицы)

	Запрос = ЗапросИндекса(Индекс, ВременныеТаблицы);
	Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
	ЗагрузитьСвязиГрафа(Запрос, Контекст, Истина);
	СообщитьПодготовку(Контекст.Прогресс, "Проверка точных ключей графа");
	ПроверитьКлючиГрафа(Запрос, Контекст);
	СообщитьПодготовку(Контекст.Прогресс, "Устранение повторных связей графа");
	СвернутьСвязиГрафа(Запрос);
	Запрос.Текст =
		"ВЫБРАТЬ Узлы.Узел КАК Узел, Узлы.КлючЕдиницы КАК КлючЕдиницы
		|ПОМЕСТИТЬ Узлы ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид <> &Маркер ИНДЕКСИРОВАТЬ ПО Узел";
	Запрос.Выполнить();
	СообщитьПодготовку(Контекст.Прогресс, "Подготовка связности графа");
	СгруппироватьКомпонентыГрафа(Запрос, Контекст);
	Возврат Запрос;

КонецФункции

Функция РазметитьЗанятыеКомпоненты(Контекст, Порция, Запрос)

	Занятые = Новый ТаблицаЗначений;
	Занятые.Колонки.Добавить("Задание", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Занятые.Колонки.Добавить("Метка", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64)));
	Запрос.УстановитьПараметр("ЗанятыеКомпоненты", Занятые);
	Запрос.УстановитьПараметр("ЗапускОперации", Контекст.Запуск);
	Запрос.УстановитьПараметр("МаркерИндекса", "ИндексКаскада");
	Запрос.Текст =
		ТекстАктивныхИндексов("ВТ_АктивныеЗадания", "ЗапускОперации") +
		"ВЫБРАТЬ Свои.КлючЕдиницы КАК КлючЕдиницы, МИНИМУМ(Свои.Узел) КАК Опора
		|ПОМЕСТИТЬ ВТ_ЕдиницыРазделения ИЗ РегистрСведений.Cutter3000_Узлы КАК Свои
		|ГДЕ Свои.Запуск = &Запуск И Свои.Вид <> &Маркер
		|СГРУППИРОВАТЬ ПО Свои.КлючЕдиницы ИНДЕКСИРОВАТЬ ПО КлючЕдиницы;
		|ВЫБРАТЬ Занятые.Задание КАК Задание, Занятые.Метка КАК Метка
		|ПОМЕСТИТЬ ВТ_ЗанятыеКомпоненты ИЗ &ЗанятыеКомпоненты КАК Занятые
		|ИНДЕКСИРОВАТЬ ПО Задание, Метка";
	Запрос.ВыполнитьПакет();
	Чтение = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 500 Задания.Задание КАК Задание, Занятые.Узел КАК Узел,
		| Занятые.Локатор КАК Занятый, Занятые.ЕдиницаЗаписи КАК ЗанятаяЕдиница,
		| Свои.Локатор КАК Свой, СвоиМетки.Метка КАК СвояМетка,
		| Единица.ЕдиницаЗаписи КАК СвояЕдиница, МеткиЕдиницы.Метка КАК МеткаЕдиницы,
		| ВЫБОР КОГДА ЗанятыеУзлы.Метка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК УчтенУзел,
		| ВЫБОР КОГДА ЗанятыеЕдиницы.Метка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК УчтенаЕдиница
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Занятые
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АктивныеЗадания КАК Задания ПО Занятые.Запуск = Задания.Индекс
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Свои
		| ПО Свои.Запуск = &Индекс И Свои.Узел = Занятые.Узел
		| ЛЕВОЕ СОЕДИНЕНИЕ Метки КАК СвоиМетки ПО Свои.Узел = СвоиМетки.Узел
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕдиницыРазделения КАК Единицы
		| ПО Занятые.КлючЕдиницы = Единицы.КлючЕдиницы
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Единица
		| ПО Единица.Запуск = &Индекс И Единица.Узел = Единицы.Опора
		| ЛЕВОЕ СОЕДИНЕНИЕ Метки КАК МеткиЕдиницы ПО Единица.Узел = МеткиЕдиницы.Узел
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗанятыеКомпоненты КАК ЗанятыеУзлы
		| ПО ЗанятыеУзлы.Задание = Задания.Задание И ЗанятыеУзлы.Метка = СвоиМетки.Метка
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗанятыеКомпоненты КАК ЗанятыеЕдиницы
		| ПО ЗанятыеЕдиницы.Задание = Задания.Задание И ЗанятыеЕдиницы.Метка = МеткиЕдиницы.Метка
		|ГДЕ НЕ Занятые.Вид В (&ИсключенныеВиды) И ((СвоиМетки.Метка ЕСТЬ НЕ NULL И ЗанятыеУзлы.Метка ЕСТЬ NULL)
		| ИЛИ (МеткиЕдиницы.Метка ЕСТЬ НЕ NULL И ЗанятыеЕдиницы.Метка ЕСТЬ NULL))
		| И (Задания.Задание > &Задание ИЛИ (Задания.Задание = &Задание И Занятые.Узел > &Узел))
		|УПОРЯДОЧИТЬ ПО Задания.Задание, Занятые.Узел");
	Чтение.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	Чтение.УстановитьПараметр("ИсключенныеВиды", СтрРазделить("ЧерновикКаскада,ИндексКаскада,ТабличнаяЧасть", ","));
	Чтение.УстановитьПараметр("Индекс", Порция.Снимок.Индекс);
	ПоследнееЗадание = "";
	ПоследнийУзел = "";
	Задания = Новый Соответствие;
	Проверено = 0;
	ШагПрогресса = 5000;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Если Проверено % ШагПрогресса = 0 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Разделение порции: проверка занятых компонент, узлов %1", Проверено));
		КонецЕсли;
		Чтение.УстановитьПараметр("Задание", ПоследнееЗадание);
		Чтение.УстановитьПараметр("Узел", ПоследнийУзел);
		РезультатЗапроса = Чтение.Выполнить();
		Строки = РезультатЗапроса.Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Совпадения = Новый Соответствие;
		Для Каждого СтрокаУзла Из Строки Цикл
			Если Не СтрокаУзла.УчтенУзел И СтрокаУзла.Занятый = СтрокаУзла.Свой Тогда
				ДобавитьЗанятуюКомпоненту(Совпадения, СтрокаУзла.Задание, СтрокаУзла.СвояМетка);
				Задания.Вставить(СтрокаУзла.Задание, Истина);
			КонецЕсли;
			Если Не СтрокаУзла.УчтенаЕдиница И СтрокаУзла.ЗанятаяЕдиница = СтрокаУзла.СвояЕдиница Тогда
				ДобавитьЗанятуюКомпоненту(Совпадения, СтрокаУзла.Задание, СтрокаУзла.МеткаЕдиницы);
				Задания.Вставить(СтрокаУзла.Задание, Истина);
			КонецЕсли;
			ПоследнееЗадание = СтрокаУзла.Задание;
			ПоследнийУзел = СтрокаУзла.Узел;
		КонецЦикла;
		СохранитьЗанятыеКомпоненты(Запрос, Занятые, Совпадения);
		Проверено = Проверено + Строки.Количество();
	КонецЦикла;
	Запрос.Текст =
		"ВЫБРАТЬ Занятые.Метка КАК Метка ПОМЕСТИТЬ ВТ_ОжидающиеМетки
		|ИЗ ВТ_ЗанятыеКомпоненты КАК Занятые СГРУППИРОВАТЬ ПО Занятые.Метка ИНДЕКСИРОВАТЬ ПО Метка;
		|ВЫБРАТЬ Метки.Узел КАК Узел, ВЫБОР КОГДА Занятые.Метка ЕСТЬ NULL
		| ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК Ожидает ПОМЕСТИТЬ ВТ_РазделениеГрафа
		|ИЗ Метки КАК Метки ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОжидающиеМетки КАК Занятые ПО Метки.Метка = Занятые.Метка
		|ИНДЕКСИРОВАТЬ ПО Узел;
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, ЕСТЬNULL(СУММА(ВЫБОР КОГДА Узлы.Ожидает
		| ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Ожидает ИЗ ВТ_РазделениеГрафа КАК Узлы";
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[2].Выбрать();
	Выборка.Следующий();
	Если Выборка.Всего <> Порция.Всего Тогда
		ВызватьИсключение "Группировка не сохранила все узлы разделяемой порции.";
	КонецЕсли;
	Пересечения = Новый Массив;
	Для Каждого Пара Из Задания Цикл
		Пересечения.Добавить(Пара.Ключ);
	КонецЦикла;
	Возврат Новый Структура("Узлов,Задания", Выборка.Ожидает, Пересечения);

КонецФункции

Процедура ДобавитьЗанятуюКомпоненту(Совпадения, Задание, Метка)

	Ключ = СтрШаблон("%1|%2", Задание, Метка);
	Совпадения.Вставить(Ключ, Новый Структура("Задание,Метка", Задание, Метка));

КонецПроцедуры

Процедура СохранитьЗанятыеКомпоненты(Запрос, Занятые, Совпадения)

	ПределСтрок = 500;
	Запрос.УстановитьПараметр("ЗанятыеКомпоненты", Занятые);
	Запрос.Текст = "ВЫБРАТЬ Занятые.Задание КАК Задание, Занятые.Метка КАК Метка
		|ДОБАВИТЬ ВТ_ЗанятыеКомпоненты ИЗ &ЗанятыеКомпоненты КАК Занятые";
	Для Каждого Пара Из Совпадения Цикл
		ЗаполнитьЗначенияСвойств(Занятые.Добавить(), Пара.Значение);
		Если Занятые.Количество() = ПределСтрок Тогда
			Запрос.Выполнить();
			Занятые.Очистить();
		КонецЕсли;
	КонецЦикла;
	Если Занятые.Количество() > 0 Тогда
		Запрос.Выполнить();
		Занятые.Очистить();
	КонецЕсли;

КонецПроцедуры

Функция НоваяЧастьПорции(Контекст, Исходная, Ожидает, Задания)

	Снимок = НовыйСнимок(Контекст.Каталог);
	Снимок.Вставить("Индекс", Строка(Новый УникальныйИдентификатор));
	Снимок.Вставить("Обработанные", Новый Соответствие);
	Снимок.Вставить("ОбъемГрафа", 0);
	Снимок.Вставить("Всего", 0);
	Снимок.Вставить("Стоимость", 0);
	Маркер = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
	Маркер.Запуск = Снимок.Индекс;
	Маркер.Узел = "ЧерновикКаскада";
	Маркер.Вид = "ЧерновикКаскада";
	Маркер.Метаданные = Контекст.Запуск;
	Маркер.Обработан = Истина;
	Маркер.Записать();
	Результат = Новый Структура("Семена,Снимок,Задание,Пересечение,Поколение,ПересекающиесяЗадания,Стоимость,Всего,Полосы",
		НовыйСнимок(Контекст.Каталог), Снимок, Исходная.Задание, Ожидает, Исходная.Поколение,
		Задания, 0, 0, Исходная.Полосы);
	Повторы = Неопределено;
	Если Исходная.Свойство("ПовторыПерестроения", Повторы) Тогда
		Результат.Вставить("ПовторыПерестроения", Повторы);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура СкопироватьУзлыЧастей(Контекст, Исходная, Запрос, Готовая, Ожидающая)

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 Узлы.*, Разделение.Ожидает КАК Ожидает
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РазделениеГрафа КАК Разделение ПО Узлы.Узел = Разделение.Узел
		|ГДЕ Узлы.Запуск = &Запуск И Узлы.Узел > &Последний УПОРЯДОЧИТЬ ПО Узлы.Узел";
	Последний = "";
	ШагПрогресса = 5000;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Если (Готовая.Всего + Ожидающая.Всего) % ШагПрогресса = 0 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Разделение порции: запись узлов, свободных %1, ожидающих %2",
					Готовая.Всего, Ожидающая.Всего));
		КонецЕсли;
		Запрос.УстановитьПараметр("Последний", Последний);
		РезультатЗапроса = Запрос.Выполнить();
		Строки = РезультатЗапроса.Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		СвободныеУзлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
		СвободныеУзлы.Отбор.Запуск.Установить(Готовая.Снимок.Индекс);
		ОжидающиеУзлы = РегистрыСведений.Cutter3000_Узлы.СоздатьНаборЗаписей();
		ОжидающиеУзлы.Отбор.Запуск.Установить(Ожидающая.Снимок.Индекс);
		Для Каждого СтрокаУзла Из Строки Цикл
			Часть = Готовая;
			Набор = СвободныеУзлы;
			Если СтрокаУзла.Ожидает Тогда
				Часть = Ожидающая;
				Набор = ОжидающиеУзлы;
			КонецЕсли;
			Запись = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаУзла);
			Запись.Запуск = Часть.Снимок.Индекс;
			Вес = Контекст.ОценкиКорней.Получить(СтрокаУзла.Метаданные);
			Если Вес = Неопределено Тогда
				Вес = 0;
			КонецЕсли;
			Часть.Стоимость = Часть.Стоимость + 1 + Вес;
			Часть.Всего = Часть.Всего + 1;
			Семя = Исходная.Семена.Узлы.Получить(СтрокаУзла.Локатор);
			Если Семя <> Неопределено Тогда
				СлитьУзелКаскада(Часть.Семена, Семя, Исходная.Семена.Ссылки.Получить(СтрокаУзла.Локатор));
			КонецЕсли;
			Последний = СтрокаУзла.Узел;
		КонецЦикла;
		Если СвободныеУзлы.Количество() > 0 Тогда
			СвободныеУзлы.Записать(РежимЗамещения.Слияние);
		КонецЕсли;
		Если ОжидающиеУзлы.Количество() > 0 Тогда
			ОжидающиеУзлы.Записать(РежимЗамещения.Слияние);
		КонецЕсли;
	КонецЦикла;
	Готовая.Снимок.Всего = Готовая.Всего;
	Готовая.Снимок.Стоимость = Готовая.Стоимость;
	Ожидающая.Снимок.Всего = Ожидающая.Всего;
	Ожидающая.Снимок.Стоимость = Ожидающая.Стоимость;

КонецПроцедуры

Процедура СкопироватьСвязиЧастей(Контекст, Запрос, Готовая, Ожидающая)

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 Связи.Цель КАК Цель, Связи.УзелИсточник КАК УзелИсточник,
		| Связи.ЛокаторЦели КАК ЛокаторЦели, Разделение.Ожидает КАК Ожидает
		|ИЗ СвязиГрафа КАК Связи ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РазделениеГрафа КАК Разделение
		| ПО Связи.УзелИсточник = Разделение.Узел
		|ГДЕ Связи.Цель > &Цель ИЛИ (Связи.Цель = &Цель И Связи.УзелИсточник > &Источник)
		|УПОРЯДОЧИТЬ ПО Связи.Цель, Связи.УзелИсточник";
	ПоследняяЦель = "";
	ПоследнийИсточник = "";
	ПределОбъема = 2 * 1024 * 1024;
	Проверено = 0;
	ШагПрогресса = 5000;
	СвободныеСвязи = НоваяПорцияСвязейГрафа();
	ОжидающиеСвязи = НоваяПорцияСвязейГрафа();
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Если Проверено % ШагПрогресса = 0 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Разделение порции: запись связей, обработано %1", Проверено));
		КонецЕсли;
		Запрос.УстановитьПараметр("Цель", ПоследняяЦель);
		Запрос.УстановитьПараметр("Источник", ПоследнийИсточник);
		РезультатЗапроса = Запрос.Выполнить();
		Строки = РезультатЗапроса.Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Объем = 0;
		Для Каждого СтрокаСвязи Из Строки Цикл
			Связи = СвободныеСвязи;
			Если СтрокаСвязи.Ожидает Тогда
				Связи = ОжидающиеСвязи;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Связи.Добавить(), СтрокаСвязи);
			Объем = Объем + 1024 + 2 * СтрДлина(СтрокаСвязи.ЛокаторЦели);
			Если Объем >= ПределОбъема Тогда
				СохранитьПорциюСвязейГрафа(Готовая.Снимок.Индекс, СвободныеСвязи);
				СохранитьПорциюСвязейГрафа(Ожидающая.Снимок.Индекс, ОжидающиеСвязи);
				Объем = 0;
			КонецЕсли;
			ПоследняяЦель = СтрокаСвязи.Цель;
			ПоследнийИсточник = СтрокаСвязи.УзелИсточник;
		КонецЦикла;
		СохранитьПорциюСвязейГрафа(Готовая.Снимок.Индекс, СвободныеСвязи);
		СохранитьПорциюСвязейГрафа(Ожидающая.Снимок.Индекс, ОжидающиеСвязи);
		Проверено = Проверено + Строки.Количество();
	КонецЦикла;

КонецПроцедуры

Процедура СгруппироватьКомпонентыГрафа(Запрос, Контекст)

	// Быстрый путь не создает симметричную смежность и повторные сокращенные графы.
	// Отказ по числу узлов происходит до выделения индекса и изменения исходных таблиц.
	Если СгруппироватьГрафВПамяти(Запрос, Контекст) Тогда
		Возврат;
	КонецЕсли;
	СообщитьПодготовку(Контекст.Прогресс, "Объединение компонент каскада: дисковый алгоритм");
	ПостроитьСмежностьГрафа(Запрос);
	СгруппироватьГрафИндекса(Запрос, Контекст);
	Запрос.Текст = "УНИЧТОЖИТЬ Смежность";
	Запрос.Выполнить();

КонецПроцедуры

Функция СгруппироватьГрафВПамяти(Запрос, Контекст, ПределУзлов = 250000)

	// Предел относится к числу коротких ключей; полные локаторы и все ребра остаются в СУБД.
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Узлы";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Количество = Выборка.Всего;
	Если Количество > ПределУзлов Тогда
		Возврат Ложь;
	КонецЕсли;

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	РазмерБуфера = Макс(4, Количество * 4);
	Группы = Новый Структура("Номера,Ключи,Родители,Размеры,Минимумы",
		Новый Соответствие, Новый Массив,
		Новый БуферДвоичныхДанных(РазмерБуфера), Новый БуферДвоичныхДанных(РазмерБуфера),
		Новый БуферДвоичныхДанных(РазмерБуфера));
	СообщитьПодготовку(Контекст.Прогресс,
		СтрШаблон("Объединение компонент каскада: чтение %1 узлов", Количество));
	ПрочитатьУзлыКомпонент(Запрос, Контекст, Группы);
	СообщитьПодготовку(Контекст.Прогресс, "Объединение компонент каскада: чтение связей");
	ПрочитатьСвязиКомпонент(Запрос, Контекст, Группы);
	СообщитьПодготовку(Контекст.Прогресс, "Объединение компонент каскада: запись меток");
	ЗаписатьМеткиКомпонент(Запрос, Контекст, Группы);
	Возврат Истина;

КонецФункции

Процедура ПрочитатьУзлыКомпонент(Запрос, Контекст, Группы)

	Запрос.Текст =
		"ВЫБРАТЬ Узел КАК Узел, КлючЕдиницы КАК КлючЕдиницы ИЗ Узлы
		|УПОРЯДОЧИТЬ ПО КлючЕдиницы, Узел";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПредыдущаяЕдиница = Неопределено;
	ОпораЕдиницы = 0;
	Номер = 0;
	Пока Выборка.Следующий() Цикл

		Если Номер % 500 = 0 Тогда
			Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		КонецЕсли;
		Группы.Номера.Вставить(Выборка.Узел, Номер);
		Группы.Ключи.Добавить(Выборка.Узел);
		Группы.Родители.ЗаписатьЦелое32(Номер * 4, Номер);
		Группы.Размеры.ЗаписатьЦелое32(Номер * 4, 1);
		Группы.Минимумы.ЗаписатьЦелое32(Номер * 4, Номер);
		Если ПредыдущаяЕдиница = Выборка.КлючЕдиницы Тогда
			ОбъединитьУзлыКомпонент(Группы, ОпораЕдиницы, Номер);
		Иначе
			ПредыдущаяЕдиница = Выборка.КлючЕдиницы;
			ОпораЕдиницы = Номер;
		КонецЕсли;
		Номер = Номер + 1;
		Если Номер % 5000 = 0 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Объединение компонент каскада: прочитано узлов %1", Номер));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьСвязиКомпонент(Запрос, Контекст, Группы)

	Прочитано = 0;
	СледующееСообщение = 5000;
	ПослеЦели = "";
	ПослеИсточника = "";
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);

		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Строки = СтраницаИсходныхСвязей(Запрос, ПослеЦели, ПослеИсточника);
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ПослеЦели = Строки[Строки.Количество() - 1].Цель;
		ПослеИсточника = Строки[Строки.Количество() - 1].УзелИсточник;
		Для Каждого Ребро Из Строки Цикл

			Первый = Группы.Номера.Получить(Ребро.УзелИсточник);
			Второй = Группы.Номера.Получить(Ребро.Цель);
			Если Первый <> Неопределено И Второй <> Неопределено Тогда
				ОбъединитьУзлыКомпонент(Группы, Первый, Второй);
			КонецЕсли;

		КонецЦикла;
		Прочитано = Прочитано + Строки.Количество();
		Если Прочитано >= СледующееСообщение Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Объединение компонент каскада: прочитано связей %1", Прочитано));
			СледующееСообщение = Прочитано + 5000;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция СтраницаИсходныхСвязей(Запрос, ПослеЦели, ПослеИсточника, СЛокатором = Ложь)

	Запрос.УстановитьПараметр("ЦельСтраницы", ПослеЦели);
	Запрос.УстановитьПараметр("ИсточникСтраницы", ПослеИсточника);
	Поля = "Цель КАК Цель, УзелИсточник КАК УзелИсточник";
	Если СЛокатором Тогда
		Поля = Поля + ", ЛокаторЦели КАК ЛокаторЦели";
	КонецЕсли;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 " + Поля + " ИЗ СвязиГрафа
		|ГДЕ Цель = &ЦельСтраницы И УзелИсточник > &ИсточникСтраницы
		|УПОРЯДОЧИТЬ ПО Цель, УзелИсточник";
	Результат = Запрос.Выполнить();
	Строки = Результат.Выгрузить();
	Если Строки.Количество() < 500 Тогда

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 " + Поля + " ИЗ СвязиГрафа
			|ГДЕ Цель > &ЦельСтраницы УПОРЯДОЧИТЬ ПО Цель, УзелИсточник";
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Строки.Количество() < 500 И Выборка.Следующий() Цикл

			СтрокаСвязи = Строки.Добавить();
			СтрокаСвязи.Цель = Выборка.Цель;
			СтрокаСвязи.УзелИсточник = Выборка.УзелИсточник;
			Если СЛокатором Тогда
				СтрокаСвязи.ЛокаторЦели = Выборка.ЛокаторЦели;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;
	Возврат Строки;

КонецФункции

Процедура ОбъединитьУзлыКомпонент(Группы, Первый, Второй)

	КореньПервого = КореньКомпоненты(Группы.Родители, Первый);
	КореньВторого = КореньКомпоненты(Группы.Родители, Второй);
	Если КореньПервого = КореньВторого Тогда
		Возврат;
	КонецЕсли;
	РазмерПервого = Группы.Размеры.ПрочитатьЦелое32(КореньПервого * 4);
	РазмерВторого = Группы.Размеры.ПрочитатьЦелое32(КореньВторого * 4);
	Если РазмерПервого < РазмерВторого Тогда
		Обмен = КореньПервого;
		КореньПервого = КореньВторого;
		КореньВторого = Обмен;
	КонецЕсли;
	Группы.Родители.ЗаписатьЦелое32(КореньВторого * 4, КореньПервого);
	Группы.Размеры.ЗаписатьЦелое32(КореньПервого * 4, РазмерПервого + РазмерВторого);
	МинимумПервого = Группы.Минимумы.ПрочитатьЦелое32(КореньПервого * 4);
	МинимумВторого = Группы.Минимумы.ПрочитатьЦелое32(КореньВторого * 4);
	Если Группы.Ключи[МинимумВторого] < Группы.Ключи[МинимумПервого] Тогда
		Группы.Минимумы.ЗаписатьЦелое32(КореньПервого * 4, МинимумВторого);
	КонецЕсли;

КонецПроцедуры

Функция КореньКомпоненты(Родители, Узел)

	Корень = Узел;
	Пока Истина Цикл
		Следующий = Родители.ПрочитатьЦелое32(Корень * 4);
		Если Следующий = Корень Тогда
			Прервать;
		КонецЕсли;
		Корень = Следующий;
	КонецЦикла;
	Текущий = Узел;
	Пока Текущий <> Корень Цикл
		Следующий = Родители.ПрочитатьЦелое32(Текущий * 4);
		Родители.ЗаписатьЦелое32(Текущий * 4, Корень);
		Текущий = Следующий;
	КонецЦикла;
	Возврат Корень;

КонецФункции

Процедура ЗаписатьМеткиКомпонент(Запрос, Контекст, Группы)

	СообщитьПодготовку(Контекст.Прогресс, "Объединение компонент каскада: подготовка таблицы меток");
	// Индекс пустой таблицы заполняется вместе со страницами, без общей копии в конце.
	Запрос.Текст =
		"ВЫБРАТЬ Узел КАК Узел, Узел КАК Метка ПОМЕСТИТЬ Метки ИЗ Узлы ГДЕ ЛОЖЬ
		|ИНДЕКСИРОВАТЬ ПО Узел";
	Запрос.Выполнить();
	Страница = Новый ТаблицаЗначений;
	ТипКлюча = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Страница.Колонки.Добавить("Узел", ТипКлюча);
	Страница.Колонки.Добавить("Метка", ТипКлюча);
	Для Номер = 0 По Группы.Ключи.Количество() - 1 Цикл

		Корень = КореньКомпоненты(Группы.Родители, Номер);
		Минимум = Группы.Минимумы.ПрочитатьЦелое32(Корень * 4);
		Метка = Страница.Добавить();
		Метка.Узел = Группы.Ключи[Номер];
		Метка.Метка = Группы.Ключи[Минимум];
		Если Страница.Количество() = 500 Тогда
			СохранитьСтраницуМеток(Запрос, Контекст, Страница);
			Если (Номер + 1) % 5000 = 0 Тогда
				СообщитьПодготовку(Контекст.Прогресс,
					СтрШаблон("Объединение компонент каскада: записано меток %1", Номер + 1));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	СохранитьСтраницуМеток(Запрос, Контекст, Страница);
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	СообщитьПодготовку(Контекст.Прогресс, "Объединение компонент каскада: освобождение исходных узлов");
	Запрос.Текст = "УНИЧТОЖИТЬ Узлы";
	Запрос.Выполнить();
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	СообщитьПодготовку(Контекст.Прогресс,
		СтрШаблон("Компоненты каскада подготовлены: узлов %1", Группы.Ключи.Количество()));

КонецПроцедуры

Процедура СохранитьСтраницуМеток(Запрос, Контекст, Страница)

	Cutter3000_ЗаданияСервер.ОбслужитьОчередьКаскадов(Контекст);

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	Если Страница.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос.УстановитьПараметр("МеткиСтраницы", Страница);
	Запрос.Текст =
		"ВЫБРАТЬ Строки.Узел КАК Узел, Строки.Метка КАК Метка
		|ДОБАВИТЬ Метки ИЗ &МеткиСтраницы КАК Строки";
	Запрос.Выполнить();
	Страница.Очистить();
	Запрос.УстановитьПараметр("МеткиСтраницы", Неопределено);

КонецПроцедуры

Процедура ПостроитьСмежностьГрафа(Запрос)

	// Весь индекс уже относится к каскаду; дополнительные копии кандидатов и ребер не нужны.
	Запрос.Текст =
		"ВЫБРАТЬ Узлы.КлючЕдиницы КАК КлючЕдиницы, МИНИМУМ(Узлы.Узел) КАК Опора
		|ПОМЕСТИТЬ Единицы ИЗ Узлы КАК Узлы
		|СГРУППИРОВАТЬ ПО Узлы.КлючЕдиницы ИНДЕКСИРОВАТЬ ПО КлючЕдиницы;
		|ВЫБРАТЬ Связи.УзелИсточник КАК Первый, Связи.Цель КАК Второй ПОМЕСТИТЬ Смежность
		|ИЗ СвязиГрафа КАК Связи
		|ГДЕ Связи.УзелИсточник <> Связи.Цель
		| И Связи.УзелИсточник В (ВЫБРАТЬ Узел ИЗ Узлы) И Связи.Цель В (ВЫБРАТЬ Узел ИЗ Узлы)
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Связи.Цель, Связи.УзелИсточник
		|ИЗ СвязиГрафа КАК Связи
		|ГДЕ Связи.УзелИсточник <> Связи.Цель
		| И Связи.УзелИсточник В (ВЫБРАТЬ Узел ИЗ Узлы) И Связи.Цель В (ВЫБРАТЬ Узел ИЗ Узлы)
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Узлы.Узел, Единицы.Опора ИЗ Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Единицы КАК Единицы ПО Узлы.КлючЕдиницы = Единицы.КлючЕдиницы
		|ГДЕ Узлы.Узел <> Единицы.Опора
		|ОБЪЕДИНИТЬ ВЫБРАТЬ Единицы.Опора, Узлы.Узел ИЗ Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Единицы КАК Единицы ПО Узлы.КлючЕдиницы = Единицы.КлючЕдиницы
		|ГДЕ Узлы.Узел <> Единицы.Опора ИНДЕКСИРОВАТЬ ПО Первый, Второй;
		|ВЫБРАТЬ Узел КАК Узел, Узел КАК Метка ПОМЕСТИТЬ Метки ИЗ Узлы ИНДЕКСИРОВАТЬ ПО Узел;
		|УНИЧТОЖИТЬ Единицы; УНИЧТОЖИТЬ Узлы";
	Запрос.ВыполнитьПакет();

КонецПроцедуры

Процедура СгруппироватьГрафИндекса(Запрос, Контекст)

	Проход = 0;
	Пока Истина Цикл
		Проход = Проход + 1;
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Объединение компонент каскада: проход %1", Проход));
		// Рабочие вершины представляют уже объединенные компоненты.
		// Указатели всегда убывают: циклы исключены, корень остается узлом исходного графа.
		Запрос.Текст =
			"ВЫБРАТЬ Ребра.Первый КАК Узел, МИНИМУМ(ВЫБОР
			| КОГДА Ребра.Первый < Ребра.Второй ТОГДА Ребра.Первый
			| ИНАЧЕ Ребра.Второй КОНЕЦ) КАК Метка ПОМЕСТИТЬ ВТ_РодителиКомпонент
			|ИЗ Смежность КАК Ребра СГРУППИРОВАТЬ ПО Ребра.Первый ИНДЕКСИРОВАТЬ ПО Узел";
		Запрос.Выполнить();
		СжатьУказателиКомпонент(Запрос, Контекст, Проход);
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Объединение компонент каскада: проход %1, сворачивание связей", Проход));
		ОсталосьСвязей = СвернутьРабочийГраф(Запрос, Контекст, Проход);
		Если ОсталосьСвязей = 0 Тогда
			Прервать;
		КонецЕсли;
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Объединение компонент каскада: проход %1, осталось связей %2", Проход, ОсталосьСвязей));
	КонецЦикла;

КонецПроцедуры

Процедура СжатьУказателиКомпонент(Запрос, Контекст, Проход)

	Шаг = 0;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Шаг = Шаг + 1;
		СообщитьПодготовку(Контекст.Прогресс,
			СтрШаблон("Объединение компонент каскада: проход %1, сокращение указателей %2", Проход, Шаг));
		Запрос.Текст =
			"ВЫБРАТЬ Свои.Узел КАК Узел, Родители.Метка КАК Метка ПОМЕСТИТЬ ВТ_НовыеРодители
			|ИЗ ВТ_РодителиКомпонент КАК Свои
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РодителиКомпонент КАК Родители ПО Свои.Метка = Родители.Узел
			|ИНДЕКСИРОВАТЬ ПО Узел;
			|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Изменено ИЗ ВТ_НовыеРодители КАК Новые
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РодителиКомпонент КАК Старые ПО Новые.Узел = Старые.Узел
			|ГДЕ Новые.Метка <> Старые.Метка";
		Результаты = Запрос.ВыполнитьПакет();
		Выборка = Результаты[1].Выбрать();
		Выборка.Следующий();
		Изменено = Выборка.Изменено;
		Результаты = Неопределено;
		Выборка = Неопределено;
		Запрос.Текст =
			"УНИЧТОЖИТЬ ВТ_РодителиКомпонент;
			|ВЫБРАТЬ Узел КАК Узел, Метка КАК Метка ПОМЕСТИТЬ ВТ_РодителиКомпонент
			|ИЗ ВТ_НовыеРодители ИНДЕКСИРОВАТЬ ПО Узел; УНИЧТОЖИТЬ ВТ_НовыеРодители";
		Запрос.ВыполнитьПакет();
		Если Изменено = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СвернутьРабочийГраф(Запрос, Контекст, Проход)

	// СвязиГрафа сохраняются для публикации и разделения; сокращается только рабочая смежность.
	// До завершения обоих переносов исходные рабочие таблицы остаются доступными.
	Запрос.Текст =
		"ВЫБРАТЬ Узел КАК Узел, Метка КАК Метка ПОМЕСТИТЬ ВТ_МеткиКомпонент
		|ИЗ Метки ГДЕ ЛОЖЬ;
		|ВЫБРАТЬ Первый КАК Первый, Второй КАК Второй ПОМЕСТИТЬ ВТ_СвязиКомпонент
		|ИЗ Смежность ГДЕ ЛОЖЬ";
	Запрос.ВыполнитьПакет();
	ПеренестиМеткиКомпонент(Запрос, Контекст, Проход);
	ПеренестиСвязиКомпонент(Запрос, Контекст, Проход);
	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
	СообщитьПодготовку(Контекст.Прогресс,
		СтрШаблон("Объединение компонент каскада: проход %1, запись сокращенного графа", Проход));
	Запрос.Текст =
		"УНИЧТОЖИТЬ Метки;
		|ВЫБРАТЬ Узел КАК Узел, Метка КАК Метка ПОМЕСТИТЬ Метки
		|ИЗ ВТ_МеткиКомпонент ИНДЕКСИРОВАТЬ ПО Узел;
		|УНИЧТОЖИТЬ Смежность;
		|ВЫБРАТЬ Первый КАК Первый, Второй КАК Второй ПОМЕСТИТЬ Смежность ИЗ ВТ_СвязиКомпонент
		|СГРУППИРОВАТЬ ПО Первый, Второй ИНДЕКСИРОВАТЬ ПО Первый, Второй;
		|УНИЧТОЖИТЬ ВТ_МеткиКомпонент; УНИЧТОЖИТЬ ВТ_СвязиКомпонент; УНИЧТОЖИТЬ ВТ_РодителиКомпонент;
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ОсталосьСвязей ИЗ Смежность";
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[7].Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ОсталосьСвязей;

КонецФункции

Процедура ПеренестиМеткиКомпонент(Запрос, Контекст, Проход)

	// Выгрузка результата запроса расширяет строковые типы; добавляем в индекс типизированную страницу.
	Страница = Новый ТаблицаЗначений;
	ТипКлюча = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Страница.Колонки.Добавить("Узел", ТипКлюча);
	Страница.Колонки.Добавить("Метка", ТипКлюча);
	ПоследнийУзел = "";
	Перенесено = 0;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Запрос.УстановитьПараметр("ПослеУзлаКомпоненты", ПоследнийУзел);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Узел КАК Узел, Метка КАК Метка ИЗ Метки
			|ГДЕ Узел > &ПослеУзлаКомпоненты УПОРЯДОЧИТЬ ПО Узел";
		Строки = Запрос.Выполнить().Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоследнийУзел = Строки[Строки.Количество() - 1].Узел;
		Родители = РодителиСтраницыКомпонент(Запрос, Строки.ВыгрузитьКолонку("Метка"));
		Страница.Очистить();
		Для Каждого СтрокаМетки Из Строки Цикл
			НоваяМетка = Страница.Добавить();
			НоваяМетка.Узел = СтрокаМетки.Узел;
			НоваяМетка.Метка = СтрокаМетки.Метка;
			Метка = Родители.Получить(СтрокаМетки.Метка);
			// Отсутствие рабочего родителя означает завершенную либо изолированную компоненту.
			Если Метка <> Неопределено Тогда
				НоваяМетка.Метка = Метка;
			КонецЕсли;
		КонецЦикла;
		Запрос.УстановитьПараметр("СтраницаКомпонент", Страница);
		Запрос.Текст =
			"ВЫБРАТЬ Страница.Узел КАК Узел, Страница.Метка КАК Метка
			|ДОБАВИТЬ ВТ_МеткиКомпонент ИЗ &СтраницаКомпонент КАК Страница";
		Запрос.Выполнить();
		Перенесено = Перенесено + Строки.Количество();
		Если Перенесено % 5000 = 0 Или Строки.Количество() < 500 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Объединение компонент каскада: проход %1, перенесено меток %2", Проход, Перенесено));
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("СтраницаКомпонент", Неопределено);

КонецПроцедуры

Процедура ПеренестиСвязиКомпонент(Запрос, Контекст, Проход)

	Страница = Новый ТаблицаЗначений;
	ТипКлюча = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	Страница.Колонки.Добавить("Первый", ТипКлюча);
	Страница.Колонки.Добавить("Второй", ТипКлюча);
	ПоследнийПервый = "";
	ПоследнийВторой = "";
	Перенесено = 0;
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Строки = СтраницаСвязейКомпонент(Запрос, ПоследнийПервый, ПоследнийВторой);
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		// Курсор относится к исходным ребрам, а не к замененным ниже представителям.
		ПоследнийПервый = Строки[Строки.Количество() - 1].Первый;
		ПоследнийВторой = Строки[Строки.Количество() - 1].Второй;
		Ключи = Строки.ВыгрузитьКолонку("Первый");
		Для Каждого СтрокаСвязи Из Строки Цикл
			Ключи.Добавить(СтрокаСвязи.Второй);
		КонецЦикла;
		Родители = РодителиСтраницыКомпонент(Запрос, Ключи);
		ЗаполнитьСтраницуСвязейКомпонент(Строки, Родители, Страница);
		Если Страница.Количество() > 0 Тогда
			Запрос.УстановитьПараметр("СтраницаКомпонент", Страница);
			Запрос.Текст =
				"ВЫБРАТЬ Страница.Первый КАК Первый, Страница.Второй КАК Второй
				|ДОБАВИТЬ ВТ_СвязиКомпонент ИЗ &СтраницаКомпонент КАК Страница";
			Запрос.Выполнить();
		КонецЕсли;
		Перенесено = Перенесено + Строки.Количество();
		Если Перенесено % 5000 = 0 Или Строки.Количество() < 500 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Объединение компонент каскада: проход %1, обработано связей %2", Проход, Перенесено));
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("СтраницаКомпонент", Неопределено);

КонецПроцедуры

Процедура ЗаполнитьСтраницуСвязейКомпонент(Строки, Родители, Страница)

	Страница.Очистить();
	Для Каждого СтрокаСвязи Из Строки Цикл
		Первый = Родители.Получить(СтрокаСвязи.Первый);
		Второй = Родители.Получить(СтрокаСвязи.Второй);
		Если Первый = Неопределено Или Второй = Неопределено Тогда
			ВызватьИсключение "Не найден представитель рабочего ребра каскада";
		КонецЕсли;
		Если Первый <> Второй Тогда
			НоваяСвязь = Страница.Добавить();
			НоваяСвязь.Первый = Первый;
			НоваяСвязь.Второй = Второй;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СтраницаСвязейКомпонент(Запрос, ПоследнийПервый, ПоследнийВторой)

	// Два диапазона не требуют фильтровать все предшествующие строки составного индекса.
	Запрос.УстановитьПараметр("ПослеПервогоКомпоненты", ПоследнийПервый);
	Запрос.УстановитьПараметр("ПослеВторогоКомпоненты", ПоследнийВторой);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500 Первый КАК Первый, Второй КАК Второй ИЗ Смежность
		|ГДЕ Первый = &ПослеПервогоКомпоненты И Второй > &ПослеВторогоКомпоненты
		|УПОРЯДОЧИТЬ ПО Первый, Второй";
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() < 500 Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Первый КАК Первый, Второй КАК Второй ИЗ Смежность
			|ГДЕ Первый > &ПослеПервогоКомпоненты УПОРЯДОЧИТЬ ПО Первый, Второй";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Строки.Количество() < 500 И Выборка.Следующий() Цикл
			НоваяСтрока = Строки.Добавить();
			НоваяСтрока.Первый = Выборка.Первый;
			НоваяСтрока.Второй = Выборка.Второй;
		КонецЦикла;
	КонецЕсли;
	Возврат Строки;

КонецФункции

Функция РодителиСтраницыКомпонент(Запрос, Ключи)

	Запрос.УстановитьПараметр("КлючиКомпонент", Ключи);
	Запрос.Текст =
		"ВЫБРАТЬ Узел КАК Узел, Метка КАК Метка ИЗ ВТ_РодителиКомпонент ГДЕ Узел В (&КлючиКомпонент)";
	Выборка = Запрос.Выполнить().Выбрать();
	Родители = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Родители.Вставить(Выборка.Узел, Выборка.Метка);
	КонецЦикла;
	Запрос.УстановитьПараметр("КлючиКомпонент", Неопределено);
	Возврат Родители;

КонецФункции

Процедура ПроверитьКлючиГрафа(Запрос, Контекст)

	// Сокращенные идентификаторы используются для поиска; равенство подтверждается полными ключами.
	// Одна строка единицы не может конфликтовать с другой: проверяются только общие ключи.
	// Полные цели уже сверены до записи каждого буфера ребер.
	Запрос.Текст =
		"ВЫБРАТЬ Узлы.КлючЕдиницы КАК КлючЕдиницы ПОМЕСТИТЬ ОбщиеЕдиницыГрафа
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид <> &Маркер
		|СГРУППИРОВАТЬ ПО Узлы.КлючЕдиницы ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 1
		|ИНДЕКСИРОВАТЬ ПО КлючЕдиницы;
		|ВЫБРАТЬ Узлы.Узел КАК Узел, Узлы.КлючЕдиницы КАК КлючЕдиницы ПОМЕСТИТЬ КлючиЕдиниц
		|ИЗ РегистрСведений.Cutter3000_Узлы КАК Узлы
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбщиеЕдиницыГрафа КАК ОбщиеКлючи
		| ПО Узлы.КлючЕдиницы = ОбщиеКлючи.КлючЕдиницы
		|ГДЕ Узлы.Запуск = &Запуск И Узлы.Вид <> &Маркер ИНДЕКСИРОВАТЬ ПО КлючЕдиницы, Узел;
		|УНИЧТОЖИТЬ ОбщиеЕдиницыГрафа";
	Запрос.ВыполнитьПакет();
	ПоследняяЕдиница = "";
	ПоследнийУзел = "";
	ПредыдущаяЕдиница = Неопределено;
	ПредыдущийКлюч = "";
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Запрос.УстановитьПараметр("Единица", ПоследняяЕдиница);
		Запрос.УстановитьПараметр("Узел", ПоследнийУзел);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 500 Ключи.Узел, Ключи.КлючЕдиницы, Узлы.ЕдиницаЗаписи
			|ИЗ КлючиЕдиниц КАК Ключи
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Узлы
			| ПО Ключи.Узел = Узлы.Узел И Узлы.Запуск = &Запуск
			|ГДЕ Ключи.КлючЕдиницы > &Единица ИЛИ (Ключи.КлючЕдиницы = &Единица И Ключи.Узел > &Узел)
			|УПОРЯДОЧИТЬ ПО Ключи.КлючЕдиницы, Ключи.Узел";
		Строки = Запрос.Выполнить().Выгрузить();
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого СтрокаУзла Из Строки Цикл
			Если СтрокаУзла.КлючЕдиницы = ПредыдущийКлюч
				И СтрокаУзла.ЕдиницаЗаписи <> ПредыдущаяЕдиница Тогда
				ВызватьИсключение "Коллизия единиц чернового индекса. Каскад не опубликован.";
			КонецЕсли;
			ПредыдущийКлюч = СтрокаУзла.КлючЕдиницы;
			ПредыдущаяЕдиница = СтрокаУзла.ЕдиницаЗаписи;
			ПоследняяЕдиница = СтрокаУзла.КлючЕдиницы;
			ПоследнийУзел = СтрокаУзла.Узел;
		КонецЦикла;
	КонецЦикла;
	Запрос.Текст = "УНИЧТОЖИТЬ КлючиЕдиниц";
	Запрос.Выполнить();

КонецПроцедуры

Процедура ОпубликоватьУзлыГрафа(Контекст, Задание, Строки, Группы, БуферПлана)

	Для Каждого СтрокаУзла Из Строки Цикл
		Группа = Группы.Получить(СтрокаУзла.Метка);
		Если Группа = Неопределено Тогда
			Группа = Строка(Новый УникальныйИдентификатор);
			Группы.Вставить(СтрокаУзла.Метка, Группа);
		КонецЕсли;
		Если БуферПлана.Состав.Количество() > 0 И (БуферПлана.Группа <> Группа
			Или БуферПлана.Состав.Количество() >= 500 Или БуферПлана.Объем >= 2 * 1024 * 1024) Тогда
			СохранитьБлокПлана(Контекст.Запуск, Задание, БуферПлана);
		КонецЕсли;
		БуферПлана.Группа = Группа;
		Если БуферПлана.ОбщаяОчередь Тогда
			ДобавитьСемяГруппы(БуферПлана.СеменаОчереди, СтрокаУзла.Узел, Группа, Истина);
		КонецЕсли;
		БуферПлана.Состав.Добавить(СтрокаУзла.Узел);
		БуферПлана.Объем = БуферПлана.Объем + 1024 + 2 * СтрДлина(СтрокаУзла.Узел);
	КонецЦикла;

КонецПроцедуры

Процедура ОпубликоватьСвязиГрафа(Контекст, ВременныеТаблицы, Задание)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	Буфер = Новый Структура("Набор,Источники,Цель,Локатор,Номер,Объем",
		РегистрыСведений.Cutter3000_Связи.СоздатьНаборЗаписей(), Новый Массив, "", "", 0, 0);
	Буфер.Набор.Отбор.Запуск.Установить(Задание);
	ПоследняяЦель = "";
	ПоследнийИсточник = "";
	Прочитано = 0;
	СообщитьПодготовку(Контекст.Прогресс, "Запись связей каскада: прочитано 0");
	Пока Истина Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Контекст.Запуск);
		Строки = СтраницаИсходныхСвязей(Запрос, ПоследняяЦель, ПоследнийИсточник, Истина);
		Если Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Запрос.УстановитьПараметр("ИсточникиПубликации", Строки.ВыгрузитьКолонку("УзелИсточник"));
		Запрос.Текст =
			"ВЫБРАТЬ Узел КАК Узел ИЗ ВТ_УзлыПубликации
			|ГДЕ Узел В (&ИсточникиПубликации) И Вид <> &ТабличнаяЧасть";
		Запрос.УстановитьПараметр("ТабличнаяЧасть", "ТабличнаяЧасть");
		Результат = Запрос.Выполнить();
		Источники = Новый Соответствие;
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Источники.Вставить(Выборка.Узел, Истина);
		КонецЦикла;
		Для Каждого СтрокаСвязи Из Строки Цикл
			ПоследняяЦель = СтрокаСвязи.Цель;
			ПоследнийИсточник = СтрокаСвязи.УзелИсточник;
			Если Источники.Получить(СтрокаСвязи.УзелИсточник) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Буфер.Цель <> СтрокаСвязи.Цель Или Буфер.Источники.Количество() = 500 Тогда
				СохранитьБлокСвязей(Задание, Буфер);
			КонецЕсли;
			Буфер.Цель = СтрокаСвязи.Цель;
			Буфер.Локатор = СтрокаСвязи.ЛокаторЦели;
			Буфер.Источники.Добавить(СтрокаСвязи.УзелИсточник);
		КонецЦикла;
		Прочитано = Прочитано + Строки.Количество();
		Если Прочитано % 5000 = 0 Или Строки.Количество() < 500 Тогда
			СообщитьПодготовку(Контекст.Прогресс,
				СтрШаблон("Запись связей каскада: прочитано %1, блоков %2", Прочитано, Буфер.Номер));
		КонецЕсли;
	КонецЦикла;
	СохранитьБлокСвязей(Задание, Буфер);
	Объем = Буфер.Объем;
	СохранитьПакетСлужебныхЗаписей(Буфер.Набор, Объем, Истина);

КонецПроцедуры


Процедура СохранитьБлокПлана(Запуск, Задание, БуферПлана)

	Если БуферПлана.Состав.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись = БуферПлана.Набор.Добавить();
	Запись.Запуск = Запуск;
	Запись.Задание = Задание;
	Запись.Группа = БуферПлана.Группа;
	ОбщаяОчередь = Ложь;
	Если БуферПлана.Свойство("ОбщаяОчередь", ОбщаяОчередь) И ОбщаяОчередь Тогда
		Запись.Граф = Задание;
	КонецЕсли;
	Запись.Элемент = Строка(Новый УникальныйИдентификатор);
	Запись.Вид = "ПакетПлана";
	Запись.Порядок = БуферПлана.Состав.Количество();
	// Индекс неизменяем до завершения задания; полные поля повторно не записываются.
	Данные = Новый Структура("Индекс,Узлы", БуферПлана.Индекс, БуферПлана.Состав);
	Хранилище = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(1));
	Запись.Локатор = "Cutter3000Plan/2:" + ЗначениеВСтрокуВнутр(Хранилище);
	ОбъемНабора = БуферПлана.ОбъемНабора + 1024 + 2 * СтрДлина(Запись.Локатор);
	СохранитьПакетСлужебныхЗаписей(БуферПлана.Набор, ОбъемНабора);
	БуферПлана.ОбъемНабора = ОбъемНабора;
	Размеры = Неопределено;
	Если БуферПлана.Свойство("РазмерыГрупп", Размеры) Тогда
		Размер = Размеры.Получить(БуферПлана.Группа);
		Если Размер = Неопределено Тогда
			Размер = 0;
		КонецЕсли;
		Размеры.Вставить(БуферПлана.Группа, Размер + БуферПлана.Состав.Количество());
	КонецЕсли;
	БуферПлана.Состав.Очистить();
	БуферПлана.Объем = 0;

КонецПроцедуры

Процедура СохранитьБлокСвязей(Задание, Буфер)

	Если Буфер.Источники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Буфер.Номер = Буфер.Номер + 1;
	Запись = Буфер.Набор.Добавить();
	Запись.Запуск = Задание;
	Запись.Цель = Буфер.Цель;
	Запись.УзелИсточник = "ПакетСвязей";
	Запись.Вхождение = Буфер.Номер;
	Данные = Новый Структура("Локатор,Источники", Буфер.Локатор, Буфер.Источники);
	Запись.ЛокаторЦели = "Cutter3000Links/1:" + ЗначениеВСтрокуВнутр(Данные);
	Объем = Буфер.Объем + 1024 + 2 * СтрДлина(Запись.ЛокаторЦели);
	СохранитьПакетСлужебныхЗаписей(Буфер.Набор, Объем);
	Буфер.Объем = Объем;
	Буфер.Источники.Очистить();

КонецПроцедуры

Функция ОпубликованныйИндексЗадания(Задание)

	Запись = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
	Запись.Запуск = Задание;
	Запись.Узел = "ИндексКаскада";
	Запись.Прочитать();
	Если Запись.Вид = "ИндексКаскада" Тогда
		Возврат Запись.Таблица;
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ЗарегистрироватьИндексКаскада(Контекст, Задание, Индекс)

	Запись = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
	Запись.Запуск = Задание;
	Запись.Узел = "ИндексКаскада";
	Запись.Прочитать();
	Если Запись.Вид <> "" Тогда
		ВызватьИсключение "Задание Cutter3000 уже владеет опубликованным индексом.";
	КонецЕсли;
	Запись.Запуск = Задание;
	Запись.Узел = "ИндексКаскада";
	Запись.Вид = "ИндексКаскада";
	Запись.Таблица = Индекс;
	Запись.Метаданные = Контекст.Запуск;
	Запись.Обработан = Истина;
	Запись.Записать();

КонецПроцедуры

Функция ТекстАктивныхИндексов(ИмяТаблицы, ПараметрЗапуска)

	// Оба аргумента задаются только константами в двух внутренних местах вызова.
	Возврат СтрШаблон(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ План.Задание КАК Задание,
		| ЕСТЬNULL(Индексы.Таблица, План.Задание) КАК Индекс ПОМЕСТИТЬ %1
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Узлы КАК Индексы
		| ПО Индексы.Запуск = План.Задание И Индексы.Узел = &МаркерИндекса
		|ГДЕ План.Запуск = &%2 И НЕ План.Пропущено ИНДЕКСИРОВАТЬ ПО Индекс, Задание;",
		ИмяТаблицы, ПараметрЗапуска);

КонецФункции

Процедура ДобавитьВходящиеБлоков(Снимок, Задание, Ключи, ИзвестныеЛокаторы)

	Индекс = ОпубликованныйИндексЗадания(Задание);
	Если Индекс = "" Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Связи.ЛокаторЦели КАК Данные
		|ИЗ РегистрСведений.Cutter3000_Связи КАК Связи
		|ГДЕ Связи.Запуск = &Задание И Связи.Цель В (&Ключи) И Связи.УзелИсточник = &Маркер");
	Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Маркер", "ПакетСвязей");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Порция = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = ДанныеБлокаСвязей(Выборка.Данные);
		Входящие = Снимок.Входящие.Получить(Данные.Локатор);
		Для Каждого Источник Из Данные.Источники Цикл
			ЛокаторИсточника = ИзвестныеЛокаторы.Получить(Источник);
			Если ЛокаторИсточника <> Неопределено Тогда
				Если Входящие = Неопределено Тогда
					Входящие = Новый Соответствие;
					Снимок.Входящие.Вставить(Данные.Локатор, Входящие);
				КонецЕсли;
				Входящие.Вставить(ЛокаторИсточника, Истина);
			Иначе
				Порция.Добавить(Новый Структура("Источник,Локатор", Источник, Данные.Локатор));
				Если Порция.Количество() = 500 Тогда
					ДобавитьВходящиеПорции(Снимок, Индекс, Порция, ИзвестныеЛокаторы);
					Порция.Очистить();
					Входящие = Снимок.Входящие.Получить(Данные.Локатор);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Порция.Количество() > 0 Тогда
		ДобавитьВходящиеПорции(Снимок, Индекс, Порция, ИзвестныеЛокаторы);
	КонецЕсли;

КонецПроцедуры

Функция ДанныеБлокаСвязей(Текст)

	Префикс = "Cutter3000Links/1:";
	Если Лев(Текст, СтрДлина(Префикс)) <> Префикс Тогда
		ВызватьИсключение "Неизвестный формат блока связей Cutter3000.";
	КонецЕсли;
	Данные = ЗначениеИзСтрокиВнутр(Сред(Текст, СтрДлина(Префикс) + 1));
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "Поврежден блок связей Cutter3000.";
	КонецЕсли;
	Если Не Данные.Свойство("Локатор") Или Не Данные.Свойство("Источники") Тогда
		ВызватьИсключение "Не заполнен состав блока связей Cutter3000.";
	КонецЕсли;
	Если ТипЗнч(Данные.Локатор) <> Тип("Строка") Или ТипЗнч(Данные.Источники) <> Тип("Массив") Тогда
		ВызватьИсключение "Повреждены поля блока связей Cutter3000.";
	КонецЕсли;
	Если Данные.Локатор = "" Тогда
		ВызватьИсключение "Не заполнен локатор блока связей Cutter3000.";
	КонецЕсли;
	Если Данные.Источники.Количество() = 0 Или Данные.Источники.Количество() > 500 Тогда
		ВызватьИсключение "Неверный размер блока связей Cutter3000.";
	КонецЕсли;
	Для Каждого Источник Из Данные.Источники Цикл
		Если ТипЗнч(Источник) <> Тип("Строка") Тогда
			ВызватьИсключение "Поврежден ключ источника блока связей Cutter3000.";
		КонецЕсли;
		Если СтрДлина(Источник) <> 64 Тогда
			ВызватьИсключение "Неверный ключ источника блока связей Cutter3000.";
		КонецЕсли;
	КонецЦикла;
	Возврат Данные;

КонецФункции

Процедура ДобавитьВходящиеПорции(Снимок, Индекс, Порция, ИзвестныеЛокаторы)

	Ключи = Новый Массив;
	Локаторы = Новый Соответствие;
	Для Каждого Ребро Из Порция Цикл
		Локатор = ИзвестныеЛокаторы.Получить(Ребро.Источник);
		Если Локатор = Неопределено Тогда
			Ключи.Добавить(Ребро.Источник);
		Иначе
			Локаторы.Вставить(Ребро.Источник, Локатор);
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() > 0 Тогда
		ДополнитьЛокаторыВходящих(Локаторы, Индекс, Ключи);
	КонецЕсли;
	Для Каждого Ребро Из Порция Цикл
		Владелец = Локаторы.Получить(Ребро.Источник);
		Если Владелец = Неопределено Тогда
			ВызватьИсключение "Не найден источник опубликованного каскада Cutter3000.";
		КонецЕсли;
		Входящие = Снимок.Входящие.Получить(Ребро.Локатор);
		Если Входящие = Неопределено Тогда
			Входящие = Новый Соответствие;
			Снимок.Входящие.Вставить(Ребро.Локатор, Входящие);
		КонецЕсли;
		Входящие.Вставить(Владелец, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьЛокаторыВходящих(Локаторы, Индекс, Ключи)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Узел КАК Узел, Локатор КАК Локатор ИЗ РегистрСведений.Cutter3000_Узлы
		|ГДЕ Запуск = &Индекс И Узел В (&Ключи) И Вид <> &ТабличнаяЧасть");
	Запрос.УстановитьПараметр("Индекс", Индекс);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("ТабличнаяЧасть", "ТабличнаяЧасть");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Локаторы.Вставить(Выборка.Узел, Выборка.Локатор);
	КонецЦикла;

КонецПроцедуры

Процедура ЗакрепитьИндексЗаЗаданием(Контекст, Задание, Индекс)

	Если РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Узел КАК Узел ИЗ РегистрСведений.Cutter3000_Узлы
			|ГДЕ Запуск = &Индекс И Узел = &Маркер ДЛЯ ИЗМЕНЕНИЯ");
		Запрос.УстановитьПараметр("Индекс", Индекс);
		Запрос.УстановитьПараметр("Маркер", "ЧерновикКаскада");
		Запрос.Выполнить();
	Иначе
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Узлы");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Запуск", Индекс);
		Элемент.УстановитьЗначение("Узел", "ЧерновикКаскада");
		Блокировка.Заблокировать();
	КонецЕсли;
	Запись = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
	Запись.Запуск = Индекс;
	Запись.Узел = "ЧерновикКаскада";
	Запись.Прочитать();
	Если Запись.Таблица <> "" Тогда
		ВызватьИсключение "Граф Cutter3000 уже передан заданию.";
	КонецЕсли;
	Если Запись.Метаданные <> "" И Запись.Метаданные <> Контекст.Запуск Тогда
		ВызватьИсключение "Граф Cutter3000 принадлежит другому запуску.";
	КонецЕсли;
	Запись.Запуск = Индекс;
	Запись.Узел = "ЧерновикКаскада";
	Запись.Вид = "ЧерновикКаскада";
	Запись.Метаданные = Контекст.Запуск;
	Запись.Таблица = Задание;
	Запись.Обработан = Истина;
	Запись.Записать();

КонецПроцедуры

Функция ИндексИспользуетсяЗаданием(Индекс)

	Запись = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
	Запись.Запуск = Индекс;
	Запись.Узел = "ЧерновикКаскада";
	Запись.Прочитать();
	Если Запись.Таблица = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОпубликованныйИндексЗадания(Запись.Таблица) = Индекс;

КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункцииОчереди

Функция ПодготовитьСеменаОчереди(Контекст, Порция)

	Результат = Новый Структура("Локаторы,Короткие,Группы", Новый Соответствие,
		Новый Соответствие, Новый Соответствие);
	Если Не Контекст.Свойство("ОбщаяОчередь") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого СтрокаСемени Из ЭлементыСнимкаКаскада(Порция.Семена) Цикл
		Элемент = Новый Структура("Метаданные,Вид,Локатор,ЕдиницаЗаписи");
		ЗаполнитьЗначенияСвойств(Элемент, СтрокаСемени);
		Результат.Локаторы.Вставить(Элемент.Локатор, Элемент);
		Ключ = ХешКлюча(Элемент.Локатор);
		Если Результат.Короткие.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение "Коллизия полных ключей исходных корней очереди.";
		КонецЕсли;
		Результат.Короткие.Вставить(Ключ, Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьСемяГруппы(Семена, Ключ, Группа, Короткий = Ложь)

	Если Короткий Тогда
		Элемент = Семена.Короткие.Получить(Ключ);
	Иначе
		Элемент = Семена.Локаторы.Получить(Ключ);
	КонецЕсли;
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ГруппаСемян = Семена.Группы.Получить(Группа);
	Если ГруппаСемян = Неопределено Тогда
		ГруппаСемян = Новый Массив;
		Семена.Группы.Вставить(Группа, ГруппаСемян);
	КонецЕсли;
	ГруппаСемян.Добавить(Элемент);

КонецПроцедуры

Процедура ОтметитьУстаревшийПлан(Контекст)

	Если Контекст <> Неопределено Тогда
		Контекст.Вставить("ПланУстарел", Истина);
	КонецЕсли;

КонецПроцедуры



Процедура ПроверитьКорниОчереди(Снимок, Контекст)

	Семена = Неопределено;
	Если Не Контекст.Свойство("СеменаПорции", Семена) Тогда
		Возврат;
	КонецЕсли;
	ВладельцыНарушений = Неопределено;
	Для Каждого Семя Из Семена Цикл
		Узел = Снимок.Узлы.Получить(Семя.Локатор);
		Если Узел = Неопределено Тогда
			ОтметитьУстаревшийПлан(Контекст);
			ВызватьИсключение "Исходный корень каскада изменился после публикации.";
		КонецЕсли;
		Поле = ПолеПериода(Узел.Таблица);
		Если Поле <> "" И Узел.Поля[Поле] < Контекст.ГраницаОчереди Тогда
			Продолжить;
		КонецЕсли;
		Если ВладельцыНарушений = Неопределено Тогда
			ВладельцыНарушений = ВладельцыБитыхСсылок(Снимок);
		КонецЕсли;
		Если ВладельцыНарушений.Получить(Семя.Локатор) = Неопределено Тогда
			ОтметитьУстаревшийПлан(Контекст);
			ВызватьИсключение "Исходный корень больше не соответствует границе обрезки.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
