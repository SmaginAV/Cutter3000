
#Область ПрограммныйИнтерфейс

// Публикует очередь целых компонент в уже открытой транзакции публикации графа.
// Параметры:
//  Контекст - Структура - контекст запуска.
//  Порция - Структура - общий граф и полосы.
//  План - Структура - размеры компонент и исходные корни.
Процедура Опубликовать(Контекст, Порция, План) Экспорт

	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Группы.Колонки.Добавить("Всего", Новый ОписаниеТипов("Число"));
	Для Каждого Пара Из План.РазмерыГрупп Цикл
		СтрокаГруппы = Группы.Добавить();
		СтрокаГруппы.Группа = Пара.Ключ;
		СтрокаГруппы.Всего = Пара.Значение;
	КонецЦикла;
	Группы.Сортировать("Группа");
	Набор = РегистрыСведений.Cutter3000_Пакеты.СоздатьНаборЗаписей();
	Набор.Отбор.Запуск.Установить(Контекст.Запуск);
	РазмерПорции = 2000;
	Номер = 0;
	Пакет = НовыйПакет(Порция);
	Всего = 0;
	Для Каждого Группа Из Группы Цикл
		Если Пакет.Всего > 0 И Пакет.Всего + Группа.Всего > РазмерПорции Тогда
			Номер = Номер + 1;
			ДобавитьПакет(Набор, Порция, Пакет, Номер);
			Пакет = НовыйПакет(Порция);
		КонецЕсли;
		Пакет.Группы.Добавить(Группа.Группа);
		Пакет.Всего = Пакет.Всего + Группа.Всего;
		Пакет.Размеры.Вставить(Группа.Группа, Группа.Всего);
		Семена = План.СеменаГрупп.Получить(Группа.Группа);
		Если Семена = Неопределено Или Семена.Количество() = 0 Тогда
			ВызватьИсключение "Для компоненты очереди не сохранены исходные корни.";
		КонецЕсли;
		Пакет.Семена.Вставить(Группа.Группа, Семена);
		Всего = Всего + Группа.Всего;
	КонецЦикла;
	Если Пакет.Всего > 0 Тогда
		ДобавитьПакет(Набор, Порция, Пакет, Номер + 1);
	КонецЕсли;
	Если Всего <> План.Всего Тогда
		ВызватьИсключение "При упаковке очереди изменилось количество узлов графа.";
	КонецЕсли;
	Маркер = Набор.Добавить();
	Маркер.Запуск = Контекст.Запуск;
	Маркер.Пакет = Порция.Задание;
	Маркер.Граф = Порция.Задание;
	Маркер.Состояние = "Граф";
	Набор.Записать(Ложь);

КонецПроцедуры

// Возвращает закреплённый пакет либо Неопределено. Захват отделён от удаления данных.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор работника.
//  НомерПотока - Число - номер существующего слота с нуля.
//  КоличествоУдалений - Число - 2 либо 3; число кандидатов при одновременном захвате.
// Возвращаемое значение:
//  Структура, Неопределено - закреплённый пакет либо отсутствие готовой работы.
Функция Захватить(Запуск, Работник, НомерПотока, КоличествоУдалений = 2) Экспорт

	Cutter3000_ЗаданияСервер.ПроверитьОстановку(Запуск);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Пакеты.Пакет КАК Пакет
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Состояние = &Готово
		|УПОРЯДОЧИТЬ ПО Пакеты.НомерОчереди, Пакеты.Пакет");
	Если КоличествоУдалений = 3 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 2", "ПЕРВЫЕ 3");
	КонецЕсли;
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Готово", "Готово");
	Результат = Запрос.Выполнить();
	Кандидаты = Результат.Выбрать();
	Пока Кандидаты.Следующий() Цикл
		Захвачен = Ложь;
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
		Попытка
			ЗаблокироватьПакет(Запуск, Кандидаты.Пакет);
			Пакет = ЗаписьПакета(Запуск, Кандидаты.Пакет);
			Если Пакет.Состояние = "Готово" Тогда
				Данные = Пакет.Данные.Получить();
				Пакет.Состояние = "Удаление";
				Пакет.Работник = Работник;
				Пакет.Работа = Данные.Полосы[НомерПотока % Данные.Полосы.Количество()];
				Пакет.Записать();
				ПодготовитьСостояниеПакета(Пакет);
				Захвачен = Истина;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		Если Захвачен Тогда
			Работа = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
			Работа.Запуск = Запуск;
			Работа.Задание = Пакет.Работа;
			Работа.Прочитать();
			Возврат Новый Структура("Пакет,Граф,Работа,Размеры,Семена,Повторы,Граница",
				Пакет.Пакет, Пакет.Граф, Пакет.Работа, Данные.Размеры, Данные.Семена,
				Данные.Повторы, Работа.Граница);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Читает незавершённые группы одного уже закреплённого задания без группировки общего плана.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Пакет - Строка - идентификатор закреплённого пакета.
//  ГруппыРазбора - Массив из Строка, Неопределено - группы после отката.
// Возвращаемое значение:
//  Массив из Строка - незавершённые группы пакета.
Функция ГруппыПакета(Запуск, Пакет, ГруппыРазбора = Неопределено) Экспорт

	Запись = ЗаписьПакета(Запуск, Пакет);
	Результат = Новый Массив;
	Если Запись.Состояние <> "Удаление" Тогда
		Возврат Результат;
	КонецЕсли;
	Данные = Запись.Данные.Получить();
	Для Каждого Группа Из Данные.Группы Цикл
		Если Данные.Завершенные.Получить(Группа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ГруппыРазбора <> Неопределено И ГруппыРазбора.Найти(Группа) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Группа);
		Если ГруппыРазбора <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Записывает завершение групп в той же транзакции, что и прикладное удаление либо его откатный разбор.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Пакет - Строка - идентификатор пакета.
//  Состав - ТаблицаЗначений - целые компоненты текущей попытки.
//  Перестроить - Булево - сохранить корни для нового построения.
Процедура ЗавершитьГруппы(Запуск, Пакет, Состав, Перестроить = Ложь) Экспорт

	Запись = ЗаписьПакета(Запуск, Пакет);
	Если Запись.Состояние <> "Удаление" Тогда
		ВызватьИсключение "Пакет каскадов потерял закрепление за работником.";
	КонецЕсли;
	Данные = Запись.Данные.Получить();
	Для Каждого Элемент Из Состав Цикл
		Если Данные.Завершенные.Получить(Элемент.Группа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Данные.Завершенные.Вставить(Элемент.Группа, Истина);
		Если Перестроить Тогда
			Семена = Данные.Семена.Получить(Элемент.Группа);
			Если Семена = Неопределено Или Семена.Количество() = 0 Тогда
				ВызватьИсключение "Для изменившейся компоненты не сохранены исходные корни.";
			КонецЕсли;
			Данные.Перестроения.Вставить(Элемент.Группа, Семена);
			Запись.Всего = Запись.Всего - Данные.Размеры[Элемент.Группа];
		КонецЕсли;
	КонецЦикла;
	Если Данные.Завершенные.Количество() = Данные.Группы.Количество() Тогда
		Запись.Состояние = "ГотовоПерестроение";
		Если Данные.Перестроения.Количество() = 0 Тогда
			Запись.Состояние = "Завершено";
		КонецЕсли;
	КонецЕсли;
	Запись.Данные = Новый ХранилищеЗначения(Данные);
	Запись.Записать();
	Если Перестроить Тогда
		Состояние = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
		Состояние.Запуск = Запуск;
		Состояние.Задание = Пакет;
		Состояние.Прочитать();
		Состояние.Всего = Запись.Всего;
		Состояние.Записать();
	КонецЕсли;

КонецПроцедуры

// Позволяет отличить пакет общей очереди от прежней логической работы.
// Параметры:
//  Задание - Строка - идентификатор задания.
// Возвращаемое значение:
//  Булево - задание является пакетом общей очереди.
Функция ЭтоПакет(Задание) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Пакеты.Пакет
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Пакет = &Пакет И Пакеты.Граф <> Пакеты.Пакет");
	Запрос.УстановитьПараметр("Пакет", Задание);
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();

КонецФункции

// Возвращает наличие заданий либо место для следующего опубликованного графа.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  ТолькоГотовые - Булево - искать только готовые пакеты.
// Возвращаемое значение:
//  Булево - найдена работа в выбранном состоянии.
Функция ЕстьРабота(Запуск, ТолькоГотовые = Ложь) Экспорт

	Состояния = СтрРазделить("Граф,Готово,Удаление,ГотовоПерестроение", ",");
	Если ТолькоГотовые Тогда
		Состояния = СтрРазделить("Готово", ",");
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Пакеты.Пакет
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Состояние В (&Состояния)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();

КонецФункции

// Запуск - Строка. Возвращает Булево: одновременно публикуются не более двух графов.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Булево - опубликовано меньше двух графов.
Функция ЕстьМесто(Запуск) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Пакеты.Пакет
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Состояние = &Граф");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Граф", "Граф");
	Результат = Запрос.Выполнить();
	Строки = Результат.Выгрузить();
	Возврат Строки.Количество() < 2;

КонецФункции

// Очищает общий индекс лишь после завершения всех его потребителей, вне транзакции удаления.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ОчиститьЗавершенныеГрафы(Запуск) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ Маркеры.Пакет КАК Граф
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Маркеры
		|ГДЕ Маркеры.Запуск = &Запуск И Маркеры.Состояние = &Маркер
		| И Маркеры.Пакет НЕ В (ВЫБРАТЬ Пакеты.Граф
		| ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		| ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Состояние В (&Активные))");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Маркер", "Граф");
	Запрос.УстановитьПараметр("Активные", СтрРазделить("Готово,Удаление", ","));
	Результат = Запрос.Выполнить();
	Графы = Результат.Выбрать();
	Пока Графы.Следующий() Цикл
		Cutter3000_ЗаданияСервер.ПроверитьОстановку(Запуск);
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
		Попытка
			СохранитьПропускиГрафа(Запуск, Графы.Граф);
			План = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
			План.Отбор.Запуск.Установить(Запуск);
			План.Отбор.Граф.Установить(Графы.Граф);
			План.Записать();
			Cutter3000_ДанныеСервер.ОчиститьИндексКаскадов(Графы.Граф);
			СвернутьСостоянияГрафа(Запуск, Графы.Граф);
			Маркер = ЗаписьПакета(Запуск, Графы.Граф);
			Если ЕстьПерестроениеГрафа(Запуск, Графы.Граф) Тогда
				Маркер.Состояние = "ГрафЗакрыт";
				Маркер.Записать();
			Иначе
				Маркер.Удалить();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Возвращает корни одной изменившейся компоненты после освобождения общего графа либо Неопределено.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Структура, Неопределено - корни изменившейся компоненты либо отсутствие перестроений.
Функция СледующееПерестроение(Запуск) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Пакеты.Пакет КАК Пакет
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Пакеты КАК Графы
		| ПО Графы.Запуск = Пакеты.Запуск И Графы.Пакет = Пакеты.Граф
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Состояние = &Перестроение
		| И Графы.Состояние = &Закрыт УПОРЯДОЧИТЬ ПО Пакеты.Пакет");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Перестроение", "ГотовоПерестроение");
	Запрос.УстановитьПараметр("Закрыт", "ГрафЗакрыт");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пакет = ЗаписьПакета(Запуск, Выборка.Пакет);
	Данные = Пакет.Данные.Получить();
	Для Каждого Пара Из Данные.Перестроения Цикл
		Возврат Новый Структура("Пакет,Группа,Семена,Полосы,Повторы", Пакет.Пакет, Пара.Ключ,
			Пара.Значение, Данные.Полосы, Данные.Повторы + 1);
	КонецЦикла;
	ВызватьИсключение "У изменившегося пакета отсутствуют корни перестроения.";

КонецФункции

// Подтверждает передачу корней координатору; повторное построение уже хранится в его очереди.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Перестроение - Структура - идентификаторы пакета и группы.
Процедура ПодтвердитьПерестроение(Запуск, Перестроение) Экспорт

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		Пакет = ЗаписьПакета(Запуск, Перестроение.Пакет);
		Данные = Пакет.Данные.Получить();
		Данные.Перестроения.Удалить(Перестроение.Группа);
		Если Данные.Перестроения.Количество() = 0 Тогда
			Граф = Пакет.Граф;
			Пакет.Удалить();
			Если Не ЕстьПерестроениеГрафа(Запуск, Граф) Тогда
				Маркер = ЗаписьПакета(Запуск, Граф);
				Маркер.Удалить();
			КонецЕсли;
		Иначе
			Пакет.Данные = Новый ХранилищеЗначения(Данные);
			Пакет.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры


// Дополняет строки логических работ только текущими пакетами; завершённые графы сворачиваются в итоги.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работы - ТаблицаЗначений - логические строки прогресса.
// Возвращаемое значение:
//  ТаблицаЗначений - строки с текущими итогами пакетов.
Функция ДополнитьРаботы(Запуск, Работы) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ Пакеты.Работа КАК Работа,
		| СУММА(Пакеты.Всего) КАК Всего, СУММА(ЕСТЬNULL(Задания.Обработано, 0)) КАК Обработано,
		| СУММА(ЕСТЬNULL(Задания.Ошибок, 0)) КАК Ошибок
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Задания КАК Задания
		| ПО Задания.Запуск = Пакеты.Запуск И Задания.Задание = Пакеты.Пакет
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Работа <> &Пусто
		|СГРУППИРОВАТЬ ПО Пакеты.Работа");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Пусто", "");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРаботы = Работы.Найти(Выборка.Работа, "Идентификатор");
		Если СтрокаРаботы = Неопределено Тогда
			Состояние = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
			Состояние.Запуск = Запуск;
			Состояние.Задание = Выборка.Работа;
			Состояние.Прочитать();
			СтрокаРаботы = Работы.Добавить();
			СтрокаРаботы.Идентификатор = Выборка.Работа;
			СтрокаРаботы.Наименование = Состояние.Наименование;
			СтрокаРаботы.ВидОперации = Состояние.ВидОперации;
			СтрокаРаботы.Всего = Состояние.Всего;
			СтрокаРаботы.Зафиксировано = Состояние.Обработано;
			СтрокаРаботы.Ошибок = Состояние.Ошибок;
			СтрокаРаботы.ТекущаяПопытка = 0;
			СтрокаРаботы.Прогресс = 0;
		КонецЕсли;
		СтрокаРаботы.Всего = СтрокаРаботы.Всего + Выборка.Всего;
		СтрокаРаботы.Зафиксировано = СтрокаРаботы.Зафиксировано + Выборка.Обработано;
		СтрокаРаботы.Ошибок = СтрокаРаботы.Ошибок + Выборка.Ошибок;
		СтрокаРаботы.Этап = "Удаление каскада";
		СтрокаРаботы.Состояние = "Выполняется";
	КонецЦикла;
	Возврат Работы;

КонецФункции

// Сопоставляет технические пакеты с неизменными строками логических работ для снимков прогресса.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Соответствие - идентификатор пакета и структура Работа, Обработано, Ошибок.
Функция КартаРабот(Запуск) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ Пакеты.Пакет КАК Пакет, Пакеты.Работа КАК Работа,
		| ЕСТЬNULL(Задания.Обработано, 0) КАК Обработано, ЕСТЬNULL(Задания.Ошибок, 0) КАК Ошибок
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Задания КАК Задания
		| ПО Задания.Запуск = Пакеты.Запуск И Задания.Задание = Пакеты.Пакет
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Работа <> &Пусто");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Пусто", "");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Карта = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(Выборка.Пакет, Новый Структура("Работа,Обработано,Ошибок",
			Выборка.Работа, Выборка.Обработано, Выборка.Ошибок));
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Проверяет сохранённые причины ожидания без повторного чтения узлов графа.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Графы - Массив из Структура - сохранённые блокирующие графы.
// Возвращаемое значение:
//  Булево - хотя бы один блокирующий граф ещё существует.
Функция ОжидаютсяГрафы(Запуск, Графы) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Пакет В (&Графы) И Пакеты.Состояние = &Граф");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Графы", Графы);
	Запрос.УстановитьПараметр("Граф", "Граф");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Всего = Графы.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйПакет(Порция)

	Повторы = 0;
	Если Не Порция.Свойство("ПовторыПерестроения", Повторы) Тогда
		Повторы = 0;
	КонецЕсли;
	Возврат Новый Структура("Группы,Всего,Размеры,Семена,Завершенные,Перестроения,Полосы,Повторы",
		Новый Массив, 0, Новый Соответствие, Новый Соответствие, Новый Соответствие,
		Новый Соответствие, Порция.Полосы, Повторы);

КонецФункции

Процедура ДобавитьПакет(Набор, Порция, Данные, Номер)

	Запись = Набор.Добавить();
	Запись.Запуск = Набор.Отбор.Запуск.Значение;
	Запись.Пакет = Строка(Новый УникальныйИдентификатор);
	Запись.Граф = Порция.Задание;
	Запись.Состояние = "Готово";
	Запись.Всего = Данные.Всего;
	Запись.НомерОчереди = Номер;
	Запись.Работа = Данные.Полосы[(Номер - 1) % Данные.Полосы.Количество()];
	Запись.Данные = Новый ХранилищеЗначения(Данные);

КонецПроцедуры

Функция ЗаписьПакета(Запуск, Пакет)

	Запись = РегистрыСведений.Cutter3000_Пакеты.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Пакет = Пакет;
	Запись.Прочитать();
	Возврат Запись;

КонецФункции

Процедура ЗаблокироватьПакет(Запуск, Пакет)

	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Пакеты.Пакет
			|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
			|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Пакет = &Пакет ДЛЯ ИЗМЕНЕНИЯ");
		Запрос.УстановитьПараметр("Запуск", Запуск);
		Запрос.УстановитьПараметр("Пакет", Пакет);
		Результат = Запрос.Выполнить();
	Иначе
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Пакеты");
		Элемент.УстановитьЗначение("Запуск", Запуск);
		Элемент.УстановитьЗначение("Пакет", Пакет);
		Блокировка.Заблокировать();
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьСостояниеПакета(Пакет)

	Работа = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
	Работа.Запуск = Пакет.Запуск;
	Работа.Задание = Пакет.Работа;
	Работа.Прочитать();
	Состояние = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
	Состояние.Запуск = Пакет.Запуск;
	Состояние.Задание = Пакет.Пакет;
	Состояние.ВидОперации = "Пакет";
	Состояние.Наименование = Работа.Наименование;
	Состояние.Граница = Работа.Граница;
	Состояние.Всего = Пакет.Всего;
	Состояние.Работник = Пакет.Работник;
	Состояние.Этап = "Удаление каскада";
	Состояние.Состояние = "Выполняется";
	Состояние.Начало = ТекущаяДатаСеанса();
	Состояние.Обновление = Состояние.Начало;
	Состояние.Записать();

КонецПроцедуры


Процедура СохранитьПропускиГрафа(Запуск, Граф)

	// Сохраняются все поля отказавших строк, включая полные локаторы и единицы записи.
	// Эти маркеры живут до конца запуска и не должны исчезать вместе с общим графом.
	Запрос = Новый Запрос("ВЫБРАТЬ План.*
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Граф = &Граф И План.Пропущено");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Граф", Граф);
	Результат = Запрос.Выполнить();
	Пропуски = Результат.Выгрузить();
	Если Пропуски.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПропуска Из Пропуски Цикл
		СтрокаПропуска.Граф = "";
	КонецЦикла;
	Набор = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
	Набор.Отбор.Запуск.Установить(Запуск);
	Набор.Загрузить(Пропуски);
	Набор.Записать(Ложь);

КонецПроцедуры

Процедура СвернутьСостоянияГрафа(Запуск, Граф)

	Запрос = Новый Запрос("ВЫБРАТЬ Пакеты.Пакет КАК Пакет, Пакеты.Работа КАК Работа
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Граф = &Граф И Пакеты.Пакет <> &Граф");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Граф", Граф);
	Результат = Запрос.Выполнить();
	Пакеты = Результат.Выбрать();
	Карта = Новый Соответствие;
	Пока Пакеты.Следующий() Цикл
		Состояние = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
		Состояние.Запуск = Запуск;
		Состояние.Задание = Пакеты.Пакет;
		Состояние.Прочитать();
		Работа = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
		Работа.Запуск = Запуск;
		Работа.Задание = Пакеты.Работа;
		Работа.Прочитать();
		Работа.Всего = Работа.Всего + Состояние.Всего;
		Работа.Обработано = Работа.Обработано + Состояние.Обработано;
		Работа.Ошибок = Работа.Ошибок + Состояние.Ошибок;
		Если Состояние.ОписаниеОшибки <> "" Тогда
			Работа.ОписаниеОшибки = Состояние.ОписаниеОшибки;
			Работа.Контекст = Состояние.Контекст;
		КонецЕсли;
		Работа.Обновление = ТекущаяДатаСеанса();
		Работа.Этап = "Ожидание каскада";
		Работа.Записать();
		Карта.Вставить(Пакеты.Пакет, Пакеты.Работа);
		Состояние.Удалить();
		Пакет = ЗаписьПакета(Запуск, Пакеты.Пакет);
		Если Пакет.Состояние = "Завершено" Тогда
			Пакет.Удалить();
		Иначе
			Пакет.Всего = 0;
			Пакет.Работа = "";
			Пакет.Записать();
		КонецЕсли;
	КонецЦикла;
	ПеренестиОшибкиПакетов(Запуск, Карта);

КонецПроцедуры

Процедура ПеренестиОшибкиПакетов(Запуск, Карта)

	Идентификаторы = Новый Массив;
	Для Каждого Пара Из Карта Цикл
		Идентификаторы.Добавить(Пара.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ Ошибки.Ошибка КАК Ошибка, Ошибки.Задание КАК Задание
		|ИЗ РегистрСведений.Cutter3000_Ошибки КАК Ошибки
		|ГДЕ Ошибки.Запуск = &Запуск И Ошибки.Задание В (&Пакеты)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Пакеты", Идентификаторы);
	Результат = Запрос.Выполнить();
	Ошибки = Результат.Выбрать();
	Пока Ошибки.Следующий() Цикл
		Запись = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
		Запись.Запуск = Запуск;
		Запись.Ошибка = Ошибки.Ошибка;
		Запись.Прочитать();
		Запись.Задание = Карта[Ошибки.Задание];
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры


Функция ЕстьПерестроениеГрафа(Запуск, Граф)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Пакеты.Пакет КАК Пакет
		|ИЗ РегистрСведений.Cutter3000_Пакеты КАК Пакеты
		|ГДЕ Пакеты.Запуск = &Запуск И Пакеты.Граф = &Граф И Пакеты.Состояние = &Перестроение");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Граф", Граф);
	Запрос.УстановитьПараметр("Перестроение", "ГотовоПерестроение");
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();

КонецФункции

#КонецОбласти
