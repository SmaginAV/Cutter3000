Процедура ЗапуститьРаботникаПула(Запуск, Слот, Родитель, Назначение)

	ФазаКоординатора(Запуск, "Регистрация");
	Слот.Вставить("Запуск", Запуск);
	Слот.Вставить("Пул", Истина);
	Управление = ЗаписьУправления(Запуск, Слот.Идентификатор);
	Управление.НазначениеРаботника = Назначение;
	Управление.ФазаИсполнения = "Ожидание";
	Управление.Записать();
	Очередь = ЗаписьОчереди(Запуск, Слот.Идентификатор);
	Очередь.Состояние = "Свободен";
	Очередь.Записать();
	Запись = ЗаписьСостояния(Запуск, Слот.Идентификатор);
	Запись.Этап = "Работник";
	Запись.Состояние = "Выполняется";
	Запись.Наименование = "Постоянный работник Cutter3000";
	Запись.Записать();
	Параметры = Новый Массив;
	Параметры.Добавить(Запуск);
	Параметры.Добавить(Слот.Идентификатор);
	Параметры.Добавить(Родитель);
	Слот.Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ЗаданияСервер.ВыполнитьРаботникаПула",
		Параметры, Слот.Идентификатор, "Cutter3000: постоянный работник");
	ЗарегистрироватьФоновое(Запуск, Слот.Идентификатор, Слот.Фоновое);
	СохранитьФоновое(Запуск, Слот.Идентификатор, Слот.Фоновое);
	ФазаКоординатора(Запуск, "Чтение");

КонецПроцедуры

Процедура ОстановитьПулКаскадов(Слоты, Читатели)

	Все = Новый Массив;
	Для Каждого Слот Из Слоты Цикл
		Все.Добавить(Слот);
	КонецЦикла;
	Для Каждого Слот Из Читатели Цикл
		Все.Добавить(Слот);
	КонецЦикла;
	Для Каждого Слот Из Все Цикл
		Если Не Слот.Свойство("Пул") Или Слот.Фоновое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Сигнал отдельным полем: текущий результат не перезаписывает команду остановки.
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
		Попытка
			ЗаблокироватьОчередь(Слот.Запуск, Слот.Идентификатор);
			Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
			Очередь.Команда = "Стоп";
			Очередь.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	Для Каждого Слот Из Все Цикл
		Если Не Слот.Свойство("Пул") Или Слот.Фоновое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пока Слот.Фоновое.Состояние = СостояниеФоновогоЗадания.Активно Цикл
			Слот.Фоновое = Слот.Фоновое.ОжидатьЗавершенияВыполнения(1);
		КонецЦикла;
		Слот.Фоновое = Неопределено;
	КонецЦикла;

КонецПроцедуры

Функция ЗаписьСостояния(Запуск, Задание)

	Запись = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Задание = Задание;
	Запись.Прочитать();
	// Прочитать() очищает ключи менеджера, если записи еще нет.
	Запись.Запуск = Запуск;
	Запись.Задание = Задание;
	Возврат Запись;

КонецФункции

Процедура СохранитьФоновое(Запуск, Работник, Фоновое)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние(Запуск, "Б-" + Лев(Работник, 34));
		Запись = ЗаписьСостояния(Запуск, Работник);
		Запись.ФоновоеЗадание = Строка(Фоновое.УникальныйИдентификатор);
		Запись.Обновление = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ВосстановитьСостояние(Запуск)

	Если Запуск = "" Тогда
		Возврат;
	КонецЕсли;
	Если ОстановкаЗапрошена(Запуск) Тогда
		Управление = ЗаписьУправления(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Если Не ФоновоеАктивно(Данные.ФоновоеОстановки) Тогда
			ЗапроситьОстановку(Запуск);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Если Заголовок.ВидОперации = "Обфускация" Тогда
		ВосстановитьОбфускацию(Запуск, Заголовок);
		Возврат;
	КонецЕсли;
	Если Заголовок.Состояние <> "Выполняется" И Заголовок.Состояние <> "Ожидание" Тогда
		Если Не ЕстьАктивныеРаботники(Запуск) Тогда
			Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ФоновоеАктивно(Заголовок.ФоновоеЗадание) Тогда
		Возврат;
	КонецЕсли;
	Прерванные = Новый Массив;
	Фоновые = ФоновыеЗапуска(Запуск);
	ЕстьАктивный = Ложь;
	Для Каждого СтрокаФонового Из Фоновые Цикл
		Если СтрокаФонового.Задание = "Запуск" И Заголовок.Этап <> "Планирование" Тогда
			Продолжить;
		КонецЕсли;
		Если ФоновоеАктивно(СтрокаФонового.ФоновоеЗадание) Тогда
			ЕстьАктивный = Истина;
			Продолжить;
		КонецЕсли;
		Если СтрокаФонового.Состояние <> "Выполняется" И СтрокаФонового.Состояние <> "Ожидание" Тогда
			Продолжить;
		КонецЕсли;
		Если ТекущаяДатаСеанса() - Заголовок.Обновление >= 30 Тогда
			Прерванные.Добавить(СтрокаФонового.Задание);
		Иначе
			ЕстьАктивный = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Прерванные.Количество() = 0 Тогда
		Если Не ЕстьАктивный И Заголовок.Этап <> "Планирование" Тогда
			ЗавершитьЗапуск(Запуск);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗафиксироватьПрерывание(Запуск, Прерванные, ЕстьАктивный);
	Если Не ЕстьАктивный Тогда
		Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
	КонецЕсли;

КонецПроцедуры

Функция ФоновоеАктивно(Идентификатор)

	Если Идентификатор = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Фоновое = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));
	Возврат Фоновое <> Неопределено И Фоновое.Состояние = СостояниеФоновогоЗадания.Активно;

КонецФункции

Функция ЕстьАктивныеРаботники(Запуск)

	Данные = ДанныеУправления(ЗаписьУправления(Запуск, "Управление"));
	Если ФоновоеАктивно(Данные.ФоновоеОстановки) Тогда
		Возврат Истина;
	КонецЕсли;
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Если Заголовок.Состояние = "Остановлено" И ФоновоеАктивно(Заголовок.ФоновоеЗадание) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Работа Из ФоновыеЗапуска(Запуск) Цикл
		Если Работа.Задание <> "Запуск" И ФоновоеАктивно(Работа.ФоновоеЗадание) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ЗафиксироватьПрерывание(Запуск, Прерванные, ЕстьАктивный)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние(Запуск);
		Набор = РегистрыСведений.Cutter3000_Задания.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Набор.Прочитать();
		// Идентификатор задания мог появиться после предварительного опроса.
		Актуальные = ПроверкаПрерывания(Набор, Прерванные);
		Прерванные = Актуальные.Прерванные;
		ЕстьАктивный = Актуальные.ЕстьАктивный;
		Для Каждого Запись Из Набор Цикл
			Прервана = Прерванные.Найти(Запись.Задание) <> Неопределено
				Или Прерванные.Найти(Запись.Работник) <> Неопределено;
			Если Не ЕстьАктивный Тогда
				Прервана = Истина;
			КонецЕсли;
			Если Прервана И (Запись.Состояние = "Выполняется" Или Запись.Состояние = "Ожидание") Тогда
				Запись.Состояние = "Ошибка";
				Запись.Этап = "Выполнение прервано";
				Если Запись.Задание = "Запуск" И ЕстьАктивный Тогда
					// Индекс остается нужен уже запущенным транзакциям работников.
					Запись.Состояние = "Выполняется";
					Запись.Этап = "Прерывание планирования";
				КонецЕсли;
				Запись.Ошибок = 1;
				Запись.Обновление = ТекущаяДатаСеанса();
				Запись.ОписаниеОшибки = "Фоновое задание завершилось без окончательного состояния."
					+ " Незавершенная транзакция отменена платформой. Повторный запуск построит новый план.";
				Запись.Контекст = СтрШаблон("Запуск: %1; задание: %2; работник: %3; фон: %4.",
					Запуск, Запись.Задание, Запись.Работник, Запись.ФоновоеЗадание);
				Детали = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
				Детали.Запуск = Запуск;
				Детали.Ошибка = Строка(Новый УникальныйИдентификатор);
				Детали.Задание = Запись.Задание;
				Детали.Момент = Запись.Обновление;
				Детали.Этап = Запись.Этап;
				Детали.КраткоеОписание = "Выполнение фонового задания прервано.";
				Детали.ОписаниеОшибки = Запись.ОписаниеОшибки;
				Детали.Контекст = Запись.Контекст;
				Детали.Записать();
			КонецЕсли;
		КонецЦикла;
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ПроверкаПрерывания(Набор, Предварительные)

	Результат = Новый Структура("Прерванные,ЕстьАктивный", Новый Массив, Ложь);
	Для Каждого Запись Из Набор Цикл

		ЭтоФоновое = Запись.Этап = "Работник"
			Или (Запись.Задание = "Запуск" И Запись.Этап = "Планирование");
		Если Не ЭтоФоновое Тогда
			Продолжить;
		КонецЕсли;
		Если ФоновоеАктивно(Запись.ФоновоеЗадание) Тогда
			Результат.ЕстьАктивный = Истина;
		ИначеЕсли Предварительные.Найти(Запись.Задание) <> Неопределено
			И (Запись.Состояние = "Выполняется" Или Запись.Состояние = "Ожидание") Тогда
			Результат.Прерванные.Добавить(Запись.Задание);
		КонецЕсли;

	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаблокироватьСостояние(Запуск, Задание = "")

	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда

		// Запись фиксированного ключа удерживает автоматическую блокировку до конца транзакции.
		Если Задание = "" Тогда
			Задание = "СлужебнаяБлокировка";
		КонецЕсли;
		Служебная = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
		Служебная.Запуск = Запуск;
		Служебная.Задание = Задание;
		Служебная.Этап = "Служебный";
		Служебная.Состояние = "Завершено";
		Служебная.Обновление = ТекущаяДатаСеанса();
		Служебная.Записать();
		Возврат;

	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Задания");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Запуск", Запуск);
	Если Задание <> "" Тогда
		Элемент.УстановитьЗначение("Задание", Задание);
	КонецЕсли;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция АктивныйЗапуск()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Состояния.Запуск КАК Запуск
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Задание = &Заголовок
		| И Состояния.Состояние В (&Активные)
		|УПОРЯДОЧИТЬ ПО Состояния.Начало УБЫВ");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Запрос.УстановитьПараметр("Активные", СтрРазделить("Выполняется,Ожидание,Останавливается", ","));
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Запуск;
	КонецЕсли;
	// После сбоя координатора работник может еще завершать текущую транзакцию.
	Последний = ПоследнийЗапуск();
	Если Последний <> "" И (ОстановкаЗапрошена(Последний) Или ЕстьАктивныеРаботники(Последний)) Тогда
		Возврат Последний;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПоследнийЗапуск()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Состояния.Запуск КАК Запуск
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Задание = &Заголовок
		|УПОРЯДОЧИТЬ ПО Состояния.Начало УБЫВ");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Запуск;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция РаботыЗапуска(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Состояния.Задание КАК Идентификатор,
		| Состояния.Наименование КАК Наименование,
		| Состояния.Этап КАК Этап,
		| Состояния.Состояние КАК Состояние,
		| Состояния.Всего КАК Всего,
		| Состояния.Обработано КАК Зафиксировано,
		| 0 КАК ТекущаяПопытка,
		| 0 КАК Прогресс,
		| Состояния.Ошибок КАК Ошибок
		| ,Состояния.ВидОперации КАК ВидОперации
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Запуск = &Запуск И Состояния.Этап <> &Работник И Состояния.Этап <> &Служебный
		| И (Состояния.Задание = &Заголовок ИЛИ Состояния.Всего > 0
		|  ИЛИ Состояния.Обработано > 0 ИЛИ Состояния.Ошибок > 0
		|  ИЛИ Состояния.ВидОперации = &Обфускация)
		|УПОРЯДОЧИТЬ ПО Состояния.Наименование, Состояния.Задание");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Работник", "Работник");
	Запрос.УстановитьПараметр("Служебный", "Служебный");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Запрос.УстановитьПараметр("Обфускация", "Обфускация");
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции

Функция ФоновыеЗапуска(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Состояния.Задание КАК Задание,
		| Состояния.ФоновоеЗадание КАК ФоновоеЗадание,
		| Состояния.Состояние КАК Состояние
