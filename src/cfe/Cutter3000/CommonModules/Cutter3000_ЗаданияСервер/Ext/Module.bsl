#Область ПрограммныйИнтерфейс

// Принимает единственный запуск обрезки.
// Параметры:
//  ДатаОбрезки - Дата - первый сохраняемый день.
//  УскоренныйРежим - Булево - пропуск повторной проверки обычных входящих ссылок;
//   по умолчанию Ложь. Может оставить битые ссылки. Выбор действует на весь новый запуск.
//  Трассировка - Булево - запись технических замеров в журнал регистрации; по умолчанию Ложь.
// Возвращаемое значение:
//  Строка - идентификатор нового или уже активного запуска.
Функция НачатьОбрезку(ДатаОбрезки, УскоренныйРежим = Ложь, Трассировка = Ложь) Экспорт

	Если ТипЗнч(УскоренныйРежим) <> Тип("Булево") Тогда
		ВызватьИсключение "Режим обрезки должен иметь тип Булево.";
	КонецЕсли;
	Если ТипЗнч(Трассировка) <> Тип("Булево") Тогда
		ВызватьИсключение "Флажок трассировки должен иметь тип Булево.";
	КонецЕсли;
	Если Трассировка Тогда
		УровниЖурнала = ПолучитьИспользованиеЖурналаРегистрации();
		Если УровниЖурнала.Найти(УровеньЖурналаРегистрации.Информация) = Неопределено Тогда
			ВызватьИсключение "Для трассировки включите уровень Информация в настройках журнала регистрации.";
		КонецЕсли;
	КонецЕсли;
	Граница = Cutter3000_ДанныеСервер.ГраницаОбрезки(ДатаОбрезки);
	ВосстановитьСостояние(АктивныйЗапуск());
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка

		ЗаблокироватьСостояние("Служебный", "ЕдинственныйЗапуск");
		Активный = АктивныйЗапуск();
		Если Активный <> "" Тогда
			Если ЗаписьСостояния(Активный, "Запуск").ВидОперации = "Обфускация" Тогда
				ВызватьИсключение "Сначала дождитесь завершения обфускации или ее остановки.";
			КонецЕсли;
			Запуск = Активный;
		Иначе
			Запуск = Строка(Новый УникальныйИдентификатор);
			Заголовок = ЗаписьСостояния(Запуск, "Запуск");
			Заголовок.Граница = Граница;
			Заголовок.ВидОперации = "Обрезка";
			Заголовок.УскоренныйРежим = УскоренныйРежим;
			Заголовок.Трассировка = Трассировка;
			Заголовок.Начало = ТекущаяДатаСеанса();
			Заголовок.Обновление = Заголовок.Начало;
			Заголовок.Наименование = "Подготовка плана обрезки";
			Заголовок.Этап = "Планирование";
			Заголовок.Состояние = "Выполняется";
			Заголовок.Записать();
			СоздатьУправлениеЗапуском(Запуск);
			ПараметрыЗадания = Новый Массив;
			ПараметрыЗадания.Добавить(Запуск);
			Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ЗаданияСервер.ПостроитьПлан",
				ПараметрыЗадания, Запуск, "Cutter3000: подготовка плана обрезки");
			Заголовок.ФоновоеЗадание = Строка(Фоновое.УникальныйИдентификатор);
			Заголовок.Записать();
			ЗарегистрироватьФоновое(Запуск, "Запуск", Фоновое);
			Координатор = ЗаписьУправления(Запуск, "Запуск");
			Координатор.ФазаИсполнения = "Чтение";
			Координатор.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;
	Возврат Запуск;

КонецФункции

// Принимает остановку только текущего запуска, не ожидая удаления на клиенте.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Структура - Принято (Булево), Описание (Строка).
Функция ЗапроситьОстановку(Запуск) Экспорт

	Принято = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Если Управление.НазначениеРаботника = "Управление"
			И Управление.Состояние <> "Завершение" Тогда
			Принято = Истина;
			Если Управление.Команда <> "Остановка" Тогда
				Управление.Команда = "Остановка";
				Управление.Состояние = "Останавливается";
				Управление.Записать();
			КонецЕсли;
			ОбеспечитьЗаданиеОстановки(Запуск, Управление);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	// В файловом клиенте фоновые задания последовательны: отмена освобождает очередь для завершения остановки.
	Если Принято И ФайловаяБаза() Тогда
		ОтменитьЧтениеЗапуска(Запуск);
	КонецЕсли;
	// На сервере читателей отменяет уже зарегистрированное задание остановки, не клиентский вызов.
	Управление = ЗаписьУправления(Запуск, "Управление");
	Описание = Управление.Ошибка;
	Возврат Новый Структура("Принято,Описание", Принято, Описание);

КонецФункции

// Проверяет устойчивый сигнал на границе страницы или команды планировщика.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Булево - принят ли запрос остановки.
Функция ОстановкаЗапрошена(Запуск) Экспорт

	Если Запуск = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Управление = ЗаписьУправления(Запуск, "Управление");
	Возврат Управление.Команда = "Остановка";

КонецФункции

// Прерывает подготовку вне транзакции; уже начатая атомарная публикация завершается целиком.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ПроверитьОстановку(Запуск) Экспорт

	// Чтение управления внутри долгой транзакции удерживает его блокировку до фиксации.
	Если ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	Если ОстановкаЗапрошена(Запуск) Тогда
		ВызватьИсключение "Остановка обрезки запрошена пользователем.";
	КонецЕсли;

КонецПроцедуры

// Завершает остановку независимо от формы и отмененного читающего координатора.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ВыполнитьОстановку(Запуск) Экспорт

	Попытка
		Пока ЕстьЗаданияДанных(Запуск) Цикл
			ОтменитьЧтениеЗапуска(Запуск);
			Данные = ДанныеУправления(ЗаписьУправления(Запуск, "Управление"));
			Для Каждого Фон Из Данные.Фоновые Цикл
				Задание = ФоновоеПоСтроке(Фон.Значение);
				Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
					Задание.ОжидатьЗавершенияВыполнения(0.1);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ЗавершитьОстановку(Запуск);
	Исключение
		СохранитьОшибку(Запуск, "Запуск", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры


// Читает состояние и последние снимки прогресса без удаления сообщений наблюдателем.
// Параметры:
//  Запуск - Строка - идентификатор запуска; пустой означает последний запуск.
//  Прочитанные - Соответствие, Неопределено - номера пакетов по идентификаторам фоновых заданий.
// Возвращаемое значение:
//  Структура - заголовок, работы, сообщения текущих попыток, ПрошлоСекунд (Число),
//   УскоренныйРежим (Булево) - сохраненный режим обрезки этого запуска.
Функция СостояниеОбрезки(Запуск = "", Прочитанные = Неопределено) Экспорт

	Активный = АктивныйЗапуск();
	Если Активный <> "" Тогда
		Запуск = Активный;
	ИначеЕсли Запуск = "" Тогда
		Запуск = ПоследнийЗапуск();
	КонецЕсли;
	ВосстановитьСостояние(Запуск);
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Работы = РаботыЗапуска(Запуск);
	Управление = ЗаписьУправления(Запуск, "Управление");
	Останавливается = Управление.Команда = "Остановка"
		Или (Заголовок.Состояние = "Остановлено" И ФоновоеАктивно(Заголовок.ФоновоеЗадание));
	Если Останавливается Тогда
		Заголовок.Состояние = "Останавливается";
		Для Каждого Работа Из Работы Цикл
			Если Работа.Идентификатор = "Запуск" Тогда
				Работа.Этап = "Останавливается";
				Работа.Состояние = "Останавливается";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	МожноОстановить = Управление.НазначениеРаботника = "Управление"
		И Управление.Состояние <> "Завершение" И Не Останавливается;
	Сообщения = Новый Массив;
	Фоновые = ФоновыеЗапуска(Запуск);
	Для Каждого СтрокаФонового Из Фоновые Цикл

		Если СтрокаФонового.ФоновоеЗадание = "" Тогда
			Продолжить;
		КонецЕсли;
		Фоновое = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
			Новый УникальныйИдентификатор(СтрокаФонового.ФоновоеЗадание));
		Если Фоновое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Снимок Из СнимкиПрогресса(Фоновое, Прочитанные) Цикл
			Сообщения.Добавить(Снимок);
		КонецЦикла;

	КонецЦикла;
	МассивРабот = Новый Массив;
	Для Каждого Работа Из Работы Цикл
		СтрокаРаботы = Новый Структура;
		Для Каждого Колонка Из Работы.Колонки Цикл
			СтрокаРаботы.Вставить(Колонка.Имя, Работа[Колонка.Имя]);
		КонецЦикла;
		МассивРабот.Добавить(СтрокаРаботы);
	КонецЦикла;
	ПрошлоСекунд = 0;
	Если ЗначениеЗаполнено(Заголовок.Начало) Тогда
		МоментРасчета = Заголовок.Обновление;
		Если Заголовок.Состояние = "Выполняется" Или Заголовок.Состояние = "Ожидание"
			Или Заголовок.Состояние = "Останавливается" Тогда
			МоментРасчета = ТекущаяДатаСеанса();
		КонецЕсли;
		ПрошлоСекунд = Макс(0, МоментРасчета - Заголовок.Начало);
	КонецЕсли;
	ИтогОбфускации = "";
	Если Заголовок.ВидОперации = "Обфускация" И Заголовок.Состояние <> "Выполняется"
		И Заголовок.Состояние <> "Останавливается" Тогда
		ИтогОбфускации = Заголовок.Контекст;
	КонецЕсли;
	Возврат Новый Структура("Запуск,Граница,Состояние,Работы,Сообщения,Режим,ПланЗавершен,ПрошлоСекунд,МожноОстановить,ВидОперации,ИтогОбфускации,УскоренныйРежим,Трассировка", Запуск,
		Заголовок.Граница, Заголовок.Состояние, МассивРабот, Сообщения, РежимВыполнения(),
		Заголовок.Этап <> "Планирование", ПрошлоСекунд, МожноОстановить, Заголовок.ВидОперации, ИтогОбфускации, Заголовок.УскоренныйРежим, Заголовок.Трассировка);

КонецФункции

// Читает тяжелую диагностику только по запросу пользователя.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор логической работы.
// Возвращаемое значение:
//  Структура - описание ошибки и контекст без прикладных ссылок.
Функция ОшибкиЗадания(Запуск, Задание) Экспорт

	Запись = ЗаписьСостояния(Запуск, Задание);
	Возврат Новый Структура("ОписаниеОшибки,Контекст", Запись.ОписаниеОшибки, Запись.Контекст);

КонецФункции

// Читает отдельные ошибки для реквизита таблицы управляемой формы, только на сервере.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор работы; «Запуск» показывает ошибки всех работ.
// Возвращаемое значение:
//  ТаблицаЗначений - Идентификатор, Момент, НаименованиеЗадания, Этап, КраткоеОписание.
Функция СписокОшибокЗадания(Запуск, Задание) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ Ошибки.Ошибка КАК Идентификатор, Ошибки.Момент,
		| ЕСТЬNULL(Задания.Наименование, Ошибки.Задание) КАК НаименованиеЗадания,
		| Ошибки.Этап, Ошибки.КраткоеОписание
		|ИЗ РегистрСведений.Cutter3000_Ошибки КАК Ошибки
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Задания КАК Задания
		| ПО Ошибки.Запуск = Задания.Запуск И Ошибки.Задание = Задания.Задание
		|ГДЕ Ошибки.Запуск = &Запуск И (&ВсеЗадания ИЛИ Ошибки.Задание = &Задание)
		|УПОРЯДОЧИТЬ ПО Ошибки.Момент, Ошибки.Ошибка");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("ВсеЗадания", Задание = "Запуск");
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции

// Читает полный текст одной сохраненной ошибки без прикладных ссылок.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Идентификатор - Строка - ключ строки таблицы ошибок.
// Возвращаемое значение:
//  Структура - ОписаниеОшибки и Контекст, пригодные для параметров формы.
Функция ДеталиОшибки(Запуск, Идентификатор) Экспорт

	Запись = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Ошибка = Идентификатор;
	Запись.Прочитать();
	Контекст = СтрШаблон("Время: %1; этап: %2.%3%4",
		Формат(Запись.Момент, "ДФ=yyyy-MM-dd HH:mm:ss"), Запись.Этап, Символы.ПС, Запись.Контекст);
	Возврат Новый Структура("ОписаниеОшибки,Контекст", Запись.ОписаниеОшибки, Контекст);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет команды одного координатора; описания метаданных живут до завершения работника.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - ключ единственного почтового ящика.
//  Родитель - Строка - идентификатор фонового координатора.
Процедура ВыполнитьРаботникаПула(Запуск, Работник, Родитель) Экспорт

	Контекст = Неопределено;
	Попытка
		Пока Истина Цикл
			Если ОстановкаЗапрошена(Запуск) Тогда
				Прервать;
			КонецЕсли;
			Координатор = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Родитель));
			Если Координатор = Неопределено Или Координатор.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				Прервать;
			КонецЕсли;
			Очередь = ЗаписьОчереди(Запуск, Работник);
			Если Очередь.Команда = "Стоп" Или Очередь.Состояние = "" Тогда
				Прервать;
			КонецЕсли;
			Если Очередь.Состояние <> "Новая" Тогда
				Координатор.ОжидатьЗавершенияВыполнения(0.1);
				Продолжить;
			КонецЕсли;
			// Единственный потребитель; до ответа координатор не заменяет запрос.
			Данные = Очередь.Данные.Получить();
			Если Контекст = Неопределено Тогда
				Контекст = Cutter3000_ДанныеСервер.КонтекстКонтроляКаскадов();
				Контекст.Вставить("Трассировка", КонтекстТрассировки(Запуск, Работник, ЗаписьСостояния(Запуск, "Запуск").Трассировка));
			КонецЕсли;
			Если Очередь.Команда = "Чтение" Тогда
				ПроверитьОстановку(Запуск);
				Результат = Cutter3000_ДанныеСервер.ПрочитатьПакетСтраницРаботника(Контекст, Данные, Запуск);
				ПроверитьОстановку(Запуск);
			ИначеЕсли Очередь.Команда = "Удаление" Тогда
				ВыполнитьГруппу(Запуск, Данные, Контекст, Работник);
				Результат = Истина;
			Иначе
				ВызватьИсключение "Неизвестная команда работника Cutter3000.";
			КонецЕсли;
			ЗаписатьОтветПула(Запуск, Работник, Результат);
			// Следующая команда не должна строиться одновременно с прежним графом ответа.
			Результат = Неопределено;
			Данные = Неопределено;
			Очередь = Неопределено;
		КонецЦикла;
		ЗавершитьРаботника(Запуск, Работник);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ОстановкаЗапрошена(Запуск) Тогда
			Возврат;
		КонецЕсли;
		ЗаписатьОтветПула(Запуск, Работник, Неопределено, ПодробноеПредставлениеОшибки(Ошибка));
		СохранитьОшибку(Запуск, Работник, Ошибка);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает постоянных читателей и свободные слоты удаления для одной волны чтения.
// Параметры:
//  Контекст - Структура - контекст координатора с читателями и необязательными слотами удаления.
// Возвращаемое значение:
//  Массив - уникальные слоты; все их ответы должны быть приняты до следующей публикации каскада.
Функция СлотыЧтенияПула(Контекст) Экспорт

	Результат = Новый Массив;
	Для Каждого Читатель Из Контекст.Читатели Цикл
		Результат.Добавить(Читатель);
	КонецЦикла;
	Вспомогательные = Неопределено;
	Если Контекст.Свойство("СлотыУдаления", Вспомогательные) Тогда
		ОбновитьСлотыКаскадов(Вспомогательные);
		Для Каждого Слот Из Вспомогательные Цикл
			Если Слот.Задание = "" Тогда
				Результат.Добавить(Слот);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Передает одну команду свободному работнику. Повторного выполнения при потере работника нет.
// Параметры:
//  Слот - Структура - слот координатора с идентификатором запуска и фонового задания.
//  Команда - Строка - Чтение либо Удаление.
//  Данные - Произвольный - сериализуемые параметры без объектов метаданных.
Процедура ОтправитьКомандуПула(Слот, Команда, Данные) Экспорт

	ПроверитьОстановку(Слот.Запуск);
	Если Не ФоновоеАктивно(Строка(Слот.Фоновое.УникальныйИдентификатор)) Тогда
		ВызватьИсключение "Постоянный работник завершился до получения команды.";
	КонецЕсли;
	// Сериализация и почтовый ящик не должны удерживать шлюз остановки.
	ХранилищеКоманды = Новый ХранилищеЗначения(Данные);
	Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
	Если Очередь.Состояние <> "Свободен" И Очередь.Состояние <> "Готово" Тогда
		ВызватьИсключение "Почтовый ящик работника занят или содержит ошибку.";
	КонецЕсли;
	Очередь = Неопределено;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		// Назначение и резерв отмены чтения меняются под одной блокировкой управления.
		ЗаблокироватьУправление(Слот.Запуск, "Управление");
		Если Не ЗапускДопускаетРаботу(ЗаписьУправления(Слот.Запуск, "Управление")) Тогда
			ВызватьИсключение "Выдача команды остановлена: запуск остановлен или завершен.";
		КонецЕсли;
		ЗаблокироватьУправление(Слот.Запуск, Слот.Идентификатор);
		Управление = ЗаписьУправления(Слот.Запуск, Слот.Идентификатор);
		Управление.НазначениеРаботника = Команда;
		Управление.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Слот.Запуск, Слот.Идентификатор);
		// После резерва могла быть принята остановка; чтение сигнала не занимает общий замок.
		Если Не ЗапускДопускаетРаботу(ЗаписьУправления(Слот.Запуск, "Управление")) Тогда
			ВызватьИсключение "Выдача команды остановлена: запуск остановлен или завершен.";
		КонецЕсли;
		Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
		Если Очередь.Состояние <> "Свободен" И Очередь.Состояние <> "Готово" Тогда
			ВызватьИсключение "Почтовый ящик работника занят или содержит ошибку.";
		КонецЕсли;
		Очередь.Команда = Команда;
		Очередь.Данные = ХранилищеКоманды;
		Очередь.Ошибка = "";
		Очередь.Состояние = "Новая";
		Очередь.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Читает готовый ответ, не дожидаясь следующего опроса формы.
// Параметры:
//  Слот - Структура - слот координатора.
// Возвращаемое значение:
//  Структура, Неопределено - Результат команды либо ожидание; сбой прерывает только координатор.
Функция ПолучитьРезультатПула(Слот) Экспорт

	ПроверитьОстановку(Слот.Запуск);
	Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
	Если Очередь.Состояние = "Ошибка" Тогда
		ВызватьИсключение Очередь.Ошибка;
	КонецЕсли;
	Если Очередь.Состояние = "Готово" Тогда
		Возврат Новый Структура("Результат", Очередь.Данные.Получить());
	КонецЕсли;
	Если Не ФоновоеАктивно(Строка(Слот.Фоновое.УникальныйИдентификатор)) Тогда
		ВызватьИсключение "Потерян постоянный работник " + Слот.Идентификатор;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Планировщик читает следующий каскад одновременно с удалением опубликованной порции.
// Параметры:
//  Запуск - Строка - идентификатор принятого запуска.
Процедура ПостроитьПлан(Запуск) Экспорт

	Слоты = Новый Массив;
	Читатели = Новый Массив;
	Попытка
		ФазаКоординатора(Запуск, "Чтение");
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		КоличествоПотоков = 2;
		Если ФайловаяБаза() Тогда
			КоличествоПотоков = 1;
		КонецЕсли;
		Контекст = Cutter3000_ДанныеСервер.НачатьПланированиеКаскадов(Заголовок.Граница, Запуск,
			КоличествоПотоков);
		Контекст.Вставить("Трассировка", КонтекстТрассировки(Запуск, "Запуск", Заголовок.Трассировка));
		Контекст.Прогресс.Контроль.Вставить("Трассировка", Контекст.Трассировка);
		Контекст.Прогресс.Контроль.Вставить("ФоновоеПрогресса", ФоновоеПрогресса(Заголовок.ФоновоеЗадание));
		Слоты = СоздатьСлотыКаскадов(Запуск, Контекст.Работы);
		КонтекстПроверки = Cutter3000_ДанныеСервер.КонтекстКонтроляКаскадов(Контекст);
		Если Не ФайловаяБаза() Тогда
			Для Каждого Слот Из Слоты Цикл
				ЗапуститьРаботникаПула(Запуск, Слот, Заголовок.ФоновоеЗадание, "Удаление");
			КонецЦикла;
			Для Номер = 1 По 2 Цикл
				Читатель = Новый Структура("Идентификатор,Фоновое,Использован,Задание",
					Строка(Новый УникальныйИдентификатор), Неопределено, Ложь, "");
				Читатели.Добавить(Читатель);
				ЗапуститьРаботникаПула(Запуск, Читатель, Заголовок.ФоновоеЗадание, "Чтение");
			КонецЦикла;
			Контекст.Вставить("Читатели", Читатели);
			Контекст.Вставить("СлотыУдаления", Слоты);
		КонецЕсли;
		ПодготовитьИПередатьКаскады(Запуск, Контекст, Слоты, КонтекстПроверки);
		ПроверитьОстановку(Запуск);
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Заголовок.Этап = "Выполнение";
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.Записать();
		Для Каждого Слот Из Слоты Цикл
			ОжидатьСлотКаскадов(Слот);
		КонецЦикла;
		ОстановитьПулКаскадов(Слоты, Читатели);
		ЗавершитьРаботыКаскадов(Запуск);
		ЗавершитьЗапуск(Запуск);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ОстановкаЗапрошена(Запуск) Тогда
			Возврат;
		КонецЕсли;
		// Сначала завершаются уже запущенные транзакции; их индекс еще нужен работникам.
		Для Каждого Слот Из Слоты Цикл
			Попытка
				ОжидатьСлотКаскадов(Слот);
			Исключение
				// Первичная ошибка сохраняется после завершения остальных работников.
			КонецПопытки;
		КонецЦикла;
		Попытка
			ОстановитьПулКаскадов(Слоты, Читатели);
		Исключение
			// Если остановка недоступна, работники выйдут после окончания координатора.
			// Очистку их индекса выполнит восстановление после завершения всех сеансов.
		КонецПопытки;
		СохранитьОшибку(Запуск, "Запуск", Ошибка);
		ЗавершитьРаботыКаскадов(Запуск, Истина);
		Если Не ЕстьАктивныеРаботники(Запуск) Тогда
			Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Удаляет опубликованную порцию одной работы; дочерних заданий не создает.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор технического работника.
//  Задание - Строка - идентификатор работы с единственной опубликованной порцией.
//  КонтекстПроверки - Структура, Неопределено - описания метаданных текущего сеанса.
Процедура ВыполнитьПакетКаскадов(Запуск, Работник, Задание, КонтекстПроверки = Неопределено) Экспорт

	ВыполнитьГруппу(Запуск, Задание, КонтекстПроверки, "Запуск");
	ЗавершитьРаботника(Запуск, Работник);

КонецПроцедуры

// Экспортная точка входа работника очереди.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор технического работника.
Процедура ВыполнитьОчередь(Запуск, Работник) Экспорт

	Запись = ЗаписьСостояния(Запуск, Работник);
	Запись.Состояние = "Выполняется";
	Запись.Обновление = ТекущаяДатаСеанса();
	Запись.Записать();
	Пока Истина Цикл

		Задание = РезервироватьГруппу(Запуск, Работник);
		Если Задание = "" Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьГруппу(Запуск, Задание);

	КонецЦикла;
	ЗавершитьРаботника(Запуск, Работник);

КонецПроцедуры

// Отправляет компактный прогресс текущей транзакции.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор логической работы.
//  Этап - Строка - этап выполнения.
//  Обработано - Число - счетчик текущей попытки; не является зафиксированным результатом.
//  Контроль - Структура - время последнего сообщения, ФоновоеПрогресса (ФоновоеЗадание),
//   ЗафиксированоДо и необязательное ОшибокДо. Без фонового контекста технические сообщения не выводятся.
Процедура СообщитьПрогресс(Запуск, Задание, Этап, Обработано, Контроль) Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Если Сейчас - Контроль.ПоследнееСообщение < 1 Тогда
		Возврат;
	КонецЕсли;
	Контроль.ПоследнееСообщение = Сейчас;
	Контроль.Вставить("ЭтапПланировщика", Этап);
	ЗамерПрогресса = НачатьЗамер(Контроль, "Прогресс: " + Этап, "", Обработано);
	ЗакончитьЗамер(ЗамерПрогресса);
	Фоновое = Неопределено;
	Если Не Контроль.Свойство("ФоновоеПрогресса", Фоновое) Или Фоновое = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не Контроль.Свойство("ЗафиксированоДо") Тогда
		ЗафиксированоДо = 0;
		Если Задание <> "Запуск" Тогда
			ЗафиксированоДо = ЗаписьСостояния(Запуск, Задание).Обработано;
		КонецЕсли;
		Контроль.Вставить("ЗафиксированоДо", ЗафиксированоДо);
	КонецЕсли;
	Данные = Новый Структура("Запуск,Задание,Этап,Обработано,ЗафиксированоДо", Запуск, Задание, Этап,
		Обработано, Контроль.ЗафиксированоДо);
	ОшибокДо = 0;
	Если Контроль.Свойство("ОшибокДо", ОшибокДо) Тогда
		Данные.Вставить("ОшибокДо", ОшибокДо);
	КонецЕсли;
	ОтправитьСнимокПрогресса(Фоновое, Данные);

КонецПроцедуры

// Создает контекст диагностики без чтения прикладных данных.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор работника или логической работы.
//  Включена - Булево - сохраненный выбор запуска.
// Возвращаемое значение:
//  Структура, Неопределено - контекст включенной трассировки либо отсутствие контекста.
Функция КонтекстТрассировки(Запуск, Задание, Включена) Экспорт

	Если Не Включена Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Запуск,Задание,Включена", Запуск, Задание, Истина);

КонецФункции

// Сохраняет начало замера до выполнения операции.
// Параметры:
//  Контекст - Структура, Неопределено - контекст трассировки или содержащая его структура.
//  Операция - Строка - фиксированное название операции без значений данных.
//  Таблица - Строка - полное имя таблицы метаданных.
//  Строк - Число - количество входных строк.
//  ШаблонЗапроса - Строка - текст запроса без значений параметров.
// Возвращаемое значение:
//  Структура, Неопределено - отметка для завершения замера.
Функция НачатьЗамер(Знач Контекст, Операция, Таблица = "", Строк = 0, ШаблонЗапроса = "") Экспорт

	Если Контекст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Контекст.Свойство("Трассировка") Тогда
		Контекст = Контекст.Трассировка;
		Если Контекст = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если Не Контекст.Свойство("Включена") Или Не Контекст.Включена Тогда
		Возврат Неопределено;
	КонецЕсли;
	Замер = Новый Структура("Запуск,Задание,Операция,Таблица,Строк,Запрос,Идентификатор,НачалоМс",
		Контекст.Запуск, Контекст.Задание, Операция, Таблица, Строк, ШаблонЗапроса,
		Строка(Новый УникальныйИдентификатор), ТекущаяУниверсальнаяДатаВМиллисекундах());
	ЗаписатьЗамер(Замер, "Начало", 0);
	Возврат Замер;

КонецФункции

// Сохраняет конец замера с длительностью; выключенная трассировка ничего не записывает.
// Параметры:
//  Замер - Структура, Неопределено - отметка начала.
//  Строк - Число - фактическое число строк; отрицательное значение сохраняет входное число.
//  Исход - Строка - фиксированный технический исход без значений данных и текста ошибки.
Процедура ЗакончитьЗамер(Замер, Строк = -1, Исход = "Завершено") Экспорт

	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строк >= 0 Тогда
		Замер.Строк = Строк;
	КонецЕсли;
	ЗаписатьЗамер(Замер, Исход, ТекущаяУниверсальнаяДатаВМиллисекундах() - Замер.НачалоМс);

КонецПроцедуры

// Выгружает только технические записи указанного запуска, в том числе незавершенного.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  ВладелецХранилища - УникальныйИдентификатор - форма, владеющая временным файлом выгрузки.
// Возвращаемое значение:
//  Строка - адрес XML-файла во временном хранилище.
Функция ФайлТрассировки(Запуск, ВладелецХранилища) Экспорт

	Если Запуск = "" Тогда
		ВызватьИсключение "Нет запуска для выгрузки трассировки.";
	КонецЕсли;
	Отбор = Новый Структура("Событие", "Cutter3000.Трассировка." + Запуск);
	События = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(События, Отбор, "Дата,Комментарий");
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("Cutter3000Trace");
	Запись.ЗаписатьАтрибут("run", Запуск);
	Для Каждого Событие Из События Цикл
		Запись.ЗаписатьНачалоЭлемента("Event");
		Запись.ЗаписатьТекст(Событие.Комментарий);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	ТекстТрассы = Запись.Закрыть();
	// Формирование в памяти позволяет выгружать трассу и в безопасном режиме расширения.
	ДанныеФайла = ПолучитьДвоичныеДанныеИзСтроки(ТекстТрассы, КодировкаТекста.UTF8);
	Возврат ПоместитьВоВременноеХранилище(ДанныеФайла, ВладелецХранилища);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейсОбфускации

// Начинает операцию по проверенному снимку настроек. Старый интерфейс обрезки сохранен.
// Параметры: Настройки - Структура - правила, UUID исключений и выбранные области очистки.
// Возвращаемое значение: Строка - UUID запуска.
Функция НачатьОбфускацию(Настройки) Экспорт

	Снимок = Cutter3000_ОбфускацияСервер.ПроверитьНастройки(Настройки);
	ВосстановитьСостояние(АктивныйЗапуск());
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние("Служебный", "ЕдинственныйЗапуск");
		Если АктивныйЗапуск() <> "" Тогда
			ВызватьИсключение "Уже выполняется обрезка, обфускация или завершение предыдущего запуска.";
		КонецЕсли;
		Запуск = Строка(Новый УникальныйИдентификатор);
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Заголовок.ВидОперации = "Обфускация";
		Заголовок.Начало = ТекущаяДатаСеанса();
		Заголовок.Обновление = Заголовок.Начало;
		Заголовок.Наименование = "Обфускация: обработка выбранных источников";
		Заголовок.Этап = "Обфускация";
		Заголовок.Состояние = "Выполняется";
		Заголовок.Контекст = Снимок.ОстаточныйОхват;
		Заголовок.Записать();
		СоздатьУправлениеЗапуском(Запуск);
		Cutter3000_ИменаПерсонажей.ПодготовитьСчетчикИмен(Запуск);
		Управление = ЗаписьУправления(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Данные.Вставить("НастройкиОбфускации", Снимок);
		Данные.Вставить("СледующийИсточник", 0);
		Управление.Данные = Новый ХранилищеЗначения(Данные);
		Управление.Записать();
		ПараметрыФонового = Новый Массив;
		ПараметрыФонового.Добавить(Запуск);
		Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ОбфускацияСервер.ВыполнитьОбфускацию",
			ПараметрыФонового, Запуск, "Cutter3000: обфускация");
		Заголовок.ФоновоеЗадание = Строка(Фоновое.УникальныйИдентификатор);
		Заголовок.Записать();
		ЗарегистрироватьФоновое(Запуск, "Запуск", Фоновое);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Запуск;

КонецФункции

// Возвращает только технические настройки, без исходных персональных значений.
Функция НастройкиОбфускацииЗапуска(Запуск) Экспорт

	Данные = ДанныеУправления(ЗаписьУправления(Запуск, "Управление"));
	Возврат Данные.НастройкиОбфускации;

КонецФункции

// Атомарно назначает свободному работнику следующий источник; источник имеет одного владельца.
Функция ВзятьИсточникОбфускации(Запуск, Работник) Экспорт

	Источник = Неопределено;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Если Управление.Команда <> "Остановка" И Управление.Состояние <> "Завершение"
			И ФоновоеАктивно(ЗаписьСостояния(Запуск, "Запуск").ФоновоеЗадание)
			И Данные.СледующийИсточник < Данные.НастройкиОбфускации.Источники.Количество() Тогда
			Источник = Данные.НастройкиОбфускации.Источники[Данные.СледующийИсточник];
			Данные.СледующийИсточник = Данные.СледующийИсточник + 1;
			Управление.Данные = Новый ХранилищеЗначения(Данные);
			Управление.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Источник;

КонецФункции

// Фаза записи допускается под тем же замком, под которым принимается остановка.
Функция ДопуститьОбфускацию(Запуск, Работник, Фаза) Экспорт

	Возврат ИзменитьФазуРаботника(Запуск, Работник, Фаза);

КонецФункции

// Регистрирует работника до выдачи источника. В файловой базе работник выполняется самим координатором.
Функция СоздатьРаботникаОбфускации(Запуск, Фоновый) Экспорт

	Работник = Строка(Новый УникальныйИдентификатор);
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Если ОстановкаЗапрошена(Запуск) Тогда
			ЗафиксироватьТранзакцию();
			Возврат "";
		КонецЕсли;
		Очередь = ЗаписьУправления(Запуск, Работник);
		Очередь.НазначениеРаботника = "Обфускация";
		Очередь.ФазаИсполнения = "Чтение";
		Очередь.Состояние = "Выполняется";
		Очередь.Записать();
		Состояние = ЗаписьСостояния(Запуск, Работник);
		Состояние.ВидОперации = "Обфускация";
		Состояние.Наименование = "Обфускация выбранных полей";
		Состояние.Этап = "Работник";
		Состояние.Состояние = "Выполняется";
		Состояние.Начало = ТекущаяДатаСеанса();
		Состояние.Обновление = Состояние.Начало;
		Если Фоновый Тогда
			ПараметрыФонового = Новый Массив;
			ПараметрыФонового.Добавить(Запуск);
			ПараметрыФонового.Добавить(Работник);
			Фон = ФоновыеЗадания.Выполнить("Cutter3000_ОбфускацияСервер.ВыполнитьРаботника",
				ПараметрыФонового, Работник, "Cutter3000: работник обфускации");
			Состояние.ФоновоеЗадание = Строка(Фон.УникальныйИдентификатор);
			ЗарегистрироватьФоновое(Запуск, Работник, Фон);
		Иначе
			Состояние.ФоновоеЗадание = ЗаписьСостояния(Запуск, "Запуск").ФоновоеЗадание;
		КонецЕсли;
		Состояние.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Работник;

КонецФункции

// Фиксирует счетчики вместе с прикладными данными; отмененные записи в результат не входят.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор исполнителя.
//  Этап - Строка - безопасное имя текущей операции.
//  Счетчики - Структура - Прочитано, Зафиксировано, Исключено.
//  Завершено - Булево - закончилась ли работа исполнителя.
Процедура ПрогрессОбфускации(Запуск, Работник, Этап, Счетчики, Завершено = Ложь) Экспорт

	Прочитано = Счетчики.Прочитано;
	Зафиксировано = Счетчики.Зафиксировано;
	Исключено = Счетчики.Исключено;
	Состояние = ЗаписьСостояния(Запуск, Работник);
	Если Завершено И Состояние.Этап = "Работник" Тогда
		// Исполнитель, которому не достался источник, остается скрытым в главной таблице.
		Состояние.Состояние = "Завершено";
		Состояние.Обновление = ТекущаяДатаСеанса();
		Состояние.Записать();
		Возврат;
	КонецЕсли;
	Состояние.Этап = Этап;
	Состояние.Всего = Прочитано;
	Состояние.Обработано = Зафиксировано;
	ПозицияСводки = СтрНайти(Состояние.Контекст, Символы.ПС);
	Сводка = "";
	Если ПозицияСводки > 0 Тогда
		Сводка = Сред(Состояние.Контекст, ПозицияСводки);
	КонецЕсли;
	Состояние.Контекст = СтрШаблон("Прочитано: %1; изменено: %2; защищенных единиц: %3.",
		Прочитано, Зафиксировано, Исключено) + Сводка;
	Состояние.Обновление = ТекущаяДатаСеанса();
	Если Завершено Тогда
		Состояние.Состояние = "Завершено";
	КонецЕсли;
	Состояние.Записать();

КонецПроцедуры

// Сохраняет отчет одного источника без прикладных значений; остальная диагностика не перезаписывается.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор исполнителя.
//  Источник - Строка - имя метаданных.
//  Счетчики - Структура - Прочитано, Зафиксировано, Исключено.
//  Завершен - Булево - доступность адаптера; ошибки отдельных записей перечислены отдельно.
Процедура ИтогИсточникаОбфускации(Запуск, Работник, Источник, Счетчики, Завершен) Экспорт

	Перем Несогласовано;
	Прочитано = Счетчики.Прочитано;
	Изменено = Счетчики.Зафиксировано;
	Исключено = Счетчики.Исключено;
	Состояние = ЗаписьСостояния(Запуск, Работник);
	РезультатАдаптера = "требуется ручная обработка";
	Если Завершен Тогда
		РезультатАдаптера = "адаптер выполнен";
	КонецЕсли;
	Состояние.Контекст = Состояние.Контекст + Символы.ПС
		+ СтрШаблон("%1: прочитано %2; изменено %3; защищено %4; %5.", Источник, Прочитано,
			Изменено, Исключено, РезультатАдаптера);
	Если Не Счетчики.Свойство("Несогласовано", Несогласовано) Тогда
		Несогласовано = 0;
	КонецЕсли;
	Если Несогласовано > 0 Тогда
		Состояние.Контекст = Состояние.Контекст + СтрШаблон(" Имен с независимым псевдонимом: %1.", Несогласовано);
	КонецЕсли;
	Состояние.Записать();

КонецПроцедуры

// Безопасная диагностика: Причина и Источник должны быть фиксированным текстом и именем метаданных.
// Не принимает ИнформацияОбОшибке и прикладные значения.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор исполнителя.
//  Причина - Строка - фиксированная безопасная причина.
//  Источник - Строка - полное имя метаданных.
//  КлючЕдиницы - Строка - UUID объекта либо хеш ключа регистра, без исходных измерений.
Процедура ЗаписатьОшибкуОбфускации(Запуск, Работник, Причина, Источник = "", КлючЕдиницы = "") Экспорт

	Состояние = ЗаписьСостояния(Запуск, Работник);
	Состояние.Ошибок = Состояние.Ошибок + 1;
	Состояние.ОписаниеОшибки = Причина;
	Состояние.Обновление = ТекущаяДатаСеанса();
	Состояние.Записать();
	Детали = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
	Детали.Запуск = Запуск;
	Детали.Ошибка = Строка(Новый УникальныйИдентификатор);
	Детали.Задание = Работник;
	Детали.Момент = Состояние.Обновление;
	Детали.Этап = Состояние.Этап;
	Детали.КраткоеОписание = Причина;
	Детали.ОписаниеОшибки = Причина + " Исходный текст исключения скрыт: он может содержать персональные данные.";
	Детали.Контекст = "Источник: " + Источник + "; запуск: " + Запуск;
	Если КлючЕдиницы <> "" Тогда
		Детали.Контекст = Детали.Контекст + "; единица: " + КлючЕдиницы;
	КонецЕсли;
	Детали.Записать();

КонецПроцедуры

// Ожидает только дочерние задания; координатор не ожидает самого себя.
Процедура ДождатьсяРаботниковОбфускации(Запуск) Экспорт

	Данные = ДанныеУправления(ЗаписьУправления(Запуск, "Управление"));
	Для Каждого Фон Из Данные.Фоновые Цикл
		Если Фон.Ключ = "Запуск" Тогда
			Продолжить;
		КонецЕсли;
		Задание = ФоновоеПоСтроке(Фон.Значение);
		Если Задание <> Неопределено Тогда
			Пока Задание.Состояние = СостояниеФоновогоЗадания.Активно Цикл
				Задание.ОжидатьЗавершенияВыполнения(0.2);
				Если ОстановкаЗапрошена(Запуск) Тогда
					ОтменитьЧтениеЗапуска(Запуск);
				КонецЕсли;
			КонецЦикла;
			Если Задание.Состояние <> СостояниеФоновогоЗадания.Завершено
				И Не ОстановкаЗапрошена(Запуск) Тогда
				ЗаписатьОшибкуОбфускации(Запуск, Фон.Ключ, "Работник обфускации завершился аварийно.");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Завершение с явным остаточным охватом, без повторного поиска ссылок по базе.
Процедура ЗавершитьОбфускацию(Запуск) Экспорт

	Если Не НачатьЗавершениеЗапуска(Запуск) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ СУММА(Обработано) КАК Обработано, СУММА(Ошибок) КАК Ошибок
		|ИЗ РегистрСведений.Cutter3000_Задания ГДЕ Запуск = &Запуск И Задание <> &Заголовок");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Итог = Запрос.Выполнить().Выбрать();
	Итог.Следующий();
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Заголовок.Обработано = 0;
	Если Итог.Обработано <> NULL Тогда
		Заголовок.Обработано = Итог.Обработано;
	КонецЕсли;
	Если Итог.Ошибок <> NULL Тогда
		Заголовок.Ошибок = Заголовок.Ошибок + Итог.Ошибок;
	КонецЕсли;
	Заголовок.Всего = Заголовок.Обработано;
	Заголовок.Контекст = ОтчетОбфускации(Запуск, Заголовок.Контекст);
	// Сохраняем активный заголовок до окончания очистки, закрывая допуск второго запуска.
	Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
	Заголовок.Состояние = "Обезличивание неполное";
	Заголовок.Этап = "Обфускация завершена; обезличивание неполное";
	Заголовок.Обновление = ТекущаяДатаСеанса();
	Заголовок.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФоновоеУдаленияДляПрогресса(Запуск, Работник, ИдентификаторКоординатора)

	Если ФайловаяБаза() Тогда
		Возврат ФоновоеПрогресса(ИдентификаторКоординатора);
	КонецЕсли;
	Возврат ФоновоеПрогресса(ЗаписьСостояния(Запуск, Работник).ФоновоеЗадание);

КонецФункции

Функция ФоновоеПрогресса(Идентификатор)

	Если Идентификатор = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

Функция ПакетПрогресса(Фоновое, УдалятьПолученные)

	Пакет = Новый Структура("Номер,Снимки", 0, Новый Массив);
	Поток = Фоновое.ПолучитьСообщенияПользователю(УдалятьПолученные);
	Для Индекс = 0 По Поток.Количество() - 1 Цикл
		Если Не СтрНачинаетсяС(Поток[Индекс].Текст, "Cutter3000|") Тогда
			Продолжить;
		КонецЕсли;
		Данные = ЗначениеИзСтрокиВнутр(Сред(Поток[Индекс].Текст, 12));
		Если Данные.Свойство("Снимки") Тогда
			Пакет = Данные;
		Иначе
			// Завершенные задания прежней сборки содержат отдельные сообщения без номера пакета.
			Пакет.Номер = Индекс;
			Пакет.Снимки.Очистить();
			Пакет.Снимки.Добавить(Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Пакет;

КонецФункции

Процедура ОтправитьСнимокПрогресса(Фоновое, Данные)

	// Единственный писатель заменяет свой пакет; наблюдатели ничего не удаляют.
	Пакет = ПакетПрогресса(Фоновое, Истина);
	Подготовка = Неопределено;
	Удаление = Неопределено;
	Для Каждого Снимок Из Пакет.Снимки Цикл
		Если Снимок.Задание = "Запуск" Тогда
			Подготовка = Снимок;
		Иначе
			Удаление = Снимок;
		КонецЕсли;
	КонецЦикла;
	Если Данные.Задание = "Запуск" Тогда
		Подготовка = Данные;
	Иначе
		Удаление = Данные;
	КонецЕсли;
	Пакет.Номер = Пакет.Номер + 1;
	Пакет.Снимки.Очистить();
	Если Подготовка <> Неопределено Тогда
		Пакет.Снимки.Добавить(Подготовка);
	КонецЕсли;
	Если Удаление <> Неопределено Тогда
		Пакет.Снимки.Добавить(Удаление);
	КонецЕсли;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Cutter3000|" + ЗначениеВСтрокуВнутр(Пакет);
	Сообщение.Сообщить();

КонецПроцедуры

Функция СнимкиПрогресса(Фоновое, Прочитанные)

	Результат = Новый Массив;
	Пакет = ПакетПрогресса(Фоновое, Ложь);
	Источник = Строка(Фоновое.УникальныйИдентификатор);
	Если Прочитанные <> Неопределено Тогда
		Номер = Прочитанные.Получить(Источник);
		Если Номер <> Неопределено И Пакет.Номер <= Номер Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Для Каждого Снимок Из Пакет.Снимки Цикл
		Результат.Добавить(Новый Структура("Источник,Номер,Данные", Источник, Пакет.Номер, Снимок));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаписатьЗамер(Замер, Исход, Длительность)

	ДанныеЗамера = Новый Структура;
	ДанныеЗамера.Вставить("Запуск", Замер.Запуск);
	ДанныеЗамера.Вставить("Задание", Замер.Задание);
	ДанныеЗамера.Вставить("Операция", Замер.Операция);
	ДанныеЗамера.Вставить("Таблица", Замер.Таблица);
	ДанныеЗамера.Вставить("Строк", Замер.Строк);
	ДанныеЗамера.Вставить("Запрос", Замер.Запрос);
	ДанныеЗамера.Вставить("Идентификатор", Замер.Идентификатор);
	ДанныеЗамера.Вставить("НачалоМс", Замер.НачалоМс);
	ДанныеЗамера.Вставить("ВремяМс", ТекущаяУниверсальнаяДатаВМиллисекундах());
	ДанныеЗамера.Вставить("ДлительностьМс", Длительность);
	ДанныеЗамера.Вставить("Исход", Исход);
	ДанныеЗамера.Вставить("Сеанс", НомерСеансаИнформационнойБазы());
	ДанныеЗамера.Вставить("Транзакция", ТранзакцияАктивна());
	ДанныеЗамера.Вставить("Версия", "1.1.0.23");
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ДанныеЗамера);
	Комментарий = Запись.Закрыть();
	// JSON-комментарий сохраняется и при откате; значения параметров запроса не передаются.
	ЗаписьЖурналаРегистрации("Cutter3000.Трассировка." + Замер.Запуск,
		УровеньЖурналаРегистрации.Информация, , , Комментарий,
		РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);

КонецПроцедуры


Процедура ВосстановитьОбфускацию(Запуск, Заголовок)

	Если ФоновоеАктивно(Заголовок.ФоновоеЗадание) Или ЕстьАктивныеРаботники(Запуск) Тогда
		Возврат;
	КонецЕсли;
	Если Заголовок.Состояние = "Выполняется" И ТекущаяДатаСеанса() - Заголовок.Обновление >= 30 Тогда
		ЗаписатьОшибкуОбфускации(Запуск, "Запуск", "Обфускация прервана. Незавершенные записи отменены платформой.");
		ЗавершитьОбфускацию(Запуск);
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьЭтапПланировщика(Контекст, Этап)

	Контроль = Контекст.Прогресс.Контроль;
	ПредыдущийЭтап = "";
	Если Не Контроль.Свойство("ЭтапПланировщика", ПредыдущийЭтап) Или ПредыдущийЭтап <> Этап Тогда
		Контроль.ПоследнееСообщение = Дата(1, 1, 1);
		Контроль.Вставить("ЭтапПланировщика", Этап);
	КонецЕсли;
	СообщитьПрогресс(Контекст.Запуск, "Запуск",
		СтрШаблон("%1; прочитано строк: %2", Этап, Контекст.Прогресс.Прочитано), 0, Контроль);

КонецПроцедуры

Функция НачатьЗавершениеЗапуска(Запуск)

	Разрешено = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Если Управление.Команда <> "Остановка" Тогда
			Управление.Состояние = "Завершение";
			Управление.Записать();
			Разрешено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Разрешено;

КонецФункции

Функция ОтчетОбфускации(Запуск, ОстаточныйОхват)

	Отчет = ОстаточныйОхват;
	Запрос = Новый Запрос("ВЫБРАТЬ Контекст ИЗ РегистрСведений.Cutter3000_Задания
		|ГДЕ Запуск = &Запуск И Задание <> &Заголовок И ВидОперации = &Вид");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Запрос.УстановитьПараметр("Вид", "Обфускация");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отчет = Отчет + Символы.ПС + Символы.ПС + Выборка.Контекст;
	КонецЦикла;
	Возврат Отчет;

КонецФункции

Функция ДанныеУправления(Управление)

	Если Управление.Данные <> Неопределено Тогда
		Данные = Управление.Данные.Получить();
		Если Данные <> Неопределено Тогда
			Возврат Данные;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Фоновые,ФоновоеОстановки,Отмененные", Новый Соответствие, "", Новый Соответствие);

КонецФункции

Процедура СоздатьУправлениеЗапуском(Запуск)

	Управление = ЗаписьУправления(Запуск, "Управление");
	Управление.НазначениеРаботника = "Управление";
	Управление.Состояние = "Выполняется";
	Управление.Данные = Новый ХранилищеЗначения(ДанныеУправления(Управление));
	Управление.Записать();
	Координатор = ЗаписьУправления(Запуск, "Запуск");
	Координатор.НазначениеРаботника = "Координатор";
	Координатор.ФазаИсполнения = "Регистрация";
	Координатор.Записать();

КонецПроцедуры

Процедура ЗарегистрироватьФоновое(Запуск, Работник, Фоновое)

	СобственнаяТранзакция = Не ТранзакцияАктивна();
	Если СобственнаяТранзакция Тогда
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	КонецЕсли;
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Данные.Фоновые.Вставить(Работник, Строка(Фоновое.УникальныйИдентификатор));
		Управление.Данные = Новый ХранилищеЗначения(Данные);
		Управление.Записать();
		Если СобственнаяТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СобственнаяТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ФоновоеПоСтроке(Идентификатор)

	Если Идентификатор = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

Процедура ОбеспечитьЗаданиеОстановки(Запуск, Управление)

	Данные = ДанныеУправления(Управление);
	Если ФоновоеАктивно(Данные.ФоновоеОстановки) Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(Запуск);
	Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ЗаданияСервер.ВыполнитьОстановку",
		Параметры, "Остановка|" + Запуск, "Cutter3000: остановка обрезки");
	Данные.ФоновоеОстановки = Строка(Фоновое.УникальныйИдентификатор);
	Управление.Данные = Новый ХранилищеЗначения(Данные);
	Управление.Записать();

КонецПроцедуры

Функция ИзменитьФазуРаботника(Запуск, Работник, Фаза)

	Разрешено = Ложь;
	Если Не ЗапускДопускаетРаботу(ЗаписьУправления(Запуск, "Управление")) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Состояние и сервис фоновых заданий читаются до захвата шлюза остановки.
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	КоординаторДоступен = Заголовок.ВидОперации <> "Обфускация" Или Работник = "Запуск"
		Или ФоновоеАктивно(Заголовок.ФоновоеЗадание);
	ФайловыйРаботникОбфускации = Заголовок.ВидОперации = "Обфускация" И Работник <> "Запуск"
		И ЗаписьСостояния(Запуск, Работник).ФоновоеЗадание = Заголовок.ФоновоеЗадание;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Если КоординаторДоступен И ЗапускДопускаетРаботу(Управление) Тогда
			ЗаблокироватьУправление(Запуск, Работник);
			Очередь = ЗаписьУправления(Запуск, Работник);
			Очередь.ФазаИсполнения = Фаза;
			Очередь.Записать();
			Если ФайловыйРаботникОбфускации Тогда
				// Файловый работник исполняется внутри координатора: фаза отмены меняется атомарно.
				Координатор = ЗаписьУправления(Запуск, "Запуск");
				Координатор.ФазаИсполнения = Фаза;
				Координатор.Записать();
			КонецЕсли;
			Разрешено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Разрешено;

КонецФункции

Функция ЗапускДопускаетРаботу(Управление)

	Возврат Управление.НазначениеРаботника = "Управление"
		И Управление.Состояние = "Выполняется" И Управление.Команда <> "Остановка";

КонецФункции

Процедура ОтметитьОжиданиеРаботника(Запуск, Работник)

	// Завершение удаления не допускает новую работу и не требует общего шлюза остановки.
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, Работник);
		Очередь = ЗаписьУправления(Запуск, Работник);
		Очередь.ФазаИсполнения = "Ожидание";
		Очередь.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ФазаКоординатора(Запуск, Фаза)

	Если Не ИзменитьФазуРаботника(Запуск, "Запуск", Фаза) Тогда
		ПроверитьОстановку(Запуск);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьЗаданияДанных(Запуск)

	Данные = ДанныеУправления(ЗаписьУправления(Запуск, "Управление"));
	Для Каждого Фон Из Данные.Фоновые Цикл
		Если ФоновоеАктивно(Фон.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ОтменитьЧтениеЗапуска(Запуск)

	Управление = ЗаписьУправления(Запуск, "Управление");
	Данные = ДанныеУправления(Управление);
	Для Каждого Фон Из Данные.Фоновые Цикл
		Если Данные.Отмененные.Получить(Фон.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Очередь = ЗаписьУправления(Запуск, Фон.Ключ);
		Если Не ЧтениеМожноОтменить(Очередь) Тогда
			Продолжить;
		КонецЕсли;
		Задание = ФоновоеПоСтроке(Фон.Значение);
		Если Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗарезервироватьОтменуЧтения(Запуск, Фон.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Описание = "";
		// Граница платформенной отмены: отказ по правам остается доступен после остановки.
		Попытка
			Задание.Отменить();
		Исключение
			Описание = "Не удалось отменить читающее задание.";
			Если ЗаписьСостояния(Запуск, "Запуск").ВидОперации <> "Обфускация" Тогда
				Описание = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
			СохранитьОшибку(Запуск, "Запуск", ИнформацияОбОшибке());
			ЗафиксироватьОтменуЧтения(Запуск, Фон.Ключ, Описание);
			Продолжить;
		КонецПопытки;
		ЗафиксироватьОтменуЧтения(Запуск, Фон.Ключ, Описание);
	КонецЦикла;

КонецПроцедуры

Функция ЧтениеМожноОтменить(Очередь)

	Если Очередь.НазначениеРаботника = "Чтение" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат (Очередь.НазначениеРаботника = "Обфускация"
		Или Очередь.НазначениеРаботника = "Координатор") И Очередь.ФазаИсполнения = "Чтение";

КонецФункции

Функция ЗарезервироватьОтменуЧтения(Запуск, Работник)

	Разрешено = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		ОчередьРаботника = ЗаписьУправления(Запуск, Работник);
		Если Управление.Команда = "Остановка" И Данные.Отмененные.Получить(Работник) = Неопределено
			И ЧтениеМожноОтменить(ОчередьРаботника) Тогда
			Данные.Отмененные.Вставить(Работник, Истина);
			Управление.Данные = Новый ХранилищеЗначения(Данные);
			Управление.Записать();
			Разрешено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Разрешено;

КонецФункции

Процедура ЗафиксироватьОтменуЧтения(Запуск, Работник, Описание)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьУправление(Запуск, "Управление");
		Управление = ЗаписьУправления(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Данные.Отмененные.Вставить(Работник, Истина);
		Управление.Данные = Новый ХранилищеЗначения(Данные);
		Если Описание <> "" Тогда
			Управление.Ошибка = СтрШаблон("%1%2%3", Управление.Ошибка, Символы.ПС, Описание);
		КонецЕсли;
		Управление.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗавершитьОстановку(Запуск)

	Если Не ОстановкаЗапрошена(Запуск) Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьЗаданияДанных(Запуск) Тогда
		ВызватьИсключение "Ожидается завершение работников обрезки.";
	КонецЕсли;
	Управление = ЗаписьУправления(Запуск, "Управление");
	Данные = ДанныеУправления(Управление);
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние(Запуск);
		Набор = РегистрыСведений.Cutter3000_Задания.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Набор.Прочитать();
		Зафиксировано = 0;
		Ошибок = 0;
		Для Каждого Запись Из Набор Цикл
			Если Запись.Задание <> "Запуск" И Запись.Этап <> "Работник" И Запись.Этап <> "Служебный" Тогда
				Зафиксировано = Зафиксировано + Запись.Обработано;
				Ошибок = Ошибок + Запись.Ошибок;
			КонецЕсли;
			Если Запись.Состояние = "Выполняется" Или Запись.Состояние = "Ожидание" Тогда
				Запись.Состояние = "Остановлено";
				Если Запись.Этап <> "Работник" И Запись.Этап <> "Служебный" Тогда
					Запись.Этап = "Остановлено пользователем";
				КонецЕсли;
				Запись.Обновление = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЦикла;
		Набор.Записать();
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Заголовок.Состояние = "Остановлено";
		Заголовок.Этап = "Остановлено пользователем";
		Заголовок.Обработано = Зафиксировано;
		Заголовок.Ошибок = Заголовок.Ошибок + Ошибок;
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.ФоновоеЗадание = Данные.ФоновоеОстановки;
		Если Заголовок.ВидОперации = "Обфускация" Тогда
			Заголовок.Контекст = ОтчетОбфускации(Запуск, Заголовок.Контекст)
				+ Символы.ПС + "Операция остановлена: незавершенные источники требуют повторной обработки.";
		КонецЕсли;
		Заголовок.Записать();
		Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры


Функция ЗаписьУправления(Запуск, Работник)

	Запись = РегистрыСведений.Cutter3000_Управление.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Работник = Работник;
	Запись.Прочитать();
	Запись.Запуск = Запуск;
	Запись.Работник = Работник;
	Возврат Запись;

КонецФункции

Процедура ЗаблокироватьУправление(Запуск, Работник)

	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Управление.Работник КАК Работник
			|ИЗ РегистрСведений.Cutter3000_Управление КАК Управление
			|ГДЕ Управление.Запуск = &Запуск И Управление.Работник = &Работник
			|ДЛЯ ИЗМЕНЕНИЯ");
		Запрос.УстановитьПараметр("Запуск", Запуск);
		Запрос.УстановитьПараметр("Работник", Работник);
		// Нужна только установка блокировки; строки результата не используются.
		Запрос.Выполнить();
	Иначе
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Управление");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Запуск", Запуск);
		Элемент.УстановитьЗначение("Работник", Работник);
		Блокировка.Заблокировать();
	КонецЕсли;

