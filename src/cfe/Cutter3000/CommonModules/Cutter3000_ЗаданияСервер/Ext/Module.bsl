#Область ПрограммныйИнтерфейс

// Принимает единственный запуск обрезки.
// Параметры:
//  ДатаОбрезки - Дата - первый сохраняемый день.
// Возвращаемое значение:
//  Строка - идентификатор нового или уже активного запуска.
Функция НачатьОбрезку(ДатаОбрезки) Экспорт

	Граница = Cutter3000_ДанныеСервер.ГраницаОбрезки(ДатаОбрезки);
	ВосстановитьСостояние(АктивныйЗапуск());
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка

		ЗаблокироватьСостояние("Служебный", "ЕдинственныйЗапуск");
		Активный = АктивныйЗапуск();
		Если Активный <> "" Тогда
			Запуск = Активный;
		Иначе
			Запуск = Строка(Новый УникальныйИдентификатор);
			Заголовок = ЗаписьСостояния(Запуск, "Запуск");
			Заголовок.Граница = Граница;
			Заголовок.Начало = ТекущаяДатаСеанса();
			Заголовок.Обновление = Заголовок.Начало;
			Заголовок.Наименование = "Подготовка плана обрезки";
			Заголовок.Этап = "Планирование";
			Заголовок.Состояние = "Выполняется";
			Заголовок.Записать();
			СоздатьУправлениеЗапуском(Запуск);
			ПараметрыЗадания = Новый Массив;
			ПараметрыЗадания.Добавить(Запуск);
			Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ЗаданияСервер.ПостроитьПлан",
				ПараметрыЗадания, Запуск, "Cutter3000: подготовка плана обрезки");
			Заголовок.ФоновоеЗадание = Строка(Фоновое.УникальныйИдентификатор);
			Заголовок.Записать();
			ЗарегистрироватьФоновое(Запуск, "Запуск", Фоновое);
			Координатор = ЗаписьОчереди(Запуск, "Запуск");
			Координатор.ФазаИсполнения = "Чтение";
			Координатор.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;
	Возврат Запуск;

КонецФункции

// Принимает остановку только текущего запуска, не ожидая удаления на клиенте.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Структура - Принято (Булево), Описание (Строка).
Функция ЗапроситьОстановку(Запуск) Экспорт

	Принято = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Запуск, "Управление");
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Если Управление.НазначениеРаботника = "Управление"
			И Управление.Состояние <> "Завершение" Тогда
			Принято = Истина;
			Если Управление.Команда <> "Остановка" Тогда
				Управление.Команда = "Остановка";
				Управление.Состояние = "Останавливается";
				Управление.Записать();
			КонецЕсли;
			ОбеспечитьЗаданиеОстановки(Запуск, Управление);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Принято Тогда
		ОтменитьЧтениеЗапуска(Запуск);
	КонецЕсли;
	Управление = ЗаписьОчереди(Запуск, "Управление");
	Описание = Управление.Ошибка;
	Возврат Новый Структура("Принято,Описание", Принято, Описание);

КонецФункции

// Проверяет устойчивый сигнал на границе страницы или команды планировщика.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
// Возвращаемое значение:
//  Булево - принят ли запрос остановки.
Функция ОстановкаЗапрошена(Запуск) Экспорт

	Если Запуск = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Управление = ЗаписьОчереди(Запуск, "Управление");
	Возврат Управление.Команда = "Остановка";

КонецФункции

// Прерывает подготовку на безопасной границе; не вызывается внутри удаления.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ПроверитьОстановку(Запуск) Экспорт

	Если ОстановкаЗапрошена(Запуск) Тогда
		ВызватьИсключение "Остановка обрезки запрошена пользователем.";
	КонецЕсли;

КонецПроцедуры

// Завершает остановку независимо от формы и отмененного читающего координатора.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ВыполнитьОстановку(Запуск) Экспорт

	Попытка
		Пока ЕстьЗаданияДанных(Запуск) Цикл
			ОтменитьЧтениеЗапуска(Запуск);
			Данные = ДанныеУправления(ЗаписьОчереди(Запуск, "Управление"));
			Для Каждого Фон Из Данные.Фоновые Цикл
				Задание = ФоновоеПоСтроке(Фон.Значение);
				Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
					Задание.ОжидатьЗавершенияВыполнения(0.1);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ЗавершитьОстановку(Запуск);
	Исключение
		СохранитьОшибку(Запуск, "Запуск", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры


// Читает состояние и недеструктивный поток промежуточных сообщений.
// Параметры:
//  Запуск - Строка - идентификатор запуска; пустой означает последний запуск.
//  Прочитанные - Соответствие, Неопределено - номера сообщений по идентификаторам фоновых заданий.
// Возвращаемое значение:
//  Структура - заголовок, работы, сообщения текущих попыток и ПрошлоСекунд (Число).
Функция СостояниеОбрезки(Запуск = "", Прочитанные = Неопределено) Экспорт

	Если Запуск = "" Тогда
		Запуск = ПоследнийЗапуск();
	КонецЕсли;
	ВосстановитьСостояние(Запуск);
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Работы = РаботыЗапуска(Запуск);
	Управление = ЗаписьОчереди(Запуск, "Управление");
	Останавливается = Управление.Команда = "Остановка"
		Или (Заголовок.Состояние = "Остановлено" И ФоновоеАктивно(Заголовок.ФоновоеЗадание));
	Если Останавливается Тогда
		Заголовок.Состояние = "Останавливается";
		Для Каждого Работа Из Работы Цикл
			Если Работа.Идентификатор = "Запуск" Тогда
				Работа.Этап = "Останавливается";
				Работа.Состояние = "Останавливается";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	МожноОстановить = Управление.НазначениеРаботника = "Управление"
		И Управление.Состояние <> "Завершение" И Не Останавливается;
	Сообщения = Новый Массив;
	Фоновые = ФоновыеЗапуска(Запуск);
	Для Каждого СтрокаФонового Из Фоновые Цикл

		Если СтрокаФонового.ФоновоеЗадание = "" Тогда
			Продолжить;
		КонецЕсли;
		Фоновое = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
			Новый УникальныйИдентификатор(СтрокаФонового.ФоновоеЗадание));
		Если Фоновое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поток = Фоновое.ПолучитьСообщенияПользователю(Ложь);
		ПервыйНомер = 0;
		Если Прочитанные <> Неопределено Тогда
			ПоследнийНомер = Прочитанные.Получить(СтрокаФонового.ФоновоеЗадание);
			Если ПоследнийНомер <> Неопределено Тогда
				ПервыйНомер = ПоследнийНомер + 1;
			КонецЕсли;
		КонецЕсли;
		Для Индекс = ПервыйНомер По Поток.Количество() - 1 Цикл

			ТекстСообщения = Поток[Индекс].Текст;
			Если СтрНачинаетсяС(ТекстСообщения, "Cutter3000|") Тогда

				ДанныеСообщения = ЗначениеИзСтрокиВнутр(Сред(ТекстСообщения, 12));
				Сообщения.Добавить(Новый Структура("Источник,Номер,Данные",
					СтрокаФонового.ФоновоеЗадание, Индекс, ДанныеСообщения));

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;
	МассивРабот = Новый Массив;
	Для Каждого Работа Из Работы Цикл
		СтрокаРаботы = Новый Структура;
		Для Каждого Колонка Из Работы.Колонки Цикл
			СтрокаРаботы.Вставить(Колонка.Имя, Работа[Колонка.Имя]);
		КонецЦикла;
		МассивРабот.Добавить(СтрокаРаботы);
	КонецЦикла;
	ПрошлоСекунд = 0;
	Если ЗначениеЗаполнено(Заголовок.Начало) Тогда
		МоментРасчета = Заголовок.Обновление;
		Если Заголовок.Состояние = "Выполняется" Или Заголовок.Состояние = "Ожидание"
			Или Заголовок.Состояние = "Останавливается" Тогда
			МоментРасчета = ТекущаяДатаСеанса();
		КонецЕсли;
		ПрошлоСекунд = Макс(0, МоментРасчета - Заголовок.Начало);
	КонецЕсли;
	Возврат Новый Структура("Запуск,Граница,Состояние,Работы,Сообщения,Режим,ПланЗавершен,ПрошлоСекунд,МожноОстановить", Запуск,
		Заголовок.Граница, Заголовок.Состояние, МассивРабот, Сообщения, РежимВыполнения(),
		Заголовок.Этап <> "Планирование", ПрошлоСекунд, МожноОстановить);

КонецФункции

// Читает тяжелую диагностику только по запросу пользователя.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор логической работы.
// Возвращаемое значение:
//  Структура - описание ошибки и контекст без прикладных ссылок.
Функция ОшибкиЗадания(Запуск, Задание) Экспорт

	Запись = ЗаписьСостояния(Запуск, Задание);
	Возврат Новый Структура("ОписаниеОшибки,Контекст", Запись.ОписаниеОшибки, Запись.Контекст);

КонецФункции

// Читает отдельные ошибки для реквизита таблицы управляемой формы, только на сервере.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор работы; «Запуск» показывает ошибки всех работ.
// Возвращаемое значение:
//  ТаблицаЗначений - Идентификатор, Момент, НаименованиеЗадания, Этап, КраткоеОписание.
Функция СписокОшибокЗадания(Запуск, Задание) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ Ошибки.Ошибка КАК Идентификатор, Ошибки.Момент,
		| ЕСТЬNULL(Задания.Наименование, Ошибки.Задание) КАК НаименованиеЗадания,
		| Ошибки.Этап, Ошибки.КраткоеОписание
		|ИЗ РегистрСведений.Cutter3000_Ошибки КАК Ошибки
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Cutter3000_Задания КАК Задания
		| ПО Ошибки.Запуск = Задания.Запуск И Ошибки.Задание = Задания.Задание
		|ГДЕ Ошибки.Запуск = &Запуск И (&ВсеЗадания ИЛИ Ошибки.Задание = &Задание)
		|УПОРЯДОЧИТЬ ПО Ошибки.Момент, Ошибки.Ошибка");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("ВсеЗадания", Задание = "Запуск");
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции

// Читает полный текст одной сохраненной ошибки без прикладных ссылок.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Идентификатор - Строка - ключ строки таблицы ошибок.
// Возвращаемое значение:
//  Структура - ОписаниеОшибки и Контекст, пригодные для параметров формы.
Функция ДеталиОшибки(Запуск, Идентификатор) Экспорт

	Запись = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Ошибка = Идентификатор;
	Запись.Прочитать();
	Контекст = СтрШаблон("Время: %1; этап: %2.%3%4",
		Формат(Запись.Момент, "ДФ=yyyy-MM-dd HH:mm:ss"), Запись.Этап, Символы.ПС, Запись.Контекст);
	Возврат Новый Структура("ОписаниеОшибки,Контекст", Запись.ОписаниеОшибки, Контекст);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет команды одного координатора; описания метаданных живут до завершения работника.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - ключ единственного почтового ящика.
//  Родитель - Строка - идентификатор фонового координатора.
Процедура ВыполнитьРаботникаПула(Запуск, Работник, Родитель) Экспорт

	Контекст = Неопределено;
	Попытка
		Пока Истина Цикл
			Если ОстановкаЗапрошена(Запуск) Тогда
				Прервать;
			КонецЕсли;
			Координатор = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Родитель));
			Если Координатор = Неопределено Или Координатор.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				Прервать;
			КонецЕсли;
			Очередь = ЗаписьОчереди(Запуск, Работник);
			Если Очередь.Команда = "Стоп" Или Очередь.Состояние = "" Тогда
				Прервать;
			КонецЕсли;
			Если Очередь.Состояние <> "Новая" Тогда
				Координатор.ОжидатьЗавершенияВыполнения(0.1);
				Продолжить;
			КонецЕсли;
			// Единственный потребитель; до ответа координатор не заменяет запрос.
			Данные = Очередь.Данные.Получить();
			Если Контекст = Неопределено Тогда
				Контекст = Cutter3000_ДанныеСервер.КонтекстКонтроляКаскадов();
			КонецЕсли;
			Если Очередь.Команда = "Чтение" Тогда
				ПроверитьОстановку(Запуск);
				Результат = Cutter3000_ДанныеСервер.ПрочитатьСтраницуРаботника(Контекст, Данные);
				ПроверитьОстановку(Запуск);
			ИначеЕсли Очередь.Команда = "Удаление" Тогда
				ВыполнитьГруппу(Запуск, Данные, Контекст, Работник);
				Результат = Истина;
			Иначе
				ВызватьИсключение "Неизвестная команда работника Cutter3000.";
			КонецЕсли;
			ЗаписатьОтветПула(Запуск, Работник, Результат);
		КонецЦикла;
		ЗавершитьРаботника(Запуск, Работник);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ОстановкаЗапрошена(Запуск) Тогда
			Возврат;
		КонецЕсли;
		ЗаписатьОтветПула(Запуск, Работник, Неопределено, ПодробноеПредставлениеОшибки(Ошибка));
		СохранитьОшибку(Запуск, Работник, Ошибка);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Передает одну команду свободному работнику. Повторного выполнения при потере работника нет.
// Параметры:
//  Слот - Структура - слот координатора с идентификатором запуска и фонового задания.
//  Команда - Строка - Чтение либо Удаление.
//  Данные - Произвольный - сериализуемые параметры без объектов метаданных.
Процедура ОтправитьКомандуПула(Слот, Команда, Данные) Экспорт

	ПроверитьОстановку(Слот.Запуск);
	Если Не ФоновоеАктивно(Строка(Слот.Фоновое.УникальныйИдентификатор)) Тогда
		ВызватьИсключение "Постоянный работник завершился до получения команды.";
	КонецЕсли;
	Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
	Если Очередь.Состояние <> "Свободен" И Очередь.Состояние <> "Готово" Тогда
		ВызватьИсключение "Почтовый ящик работника занят или содержит ошибку.";
	КонецЕсли;
	Очередь.Команда = Команда;
	Очередь.Данные = Новый ХранилищеЗначения(Данные);
	Очередь.Ошибка = "";
	Очередь.Состояние = "Новая";
	Очередь.Записать();

КонецПроцедуры

// Читает готовый ответ, не дожидаясь следующего опроса формы.
// Параметры:
//  Слот - Структура - слот координатора.
// Возвращаемое значение:
//  Структура, Неопределено - Результат команды либо ожидание; сбой прерывает только координатор.
Функция ПолучитьРезультатПула(Слот) Экспорт

	ПроверитьОстановку(Слот.Запуск);
	Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
	Если Очередь.Состояние = "Ошибка" Тогда
		ВызватьИсключение Очередь.Ошибка;
	КонецЕсли;
	Если Очередь.Состояние = "Готово" Тогда
		Возврат Новый Структура("Результат", Очередь.Данные.Получить());
	КонецЕсли;
	Если Не ФоновоеАктивно(Строка(Слот.Фоновое.УникальныйИдентификатор)) Тогда
		ВызватьИсключение "Потерян постоянный работник " + Слот.Идентификатор;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Планировщик читает следующий каскад одновременно с удалением опубликованной порции.
// Параметры:
//  Запуск - Строка - идентификатор принятого запуска.
Процедура ПостроитьПлан(Запуск) Экспорт

	Слоты = Новый Массив;
	Читатели = Новый Массив;
	Попытка
		ФазаКоординатора(Запуск, "Чтение");
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		КоличествоПотоков = 2;
		Если ФайловаяБаза() Тогда
			КоличествоПотоков = 1;
		КонецЕсли;
		Контекст = Cutter3000_ДанныеСервер.НачатьПланированиеКаскадов(Заголовок.Граница, Запуск,
			КоличествоПотоков);
		Слоты = СоздатьСлотыКаскадов(Запуск, Контекст.Работы);
		КонтекстПроверки = Cutter3000_ДанныеСервер.КонтекстКонтроляКаскадов(Контекст);
		Если Не ФайловаяБаза() Тогда
			Для Каждого Слот Из Слоты Цикл
				ЗапуститьРаботникаПула(Запуск, Слот, Заголовок.ФоновоеЗадание, "Удаление");
			КонецЦикла;
			Для Номер = 1 По 2 Цикл
				Читатель = Новый Структура("Идентификатор,Фоновое,Использован,Задание",
					Строка(Новый УникальныйИдентификатор), Неопределено, Ложь, "");
				Читатели.Добавить(Читатель);
				ЗапуститьРаботникаПула(Запуск, Читатель, Заголовок.ФоновоеЗадание, "Чтение");
			КонецЦикла;
			Контекст.Вставить("Читатели", Читатели);
		КонецЕсли;
		ПодготовитьИПередатьКаскады(Запуск, Контекст, Слоты, КонтекстПроверки);
		ПроверитьОстановку(Запуск);
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Заголовок.Этап = "Выполнение";
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.Записать();
		Для Каждого Слот Из Слоты Цикл
			ОжидатьСлотКаскадов(Слот);
		КонецЦикла;
		ОстановитьПулКаскадов(Слоты, Читатели);
		ЗавершитьРаботыКаскадов(Запуск);
		ЗавершитьЗапуск(Запуск);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ОстановкаЗапрошена(Запуск) Тогда
			Возврат;
		КонецЕсли;
		// Сначала завершаются уже запущенные транзакции; их индекс еще нужен работникам.
		Для Каждого Слот Из Слоты Цикл
			Попытка
				ОжидатьСлотКаскадов(Слот);
			Исключение
				// Первичная ошибка сохраняется после завершения остальных работников.
			КонецПопытки;
		КонецЦикла;
		Попытка
			ОстановитьПулКаскадов(Слоты, Читатели);
		Исключение
			// Если остановка недоступна, работники выйдут после окончания координатора.
			// Очистку их индекса выполнит восстановление после завершения всех сеансов.
		КонецПопытки;
		СохранитьОшибку(Запуск, "Запуск", Ошибка);
		ЗавершитьРаботыКаскадов(Запуск, Истина);
		Если Не ЕстьАктивныеРаботники(Запуск) Тогда
			Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Удаляет опубликованную порцию одной работы; дочерних заданий не создает.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор технического работника.
//  Задание - Строка - идентификатор работы с единственной опубликованной порцией.
//  КонтекстПроверки - Структура, Неопределено - описания метаданных текущего сеанса.
Процедура ВыполнитьПакетКаскадов(Запуск, Работник, Задание, КонтекстПроверки = Неопределено) Экспорт

	ВыполнитьГруппу(Запуск, Задание, КонтекстПроверки, "Запуск");
	ЗавершитьРаботника(Запуск, Работник);

КонецПроцедуры

// Экспортная точка входа работника очереди.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор технического работника.
Процедура ВыполнитьОчередь(Запуск, Работник) Экспорт

	Запись = ЗаписьСостояния(Запуск, Работник);
	Запись.Состояние = "Выполняется";
	Запись.Обновление = ТекущаяДатаСеанса();
	Запись.Записать();
	Пока Истина Цикл

		Задание = РезервироватьГруппу(Запуск, Работник);
		Если Задание = "" Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьГруппу(Запуск, Задание);

	КонецЦикла;
	ЗавершитьРаботника(Запуск, Работник);

КонецПроцедуры

// Отправляет компактный прогресс текущей транзакции.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Задание - Строка - идентификатор логической работы.
//  Этап - Строка - этап выполнения.
//  Обработано - Число - счетчик текущей попытки; не является зафиксированным результатом.
//  Контроль - Структура - время последнего сообщения текущей группы.
Процедура СообщитьПрогресс(Запуск, Задание, Этап, Обработано, Контроль) Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Если Сейчас - Контроль.ПоследнееСообщение < 1 Тогда
		Возврат;
	КонецЕсли;
	Контроль.ПоследнееСообщение = Сейчас;
	Контроль.Вставить("ЭтапПланировщика", Этап);

	Если Не Контроль.Свойство("ЗафиксированоДо") Тогда
		ЗафиксированоДо = 0;
		Если Задание <> "Запуск" Тогда
			ЗафиксированоДо = ЗаписьСостояния(Запуск, Задание).Обработано;
		КонецЕсли;
		Контроль.Вставить("ЗафиксированоДо", ЗафиксированоДо);
	КонецЕсли;
	Данные = Новый Структура("Запуск,Задание,Этап,Обработано,ЗафиксированоДо", Запуск, Задание, Этап,
		Обработано, Контроль.ЗафиксированоДо);
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Cutter3000|" + ЗначениеВСтрокуВнутр(Данные);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьЭтапПланировщика(Контекст, Этап)

	Контроль = Контекст.Прогресс.Контроль;
	ПредыдущийЭтап = "";
	Если Не Контроль.Свойство("ЭтапПланировщика", ПредыдущийЭтап) Или ПредыдущийЭтап <> Этап Тогда
		Контроль.ПоследнееСообщение = Дата(1, 1, 1);
		Контроль.Вставить("ЭтапПланировщика", Этап);
	КонецЕсли;
	СообщитьПрогресс(Контекст.Запуск, "Запуск",
		СтрШаблон("%1; прочитано строк: %2", Этап, Контекст.Прогресс.Прочитано), 0, Контроль);

КонецПроцедуры

Функция НачатьЗавершениеЗапуска(Запуск)

	Разрешено = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Запуск, "Управление");
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Если Управление.Команда <> "Остановка" Тогда
			Управление.Состояние = "Завершение";
			Управление.Записать();
			Разрешено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Разрешено;

КонецФункции

Функция ДанныеУправления(Управление)

	Если Управление.Данные <> Неопределено Тогда
		Данные = Управление.Данные.Получить();
		Если Данные <> Неопределено Тогда
			Возврат Данные;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Фоновые,ФоновоеОстановки,Отмененные", Новый Соответствие, "", Новый Соответствие);

КонецФункции

Процедура СоздатьУправлениеЗапуском(Запуск)

	Управление = ЗаписьОчереди(Запуск, "Управление");
	Управление.НазначениеРаботника = "Управление";
	Управление.Состояние = "Выполняется";
	Управление.Данные = Новый ХранилищеЗначения(ДанныеУправления(Управление));
	Управление.Записать();
	Координатор = ЗаписьОчереди(Запуск, "Запуск");
	Координатор.НазначениеРаботника = "Координатор";
	Координатор.ФазаИсполнения = "Регистрация";
	Координатор.Записать();

КонецПроцедуры

Процедура ЗарегистрироватьФоновое(Запуск, Работник, Фоновое)

	СобственнаяТранзакция = Не ТранзакцияАктивна();
	Если СобственнаяТранзакция Тогда
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	КонецЕсли;
	Попытка
		ЗаблокироватьОчередь(Запуск, "Управление");
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Данные.Фоновые.Вставить(Работник, Строка(Фоновое.УникальныйИдентификатор));
		Управление.Данные = Новый ХранилищеЗначения(Данные);
		Управление.Записать();
		Если СобственнаяТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СобственнаяТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ФоновоеПоСтроке(Идентификатор)

	Если Идентификатор = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

Процедура ОбеспечитьЗаданиеОстановки(Запуск, Управление)

	Данные = ДанныеУправления(Управление);
	Если ФоновоеАктивно(Данные.ФоновоеОстановки) Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(Запуск);
	Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ЗаданияСервер.ВыполнитьОстановку",
		Параметры, "Остановка|" + Запуск, "Cutter3000: остановка обрезки");
	Данные.ФоновоеОстановки = Строка(Фоновое.УникальныйИдентификатор);
	Управление.Данные = Новый ХранилищеЗначения(Данные);
	Управление.Записать();

КонецПроцедуры

Функция ИзменитьФазуРаботника(Запуск, Работник, Фаза, ПроверитьЗапрос = Истина)

	Разрешено = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Запуск, "Управление");
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Если Не ПроверитьЗапрос Или Управление.Команда <> "Остановка" Тогда
			ЗаблокироватьОчередь(Запуск, Работник);
			Очередь = ЗаписьОчереди(Запуск, Работник);
			Очередь.ФазаИсполнения = Фаза;
			Очередь.Записать();
			Разрешено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Разрешено;

КонецФункции

Процедура ФазаКоординатора(Запуск, Фаза)

	Если Не ИзменитьФазуРаботника(Запуск, "Запуск", Фаза) Тогда
		ПроверитьОстановку(Запуск);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьЗаданияДанных(Запуск)

	Данные = ДанныеУправления(ЗаписьОчереди(Запуск, "Управление"));
	Для Каждого Фон Из Данные.Фоновые Цикл
		Если ФоновоеАктивно(Фон.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ОтменитьЧтениеЗапуска(Запуск)

	Управление = ЗаписьОчереди(Запуск, "Управление");
	Данные = ДанныеУправления(Управление);
	Для Каждого Фон Из Данные.Фоновые Цикл
		Если Данные.Отмененные.Получить(Фон.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Очередь = ЗаписьОчереди(Запуск, Фон.Ключ);
		Читатель = Очередь.НазначениеРаботника = "Чтение";
		КоординаторЧитает = Очередь.НазначениеРаботника = "Координатор"
			И Очередь.ФазаИсполнения = "Чтение";
		Если Не Читатель И Не КоординаторЧитает Тогда
			Продолжить;
		КонецЕсли;
		Задание = ФоновоеПоСтроке(Фон.Значение);
		Если Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗарезервироватьОтменуЧтения(Запуск, Фон.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Описание = "";
		// Граница платформенной отмены: отказ по правам остается доступен после остановки.
		Попытка
			Задание.Отменить();
		Исключение
			Описание = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			СохранитьОшибку(Запуск, "Запуск", ИнформацияОбОшибке());
			ЗафиксироватьОтменуЧтения(Запуск, Фон.Ключ, Описание);
			Продолжить;
		КонецПопытки;
		ЗафиксироватьОтменуЧтения(Запуск, Фон.Ключ, Описание);
	КонецЦикла;

КонецПроцедуры

Функция ЗарезервироватьОтменуЧтения(Запуск, Работник)

	Разрешено = Ложь;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Запуск, "Управление");
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Если Управление.Команда = "Остановка" И Данные.Отмененные.Получить(Работник) = Неопределено Тогда
			Данные.Отмененные.Вставить(Работник, Истина);
			Управление.Данные = Новый ХранилищеЗначения(Данные);
			Управление.Записать();
			Разрешено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Разрешено;

КонецФункции

Процедура ЗафиксироватьОтменуЧтения(Запуск, Работник, Описание)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Запуск, "Управление");
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Данные.Отмененные.Вставить(Работник, Истина);
		Управление.Данные = Новый ХранилищеЗначения(Данные);
		Если Описание <> "" Тогда
			Управление.Ошибка = СтрШаблон("%1%2%3", Управление.Ошибка, Символы.ПС, Описание);
		КонецЕсли;
		Управление.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗавершитьОстановку(Запуск)

	Если Не ОстановкаЗапрошена(Запуск) Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьЗаданияДанных(Запуск) Тогда
		ВызватьИсключение "Ожидается завершение работников обрезки.";
	КонецЕсли;
	Управление = ЗаписьОчереди(Запуск, "Управление");
	Данные = ДанныеУправления(Управление);
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние(Запуск);
		Набор = РегистрыСведений.Cutter3000_Задания.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Набор.Прочитать();
		Зафиксировано = 0;
		Ошибок = 0;
		Для Каждого Запись Из Набор Цикл
			Если Запись.Задание <> "Запуск" И Запись.Этап <> "Работник" И Запись.Этап <> "Служебный" Тогда
				Зафиксировано = Зафиксировано + Запись.Обработано;
				Ошибок = Ошибок + Запись.Ошибок;
			КонецЕсли;
			Если Запись.Состояние = "Выполняется" Или Запись.Состояние = "Ожидание" Тогда
				Запись.Состояние = "Остановлено";
				Если Запись.Этап <> "Работник" И Запись.Этап <> "Служебный" Тогда
					Запись.Этап = "Остановлено пользователем";
				КонецЕсли;
				Запись.Обновление = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЦикла;
		Набор.Записать();
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Заголовок.Состояние = "Остановлено";
		Заголовок.Этап = "Остановлено пользователем";
		Заголовок.Обработано = Зафиксировано;
		Заголовок.Ошибок = Заголовок.Ошибок + Ошибок;
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.ФоновоеЗадание = Данные.ФоновоеОстановки;
		Заголовок.Записать();
		Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры


Функция ЗаписьОчереди(Запуск, Работник)

	Запись = РегистрыСведений.Cutter3000_Очередь.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Работник = Работник;
	Запись.Прочитать();
	Запись.Запуск = Запуск;
	Запись.Работник = Работник;
	Возврат Запись;

КонецФункции

Процедура ЗаблокироватьОчередь(Запуск, Работник)

	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Очередь.Работник
			|ИЗ РегистрСведений.Cutter3000_Очередь КАК Очередь
			|ГДЕ Очередь.Запуск = &Запуск И Очередь.Работник = &Работник
			|ДЛЯ ИЗМЕНЕНИЯ");
		Запрос.УстановитьПараметр("Запуск", Запуск);
		Запрос.УстановитьПараметр("Работник", Работник);
		Результат = Запрос.Выполнить();
	Иначе
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Очередь");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Запуск", Запуск);
		Элемент.УстановитьЗначение("Работник", Работник);
		Блокировка.Заблокировать();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьОтветПула(Запуск, Работник, Результат, Ошибка = "")

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьОчередь(Запуск, Работник);
		Очередь = ЗаписьОчереди(Запуск, Работник);
		Очередь.Данные = Новый ХранилищеЗначения(Результат);
		Очередь.Ошибка = Ошибка;
		Очередь.Состояние = ?(Ошибка = "", "Готово", "Ошибка");
		Очередь.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗапуститьРаботникаПула(Запуск, Слот, Родитель, Назначение)

	ФазаКоординатора(Запуск, "Регистрация");
	Слот.Вставить("Запуск", Запуск);
	Слот.Вставить("Пул", Истина);
	Очередь = ЗаписьОчереди(Запуск, Слот.Идентификатор);
	Очередь.Состояние = "Свободен";
	Очередь.НазначениеРаботника = Назначение;
	Очередь.Записать();
	Запись = ЗаписьСостояния(Запуск, Слот.Идентификатор);
	Запись.Этап = "Работник";
	Запись.Состояние = "Выполняется";
	Запись.Наименование = "Постоянный работник Cutter3000";
	Запись.Записать();
	Параметры = Новый Массив;
	Параметры.Добавить(Запуск);
	Параметры.Добавить(Слот.Идентификатор);
	Параметры.Добавить(Родитель);
	Слот.Фоновое = ФоновыеЗадания.Выполнить("Cutter3000_ЗаданияСервер.ВыполнитьРаботникаПула",
		Параметры, Слот.Идентификатор, "Cutter3000: постоянный работник");
	ЗарегистрироватьФоновое(Запуск, Слот.Идентификатор, Слот.Фоновое);
	СохранитьФоновое(Запуск, Слот.Идентификатор, Слот.Фоновое);
	ФазаКоординатора(Запуск, "Чтение");

КонецПроцедуры

Процедура ОстановитьПулКаскадов(Слоты, Читатели)

	Все = Новый Массив;
	Для Каждого Слот Из Слоты Цикл
		Все.Добавить(Слот);
	КонецЦикла;
	Для Каждого Слот Из Читатели Цикл
		Все.Добавить(Слот);
	КонецЦикла;
	Для Каждого Слот Из Все Цикл
		Если Не Слот.Свойство("Пул") Или Слот.Фоновое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Сигнал отдельным полем: текущий результат не перезаписывает команду остановки.
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
		Попытка
			ЗаблокироватьОчередь(Слот.Запуск, Слот.Идентификатор);
			Очередь = ЗаписьОчереди(Слот.Запуск, Слот.Идентификатор);
			Очередь.Команда = "Стоп";
			Очередь.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	Для Каждого Слот Из Все Цикл
		Если Не Слот.Свойство("Пул") Или Слот.Фоновое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пока Слот.Фоновое.Состояние = СостояниеФоновогоЗадания.Активно Цикл
			Слот.Фоновое = Слот.Фоновое.ОжидатьЗавершенияВыполнения(1);
		КонецЦикла;
		Слот.Фоновое = Неопределено;
	КонецЦикла;

КонецПроцедуры

Функция ЗаписьСостояния(Запуск, Задание)

	Запись = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Задание = Задание;
	Запись.Прочитать();
	// Прочитать() очищает ключи менеджера, если записи еще нет.
	Запись.Запуск = Запуск;
	Запись.Задание = Задание;
	Возврат Запись;

КонецФункции

Процедура СохранитьФоновое(Запуск, Работник, Фоновое)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние(Запуск, "Б-" + Лев(Работник, 34));
		Запись = ЗаписьСостояния(Запуск, Работник);
		Запись.ФоновоеЗадание = Строка(Фоновое.УникальныйИдентификатор);
		Запись.Обновление = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ВосстановитьСостояние(Запуск)

	Если Запуск = "" Тогда
		Возврат;
	КонецЕсли;
	Если ОстановкаЗапрошена(Запуск) Тогда
		Управление = ЗаписьОчереди(Запуск, "Управление");
		Данные = ДанныеУправления(Управление);
		Если Не ФоновоеАктивно(Данные.ФоновоеОстановки) Тогда
			ЗапроситьОстановку(Запуск);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Если Заголовок.Состояние <> "Выполняется" И Заголовок.Состояние <> "Ожидание" Тогда
		Если Не ЕстьАктивныеРаботники(Запуск) Тогда
			Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ФоновоеАктивно(Заголовок.ФоновоеЗадание) Тогда
		Возврат;
	КонецЕсли;
	Прерванные = Новый Массив;
	Фоновые = ФоновыеЗапуска(Запуск);
	ЕстьАктивный = Ложь;
	Для Каждого СтрокаФонового Из Фоновые Цикл
		Если СтрокаФонового.Задание = "Запуск" И Заголовок.Этап <> "Планирование" Тогда
			Продолжить;
		КонецЕсли;
		Если ФоновоеАктивно(СтрокаФонового.ФоновоеЗадание) Тогда
			ЕстьАктивный = Истина;
			Продолжить;
		КонецЕсли;
		Если СтрокаФонового.Состояние <> "Выполняется" И СтрокаФонового.Состояние <> "Ожидание" Тогда
			Продолжить;
		КонецЕсли;
		Если ТекущаяДатаСеанса() - Заголовок.Обновление >= 30 Тогда
			Прерванные.Добавить(СтрокаФонового.Задание);
		Иначе
			ЕстьАктивный = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Прерванные.Количество() = 0 Тогда
		Если Не ЕстьАктивный И Заголовок.Этап <> "Планирование" Тогда
			ЗавершитьЗапуск(Запуск);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗафиксироватьПрерывание(Запуск, Прерванные, ЕстьАктивный);
	Если Не ЕстьАктивный Тогда
		Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
	КонецЕсли;

КонецПроцедуры

Функция ФоновоеАктивно(Идентификатор)

	Если Идентификатор = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Фоновое = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));
	Возврат Фоновое <> Неопределено И Фоновое.Состояние = СостояниеФоновогоЗадания.Активно;

КонецФункции

Функция ЕстьАктивныеРаботники(Запуск)

	Данные = ДанныеУправления(ЗаписьОчереди(Запуск, "Управление"));
	Если ФоновоеАктивно(Данные.ФоновоеОстановки) Тогда
		Возврат Истина;
	КонецЕсли;
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Если Заголовок.Состояние = "Остановлено" И ФоновоеАктивно(Заголовок.ФоновоеЗадание) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Работа Из ФоновыеЗапуска(Запуск) Цикл
		Если Работа.Задание <> "Запуск" И ФоновоеАктивно(Работа.ФоновоеЗадание) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ЗафиксироватьПрерывание(Запуск, Прерванные, ЕстьАктивный)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСостояние(Запуск);
		Набор = РегистрыСведений.Cutter3000_Задания.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Набор.Прочитать();
		// Идентификатор задания мог появиться после предварительного опроса.
		Актуальные = ПроверкаПрерывания(Набор, Прерванные);
		Прерванные = Актуальные.Прерванные;
		ЕстьАктивный = Актуальные.ЕстьАктивный;
		Для Каждого Запись Из Набор Цикл
			Прервана = Прерванные.Найти(Запись.Задание) <> Неопределено
				Или Прерванные.Найти(Запись.Работник) <> Неопределено;
			Если Не ЕстьАктивный Тогда
				Прервана = Истина;
			КонецЕсли;
			Если Прервана И (Запись.Состояние = "Выполняется" Или Запись.Состояние = "Ожидание") Тогда
				Запись.Состояние = "Ошибка";
				Запись.Этап = "Выполнение прервано";
				Если Запись.Задание = "Запуск" И ЕстьАктивный Тогда
					// Индекс остается нужен уже запущенным транзакциям работников.
					Запись.Состояние = "Выполняется";
					Запись.Этап = "Прерывание планирования";
				КонецЕсли;
				Запись.Ошибок = 1;
				Запись.Обновление = ТекущаяДатаСеанса();
				Запись.ОписаниеОшибки = "Фоновое задание завершилось без окончательного состояния."
					+ " Незавершенная транзакция отменена платформой. Повторный запуск построит новый план.";
				Запись.Контекст = СтрШаблон("Запуск: %1; задание: %2; работник: %3; фон: %4.",
					Запуск, Запись.Задание, Запись.Работник, Запись.ФоновоеЗадание);
				Детали = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
				Детали.Запуск = Запуск;
				Детали.Ошибка = Строка(Новый УникальныйИдентификатор);
				Детали.Задание = Запись.Задание;
				Детали.Момент = Запись.Обновление;
				Детали.Этап = Запись.Этап;
				Детали.КраткоеОписание = "Выполнение фонового задания прервано.";
				Детали.ОписаниеОшибки = Запись.ОписаниеОшибки;
				Детали.Контекст = Запись.Контекст;
				Детали.Записать();
			КонецЕсли;
		КонецЦикла;
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ПроверкаПрерывания(Набор, Предварительные)

	Результат = Новый Структура("Прерванные,ЕстьАктивный", Новый Массив, Ложь);
	Для Каждого Запись Из Набор Цикл

		ЭтоФоновое = Запись.Этап = "Работник"
			Или (Запись.Задание = "Запуск" И Запись.Этап = "Планирование");
		Если Не ЭтоФоновое Тогда
			Продолжить;
		КонецЕсли;
		Если ФоновоеАктивно(Запись.ФоновоеЗадание) Тогда
			Результат.ЕстьАктивный = Истина;
		ИначеЕсли Предварительные.Найти(Запись.Задание) <> Неопределено
			И (Запись.Состояние = "Выполняется" Или Запись.Состояние = "Ожидание") Тогда
			Результат.Прерванные.Добавить(Запись.Задание);
		КонецЕсли;

	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаблокироватьСостояние(Запуск, Задание = "")

	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда

		// Запись фиксированного ключа удерживает автоматическую блокировку до конца транзакции.
		Если Задание = "" Тогда
			Задание = "СлужебнаяБлокировка";
		КонецЕсли;
		Служебная = РегистрыСведений.Cutter3000_Задания.СоздатьМенеджерЗаписи();
		Служебная.Запуск = Запуск;
		Служебная.Задание = Задание;
		Служебная.Этап = "Служебный";
		Служебная.Состояние = "Завершено";
		Служебная.Обновление = ТекущаяДатаСеанса();
		Служебная.Записать();
		Возврат;

	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Задания");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Запуск", Запуск);
	Если Задание <> "" Тогда
		Элемент.УстановитьЗначение("Задание", Задание);
	КонецЕсли;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция АктивныйЗапуск()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Состояния.Запуск КАК Запуск
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Задание = &Заголовок
		| И Состояния.Состояние В (&Активные)
		|УПОРЯДОЧИТЬ ПО Состояния.Начало УБЫВ");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Запрос.УстановитьПараметр("Активные", СтрРазделить("Выполняется,Ожидание,Останавливается", ","));
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Запуск;
	КонецЕсли;
	// После сбоя координатора работник может еще завершать текущую транзакцию.
	Последний = ПоследнийЗапуск();
	Если Последний <> "" И (ОстановкаЗапрошена(Последний) Или ЕстьАктивныеРаботники(Последний)) Тогда
		Возврат Последний;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПоследнийЗапуск()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Состояния.Запуск КАК Запуск
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Задание = &Заголовок
		|УПОРЯДОЧИТЬ ПО Состояния.Начало УБЫВ");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Запуск;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция РаботыЗапуска(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Состояния.Задание КАК Идентификатор,
		| Состояния.Наименование КАК Наименование,
		| Состояния.Этап КАК Этап,
		| Состояния.Состояние КАК Состояние,
		| Состояния.Всего КАК Всего,
		| Состояния.Обработано КАК Зафиксировано,
		| 0 КАК ТекущаяПопытка,
		| 0 КАК Прогресс,
		| Состояния.Ошибок КАК Ошибок
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Запуск = &Запуск И Состояния.Этап <> &Работник И Состояния.Этап <> &Служебный
		| И (Состояния.Задание = &Заголовок ИЛИ Состояния.Всего > 0
		|  ИЛИ Состояния.Обработано > 0 ИЛИ Состояния.Ошибок > 0)
		|УПОРЯДОЧИТЬ ПО Состояния.Наименование, Состояния.Задание");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Работник", "Работник");
	Запрос.УстановитьПараметр("Служебный", "Служебный");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции

Функция ФоновыеЗапуска(Запуск)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Состояния.Задание КАК Задание,
		| Состояния.ФоновоеЗадание КАК ФоновоеЗадание,
		| Состояния.Состояние КАК Состояние
		|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
		|ГДЕ Состояния.Запуск = &Запуск
		| И (Состояния.Этап = &Работник ИЛИ Состояния.Задание = &Заголовок)");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Работник", "Работник");
	Запрос.УстановитьПараметр("Заголовок", "Запуск");
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции

Функция ФайловаяБаза()

	// Навигационная ссылка недоступна в фоновых заданиях и через веб-клиент не определяет тип базы.
	Соединение = СтрокаСоединенияИнформационнойБазы();
	ВКавычках = Ложь;
	ЧитаетсяКлюч = Истина;
	Ключ = "";
	Для Индекс = 1 По СтрДлина(Соединение) Цикл
		Символ = Сред(Соединение, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = Не ВКавычках;
			Продолжить;
		КонецЕсли;
		Если ВКавычках Тогда
			Продолжить;
		КонецЕсли;
		Если Символ = ";" Тогда
			Ключ = "";
			ЧитаетсяКлюч = Истина;
		ИначеЕсли ЧитаетсяКлюч И Символ = "=" Тогда
			Если НРег(СокрЛП(Ключ)) = "file" Тогда
				Возврат Истина;
			КонецЕсли;
			ЧитаетсяКлюч = Ложь;
		ИначеЕсли ЧитаетсяКлюч Тогда
			Ключ = Ключ + Символ;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция РежимВыполнения()

	Если ФайловаяБаза() Тогда
		Возврат "Файловая база: очередь, один фоновый работник";
	КонецЕсли;
	Возврат "Серверная база: до четырех работников независимых групп";

КонецФункции

Функция СохранитьПлан(Запуск, Группы)

	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	НаборСостояния = РегистрыСведений.Cutter3000_Задания.СоздатьНаборЗаписей();
	НаборСостояния.Отбор.Запуск.Установить(Запуск);
	НаборСостояния.Прочитать();
	Всего = 0;
	Для Каждого Группа Из Группы Цикл

		Работа = НаборСостояния.Добавить();
		Работа.Запуск = Запуск;
		Работа.Задание = Группа.Идентификатор;
		Работа.Граница = Заголовок.Граница;
		Работа.Наименование = Группа.Наименование;
		Работа.Этап = "Ожидание";
		Работа.Состояние = "Ожидание";
		Работа.Всего = Группа.Всего;
		Всего = Всего + Работа.Всего;

	КонецЦикла;
	Работники = Новый Массив;
	ПределРаботников = 4;
	Если ФайловаяБаза() Тогда
		ПределРаботников = 1;
	КонецЕсли;
	КоличествоРаботников = Мин(ПределРаботников, Группы.Количество());
	Для Индекс = 1 По КоличествоРаботников Цикл

		Идентификатор = Строка(Новый УникальныйИдентификатор);
		Работники.Добавить(Идентификатор);
		Работа = НаборСостояния.Добавить();
		Работа.Запуск = Запуск;
		Работа.Задание = Идентификатор;
		Работа.Граница = Заголовок.Граница;
		Работа.Наименование = СтрШаблон("Фоновый работник %1", Индекс);
		Работа.Этап = "Работник";
		Работа.Состояние = "Ожидание";

	КонецЦикла;
	НаборСостояния.Записать();
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Заголовок.Всего = Всего;
	Заголовок.Наименование = "Обрезка базы";
	Заголовок.Этап = "Выполнение";
	Если Группы.Количество() = 0 Тогда
		Заголовок.Состояние = "Завершено";
		Заголовок.Этап = "Данные для обрезки отсутствуют";
	КонецЕсли;
	Заголовок.Обновление = ТекущаяДатаСеанса();
	Заголовок.Записать();
	Возврат Работники;

КонецФункции

Функция РезервироватьГруппу(Запуск, Работник)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка

		ЗаблокироватьСостояние(Запуск);
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Состояния.Задание КАК Задание
			|ИЗ РегистрСведений.Cutter3000_Задания КАК Состояния
			|ГДЕ Состояния.Запуск = &Запуск И Состояния.Состояние = &Ожидание
			| И Состояния.Этап <> &Работник
			|УПОРЯДОЧИТЬ ПО Состояния.Задание");
		Запрос.УстановитьПараметр("Запуск", Запуск);
		Запрос.УстановитьПараметр("Ожидание", "Ожидание");
		Запрос.УстановитьПараметр("Работник", "Работник");
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Задание = "";
		Если Выборка.Следующий() Тогда

			Задание = Выборка.Задание;
			Запись = ЗаписьСостояния(Запуск, Задание);
			Запись.Состояние = "Выполняется";
			Запись.Этап = "Проверка группы";
			Запись.Работник = Работник;
			Запись.Начало = ТекущаяДатаСеанса();
			Запись.Обновление = Запись.Начало;
			Запись.Записать();

		КонецЕсли;
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;
	Возврат Задание;

КонецФункции

Процедура ВыполнитьГруппу(Запуск, Задание, КонтекстПроверки = Неопределено, Работник = "")

	ОтдельныйКаскад = Ложь;
	Пока Истина Цикл
		Если Работник = "" Тогда
			Работник = "Запуск";
		КонецЕсли;
		// Опубликованный план неизменяем: у полосы один работник, новая порция ждет его ответа.
		// Чтение служебных таблиц вне долгой транзакции не удерживает их автоматические блокировки.
		Состав = СоставГруппы(Запуск, Задание, ОтдельныйКаскад);
		Запись = ЗаписьСостояния(Запуск, Задание);
		Если Не ИзменитьФазуРаботника(Запуск, Работник, "Удаление") Тогда
			Прервать;
		КонецЕсли;
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
		Попытка
			Если Состав.Количество() = 0 Тогда
				Запись.Состояние = "Выполняется";
				Запись.Этап = "Ожидание каскада";
				Cutter3000_ДанныеСервер.ОчиститьИндексКаскадов(Задание);
				Запись.Обновление = ТекущаяДатаСеанса();
				Запись.Записать();
				ЗафиксироватьТранзакцию();
				Прервать;
			КонецЕсли;
			Если КонтекстПроверки = Неопределено Тогда
				КонтекстПроверки = Cutter3000_ДанныеСервер.КонтекстКонтроляКаскадов();
			КонецЕсли;
			КонтекстПроверки.Вставить("ЗафиксированоДо", Запись.Обработано);
			Cutter3000_ДанныеСервер.УдалитьГруппу(Состав, Запуск, Задание, КонтекстПроверки);
			Группы = Новый Соответствие;
			Для Каждого Элемент Из Состав Цикл
				Группы.Вставить(Элемент.Группа, Истина);
			КонецЦикла;
			Для Каждого Группа Из Группы Цикл
				Набор = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
				Набор.Отбор.Запуск.Установить(Запуск);
				Набор.Отбор.Группа.Установить(Группа.Ключ);
				Набор.Записать();
			КонецЦикла;
			Запись.Обработано = Запись.Обработано + Состав.Количество();
			Запись.Этап = "Порция зафиксирована";
			Запись.Обновление = ТекущаяДатаСеанса();
			Запись.Записать();
			// Индекс последней порции очищается вместе с ее данными и счетчиками.
			ОстатокПлана = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 План.Элемент
				|ИЗ РегистрСведений.Cutter3000_План КАК План
				|ГДЕ План.Запуск = &Запуск И План.Задание = &Задание И НЕ План.Пропущено");
			ОстатокПлана.УстановитьПараметр("Запуск", Запуск);
			ОстатокПлана.УстановитьПараметр("Задание", Задание);
			Если ОстатокПлана.Выполнить().Пустой() Тогда
				Cutter3000_ДанныеСервер.ОчиститьИндексКаскадов(Задание);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ОтменитьТранзакцию();
			Если Состав = Неопределено Или Состав.Количество() = 0 Тогда
				ВызватьИсключение;
			КонецЕсли;
			Группы = Новый Соответствие;
			Для Каждого Элемент Из Состав Цикл
				Группы.Вставить(Элемент.Группа, Истина);
			КонецЦикла;
			Если ОстановкаЗапрошена(Запуск) Тогда
				// После отката сохраняется исходная ошибка, но новая попытка уже не допускается.
				СохранитьОшибку(Запуск, Задание, Ошибка, Состав, Истина);
			ИначеЕсли Группы.Количество() > 1 Тогда
				// Общий пакет откатан. Повтор по целым компонентам отделяет отказ от независимых данных.
				ОтдельныйКаскад = Истина;
			Иначе
				ЗафиксироватьПропуск(Запуск, Задание, Состав, Ошибка);
			КонецЕсли;
		КонецПопытки;
		ИзменитьФазуРаботника(Запуск, Работник, "Ожидание", Ложь);
	КонецЦикла;

КонецПроцедуры

Функция СоставГруппы(Запуск, Задание, ОтдельныйКаскад = Ложь)

	РазмерПорции = 2000;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2000 План.Группа, КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Задание = &Задание И НЕ План.Пропущено
		|СГРУППИРОВАТЬ ПО План.Группа УПОРЯДОЧИТЬ ПО План.Группа");
	Запрос.УстановитьПараметр("Запуск", Запуск);
	Запрос.УстановитьПараметр("Задание", Задание);
	Выборка = Запрос.Выполнить().Выбрать();
	Группы = Новый Массив;
	Всего = 0;
	Пока Выборка.Следующий() Цикл
		Если ОтдельныйКаскад И Группы.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		Если Группы.Количество() > 0 И Всего + Выборка.Всего > РазмерПорции Тогда
			Прервать;
		КонецЕсли;
		// Полный связанный каскад может превышать целевой размер: разрывать его нельзя.
		Группы.Добавить(Выборка.Группа);
		Всего = Всего + Выборка.Всего;
	КонецЦикла;
	Запрос.Текст =
		"ВЫБРАТЬ План.Метаданные, План.Вид, План.Локатор, План.ЕдиницаЗаписи, План.Группа
		|ИЗ РегистрСведений.Cutter3000_План КАК План
		|ГДЕ План.Запуск = &Запуск И План.Задание = &Задание
		| И НЕ План.Пропущено И План.Группа В (&Группы)";
	Запрос.УстановитьПараметр("Группы", Группы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура СохранитьОшибку(Запуск, Задание, Ошибка, Состав = Неопределено, Продолжение = Ложь)

	СобственнаяТранзакция = Не ТранзакцияАктивна();
	Если СобственнаяТранзакция Тогда
		НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	КонецЕсли;
	Попытка
		Запись = ЗаписьСостояния(Запуск, Задание);
		ЭтапОшибки = Запись.Этап;
		Запись.Состояние = "Ошибка";
		Запись.Этап = "Группа отменена";
		Если Продолжение Тогда
			Запись.Состояние = "Выполняется";
			Запись.Этап = "Каскад пропущен";
		КонецЕсли;
		Запись.Ошибок = Запись.Ошибок + 1;
		Запись.ОписаниеОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		Запись.Контекст = КонтекстОшибки(Запуск, Задание, Запись, Состав);
		Запись.Обновление = ТекущаяДатаСеанса();
		Запись.Записать();
		Детали = РегистрыСведений.Cutter3000_Ошибки.СоздатьМенеджерЗаписи();
		Детали.Запуск = Запуск;
		Детали.Ошибка = Строка(Новый УникальныйИдентификатор);
		Детали.Задание = Задание;
		Детали.Момент = Запись.Обновление;
		Детали.Этап = ЭтапОшибки;
		Детали.КраткоеОписание = Лев(КраткоеПредставлениеОшибки(Ошибка), 1000);
		Детали.ОписаниеОшибки = Запись.ОписаниеОшибки;
		Детали.Контекст = Запись.Контекст;
		Детали.Записать();
		Если СобственнаяТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СобственнаяТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция КонтекстОшибки(Запуск, Задание, Запись, Состав)

	Контекст = СтрШаблон("Запуск: %1; задание: %2; граница: %3; работник: %4.",
		Запуск, Задание, Формат(Запись.Граница, "ДФ=yyyy-MM-dd"), Запись.Работник);
	Если Состав = Неопределено Тогда
		Возврат Контекст;
	КонецЕсли;
	Контекст = Контекст + Символы.ПС + СтрШаблон("Узлов в отмененном каскаде: %1.", Состав.Количество());
	ПределКонтекста = 20;
	Для Индекс = 0 По Мин(ПределКонтекста, Состав.Количество()) - 1 Цикл
		Элемент = Состав[Индекс];
		Контекст = Контекст + Символы.ПС + СтрШаблон("%1 | %2 | %3",
			Элемент.Группа, Элемент.Метаданные, Элемент.Локатор);
	КонецЦикла;
	Возврат Контекст;

КонецФункции

Процедура ЗафиксироватьПропуск(Запуск, Задание, Состав, Ошибка)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		Группа = Состав[0].Группа;
		Набор = РегистрыСведений.Cutter3000_План.СоздатьНаборЗаписей();
		Набор.Отбор.Запуск.Установить(Запуск);
		Набор.Отбор.Группа.Установить(Группа);
		Набор.Прочитать();
		Для Каждого Запись Из Набор Цикл
			Запись.Пропущено = Истина;
		КонецЦикла;
		Набор.Записать();
		// Диагностика и маркер записываются после отката прикладных данных одной транзакцией.
		СохранитьОшибку(Запуск, Задание, Ошибка, Состав, Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗавершитьРаботника(Запуск, Работник)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка

		ЗаблокироватьСостояние(Запуск, "Б-" + Лев(Работник, 34));
		Запись = ЗаписьСостояния(Запуск, Работник);
		Запись.Состояние = "Завершено";
		Запись.Обновление = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;
	// Конвейер завершает координатор после окончания подготовки и всех работников.

КонецПроцедуры

Процедура ЗавершитьЗапуск(Запуск)

	Если Не НачатьЗавершениеЗапуска(Запуск) Тогда
		Возврат;
	КонецЕсли;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка

		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Остаток = Cutter3000_ДанныеСервер.ПроверитьРезультат(Заголовок.Граница, Ложь);
		Работы = РаботыЗапуска(Запуск);
		Ошибки = Заголовок.Ошибок;
		Обработано = 0;
		Незавершенные = 0;
		Для Каждого Работа Из Работы Цикл

			Если Работа.Идентификатор <> "Запуск" Тогда
				Ошибки = Ошибки + Работа.Ошибок;
				Обработано = Обработано + Работа.Зафиксировано;
				Если Работа.Состояние <> "Завершено" И Работа.Состояние <> "Ошибка" Тогда
					Незавершенные = Незавершенные + 1;
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
		Заголовок.Обработано = Обработано;
		Заголовок.Ошибок = Ошибки;
		Заголовок.Состояние = "Завершено";
		Заголовок.Этап = "Обрезка завершена";
		Если Остаток > 0 Или Ошибки > 0 Или Незавершенные > 0 Тогда

			Заголовок.Состояние = "Ошибка";
			Заголовок.Этап = "Завершено с ошибками";
			Заголовок.ОписаниеОшибки = СтрШаблон(
				"Осталось кандидатов: %1; ошибок групп: %2; незавершенных групп: %3.", Остаток, Ошибки, Незавершенные);
			Заголовок.Ошибок = Макс(1, Ошибки);

		КонецЕсли;
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.Записать();
		Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		СохранитьОшибку(Запуск, "Запуск", ИнформацияОбОшибке());
		Cutter3000_ДанныеСервер.ОчиститьСлужебныеДанные(Запуск);

	КонецПопытки;

КонецПроцедуры

Функция СоздатьСлотыКаскадов(Запуск, Работы)

	Слоты = Новый Массив;
	Предел = 2;
	Если ФайловаяБаза() Тогда
		Предел = 1;
	КонецЕсли;
	Для Индекс = 1 По Мин(Предел, Работы.Количество()) Цикл
		Слот = Новый Структура("Идентификатор,Фоновое,Использован,Задание,НомерПорции",
			Строка(Новый УникальныйИдентификатор), Неопределено, Ложь, "", 0);
		Слот.Вставить("Запуск", Запуск);
		Слоты.Добавить(Слот);
		Запись = ЗаписьСостояния(Запуск, Слот.Идентификатор);
		Запись.Этап = "Работник";
		Запись.Состояние = "Завершено";
		Запись.Наименование = СтрШаблон("Фоновый работник %1", Индекс);
		Запись.Записать();
	КонецЦикла;
	Заголовок = ЗаписьСостояния(Запуск, "Запуск");
	Для Каждого Работа Из Работы Цикл
		Запись = ЗаписьСостояния(Запуск, Работа.Идентификатор);
		Запись.Граница = Заголовок.Граница;
		Запись.Наименование = Работа.Наименование;
		Запись.Работник = "";
		Запись.Этап = "Ожидание каскада";
		Запись.Состояние = "Выполняется";
		Запись.Записать();
	КонецЦикла;
	Возврат Слоты;

КонецФункции

Функция НазначитьСлотКаскадов(Слоты, Порция)

	ИндексОжидания = 0;
	Пока Истина Цикл
		ПроверитьОстановку(Слоты[0].Запуск);
		ОбновитьСлотыКаскадов(Слоты);
		Слот = СвободныйСлотКаскадов(Слоты);
		Если Слот <> Неопределено Тогда
			Порция.Задание = СвободнаяРаботаКаскадов(Слоты, Порция.Полосы, Порция.Задание);
			Возврат Слот;
		КонецЕсли;
		// Ограниченное ожидание, затем снова проверяются все работники, а не один выбранный.
		Ожидаемый = Слоты[ИндексОжидания % Слоты.Количество()];
		Ожидаемый.Фоновое = Ожидаемый.Фоновое.ОжидатьЗавершенияВыполнения(0.1);
		ИндексОжидания = ИндексОжидания + 1;
	КонецЦикла;

КонецФункции

Процедура ПодготовитьИПередатьКаскады(Запуск, Контекст, Слоты, КонтекстПроверки)

	Отложенные = Новый Массив;
	КандидатыЗакончились = Ложь;
	ПределОтложенных = ПределОтложенныхКаскадов();
	ИндексОжидания = 0;
	Пока Не КандидатыЗакончились Или Отложенные.Количество() > 0 Цикл
		ФазаКоординатора(Запуск, "Чтение");
		ОбновитьСлотыКаскадов(Слоты);
		Индекс = 0;
		Пока Индекс < Отложенные.Количество() И СвободныйСлотКаскадов(Слоты) <> Неопределено Цикл
			Порция = Отложенные[Индекс];
			Если ЕстьОжидаемыеУдаления(Слоты, Порция.ОжидаемыеУдаления) Тогда
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Если ПередатьГотовуюПорцию(Запуск, Контекст, Слоты, Порция, КонтекстПроверки) Тогда
				ИзменитьРезервКорней(Контекст, Отложенные[Индекс].Семена, Ложь);
				Отложенные.Удалить(Индекс);
			Иначе
				ИзменитьРезервКорней(Контекст, Отложенные[Индекс].Семена, Ложь);
				ПодготовитьОтложеннуюПорцию(Контекст, Слоты, Порция);
				Отложенные[Индекс] = Порция;
				Индекс = Индекс + 1;
			КонецЕсли;
		КонецЦикла;
		Если Не КандидатыЗакончились И Отложенные.Количество() < ПределОтложенных Тогда
			Порция = Cutter3000_ДанныеСервер.СледующаяПорцияКаскадов(Контекст);
			Если Порция = Неопределено Тогда
				КандидатыЗакончились = Истина;
			Иначе
				ОбновитьСлотыКаскадов(Слоты);
				Если Не ПередатьГотовуюПорцию(Запуск, Контекст, Слоты, Порция, КонтекстПроверки) Тогда
					ПодготовитьОтложеннуюПорцию(Контекст, Слоты, Порция);
					Отложенные.Добавить(Порция);
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Отложенные.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		СообщитьЭтапПланировщика(Контекст,
			СтрШаблон("Ожидание отложенных каскадов: %1", Отложенные.Количество()));
		// Ожидание нужно только при заполненной очереди или исчерпанном отборе.
		Для Смещение = 0 По Слоты.Количество() - 1 Цикл
			Слот = Слоты[(ИндексОжидания + Смещение) % Слоты.Количество()];
			Если Слот.Задание <> "" Тогда
				Слот.Фоновое = Слот.Фоновое.ОжидатьЗавершенияВыполнения(0.1);
				ИндексОжидания = ИндексОжидания + Смещение + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ПределОтложенныхКаскадов()

	Возврат 4;

КонецФункции

Функция ПередатьГотовуюПорцию(Запуск, Контекст, Слоты, Порция, КонтекстПроверки)

	Если СвободныйСлотКаскадов(Слоты) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Порция.Свойство("ОжидаемыеУдаления") Тогда
		// Полный граф отложенной порции освобожден; ее корни всегда перечитываются.
		Порция.Пересечение = Истина;
	ИначеЕсли Порция.Пересечение Тогда
		Возврат Ложь;
	КонецЕсли;
	СообщитьЭтапПланировщика(Контекст, "Проверка актуальности каскада");
	ПроверитьОстановку(Запуск);
	Порция = Cutter3000_ДанныеСервер.ПеречитатьКаскады(Контекст, Порция);
	Если Порция.Снимок.Узлы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Порция.Пересечение Тогда
		Возврат Ложь;
	КонецЕсли;
	Слот = НазначитьСлотКаскадов(Слоты, Порция);
	ФазаКоординатора(Запуск, "Публикация");
	ОпубликоватьКаскады(Запуск, Контекст, Порция, Слот.Идентификатор);
	Слот.Использован = Истина;
	Слот.Задание = Порция.Задание;
	НомерПорции = 0;
	Слот.Свойство("НомерПорции", НомерПорции);
	Слот.Вставить("НомерПорции", НомерПорции + 1);
	Если ФайловаяБаза() Тогда
		ВыполнитьПакетКаскадов(Запуск, Слот.Идентификатор, Порция.Задание, КонтекстПроверки);
		Слот.Задание = "";
	Иначе
		ОтправитьКомандуПула(Слот, "Удаление", Порция.Задание);
	КонецЕсли;
	ФазаКоординатора(Запуск, "Чтение");
	Возврат Истина;

КонецФункции

Процедура ПодготовитьОтложеннуюПорцию(Контекст, Слоты, Порция)

	Ожидаемые = Новый Массив;
	Для Каждого Слот Из Слоты Цикл
		Если Слот.Задание <> "" И Порция.ПересекающиесяЗадания.Найти(Слот.Задание) <> Неопределено Тогда
			НомерПорции = 0;
			Слот.Свойство("НомерПорции", НомерПорции);
			Ожидаемые.Добавить(Новый Структура("Работник,НомерПорции", Слот.Идентификатор, НомерПорции));
		КонецЕсли;
	КонецЦикла;
	Порция.Вставить("ОжидаемыеУдаления", Ожидаемые);
	ИзменитьРезервКорней(Контекст, Порция.Семена, Истина);
	// В памяти остаются корни; полный граф строится заново только перед публикацией.
	Порция.Снимок = Неопределено;

КонецПроцедуры

Функция ЕстьОжидаемыеУдаления(Слоты, Ожидаемые)

	Для Каждого Ожидание Из Ожидаемые Цикл
		Для Каждого Слот Из Слоты Цикл
			НомерПорции = 0;
			Слот.Свойство("НомерПорции", НомерПорции);
			Если Слот.Идентификатор = Ожидание.Работник И Слот.Задание <> ""
				И НомерПорции = Ожидание.НомерПорции Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ИзменитьРезервКорней(Контекст, Семена, Добавить)

	Единицы = Новый Соответствие;
	Для Каждого Пара Из Семена.Узлы Цикл
		Единицы.Вставить(Пара.Значение.Единица, Истина);
	КонецЦикла;
	Для Каждого Единица Из Единицы Цикл
		Количество = Контекст.ОтложенныеЕдиницы.Получить(Единица.Ключ);
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		Если Добавить Тогда
			Контекст.ОтложенныеЕдиницы.Вставить(Единица.Ключ, Количество + 1);
		ИначеЕсли Количество > 1 Тогда
			Контекст.ОтложенныеЕдиницы.Вставить(Единица.Ключ, Количество - 1);
		Иначе
			Контекст.ОтложенныеЕдиницы.Удалить(Единица.Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьСлотыКаскадов(Слоты)

	Для Каждого Слот Из Слоты Цикл
		Если Слот.Свойство("Пул") Тогда
			Если Слот.Задание <> "" И ПолучитьРезультатПула(Слот) <> Неопределено Тогда
				Слот.Задание = "";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Слот.Фоновое = Неопределено Тогда
			Слот.Задание = "";
			Продолжить;
		КонецЕсли;
		Слот.Фоновое = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Слот.Фоновое.УникальныйИдентификатор);
		Если Слот.Фоновое = Неопределено Тогда
			ВызватьИсключение "Потеряно состояние фонового работника " + Слот.Идентификатор;
		КонецЕсли;
		Если Слот.Фоновое.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			ОжидатьСлотКаскадов(Слот);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СвободныйСлотКаскадов(Слоты)

	Для Каждого Слот Из Слоты Цикл
		Если Слот.Задание = "" Тогда
			Возврат Слот;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция СвободнаяРаботаКаскадов(Слоты, Полосы, Предпочтительная)

	Занятые = Новый Соответствие;
	Для Каждого Слот Из Слоты Цикл
		Если Слот.Задание <> "" Тогда
			Занятые.Вставить(Слот.Задание, Истина);
		КонецЕсли;
	КонецЦикла;
	Если Занятые.Получить(Предпочтительная) = Неопределено Тогда
		Возврат Предпочтительная;
	КонецЕсли;
	Для Каждого Работа Из Полосы Цикл
		Если Занятые.Получить(Работа) = Неопределено Тогда
			Возврат Работа;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Свободному работнику не найдена свободная полоса каскада.";

КонецФункции

Процедура ОжидатьСлотКаскадов(Слот)

	ПроверитьОстановку(Слот.Запуск);
	Если Слот.Свойство("Пул") Тогда
		Пока Слот.Задание <> "" Цикл
			Если ПолучитьРезультатПула(Слот) <> Неопределено Тогда
				Слот.Задание = "";
			Иначе
				Слот.Фоновое = Слот.Фоновое.ОжидатьЗавершенияВыполнения(0.1);
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Если Слот.Фоновое = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Ожидание серверного работника выполняется вне транзакции; в файловом режиме оно не вызывается.
	Фоновое = Слот.Фоновое;
	Пока Фоновое.Состояние = СостояниеФоновогоЗадания.Активно Цикл
		Фоновое = Фоновое.ОжидатьЗавершенияВыполнения(1);
	КонецЦикла;
	Если Фоновое.Состояние <> СостояниеФоновогоЗадания.Завершено Тогда
		ВызватьИсключение "Фоновый работник каскадов завершился аварийно: " + Слот.Идентификатор;
	КонецЕсли;
	Слот.Фоновое = Неопределено;
	Слот.Задание = "";

КонецПроцедуры

Процедура ОпубликоватьКаскады(Запуск, Контекст, Порция, Работник)

	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		План = Cutter3000_ДанныеСервер.СохранитьКаскады(Контекст, Порция);
		Запись = ЗаписьСостояния(Запуск, Порция.Задание);
		Запись.Работник = Работник;
		Запись.Всего = Запись.Всего + План.Всего;
		Запись.Этап = "Удаление каскада";
		Запись.Состояние = "Выполняется";
		Запись.Начало = ТекущаяДатаСеанса();
		Запись.Обновление = Запись.Начало;
		Запись.Записать();
		Заголовок = ЗаписьСостояния(Запуск, "Запуск");
		Заголовок.Всего = Заголовок.Всего + План.Всего;
		Заголовок.Наименование = "Подготовка и удаление каскадов";
		Заголовок.Обновление = ТекущаяДатаСеанса();
		Заголовок.Записать();
		Технический = ЗаписьСостояния(Запуск, Работник);
		Технический.Состояние = "Выполняется";
		Технический.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗавершитьРаботыКаскадов(Запуск, Прервано = Ложь)

	Работы = РаботыЗапуска(Запуск);
	Для Каждого Работа Из Работы Цикл
		Если Работа.Идентификатор = "Запуск" Тогда
			Продолжить;
		КонецЕсли;
		Запись = ЗаписьСостояния(Запуск, Работа.Идентификатор);
		Если Прервано Тогда
			Запись.Состояние = "Ошибка";
			Запись.Этап = "Запуск прерван";
			Запись.Ошибок = 1;
			Запись.ОписаниеОшибки = "Подготовка остановлена; подробности в строке запуска.";
		ИначеЕсли Работа.Ошибок > 0 Тогда
			Запись.Состояние = "Ошибка";
			Запись.Этап = "Завершено с ошибками";
		Иначе
			Запись.Состояние = "Завершено";
			Запись.Этап = "Зафиксировано";
		КонецЕсли;
		Запись.Обновление = ТекущаяДатаСеанса();
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
