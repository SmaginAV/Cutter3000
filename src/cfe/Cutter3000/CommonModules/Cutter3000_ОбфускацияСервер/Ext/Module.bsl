Функция РольПерсональногоПоля(Имя)

	Перем Группа, Корни, Корень, ИмяДляПоиска;
	ИмяДляПоиска = НРег(Имя);
	Для Каждого Группа Из СтрРазделить("получател,recipient,receiver|менеджер,manager|клиент,client,customer|отправител,sender|покупател,buyer|поставщик,supplier|ответственн,responsible|водител,driver|курьер,courier|физическ,физлиц,person,individual|сотрудник,employee|пользовател,user", "|") Цикл
		Корни = СтрРазделить(Группа, ",");
		Для Каждого Корень Из Корни Цикл
			Если СтрНайти(ИмяДляПоиска, Корень) > 0 Тогда
				Возврат Корни[0];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция КаноническоеПолеЧеловека(Описание)

	Перем Ранг, ПоляПоРангам, Результат, Поле, Цель, РангЦели, Роль, Кандидаты, НомерРанга;
	Ранг = РангСправочникаЧеловека(Описание);
	ПоляПоРангам = Новый Соответствие;
	Результат = Новый Массив;
	Для Каждого Поле Из Описание.Реквизиты Цикл
		Если Не СсылкаНаСправочник(Поле.Тип) Тогда
			Продолжить;
		КонецЕсли;
		Роль = РольПерсональногоПоля(Поле.Имя);
		Если Роль <> "физическ" И Роль <> "сотрудник" И Роль <> "пользовател" Тогда
			Продолжить;
		КонецЕсли;
		Цель = Метаданные.НайтиПоТипу(Поле.Тип.Типы()[0]);
		РангЦели = РангСправочникаЧеловека(Цель);
		Если РангЦели = 0 Или РангЦели >= Ранг Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты = ПоляПоРангам.Получить(РангЦели);
		Если Кандидаты = Неопределено Тогда
			Кандидаты = Новый Массив;
			ПоляПоРангам.Вставить(РангЦели, Кандидаты);
		КонецЕсли;
		Кандидаты.Добавить(Поле.Имя);
	КонецЦикла;
	Для НомерРанга = 1 По Ранг - 1 Цикл
		Кандидаты = ПоляПоРангам.Получить(НомерРанга);
		Если Кандидаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Кандидаты.Количество() <> 1 Тогда
			Возврат Новый Массив;
		КонецЕсли;
		Результат.Добавить(Кандидаты[0]);
	КонецЦикла;
	Возврат Результат;

