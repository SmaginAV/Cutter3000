Функция ПолеЧеловекаДляИмени(Источник, ИмяПоля)

	Перем Роль, Точные, Нейтральные, Поле, РольСсылки, Цель;
	Роль = РольПерсональногоПоля(ИмяПоля);
	Если Источник.Часть = "" И СтрНачинаетсяС(Источник.Корень, "Справочник.") И Роль = "" Тогда
		Возврат "$Сам";
	КонецЕсли;
	Точные = Новый Массив;
	Нейтральные = Новый Массив;
	Для Каждого Поле Из ПоляИсточника(Источник) Цикл
		Если Не СсылкаНаСправочник(Поле.Тип) Тогда
			Продолжить;
		КонецЕсли;
		РольСсылки = РольПерсональногоПоля(Поле.Имя);
		Если Роль <> "" И РольСсылки = Роль Тогда
			Точные.Добавить(Поле.Имя);
		КонецЕсли;
		Цель = Метаданные.НайтиПоТипу(Поле.Тип.Типы()[0]);
		Если РангСправочникаЧеловека(Цель) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Роль = "" Или РольСсылки = "физическ" Тогда
			Нейтральные.Добавить(Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Точные.Количество() = 1 Тогда
		Возврат Точные[0];
	КонецЕсли;
	Если Точные.Количество() = 0 И Нейтральные.Количество() = 1 Тогда
		Возврат Нейтральные[0];
	КонецЕсли;
	Возврат "";

