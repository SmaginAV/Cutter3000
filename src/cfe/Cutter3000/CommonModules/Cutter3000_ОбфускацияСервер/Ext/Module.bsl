Процедура ДобавитьСсылкиЗащиты(Источник, Единица, КартаПолей, Ссылки)

	Перем Пара, Строки, СтрокаДанных, Часть;
	Для Каждого Пара Из КартаПолей.Получить(Источник.Имя) Цикл
		Часть = Пара.Ключ;
		Если Источник.Вид = "Объект" И Часть = "" Тогда
			ДобавитьСсылкиСтроки(Единица, Пара.Значение, Ссылки);
		Иначе
			Строки = Единица;
			Если Источник.Вид = "Объект" Тогда
				Строки = Единица[Часть];
			КонецЕсли;
			Для Каждого СтрокаДанных Из Строки Цикл
				ДобавитьСсылкиСтроки(СтрокаДанных, Пара.Значение, Ссылки);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

