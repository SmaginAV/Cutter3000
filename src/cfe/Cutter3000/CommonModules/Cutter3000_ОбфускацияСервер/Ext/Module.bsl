Процедура РазрешитьСущностиПакетом(Ссылки, Известные, КартаКаталогов, Кэш)

	Перем Фронт, Следующий, Группы, Пара, Ссылка, ИмяКаталога, ИмяПоля, Группа, Уровень;
	Фронт = Ссылки;
	// Каноническая связь ведет только к меньшему рангу: пользователь -> сотрудник -> физлицо.
	Для Уровень = 1 По 8 Цикл
		Следующий = Новый Соответствие;
		Группы = Новый Соответствие;
		Для Каждого Пара Из Фронт Цикл
			Ссылка = Пара.Ключ;
			Если Кэш.Получить(Ссылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяКаталога = Ссылка.Метаданные().ПолноеИмя();
			ИмяПоля = КартаКаталогов.Получить(ИмяКаталога);
			Если ИмяПоля = Неопределено Тогда
				Кэш.Вставить(Ссылка, Ссылка);
				Продолжить;
			КонецЕсли;
			Если Известные.Получить(Ссылка) <> Неопределено Тогда
				ДобавитьСледующуюСущность(Ссылка, Известные.Получить(Ссылка), Следующий, Кэш);
				Продолжить;
			КонецЕсли;
			Группа = Группы.Получить(ИмяКаталога);
			Если Группа = Неопределено Тогда
				Группа = Новый Структура("Поля,Ссылки", ИмяПоля, Новый Массив);
				Группы.Вставить(ИмяКаталога, Группа);
			КонецЕсли;
			Группа.Ссылки.Добавить(Ссылка);
		КонецЦикла;
		Для Каждого Пара Из Группы Цикл
			ПрочитатьСвязиГруппы(Пара.Ключ, Пара.Значение, Известные, Следующий, Кэш);
		КонецЦикла;
		Если Следующий.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Фронт = Следующий;
	КонецЦикла;
	Для Каждого Пара Из Ссылки Цикл
		Кэш.Вставить(Пара.Ключ, КонечнаяСущность(Пара.Ключ, Известные, Кэш));
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьСвязиГруппы(ИмяКаталога, Группа, Известные, Следующий, Кэш)

	Перем Запрос, РезультатЗапроса, Выборка, Ссылка, Поле, ПоляЗапроса, Человек;
	ПоляЗапроса = Новый Массив;
	Для Каждого Поле Из Группа.Поля Цикл
		ПоляЗапроса.Добавить("Источник." + Поле + " КАК " + Поле);
	КонецЦикла;
	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ Источник.Ссылка КАК Ссылка, %1 ИЗ %2 КАК Источник ГДЕ Источник.Ссылка В (&Ссылки)", СтрСоединить(ПоляЗапроса, ", "), ИмяКаталога));
	Запрос.УстановитьПараметр("Ссылки", Группа.Ссылки);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Для Каждого Ссылка Из Группа.Ссылки Цикл
		Кэш.Вставить(Ссылка, Ссылка);
	КонецЦикла;
	Пока Выборка.Следующий() Цикл
		Человек = СущностьИзСтроки(Выборка, Группа.Поля);
		Известные.Вставить(Выборка.Ссылка, Человек);
		Если ЗначениеЗаполнено(Человек) Тогда
			Кэш.Удалить(Выборка.Ссылка);
		КонецЕсли;
		ДобавитьСледующуюСущность(Выборка.Ссылка, Человек, Следующий, Кэш);
	КонецЦикла;

КонецПроцедуры

// Прямая ссылка на физлицо приоритетнее цепочки; пустое поле не обрывает цепочку сотрудника.
Функция СущностьИзСтроки(СтрокаДанных, ИменаПолей)
	Перем ИмяПоля;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если ЗначениеЗаполнено(СтрокаДанных[ИмяПоля]) Тогда
			Возврат СтрокаДанных[ИмяПоля];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура ДобавитьСледующуюСущность(Ссылка, Человек, Следующий, Кэш)

	Если ЗначениеЗаполнено(Человек) Тогда
		Следующий.Вставить(Человек, Истина);
	Иначе
		Кэш.Вставить(Ссылка, Ссылка);
	КонецЕсли;

КонецПроцедуры

Функция КонечнаяСущность(Ссылка, Известные, Кэш)

	Перем Текущая, Посещенные, Следующая;
	Текущая = Ссылка;
	Посещенные = Новый Соответствие;
	Пока Кэш.Получить(Текущая) = Неопределено Цикл
		Если Посещенные.Получить(Текущая) <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
		Посещенные.Вставить(Текущая, Истина);
		Следующая = Известные.Получить(Текущая);
		Если Не ЗначениеЗаполнено(Следующая) Тогда
			Возврат Текущая;
		КонецЕсли;
		Текущая = Следующая;
	КонецЦикла;
	Возврат Кэш.Получить(Текущая);

КонецФункции

Функция КлючИмениПравила(Источник, Правило, СтрокаДанных, ЗапаснойКлюч, Настройки)

	Перем Карта, ИмяПоля, Ссылка, Человек;
	Если Правило.Категория <> "Персонаж" Или Не Настройки.Свойство("КартаИмен", Карта) Или Карта = Неопределено Тогда
		Возврат ЗапаснойКлюч;
	КонецЕсли;
	ИмяПоля = Карта.Поля.Получить(Источник.Имя + "|" + Правило.Часть + "|" + Правило.Имя);
	Если ИмяПоля <> "" И ИмяПоля <> Неопределено Тогда
		Если ИмяПоля = "$Сам" Тогда
			Ссылка = СтрокаДанных.Ссылка;
		Иначе
			Ссылка = СтрокаДанных[ИмяПоля];
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Человек = Настройки.КэшСущностей.Получить(Ссылка);
			Если Человек = Неопределено Тогда
				ВызватьИсключение "Ключ человека не подготовлен до начала записи.";
			КонецЕсли;
			Возврат "Сущность|" + Человек.Метаданные().ПолноеИмя() + "|" + Строка(Человек.УникальныйИдентификатор());
		КонецЕсли;
	КонецЕсли;
	Возврат "Независимо|" + Источник.Имя + "|" + ЗапаснойКлюч + "|" + Правило.Имя;

