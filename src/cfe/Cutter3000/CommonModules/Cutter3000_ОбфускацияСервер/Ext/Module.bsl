Функция НайтиИсточник(Каталог, Имя)

	Для Каждого Источник Из Каталог Цикл
		Если Источник.Имя = Имя Тогда
			Возврат Источник;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Источник правил отсутствует в текущих метаданных.";

КонецФункции

Функция НайтиПоле(Источник, Имя)

	Для Каждого Поле Из ПоляИсточника(Источник) Цикл
		Если Поле.Имя = Имя Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура ПроверитьКатегорию(Категория, ОписаниеТипа)

	Допустимые = СтрРазделить("Адрес|Дата рождения|Документ|ИНН|Организация|Очистить текст|Персонаж|Почта|СНИЛС|Телефон", "|");
	Если Допустимые.Найти(Категория) = Неопределено Тогда
		ВызватьИсключение "Укажите категорию из списка поддержанных преобразований.";
	КонецЕсли;
	ТипПоля = ОписаниеТипа.Типы()[0];
	Если (Категория = "Дата рождения") <> (ТипПоля = Тип("Дата")) Тогда
		ВызватьИсключение "Категория даты рождения подходит только для поля типа Дата.";
	КонецЕсли;
	Если ТипПоля = Тип("Число") И Категория <> "Телефон" И Категория <> "ИНН"
		И Категория <> "СНИЛС" И Категория <> "Документ" Тогда
		ВызватьИсключение "Для числового поля выбрана строковая категория.";
	КонецЕсли;

КонецПроцедуры

Функция ЗащищенныеПользователи(Настройки)

	Перем Защищенные, Оператор, Классификации, Выбранные, Классификация, ОписаниеРоли, РольМетаданных;
	Перем Выбор, Профиль, UUID, Сохранить, Роль;
	Защищенные = Новый Массив;
	Оператор = ПользователиИнформационнойБазы.ТекущийПользователь();
	Классификации = Новый Соответствие;
	Для Каждого Классификация Из Настройки.Роли Цикл
		ОписаниеРоли = Классификации.Получить(Классификация.Имя);
		Если ОписаниеРоли = Неопределено Тогда
			ОписаниеРоли = Новый Структура("Количество,ПолныеПрава", 0, Ложь);
			Классификации.Вставить(Классификация.Имя, ОписаниеРоли);
		КонецЕсли;
		ОписаниеРоли.Количество = ОписаниеРоли.Количество + 1;
		ОписаниеРоли.ПолныеПрава = ОписаниеРоли.ПолныеПрава Или Классификация.ПолныеПрава;
	КонецЦикла;
	Для Каждого РольМетаданных Из Метаданные.Роли Цикл
		ОписаниеРоли = Классификации.Получить(РольМетаданных.Имя);
		Если ОписаниеРоли = Неопределено Или ОписаниеРоли.Количество <> 1 Тогда
			ВызватьИсключение "Для каждой роли требуется одна подтвержденная классификация полных прав.";
		КонецЕсли;
	КонецЦикла;
	Выбранные = Новый Соответствие;
	Для Каждого Выбор Из Настройки.Пользователи Цикл
		Если Выбор.Сохранить Тогда
			Выбранные.Вставить(Выбор.Идентификатор, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Профиль Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		UUID = Строка(Профиль.УникальныйИдентификатор);
		Сохранить = UUID = Строка(Оператор.УникальныйИдентификатор)
			Или ПравоДоступа("Администрирование", Метаданные, Профиль);
		Сохранить = Сохранить Или Выбранные.Получить(UUID) = Истина;
		Для Каждого Роль Из Профиль.Роли Цикл
			ОписаниеРоли = Классификации.Получить(Роль.Имя);
			Если ОписаниеРоли <> Неопределено И ОписаниеРоли.ПолныеПрава Тогда
				Сохранить = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Сохранить Тогда
			Защищенные.Добавить(UUID);
		КонецЕсли;
	КонецЦикла;
	Возврат Защищенные;

КонецФункции

Функция ЗаписиУчетныхЗаписей(Идентификаторы)

	Перем Результат, Идентификатор, ТекстыПоиска, ЗначенияUUID, Запрос, РезультатЗапроса, Выборка, Записи;
	Результат = Новый Соответствие;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Результат.Вставить(Идентификатор, Новый Массив);
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ТекстыПоиска = ТекстыПоискаУчетныхЗаписей();
	Если ТекстыПоиска.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ЗначенияUUID = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		ЗначенияUUID.Добавить(Новый УникальныйИдентификатор(Идентификатор));
	КонецЦикла;
	Запрос = Новый Запрос(СтрСоединить(ТекстыПоиска, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Запрос.УстановитьПараметр("ПрофилиСтроки", Идентификаторы);
	Запрос.УстановитьПараметр("ПрофилиUUID", ЗначенияUUID);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Записи = Результат.Получить(НРег(Строка(Выборка.Идентификатор)));
		Если Записи <> Неопределено И Записи.Найти(Выборка.Ссылка) = Неопределено Тогда
			Записи.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстыПоискаУчетныхЗаписей()

	Перем Результат, Описание, Поле, ИмяПараметра;
	Результат = Новый Массив;
	Для Каждого Описание Из Метаданные.Справочники Цикл
		Для Каждого Поле Из Описание.Реквизиты Цикл
			Если Не РеквизитУчетнойЗаписи(НРег(Поле.Имя), Поле.Тип) Тогда
				Продолжить;
			КонецЕсли;
			ИмяПараметра = "ПрофилиСтроки";
			Если Поле.Тип.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
				ИмяПараметра = "ПрофилиUUID";
			КонецЕсли;
			// Имена берутся из метаданных; UUID передаются параметрами одного запроса.
			Результат.Добавить(СтрШаблон("ВЫБРАТЬ Источник.Ссылка КАК Ссылка, Источник.%1 КАК Идентификатор ИЗ %2 КАК Источник ГДЕ Источник.%1 В (&%3)",
				Поле.Имя, Описание.ПолноеИмя(), ИмяПараметра));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РеквизитУчетнойЗаписи(ИмяПоля, ТипПоля)

	Если ТипПоля.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ТипПоля.СодержитТип(Тип("Строка")) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ИмяПоля, "идентификаторпользовател") > 0
		Или ИмяПоля = "уникальныйидентификатор" Или ИмяПоля = "uuid"
		Или ИмяПоля = "useruuid" Или ИмяПоля = "userid";

КонецФункции

Функция ПроверенныеИсключенияПользователей(Настройки, Защищенные)

	Перем Найденные, Ссылки, Идентификатор, Записи, Профиль, ПоИдентификаторам, Ссылка;
	Найденные = ЗаписиУчетныхЗаписей(Защищенные);
	ПоИдентификаторам = Новый Соответствие;
	Для Каждого Профиль Из Настройки.Пользователи Цикл
		Если ПоИдентификаторам.Получить(Профиль.Идентификатор) <> Неопределено Тогда
			ВызватьИсключение "Пользователь повторяется в настройках исключений.";
		КонецЕсли;
		ПоИдентификаторам.Вставить(Профиль.Идентификатор, Профиль);
	КонецЦикла;
	Ссылки = Новый Массив;
	Для Каждого Идентификатор Из Защищенные Цикл
		Профиль = ПоИдентификаторам.Получить(Идентификатор);
		Записи = ЗаписиИсключения(Найденные.Получить(Идентификатор), Профиль);
		Для Каждого Ссылка Из Записи Цикл
			Если Ссылки.Найти(Ссылка) = Неопределено Тогда
				Ссылки.Добавить(Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

Функция ЗаписиИсключения(АвтоматическиеЗаписи, ВыборПользователя)

	Перем Результат, Запись, ЗаписиНет, АвтоматическаяЗапись;
	Если ВыборПользователя = Неопределено Тогда
		ВызватьИсключение "Обновите настройки: в списке отсутствует исключенный пользователь.";
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого АвтоматическаяЗапись Из АвтоматическиеЗаписи Цикл
		Результат.Добавить(АвтоматическаяЗапись);
	КонецЦикла;
	Запись = Неопределено;
	ЗаписиНет = Ложь;
	ВыборПользователя.Свойство("Запись", Запись);
	ВыборПользователя.Свойство("ЗаписиНет", ЗаписиНет);
	Если ЗначениеЗаполнено(Запись) Тогда
		ПроверитьПрикладнуюЗапись(Запись);
		Если Результат.Найти(Запись) = Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЕсли;
	Если ЗаписиНет И Результат.Количество() > 0 Тогда
		ВызватьИсключение "Для пользователя найдены прикладные записи: снимите отметку «Записи нет».";
	КонецЕсли;
	Если Результат.Количество() = 0 И Не ЗаписиНет Тогда
		ВызватьИсключение "Не найдены данные исключенного пользователя: выберите запись справочника или подтвердите «Записи нет».";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ПроверитьПрикладнуюЗапись(Запись)

	Перем Описание, Запрос, РезультатЗапроса;
	Описание = Метаданные.НайтиПоТипу(ТипЗнч(Запись));
	Если Описание = Неопределено Тогда
		ВызватьИсключение "Для исключения выберите существующий элемент справочника.";
	КонецЕсли;
	Если Метаданные.Справочники.Найти(Описание.Имя) <> Описание Тогда
		ВызватьИсключение "Для исключения допускается только ссылка на справочник.";
	КонецЕсли;
	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 Источник.Ссылка КАК Ссылка ИЗ %1 КАК Источник ГДЕ Источник.Ссылка = &Ссылка", Описание.ПолноеИмя()));
	Запрос.УстановитьПараметр("Ссылка", Запись);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение "Выбранная запись справочника отсутствует: повторите выбор.";
	КонецЕсли;

КонецПроцедуры

Функция ЗащищенныеСсылки(Связи, Защищенные, Каталог)

	Ссылки = Новый Массив;
	Запрос = Новый Запрос;
	Для Каждого Связь Из Связи Цикл
		Если Не Связь.Подтверждено Тогда
			Продолжить;
		КонецЕсли;
		Источник = НайтиИсточник(Каталог, Связь.Источник);
		Если Источник.Вид <> "Объект" Или Источник.Часть <> "" Тогда
			ВызватьИсключение "Связь учетной записи должна указывать на реквизит ссылочного объекта.";
		КонецЕсли;
		Поле = НайтиПоле(Источник, Связь.Поле);
		Если Поле = Неопределено Тогда
			ВызватьИсключение "Реквизит связи пользователя не найден.";
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого UUID Из Защищенные Цикл
			Если Поле.Тип.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
				Значения.Добавить(Новый УникальныйИдентификатор(UUID));
			ИначеЕсли Поле.Тип.СодержитТип(Тип("Строка")) Тогда
				Значения.Добавить(UUID);
			Иначе
				ВызватьИсключение "Связь пользователя должна хранить UUID платформенной учетной записи.";
			КонецЕсли;
		КонецЦикла;
		Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Ссылка ИЗ " + Источник.Корень
			+ " ГДЕ " + Поле.Имя + " В (&Профили)";
		Запрос.УстановитьПараметр("Профили", Значения);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Ссылки.Найти(Выборка.Ссылка) = Неопределено Тогда
				Ссылки.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

// Словарь загружается до записи и только для работника с выбранным правилом организации.
Функция СловарьОрганизацийДляИсточника(Источник, ТекущийСловарь)
	Перем ПравилоСловаря;
	Если ТекущийСловарь.Количество() > 0 Тогда
		Возврат ТекущийСловарь;
	КонецЕсли;
	Для Каждого ПравилоСловаря Из Источник.Поля Цикл
		Если ПравилоСловаря.Категория = "Организация" Тогда
			Возврат Cutter3000_ИменаПерсонажей.СловарьОрганизаций();
		КонецЕсли;
	КонецЦикла;
	Возврат ТекущийСловарь;
КонецФункции

Процедура ОбработатьИсточник(Запуск, Работник, Источник, Настройки, Счетчики)
	Настройки.СловарьОрганизаций = СловарьОрганизацийДляИсточника(Источник, Настройки.СловарьОрганизаций);

	Описание = Метаданные.НайтиПоПолномуИмени(Источник.Имя);
	Менеджер = МенеджерИсточника(Источник.Имя);
	Ключи = КлючиИсточника(Источник, Описание);
	Курсор = Неопределено;
	Пока Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Цикл
		Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, Работник, "Чтение") Тогда
			Прервать;
		КонецЕсли;
		Cutter3000_ЗаданияСервер.ПрогрессОбфускации(Запуск, Работник,
			"Чтение: " + Источник.Имя, Счетчики);
		Страница = СтраницаКлючей(Источник, Ключи, Курсор);
		Если Страница.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого СтрокаКлючей Из Страница Цикл
			Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, Работник, "Чтение") Тогда
				Возврат;
			КонецЕсли;
			Счетчики.Прочитано = Счетчики.Прочитано + 1;
			Курсор = Новый Структура;
			Для Каждого Ключ Из Ключи Цикл
				Курсор.Вставить(Ключ, СтрокаКлючей[Ключ]);
			КонецЦикла;
			Попытка
				Единица = ПодготовитьЕдиницу(Источник, Описание, Менеджер, Курсор, Запуск, Настройки);
				Если Источник.Вид = "Регистр" Тогда
					Счетчики.Прочитано = Счетчики.Прочитано + Макс(0, Единица.Количество() - 1);
				КонецЕсли;
			Исключение
				Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, Работник,
					"Единица пропущена: невозможно подготовить данные или уникальное имя.", Источник.Имя,
					ИдентификаторЕдиницыОбфускации(Курсор));
				Продолжить;
			КонецПопытки;
			Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, Работник, "Запись") Тогда
				Возврат;
			КонецЕсли;
			НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
			Попытка
				ЗаблокироватьЕдиницуОбфускации(Источник, Курсор);
				Если Источник.Вид = "Объект" И Единица <> Неопределено Тогда
					Единица.Прочитать();
				ИначеЕсли Источник.Вид = "Регистр" Тогда
					Единица.Прочитать();
				ИначеЕсли Источник.Вид = "Константа" Тогда
					Единица.Значение = Менеджер.Получить();
				КонецЕсли;
				Результат = ИзменитьЕдиницу(Источник, Описание, Менеджер, Курсор, Настройки, Новый Структура("Запуск,Единица", Запуск, Единица));
				Если Результат.Изменено > 0 Тогда
					ПроверитьЗаписанныеПоля(Источник, Менеджер, Курсор, Результат.Ожидания);
				КонецЕсли;
				// Счетчики фиксируются вместе с данными и сохраняются при отмене следующего чтения.
				Cutter3000_ЗаданияСервер.ПрогрессОбфускации(Запуск, Работник,
					"Запись: " + Источник.Имя, Новый Структура("Прочитано,Зафиксировано,Исключено",
						Счетчики.Прочитано, Счетчики.Зафиксировано + Результат.Изменено,
						Счетчики.Исключено + Результат.Исключено));
				ЗафиксироватьТранзакцию();
				Счетчики.Зафиксировано = Счетчики.Зафиксировано + Результат.Изменено;
				Счетчики.Исключено = Счетчики.Исключено + Результат.Исключено;
				Счетчики.Несогласовано = Счетчики.Несогласовано + Результат.Несогласовано;
			Исключение
				ОтменитьТранзакцию();
				Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, Работник,
					"Единица пропущена: запись или преобразование отклонены. Транзакция отменена.", Источник.Имя,
					ИдентификаторЕдиницыОбфускации(Курсор));
			КонецПопытки;
			Если Счетчики.Прочитано % 32 = 0 Тогда
				Cutter3000_ЗаданияСервер.ПрогрессОбфускации(Запуск, Работник,
					"Запись: " + Источник.Имя, Счетчики);
			КонецЕсли;
		КонецЦикла;
		Если Источник.Вид = "Константа" Или Ключи.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Блокируется только текущий объект или полный набор регистратора, затем он перечитывается.
Процедура ЗаблокироватьЕдиницуОбфускации(Источник, Ключи)

	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		Если Источник.Вид = "Константа" Тогда
			Возврат;
		КонецЕсли;
		Запрос = Новый Запрос;
		Условия = Новый Массив;
		Для Каждого Ключ Из Ключи Цикл
			Условия.Добавить(Ключ.Ключ + " = &" + Ключ.Ключ);
			Запрос.УстановитьПараметр(Ключ.Ключ, Ключ.Значение);
		КонецЦикла;
		Запрос.Текст = "ВЫБРАТЬ ИСТИНА КАК БлокируемаяЗапись ИЗ " + Источник.Имя;
		Если Условия.Количество() > 0 Тогда
			Запрос.Текст = Запрос.Текст + " ГДЕ " + СтрСоединить(Условия, " И ");
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + " ДЛЯ ИЗМЕНЕНИЯ";
		Запрос.Выполнить();
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Пространство = Источник.Имя;
	Если Источник.Вид = "Регистр" И Ключи.Свойство("Регистратор") Тогда
		Пространство = Пространство + ".НаборЗаписей";
	КонецЕсли;
	Ресурс = Блокировка.Добавить(Пространство);
	Ресурс.Режим = РежимБлокировкиДанных.Исключительный;
	Для Каждого Ключ Из Ключи Цикл
		Ресурс.УстановитьЗначение(Ключ.Ключ, Ключ.Значение);
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Адресная проверка выбранных полей текущей единицы до фиксации, без сканирования остальных данных.
Процедура ПроверитьЗаписанныеПоля(Источник, Менеджер, Ключи, Ожидания)

	Если Источник.Вид = "Константа" Тогда
		Если Менеджер.Получить() <> Ожидания.Значение Тогда
			ВызватьИсключение "Конфигурация изменила синтетическое значение константы.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Для Каждого Часть Из Ожидания Цикл
		ПроверитьПоляЧасти(Источник, Ключи, Часть.Ключ, Часть.Значение);
	КонецЦикла;

КонецПроцедуры

Функция СнимокПолейДляПроверки(Источник, Единица)

	Части = Новый Соответствие;
	Для Каждого Правило Из Источник.Поля Цикл
		Строки = Части.Получить(Правило.Часть);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Если Источник.Вид = "Объект" И Правило.Часть = "" Тогда
				Строки.Добавить(Новый Структура);
			Иначе
				Таблица = Единица;
				Если Источник.Вид = "Объект" Тогда
					Таблица = Единица[Правило.Часть];
				КонецЕсли;
				Для ИндексСтроки = 0 По Таблица.Количество() - 1 Цикл
					Строки.Добавить(Новый Структура);
				КонецЦикла;
			КонецЕсли;
			Части.Вставить(Правило.Часть, Строки);
		КонецЕсли;
		Для Индекс = 0 По Строки.Количество() - 1 Цикл
			Если Источник.Вид = "Объект" И Правило.Часть = "" Тогда
				ЗначениеПоля = Единица[Правило.Имя];
			ИначеЕсли Источник.Вид = "Объект" Тогда
				ЗначениеПоля = Единица[Правило.Часть][Индекс][Правило.Имя];
			Иначе
				ЗначениеПоля = Единица[Индекс][Правило.Имя];
			КонецЕсли;
			Строки[Индекс].Вставить(Правило.Имя, ЗначениеПоля);
		КонецЦикла;
	КонецЦикла;
	Возврат Части;

КонецФункции

Процедура ПроверитьПоляЧасти(Источник, Ключи, ИмяЧасти, Ожидания)

	Если Ожидания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Поля = Новый Массив;
	Для Каждого Поле Из Ожидания[0] Цикл
		Поля.Добавить(Поле.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Условия.Добавить(Ключ.Ключ + " = &" + Ключ.Ключ);
		Запрос.УстановитьПараметр(Ключ.Ключ, Ключ.Значение);
	КонецЦикла;
	Таблица = Источник.Имя;
	Если ИмяЧасти <> "" Тогда
		Таблица = Таблица + "." + ИмяЧасти;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ " + Таблица;
	Если Условия.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + " ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	Если ИмяЧасти <> "" Или Ключи.Свойство("Регистратор") Тогда
		Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО НомерСтроки";
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Индекс = 0;
	Пока Выборка.Следующий() Цикл
		Если Индекс >= Ожидания.Количество() Тогда
			ВызватьИсключение "Конфигурация изменила состав обрабатываемой единицы.";
		КонецЕсли;
		Для Каждого Поле Из Поля Цикл
			Если Выборка[Поле] <> Ожидания[Индекс][Поле] Тогда
				ВызватьИсключение "Конфигурация изменила синтетическое значение поля.";
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Индекс <> Ожидания.Количество() Тогда
		ВызватьИсключение "Конфигурация изменила состав обрабатываемой единицы.";
	КонецЕсли;

КонецПроцедуры

Функция МенеджерИсточника(Имя)

	Части = СтрРазделить(Имя, ".");
	Вид = Части[0];
	Объект = Части[1];
	Если Вид = "Справочник" Тогда
		Возврат Справочники[Объект];
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[Объект];
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возврат РегистрыСведений[Объект];
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Возврат РегистрыНакопления[Объект];
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат РегистрыБухгалтерии[Объект];
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Возврат РегистрыРасчета[Объект];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Объект];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Объект];
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Объект];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Объект];
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Объект];
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[Объект];
	ИначеЕсли Вид = "Константа" Тогда
		Возврат Константы[Объект];
	КонецЕсли;
	ВызватьИсключение "Для источника отсутствует адаптер записи.";

КонецФункции

Функция КлючиИсточника(Источник, Описание)

	Ключи = Новый Массив;
	Если Источник.Вид = "Объект" Тогда
		Ключи.Добавить("Ссылка");
	ИначеЕсли Источник.Вид = "Регистр" Тогда
		Подчиненный = Не СтрНачинаетсяС(Источник.Имя, "РегистрСведений.")
			Или Описание.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
		Если Подчиненный Тогда
			Ключи.Добавить("Регистратор");
		Иначе
			Если Описание.ПериодичностьРегистраСведений <>
				Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				Ключи.Добавить("Период");
			КонецЕсли;
			Для Каждого Поле Из Описание.Измерения Цикл
				Если НепрозрачныйТип(Поле.Тип) Или Поле.Тип.СодержитТип(Тип("Булево")) Тогда
					ВызватьИсключение "Ключ регистра требует отдельного адаптера порционного чтения.";
				КонецЕсли;
				Ключи.Добавить(Поле.Имя);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат Ключи;

КонецФункции

Функция СтраницаКлючей(Источник, Ключи, Курсор)

	Если Источник.Вид = "Константа" Или Ключи.Количество() = 0 Тогда
		Страница = Новый Массив;
		Страница.Добавить(Новый Структура);
		Возврат Страница;
	КонецЕсли;
	Поля = СтрСоединить(Ключи, ", ");
	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 256 " + Поля + " ИЗ " + Источник.Имя;
	Отборы = Новый Массив;
	Если СтрНачинаетсяС(Источник.Имя, "Справочник.") Тогда
		ОписаниеСправочника = Метаданные.НайтиПоПолномуИмени(Источник.Имя);
		Если ОписаниеСправочника.Иерархический
			И ОписаниеСправочника.ВидИерархии =
				Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Отборы.Добавить("НЕ ЭтоГруппа");
		КонецЕсли;
	КонецЕсли;
	Если Курсор <> Неопределено Тогда
		Условия = Новый Массив;
		Равные = Новый Массив;
		Для Индекс = 0 По Ключи.Количество() - 1 Цикл
			Ключ = Ключи[Индекс];
			Параметр = "Ключ" + Формат(Индекс, "ЧГ=0");
			Часть = Ключ + " > &" + Параметр;
			Если Равные.Количество() > 0 Тогда
				Часть = СтрСоединить(Равные, " И ") + " И " + Часть;
			КонецЕсли;
			Условия.Добавить("(" + Часть + ")");
			Равные.Добавить(Ключ + " = &" + Параметр);
			Запрос.УстановитьПараметр(Параметр, Курсор[Ключ]);
		КонецЦикла;
		Отборы.Добавить("(" + СтрСоединить(Условия, " ИЛИ ") + ")");
	КонецЕсли;
	Если Отборы.Количество() > 0 Тогда
		Текст = Текст + " ГДЕ " + СтрСоединить(Отборы, " И ");
	КонецЕсли;
	Запрос.Текст = Текст + " УПОРЯДОЧИТЬ ПО " + Поля;
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Чтение и короткие транзакции резервирования имен выполняются до допуска прикладной записи.
Функция ПодготовитьЕдиницу(Источник, Описание, Менеджер, Ключи, Запуск, Настройки)
	Перем КлючКонстанты, КлючПоля;

	СловарьИмен = Настройки.СловарьИмен;
	ЗанятыеИмена = Настройки.ЗанятыеИмена;

	Если Источник.Вид = "Константа" Тогда
		ЗначениеКонстанты = Менеджер.Получить();
		КлючКонстанты = КлючИмениПравила(Источник, Источник.Поля[0], Неопределено, Источник.Имя, Настройки);
		Если Источник.Поля[0].Категория = "Персонаж" И ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
			Cutter3000_ИменаПерсонажей.ИмяСущности(Запуск, КлючКонстанты,
				Описание.Тип.КвалификаторыСтроки.Длина, СловарьИмен, ЗанятыеИмена);
		КонецЕсли;
		Возврат Новый Структура("Значение", ЗначениеКонстанты);
	ИначеЕсли Источник.Вид = "Объект" Тогда
		Объект = Ключи.Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПодготовитьСущностиЕдиницы(Источник, Объект, Настройки);
		Ключ = КлючСущностиСтроки(Объект, Источник.СсылкаСущности, Строка(Ключи.Ссылка.УникальныйИдентификатор()));
		КонтекстЧасти = Новый Структура("Запуск,Ключ,Настройки", Запуск, Ключ, Настройки);
		Для Каждого Правило Из Источник.Поля Цикл
			Если Правило.Категория <> "Персонаж" Тогда
				Продолжить;
			КонецЕсли;
			Если Правило.Часть = "" Тогда
				Поле = НайтиПоле(Новый Структура("Описание,Вид,Часть", Описание, "Объект", ""), Правило.Имя);
				Если ЗначениеЗаполнено(Объект[Правило.Имя]) Тогда
					КлючПоля = КлючИмениПравила(Источник, Правило, Объект, Ключ, Настройки);
					Cutter3000_ИменаПерсонажей.ИмяСущности(Запуск, КлючПоля, Поле.Тип.КвалификаторыСтроки.Длина, СловарьИмен, ЗанятыеИмена);
				КонецЕсли;
			Иначе
				ПодготовитьИменаСтрокЧасти(Источник, Описание, Объект, Правило, КонтекстЧасти);
			КонецЕсли;
		КонецЦикла;
		Возврат Объект;
	КонецЕсли;
	Набор = Менеджер.СоздатьНаборЗаписей();
	Для Каждого Ключ Из Ключи Цикл
		Набор.Отбор[Ключ.Ключ].Установить(Ключ.Значение);
	КонецЦикла;
	Набор.Прочитать();
	ПодготовитьСущностиЕдиницы(Источник, Набор, Настройки);
	Ключ = Источник.Имя + ЗначениеВСтрокуВнутр(Ключи);
	Для ИндексСтроки = 0 По Набор.Количество() - 1 Цикл
		Запись = Набор[ИндексСтроки];
		Для Каждого Правило Из Источник.Поля Цикл
			Если Правило.Категория = "Персонаж" И ЗначениеЗаполнено(Запись[Правило.Имя]) Тогда
				Поле = НайтиПоле(Новый Структура("Описание,Вид,Часть", Описание, "Регистр", ""), Правило.Имя);
				КлючСтроки = КлючСущностиСтроки(Запись, Источник.СсылкаСущности, Ключ + "|" + Формат(ИндексСтроки, "ЧГ=0"));
				КлючСтроки = КлючИмениПравила(Источник, Правило, Запись, КлючСтроки, Настройки);
				Cutter3000_ИменаПерсонажей.ИмяСущности(Запуск,
					КлючСтроки, Поле.Тип.КвалификаторыСтроки.Длина, СловарьИмен, ЗанятыеИмена);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Набор;

КонецФункции

Функция ИзменитьЕдиницу(Источник, Описание, Менеджер, Ключи, Настройки, Контекст)
	Перем КлючКонстанты, КлючПоля;

	Запуск = Контекст.Запуск;
	Единица = Контекст.Единица;

	Результат = Новый Структура("Изменено,Исключено,Несогласовано", 0, 0, 0);
	Если Источник.Вид = "Константа" Тогда
		Исходное = Единица.Значение;
		КлючКонстанты = КлючИмениПравила(Источник, Источник.Поля[0], Неопределено, Источник.Имя, Настройки);
		Новое = СинтетическоеЗначение(Источник.Поля[0].Категория, КлючКонстанты, Исходное, Описание.Тип, Запуск, Настройки);
		Если НезависимоеИмя(Источник.Поля[0], КлючКонстанты, Исходное) Тогда
			Результат.Несогласовано = 1;
		КонецЕсли;
		Менеджер.Установить(Новое);
		Единица.Значение = Новое;
		Результат.Вставить("Ожидания", Новый Структура("Значение", Новое));
		Результат.Изменено = 1;
	ИначеЕсли Источник.Вид = "Объект" Тогда
		Объект = Единица;
		Если Объект = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Если ЗащищеннаяЕдиница(Объект, Описание, Настройки.ЗащищенныеСсылки) Тогда
			Результат.Исключено = 1;
			Возврат Результат;
		КонецЕсли;
		Ключ = КлючСущностиСтроки(Объект, Источник.СсылкаСущности, Строка(Ключи.Ссылка.УникальныйИдентификатор()));
		КонтекстЧасти = Новый Структура("Запуск,Ключ,Настройки,Согласование", Запуск, Ключ, Настройки, Результат);
		Изменено = Ложь;
		Для Каждого Правило Из Источник.Поля Цикл
			Если Правило.Часть = "" Тогда
				Поле = НайтиПоле(Новый Структура("Описание,Вид,Часть", Описание, "Объект", ""), Правило.Имя);
				КлючПоля = КлючИмениПравила(Источник, Правило, Объект, Ключ, Настройки);
				Если НезависимоеИмя(Правило, КлючПоля, Объект[Правило.Имя]) Тогда
					Результат.Несогласовано = Результат.Несогласовано + 1;
				КонецЕсли;
				Объект[Правило.Имя] = СинтетическоеЗначение(Правило.Категория, КлючПоля,
					Объект[Правило.Имя], Поле.Тип, Запуск, Настройки);
				Изменено = Истина;
			Иначе
				Если ИзменитьСтрокиЧасти(Источник, Описание, Объект, Правило, КонтекстЧасти) Тогда
					Изменено = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Изменено Тогда
			Результат.Вставить("Ожидания", СнимокПолейДляПроверки(Источник, Единица));
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			Результат.Изменено = 1;
		КонецЕсли;
	Иначе
		Набор = Единица;
		Ключ = Источник.Имя + ЗначениеВСтрокуВнутр(Ключи);
		Для ИндексСтроки = 0 По Набор.Количество() - 1 Цикл
			Запись = Набор[ИндексСтроки];
			Если ЗащищеннаяЗаписьРегистра(Запись, Описание, Настройки.ЗащищенныеСсылки) Тогда
				Результат.Исключено = Результат.Исключено + 1;
				Продолжить;
			КонецЕсли;
			Для Каждого Правило Из Источник.Поля Цикл
				Поле = НайтиПоле(Новый Структура("Описание,Вид,Часть", Описание, "Регистр", ""), Правило.Имя);
				КлючСтроки = КлючСущностиСтроки(Запись, Источник.СсылкаСущности, Ключ + "|" + Формат(ИндексСтроки, "ЧГ=0"));
				КлючСтроки = КлючИмениПравила(Источник, Правило, Запись, КлючСтроки, Настройки);
				Если НезависимоеИмя(Правило, КлючСтроки, Запись[Правило.Имя]) Тогда
					Результат.Несогласовано = Результат.Несогласовано + 1;
				КонецЕсли;
				Запись[Правило.Имя] = СинтетическоеЗначение(Правило.Категория, КлючСтроки,
					Запись[Правило.Имя], Поле.Тип, Запуск, Настройки);
			КонецЦикла;
			Результат.Изменено = Результат.Изменено + 1;
		КонецЦикла;
		Если Результат.Изменено > 0 Тогда
			Результат.Вставить("Ожидания", СнимокПолейДляПроверки(Источник, Единица));
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать();
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ПодготовитьИменаСтрокЧасти(Источник, Описание, Объект, Правило, Контекст)

	Поле = Описание.ТабличныеЧасти[Правило.Часть].Реквизиты[Правило.Имя];
	Для Каждого СтрокаЧасти Из Объект[Правило.Часть] Цикл
		Если Не ЗначениеЗаполнено(СтрокаЧасти[Правило.Имя]) Тогда
			Продолжить;
		КонецЕсли;
		КлючСтроки = КлючСущностиСтроки(СтрокаЧасти, Источник.СсылкиЧастей.Получить(Правило.Часть),
			Контекст.Ключ + "|" + Правило.Часть + "|" + Формат(СтрокаЧасти.НомерСтроки, "ЧГ=0"));
		КлючСтроки = КлючИмениПравила(Источник, Правило, СтрокаЧасти, КлючСтроки, Контекст.Настройки);
		Cutter3000_ИменаПерсонажей.ИмяСущности(Контекст.Запуск, КлючСтроки,
			Поле.Тип.КвалификаторыСтроки.Длина, Контекст.Настройки.СловарьИмен, Контекст.Настройки.ЗанятыеИмена);
	КонецЦикла;

КонецПроцедуры

Функция ИзменитьСтрокиЧасти(Источник, Описание, Объект, Правило, Контекст)

	ПоляЧасти = Описание.ТабличныеЧасти[Правило.Часть].Реквизиты;
	Поле = ПоляЧасти[Правило.Имя];
	Изменено = Ложь;
	Для Каждого СтрокаЧасти Из Объект[Правило.Часть] Цикл
		Если ЗащищеннаяСтрока(СтрокаЧасти, ПоляЧасти, Контекст.Настройки.ЗащищенныеСсылки) Тогда
			Продолжить;
		КонецЕсли;
		КлючСтроки = КлючСущностиСтроки(СтрокаЧасти, Источник.СсылкиЧастей.Получить(Правило.Часть),
			Контекст.Ключ + "|" + Правило.Часть + "|" + Формат(СтрокаЧасти.НомерСтроки, "ЧГ=0"));
		КлючСтроки = КлючИмениПравила(Источник, Правило, СтрокаЧасти, КлючСтроки, Контекст.Настройки);
		Если НезависимоеИмя(Правило, КлючСтроки, СтрокаЧасти[Правило.Имя]) Тогда
			Контекст.Согласование.Несогласовано = Контекст.Согласование.Несогласовано + 1;
		КонецЕсли;
		СтрокаЧасти[Правило.Имя] = СинтетическоеЗначение(Правило.Категория,
			КлючСтроки, СтрокаЧасти[Правило.Имя], Поле.Тип, Контекст.Запуск, Контекст.Настройки);
		Изменено = Истина;
	КонецЦикла;
	Возврат Изменено;

КонецФункции

// Только небольшой список явных исключений; весь справочник пользователей не сканируется.
Функция СохраненныеИменаИсключений(Настройки)

	Имена = Новый Соответствие;
	Для Каждого Профиль Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Имена.Вставить(НРег(Профиль.Имя), Истина);
	КонецЦикла;
	Для Каждого Ссылка Из Настройки.ЗащищенныеСсылки Цикл
		Описание = Ссылка.Метаданные();
		Для Каждого Источник Из Настройки.Источники Цикл
			Если Источник.Имя <> Описание.ПолноеИмя() Тогда
				Продолжить;
			КонецЕсли;
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Правило Из Источник.Поля Цикл
				Если Правило.Категория = "Персонаж" И Правило.Часть = "" Тогда
					Имена.Вставить(НРег(Объект[Правило.Имя]), Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ЗащищеннаяЕдиница(Объект, Описание, Ссылки)

	Возврат Ссылки.Найти(Объект.Ссылка) <> Неопределено
		Или ЗащищеннаяСтрока(Объект, Описание.Реквизиты, Ссылки);

КонецФункции

Функция ЗащищеннаяСтрока(СтрокаДанных, Поля, Ссылки)

	Для Каждого Поле Из Поля Цикл
		// Скалярные и непрозрачные значения для проверки исключений не читаются.
		Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
			ОписаниеТипа = Метаданные.НайтиПоТипу(ТипПоля);
			Если ОписаниеТипа <> Неопределено И СтрНачинаетсяС(ОписаниеТипа.ПолноеИмя(), "Справочник.") Тогда
				Если Ссылки.Найти(СтрокаДанных[Поле.Имя]) <> Неопределено Тогда
					Возврат Истина;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЗащищеннаяЗаписьРегистра(Запись, Описание, Ссылки)

	Возврат ЗащищеннаяСтрока(Запись, Описание.Измерения, Ссылки)
		Или ЗащищеннаяСтрока(Запись, Описание.Ресурсы, Ссылки)
		Или ЗащищеннаяСтрока(Запись, Описание.Реквизиты, Ссылки);

КонецФункции

Процедура ОчиститьИсточникиИстории(Запуск)

	Настройки = Cutter3000_ЗаданияСервер.НастройкиОбфускацииЗапуска(Запуск);
	Если Настройки.ОчиститьИсторию Тогда
		ОчиститьИсториюВыбранныхИсточников(Запуск, Настройки.Источники);
	КонецЕсли;
	Если Настройки.ОчиститьНастройки Тогда
		Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, "Запуск", "Очистка") Тогда
			Возврат;
		КонецЕсли;
		Хранилища = Новый Массив;
		Хранилища.Добавить(ХранилищеОбщихНастроек);
		Хранилища.Добавить(ХранилищеСистемныхНастроек);
		Хранилища.Добавить(ХранилищеНастроекДанныхФорм);
		Хранилища.Добавить(ХранилищеПользовательскихНастроекОтчетов);
		Хранилища.Добавить(ХранилищеВариантовОтчетов);
		Хранилища.Добавить(ХранилищеПользовательскихНастроекДинамическихСписков);
		Для Каждого Хранилище Из Хранилища Цикл
			Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, "Запуск", "Очистка") Тогда
				Возврат;
			КонецЕсли;
			Попытка
				// Пользовательское хранилище имеет свой контракт и остается для ручного адаптера.
				Если ТипЗнч(Хранилище) <> Тип("СтандартноеХранилищеНастроекМенеджер") Тогда
					ВызватьИсключение "Пользовательское хранилище настроек требует адаптера.";
				КонецЕсли;
				Хранилище.Удалить(Неопределено, Неопределено, Неопределено);
			Исключение
				Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, "Запуск", "Хранилище настроек требует ручной очистки.");
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	Если Настройки.ОчиститьЖурнал Тогда
		Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, "Запуск", "Очистка") Тогда
			Возврат;
		КонецЕсли;
		Попытка
			СократитьЖурналРегистрации(ТекущаяДатаСеанса() + 1);
		Исключение
			Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, "Запуск", "Журнал регистрации требует ручной очистки.");
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьИсториюВыбранныхИсточников(Запуск, Источники)

	Для Каждого Источник Из Источники Цикл
		Если Не Cutter3000_ЗаданияСервер.ДопуститьОбфускацию(Запуск, "Запуск", "Очистка") Тогда
			Возврат;
		КонецЕсли;
		Если Источник.Вид = "Регистр" И Не СтрНачинаетсяС(Источник.Имя, "РегистрСведений.") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Описание = Метаданные.НайтиПоПолномуИмени(Источник.Имя);
			Если Описание.ИсторияДанных = Метаданные.СвойстваОбъектов.ИспользованиеИсторииДанных.НеИспользовать Тогда
				Продолжить;
			КонецЕсли;
			Включить = Новый Массив;
			Включить.Добавить(Описание);
			// Обрабатываем очередь выбранного источника без конфигурационного обработчика версий.
			ИсторияДанных.ОбновитьИсторию(Включить, Неопределено, Ложь, Ложь);
			ИсторияДанных.УдалитьВерсии(Описание);
		Исключение
			Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, "Запуск",
				"История данных источника требует ручной очистки.", Источник.Имя);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ИдентификаторЕдиницыОбфускации(Ключи)

	Если Ключи.Свойство("Ссылка") Тогда
		Возврат Строка(Ключи.Ссылка.УникальныйИдентификатор());
	КонецЕсли;
	// Строковые измерения могут содержать персональные данные: сохраняется только технический хеш.
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ЗначениеВСтрокуВнутр(Ключи));
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма);

КонецФункции

Функция ЧисловойОтпечаток(Текст)

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Текст);
	СтрокаХеша = ВРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	ЧисловойКод = 0;
	Для Индекс = 1 По 8 Цикл
		ЧисловойКод = ЧисловойКод * 16 + СтрНайти("0123456789ABCDEF", Сред(СтрокаХеша, Индекс, 1)) - 1;
	КонецЦикла;
	Возврат ЧисловойКод;

КонецФункции

Функция ДополнитьЦифрами(Значение, Длина)

	Текст = Формат(Значение, "ЧГ=0;ЧДЦ=0;ЧН=0");
	Возврат Прав("000000000000" + Текст, Длина);

КонецФункции

Функция СинтетическийИНН(Цифры, ОписаниеТипа)

	Основа = "00" + Прав(Цифры, 8);
	Если ОписаниеТипа.КвалификаторыСтроки.Длина = 10 Тогда
		Основа = Лев(Основа, 9);
		Возврат Основа + КонтрольнаяЦифраИНН(Основа, "2,4,10,3,5,9,4,6,8");
	КонецЕсли;
	Основа = Основа + КонтрольнаяЦифраИНН(Основа, "7,2,4,10,3,5,9,4,6,8");
	Возврат Основа + КонтрольнаяЦифраИНН(Основа, "3,7,2,4,10,3,5,9,4,6,8");

КонецФункции

Функция КонтрольнаяЦифраИНН(Основа, Веса)

	Коэффициенты = СтрРазделить(Веса, ",");
	Сумма = 0;
	Для Индекс = 0 По Коэффициенты.Количество() - 1 Цикл
		Сумма = Сумма + Число(Сред(Основа, Индекс + 1, 1)) * Число(Коэффициенты[Индекс]);
	КонецЦикла;
	Возврат Формат((Сумма % 11) % 10, "ЧГ=0;ЧН=0");

КонецФункции




Функция КартаАвтоматическихИмен(Источники, Каталог)

	Перем Карта, Описание, ПолеСвязи, Источник, Правило, ИмяИсточника, ОписаниеИсточника, ПоляЗащиты;
	Карта = Новый Структура("Каталоги,Поля,ПоляЗащиты,Несогласовано", Новый Соответствие, Новый Соответствие, Новый Соответствие, 0);
	Для Каждого Описание Из Метаданные.Справочники Цикл
		ПолеСвязи = КаноническоеПолеЧеловека(Описание);
		Если ПолеСвязи.Количество() > 0 Тогда
			Карта.Каталоги.Вставить(Описание.ПолноеИмя(), ПолеСвязи);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Источник Из Источники Цикл
		ПоляЗащиты = Новый Соответствие;
		ПоляЗащиты.Вставить("", ПоляСсылокНаЛюдей(НайтиИсточник(Каталог, Источник.Имя)));
		Карта.ПоляЗащиты.Вставить(Источник.Имя, ПоляЗащиты);
		Для Каждого Правило Из Источник.Поля Цикл
			Если Правило.Часть <> "" И ПоляЗащиты.Получить(Правило.Часть) = Неопределено Тогда
				ПоляЗащиты.Вставить(Правило.Часть,
					ПоляСсылокНаЛюдей(НайтиИсточник(Каталог, Источник.Имя + "." + Правило.Часть)));
			КонецЕсли;
			Если Правило.Категория <> "Персонаж" Тогда
				Продолжить;
			КонецЕсли;
			ИмяИсточника = Источник.Имя;
			Если Правило.Часть <> "" Тогда
				ИмяИсточника = ИмяИсточника + "." + Правило.Часть;
			КонецЕсли;
			ОписаниеИсточника = НайтиИсточник(Каталог, ИмяИсточника);
			ПолеСвязи = ПолеЧеловекаДляИмени(ОписаниеИсточника, Правило.Имя);
			Карта.Поля.Вставить(Источник.Имя + "|" + Правило.Часть + "|" + Правило.Имя, ПолеСвязи);
			Если ПолеСвязи = "" Тогда
				Карта.Несогласовано = Карта.Несогласовано + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Карта;

КонецФункции

Функция РангСправочникаЧеловека(Описание)

	Перем Имя;
	Имя = НРег(Описание.Имя + " " + Описание.Синоним);
	Если СтрНайти(Имя, "физическ") > 0 Или СтрНайти(Имя, "физлиц") > 0
		Или СтрНайти(Имя, "individual") > 0 Или СтрНайти(Имя, "person") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	Если СтрНайти(Имя, "сотрудник") > 0 Или СтрНайти(Имя, "employee") > 0
		Или СтрНайти(Имя, "контактныелица") > 0 Тогда
		Возврат 2;
	КонецЕсли;
	Если СтрНайти(Имя, "пользовател") > 0 Или СтрНайти(Имя, "user") > 0 Тогда
		Возврат 3;
	КонецЕсли;
	Возврат 0;

