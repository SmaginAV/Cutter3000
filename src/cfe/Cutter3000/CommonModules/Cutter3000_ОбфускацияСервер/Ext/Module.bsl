Процедура ПодготовитьСущностиЕдиницы(Источник, Единица, Настройки)

	Перем Карта, Ссылки, Правило, СтрокаЧасти, Известные, ИмяПоля, Пара;
	Если Не Настройки.Свойство("КартаИмен", Карта) Или Карта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Настройки.КэшСущностей.Количество() > 4096 Тогда
		Настройки.КэшСущностей.Очистить();
	КонецЕсли;
	Ссылки = Новый Соответствие;
	Известные = Новый Соответствие;
	ДобавитьСсылкиЗащиты(Источник, Единица, Карта.ПоляЗащиты, Ссылки);
	Для Каждого Правило Из Источник.Поля Цикл
		Если Правило.Категория <> "Персонаж" Тогда
			Продолжить;
		КонецЕсли;
		Если Источник.Вид = "Объект" И Правило.Часть = "" Тогда
			ДобавитьСущностьСтроки(Источник, Правило, Единица, Настройки, Ссылки);
		ИначеЕсли Источник.Вид = "Объект" Тогда
			Для Каждого СтрокаЧасти Из Единица[Правило.Часть] Цикл
				ДобавитьСущностьСтроки(Источник, Правило, СтрокаЧасти, Настройки, Ссылки);
			КонецЦикла;
		Иначе
			Для Каждого СтрокаЧасти Из Единица Цикл
				ДобавитьСущностьСтроки(Источник, Правило, СтрокаЧасти, Настройки, Ссылки);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если Источник.Вид = "Объект" Тогда
		ИмяПоля = Карта.Каталоги.Получить(Источник.Имя);
		Если ИмяПоля <> Неопределено Тогда
			Известные.Вставить(Единица.Ссылка, СущностьИзСтроки(Единица, ИмяПоля));
		КонецЕсли;
	КонецЕсли;
	РазрешитьСущностиПакетом(Ссылки, Известные, Карта.Каталоги, Настройки.КэшСущностей);
	Для Каждого Пара Из Ссылки Цикл
		Если Настройки.ЗащищенныеСсылки.Найти(Настройки.КэшСущностей.Получить(Пара.Ключ)) <> Неопределено
			И Настройки.ЗащищенныеСсылки.Найти(Пара.Ключ) = Неопределено Тогда
			Настройки.ЗащищенныеСсылки.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;

