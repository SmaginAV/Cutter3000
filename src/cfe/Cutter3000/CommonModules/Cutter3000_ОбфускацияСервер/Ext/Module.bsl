Процедура ДобавитьСущностьСтроки(Источник, Правило, СтрокаДанных, Настройки, Ссылки)

	Перем ИмяПоля, Ссылка;
	ИмяПоля = Настройки.КартаИмен.Поля.Получить(Источник.Имя + "|" + Правило.Часть + "|" + Правило.Имя);
	Если ИмяПоля = "" Или ИмяПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ИмяПоля = "$Сам" Тогда
		Ссылка = СтрокаДанных.Ссылка;
	Иначе
		Ссылка = СтрокаДанных[ИмяПоля];
	КонецЕсли;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Ссылки.Вставить(Ссылка, Истина);
	КонецЕсли;

