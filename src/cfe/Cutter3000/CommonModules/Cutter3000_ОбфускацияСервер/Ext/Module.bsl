
#Область ПрограммныйИнтерфейс

// Предлагает правила по метаданным, не читая прикладные таблицы и содержимое хранилищ.
// Возвращаемое значение: Структура - массивы Правила, Пользователи, Роли, Связи и ручной охват.
Функция ПредложитьНастройки() Экспорт

	// Явная область не позволяет именам общих модулей основной конфигурации подменить локальные переменные.
	Перем Правила, Ручные, СвязиСущностей, Источник, Поле, ИмяСсылки, Категория, Доступно;
	Перем Профили, Оператор, Профиль, Защищен, Роли, Роль, ИмяРоли, ПолныеПрава;
	Перем Связи, Описание, ИмяПоля, Хранилище;

	ПроверитьАдминистратора();
	Правила = Новый Массив;
	Ручные = Новый Массив;
	СвязиСущностей = Новый Массив;
	Для Каждого Источник Из КаталогИсточников() Цикл
		Для Каждого Поле Из ПоляИсточника(Источник) Цикл
			ИмяСсылки = НРег(Поле.Имя);
			Если СсылкаНаСправочник(Поле.Тип) И (СтрНайти(ИмяСсылки, "физическ") > 0
				Или СтрНайти(ИмяСсылки, "сотрудник") > 0 Или СтрНайти(ИмяСсылки, "пользовател") > 0) Тогда
				СвязиСущностей.Добавить(Новый Структура("Источник,Поле,Подтверждено", Источник.Имя, Поле.Имя, Ложь));
			КонецЕсли;
			Категория = КатегорияПоля(Источник.Описание, Поле);
			Доступно = ПоддержанТип(Поле.Тип) И Не КлючевоеПоле(Источник, Поле.Имя);
			Если Не ПоддержанТип(Поле.Тип) Тогда
				Если НепрозрачныйТип(Поле.Тип) Тогда
					Ручные.Добавить(Источник.Имя + "." + Поле.Имя + ": непрозрачное содержимое, ручная обработка");
				ИначеЕсли Поле.Тип.СодержитТип(Тип("Строка")) Или Поле.Тип.СодержитТип(Тип("Дата")) Тогда
					Ручные.Добавить(Источник.Имя + "." + Поле.Имя + ": составной тип, требуется ручной адаптер");
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если Не Доступно И Категория <> "" Тогда
				Ручные.Добавить(Источник.Имя + "." + Поле.Имя + ": персональный ключ, ручной адаптер");
			КонецЕсли;
			Правила.Добавить(Новый Структура("Включено,Источник,Поле,Категория,Доступно,Причина",
				Доступно И Категория <> "", Источник.Имя, Поле.Имя, Категория, Доступно,
				ПредставлениеПравила(Доступно)));
		КонецЦикла;
	КонецЦикла;
	Профили = Новый Массив;
	Оператор = ПользователиИнформационнойБазы.ТекущийПользователь();
	Для Каждого Профиль Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Защищен = ПравоДоступа("Администрирование", Метаданные, Профиль)
			Или Профиль.УникальныйИдентификатор = Оператор.УникальныйИдентификатор;
		Профили.Добавить(Новый Структура("Идентификатор,Имя,Сохранить,Обязательно",
			Строка(Профиль.УникальныйИдентификатор), Профиль.Имя, Защищен, Защищен));
	КонецЦикла;
	Роли = Новый Массив;
	Для Каждого Роль Из Метаданные.Роли Цикл
		ИмяРоли = НРег(СтрЗаменить(Роль.Имя, "_", ""));
		ПолныеПрава = СтрНайти(ИмяРоли, "полныеправа") > 0 Или СтрНайти(ИмяРоли, "fullaccess") > 0;
		Роли.Добавить(Новый Структура("Имя,ПолныеПрава", Роль.Имя, ПолныеПрава));
	КонецЦикла;
	Связи = Новый Массив;
	Для Каждого Описание Из Метаданные.Справочники Цикл
		Для Каждого Поле Из Описание.Реквизиты Цикл
			ИмяПоля = НРег(Поле.Имя);
			Если СтрНайти(ИмяПоля, "идентификаторпользовател") > 0
				Или ИмяПоля = "уникальныйидентификатор" Тогда
				Связи.Добавить(Новый Структура("Источник,Поле,Подтверждено",
					Описание.ПолноеИмя(), Поле.Имя, Ложь));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Ручные.Добавить("Учетные записи платформы, логины, пароли и настройки аутентификации не изменяются.");
	Для Каждого Хранилище Из Метаданные.ХранилищаНастроек Цикл
		Ручные.Добавить(Хранилище.ПолноеИмя() + ": пользовательское хранилище настроек, требуется ручной адаптер");
	КонецЦикла;
	Ручные.Добавить("Неотмеченные поля, внешние источники, файлы вне базы и неизвестные форматы требуют проверки.");
	Возврат Новый Структура("Правила,Пользователи,Роли,Связи,Ручные,СвязиСущностей", Правила, Профили, Роли, Связи, Ручные, СвязиСущностей);

КонецФункции

// Проверяет операторские правила и возвращает безопасный неизменяемый по смыслу снимок запуска.
// Параметры:
//  Настройки - Структура - массивы формы и подтверждения оператора.
//   АвтоматическиеИмена - Булево - необязательный флаг согласования по метаданным; без него действуют прежние подтвержденные связи.
// Возвращаемое значение:
//  Структура - технические правила, исключения и области очистки.
Функция ПроверитьНастройки(Настройки) Экспорт

	Перем АвтоматическиеСвязи, АвтоматическиеИмена, КартаИмен, Снимок;
	ПроверитьАдминистратора();
	Если Не Настройки.Подтверждено Тогда
		ВызватьИсключение "Проверьте правила, классификацию полных прав, связи пользователей и остаточный охват.";
	КонецЕсли;
	Каталог = КаталогИсточников();
	Источники = Новый Массив;
	ПоИменам = Новый Соответствие;
	Для Каждого Правило Из Настройки.Правила Цикл
		Если Не Правило.Включено Тогда
			Продолжить;
		КонецЕсли;
		Источник = НайтиИсточник(Каталог, Правило.Источник);
		Поле = НайтиПоле(Источник, Правило.Поле);
		Если Поле = Неопределено Или Не ПоддержанТип(Поле.Тип)
			Или КлючевоеПоле(Источник, Поле.Имя) Тогда
			ВызватьИсключение "Выбранное поле не допускает безопасной универсальной записи. Используйте ручной адаптер.";
		КонецЕсли;
		ПроверитьКатегорию(Правило.Категория, Поле.Тип);
		Корень = Источник.Корень;
		Состав = ПоИменам.Получить(Корень);
		Если Состав = Неопределено Тогда
			Состав = Новый Структура("Имя,Вид,Поля,СсылкаСущности,СсылкиЧастей", Корень, Источник.Вид, Новый Массив, "", Новый Соответствие);
			Источники.Добавить(Состав);
			ПоИменам.Вставить(Корень, Состав);
		КонецЕсли;
		Состав.Поля.Добавить(Новый Структура("Часть,Имя,Категория", Источник.Часть, Поле.Имя, Правило.Категория));
	КонецЦикла;
	Защищенные = ЗащищенныеПользователи(Настройки);
	АвтоматическиеСвязи = Ложь;
	Настройки.Свойство("АвтоматическиеСвязи", АвтоматическиеСвязи);
	Если АвтоматическиеСвязи Тогда
		Ссылки = ПроверенныеИсключенияПользователей(Настройки, Защищенные);
	Иначе
		Ссылки = ЗащищенныеСсылки(Настройки.Связи, Защищенные, Каталог);
	КонецЕсли;
	Если Не Настройки.Свойство("АвтоматическиеИмена", АвтоматическиеИмена) Тогда
		АвтоматическиеИмена = Ложь;
	КонецЕсли;
	КартаИмен = Неопределено;
	СвязиСущностей = Новый Массив;
	Если АвтоматическиеИмена Тогда
		КартаИмен = КартаАвтоматическихИмен(Источники, Каталог);
		ДополнитьАвтоматическуюЗащиту(Ссылки, КартаИмен);
	Иначе
		СвязиСущностей = ПроверитьСвязиСущностей(Настройки, Каталог);
	КонецЕсли;
	Для Каждого Связь Из СвязиСущностей Цикл
		Состав = ПоИменам.Получить(Связь.Корень);
		Если Состав <> Неопределено Тогда
			Если Связь.Часть = "" Тогда
				Состав.СсылкаСущности = Связь.Поле;
			Иначе
				Состав.СсылкиЧастей.Вставить(Связь.Часть, Связь.Поле);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ДополнитьЗащитуПоСвязям(Ссылки, СвязиСущностей);
	Если Источники.Количество() = 0 И Не Настройки.ОчиститьИсторию
		И Не Настройки.ОчиститьЖурнал И Не Настройки.ОчиститьНастройки Тогда
		ВызватьИсключение "Не выбрано ни одного поддержанного правила или источника очистки.";
	КонецЕсли;
	Охват = "Обработаны только подтвержденные правила. Исключения применены по подтвержденным связям."
		+ Символы.ПС + "Неустановленные связи учетных записей с прикладными людьми требуют ручной проверки."
		+ Символы.ПС + "Вложения, хранилища, табличные документы и схемы компоновки остаются для ручной обработки."
		+ Символы.ПС + "Учетные записи: логины, полные имена и данные аутентификации сохраняются."
		+ Символы.ПС + "Невыбранные источники сохраняются; полное обезличивание всей базы и соответствие 152-ФЗ не подтверждаются.";
	Если Не Настройки.ОчиститьИсторию Тогда
		Охват = Охват + Символы.ПС + "История данных сохранена: ее очистка не выбрана.";
	КонецЕсли;
	Если Не Настройки.ОчиститьЖурнал Тогда
		Охват = Охват + Символы.ПС + "Журнал регистрации сохранен: его очистка не выбрана.";
	КонецЕсли;
	Если Не Настройки.ОчиститьНастройки Тогда
		Охват = Охват + Символы.ПС + "Сохраненные настройки не очищались.";
	КонецЕсли;
	Инвентаризация = ПредложитьНастройки();
	Охват = Охват + Символы.ПС + СтрСоединить(Инвентаризация.Ручные, Символы.ПС);
	Если АвтоматическиеИмена Тогда
		Охват = Охват + Символы.ПС + СтрШаблон("Имена согласуются автоматически по однозначным ссылкам. Полей без однозначной привязки: %1; для них используются независимые псевдонимы.", КартаИмен.Несогласовано);
	КонецЕсли;
	Снимок = Новый Структура("Источники,ЗащищенныеСсылки,ОчиститьИсторию,ОчиститьЖурнал,ОчиститьНастройки,ОстаточныйОхват",
		Источники, Ссылки, Настройки.ОчиститьИсторию, Настройки.ОчиститьЖурнал,
		Настройки.ОчиститьНастройки, Охват);
	Снимок.Вставить("КартаИмен", КартаИмен);
	Возврат Снимок;

КонецФункции

// Показывает результат адресного поиска записей исключенных пользователей по UUID.
// Параметры:
//  Настройки - Структура - Пользователи и Роли, как в ПроверитьНастройки.
// Возвращаемое значение:
//  Массив из Структура - Идентификатор, Защищен, Найдено, Состояние.
// Прикладные данные и учетные записи не изменяются; совпадение ФИО не используется.
Функция ПредложитьСвязиПользователей(Настройки) Экспорт

	Перем Защищенные, Найденные, Результат, Профиль, Записи, Количество, ТекстСостояния;
	ПроверитьАдминистратора();
	Защищенные = ЗащищенныеПользователи(Настройки);
	Найденные = ЗаписиУчетныхЗаписей(Защищенные);
	Результат = Новый Массив;
	Для Каждого Профиль Из Настройки.Пользователи Цикл
		Записи = Найденные.Получить(Профиль.Идентификатор);
		Количество = 0;
		ТекстСостояния = "Не исключен";
		Если Записи <> Неопределено Тогда
			Количество = Записи.Количество();
			ТекстСостояния = "Не найдены данные: выберите запись или отметьте «Записи нет»";
			Если Количество > 0 Тогда
				ТекстСостояния = СтрШаблон("Автоматически защищено записей: %1", Количество);
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Идентификатор,Защищен,Найдено,Состояние",
			Профиль.Идентификатор, Записи <> Неопределено, Количество, ТекстСостояния));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Выполняет только поиск исключений для открытой формы настроек, без изменения данных.
// Параметры:
//  Настройки - Структура - массивы Пользователи и Роли.
//  АдресРезультата - Строка - адрес временного хранилища, принадлежащего форме вызывающего сеанса.
// Результат доступен вызывающему сеансу после завершения фонового задания.
Процедура ПодготовитьСвязиПользователей(Настройки, АдресРезультата) Экспорт

	Перем Результат;
	Результат = Новый Структура("Успех,Связи", Ложь, Новый Массив);
	Попытка
		Результат.Связи = ПредложитьСвязиПользователей(Настройки);
		Результат.Успех = Истина;
	Исключение
		// Прикладной текст ошибки не передается: он может содержать персональные данные.
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации("Cutter3000.ПроверкаИсключений", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось проверить исключения пользователей; обфускация не запущена.");
	КонецПопытки;
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

// Точка входа фонового координатора; в файловом режиме не запускает дочерние задания.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
Процедура ВыполнитьОбфускацию(Запуск) Экспорт

	Попытка
		Если СтрНачинаетсяС(НРег(СтрокаСоединенияИнформационнойБазы()), "file=") Тогда
			Работник = Cutter3000_ЗаданияСервер.СоздатьРаботникаОбфускации(Запуск, Ложь);
			Если Работник <> "" Тогда
				ВыполнитьРаботника(Запуск, Работник);
			КонецЕсли;
		Иначе
			Настройки = Cutter3000_ЗаданияСервер.НастройкиОбфускацииЗапуска(Запуск);
			Для Номер = 1 По Мин(4, Настройки.Источники.Количество()) Цикл
				Cutter3000_ЗаданияСервер.СоздатьРаботникаОбфускации(Запуск, Истина);
			КонецЦикла;
			Cutter3000_ЗаданияСервер.ДождатьсяРаботниковОбфускации(Запуск);
		КонецЕсли;
		Если Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Тогда
			ОчиститьИсточникиИстории(Запуск);
			Cutter3000_ЗаданияСервер.ЗавершитьОбфускацию(Запуск);
		КонецЕсли;
	Исключение
		// Не передаем исключение платформы: обработчик записи может включить в него старое ФИО.
		Если Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Тогда
			Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, "Запуск", "Не удалось завершить координатор обфускации.");
			Cutter3000_ЗаданияСервер.ДождатьсяРаботниковОбфускации(Запуск);
			Cutter3000_ЗаданияСервер.ЗавершитьОбфускацию(Запуск);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Обрабатывает последовательно назначенные независимые источники ограниченными страницами ключей.
// Параметры:
//  Запуск - Строка - идентификатор запуска.
//  Работник - Строка - идентификатор исполнителя.
Процедура ВыполнитьРаботника(Запуск, Работник) Экспорт
	Перем НесогласованоДо;

	Счетчики = Новый Структура("Прочитано,Зафиксировано,Исключено,Несогласовано", 0, 0, 0, 0);
	Попытка
		Настройки = Cutter3000_ЗаданияСервер.НастройкиОбфускацииЗапуска(Запуск);
		Настройки.Вставить("СловарьИмен", Cutter3000_ИменаПерсонажей.СловарьПерсонажей());
		Настройки.Вставить("ЗанятыеИмена", СохраненныеИменаИсключений(Настройки));
		Настройки.Вставить("КэшСущностей", Новый Соответствие);
		Настройки.Вставить("СловарьОрганизаций", Новый Массив);
		Пока Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Цикл
			Источник = Cutter3000_ЗаданияСервер.ВзятьИсточникОбфускации(Запуск, Работник);
			Если Источник = Неопределено Тогда
				Прервать;
			КонецЕсли;
			ПрочитаноДо = Счетчики.Прочитано;
			ЗафиксированоДо = Счетчики.Зафиксировано;
			ИсключеноДо = Счетчики.Исключено;
			НесогласованоДо = Счетчики.Несогласовано;
			ЗавершенИсточник = Истина;
			Попытка
				ОбработатьИсточник(Запуск, Работник, Источник, Настройки, Счетчики);
			Исключение
				ЗавершенИсточник = Ложь;
				Если Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Тогда
					Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, Работник,
						"Источник пропущен: чтение или адаптер недоступны.", Источник.Имя);
				КонецЕсли;
			КонецПопытки;
			Если Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Тогда
				Cutter3000_ЗаданияСервер.ИтогИсточникаОбфускации(Запуск, Работник, Источник.Имя,
					Новый Структура("Прочитано,Зафиксировано,Исключено,Несогласовано",
						Счетчики.Прочитано - ПрочитаноДо, Счетчики.Зафиксировано - ЗафиксированоДо,
						Счетчики.Исключено - ИсключеноДо, Счетчики.Несогласовано - НесогласованоДо), ЗавершенИсточник);
			КонецЕсли;
		КонецЦикла;
		Cutter3000_ЗаданияСервер.ПрогрессОбфускации(Запуск, Работник,
			"Обфускация источников завершена", Счетчики, Истина);
	Исключение
		Если Не Cutter3000_ЗаданияСервер.ОстановкаЗапрошена(Запуск) Тогда
			Cutter3000_ЗаданияСервер.ЗаписатьОшибкуОбфускации(Запуск, Работник, "Работник обфускации прерван.");
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Детерминированное преобразование. Исходное значение используется только для типа/пустоты.
// Параметры:
//  Категория - Строка - категория преобразования.
//  Ключ - Строка - технический ключ сущности.
//  Исходное - Строка, Число, Дата - значение только для типа и пустоты.
//  ОписаниеТипа - ОписаниеТипов - ограничения выбранного поля.
//  Запуск - Строка - соль запуска.
// Возвращаемое значение:
//  Строка, Число, Дата - синтетическое значение того же типа.
//  Настройки - Структура, Неопределено - необязательный кэш словаря организаций работника.
Функция СинтетическоеЗначение(Категория, Ключ, Исходное, ОписаниеТипа, Запуск, Настройки = Неопределено) Экспорт
	Перем ОрганизацииСловаря;

	Если Не ЗначениеЗаполнено(Исходное) Тогда
		Возврат Исходное;
	КонецЕсли;
	Если Категория = "Персонаж" Тогда
		Возврат Cutter3000_ИменаПерсонажей.ИмяСущности(Запуск, Ключ, ОписаниеТипа.КвалификаторыСтроки.Длина);
	КонецЕсли;
	Номер = ЧисловойОтпечаток(Запуск + Ключ);
	Если Категория = "Организация" Тогда
		Если ТипЗнч(Исходное) <> Тип("Строка") Тогда
			ВызватьИсключение "Категория «Организация» подходит только для строкового поля.";
		КонецЕсли;
		Если Настройки = Неопределено Тогда
			ОрганизацииСловаря = Cutter3000_ИменаПерсонажей.СловарьОрганизаций();
		Иначе
			ОрганизацииСловаря = Настройки.СловарьОрганизаций;
		КонецЕсли;
		Возврат Cutter3000_ИменаПерсонажей.НазваниеОрганизации(Номер, Исходное,
			ОписаниеТипа.КвалификаторыСтроки.Длина, ОрганизацииСловаря);
	КонецЕсли;
	Если Категория = "Дата рождения" Тогда
		Возврат Дата(1980 + Номер % 20, 1 + Номер % 12, 1 + Номер % 28);
	КонецЕсли;
	Цифры = ДополнитьЦифрами(Номер, 9);
	Если Категория = "Телефон" Тогда
		Новое = "000" + Цифры;
	ИначеЕсли Категория = "Почта" Тогда
		Новое = "person" + Цифры + "@example.invalid";
	ИначеЕсли Категория = "Адрес" Тогда
		Новое = "Учебный город, улица Персонажей, дом " + Цифры;
	ИначеЕсли Категория = "ИНН" Тогда
		Новое = СинтетическийИНН(Цифры, ОписаниеТипа);
	ИначеЕсли Категория = "СНИЛС" Тогда
		Основа = "000" + Прав(Цифры, 6);
		Сумма = 0;
		Для Индекс = 1 По 9 Цикл
			Сумма = Сумма + Число(Сред(Основа, Индекс, 1)) * (10 - Индекс);
		КонецЦикла;
		Сумма = Сумма % 101;
		Если Сумма = 100 Тогда
			Сумма = 0;
		КонецЕсли;
		Новое = Основа + ДополнитьЦифрами(Сумма, 2);
	ИначеЕсли Категория = "Документ" Тогда
		Новое = "0000" + Прав(Цифры, 6);
	ИначеЕсли Категория = "Очистить текст" Тогда
		Новое = "Обезличено " + Цифры;
	Иначе
		ВызватьИсключение "Неизвестная категория преобразования.";
	КонецЕсли;
	Если ТипЗнч(Исходное) = Тип("Число") Тогда
		ЧисловоеЗначение = Число(Новое);
		Если ОписаниеТипа.ПривестиЗначение(ЧисловоеЗначение) <> ЧисловоеЗначение Тогда
			ВызватьИсключение "Числовое поле не вмещает синтетическое значение без изменения разрядности.";
		КонецЕсли;
		Возврат ЧисловоеЗначение;
	КонецЕсли;
	Длина = ОписаниеТипа.КвалификаторыСтроки.Длина;
	Если Длина > 0 И СтрДлина(Новое) > Длина Тогда
		Если Категория = "Очистить текст" Тогда
			Если Длина < 6 Тогда
				ВызватьИсключение "Длины поля недостаточно для уникального синтетического значения.";
			КонецЕсли;
			Новое = Лев(Новое, Длина - 6) + Прав(Цифры, 6);
		Иначе
			ВызватьИсключение "Длины поля недостаточно для формата синтетического значения.";
		КонецЕсли;
	КонецЕсли;
	Возврат Новое;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьАдминистратора()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение "Для обфускации требуются административные права.";
	КонецЕсли;
	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если ОбщийРеквизит.РазделениеДанных <>
			Метаданные.СвойстваОбъектов.РазделениеДанныхОбщегоРеквизита.НеИспользовать Тогда
			ВызватьИсключение "Обфускация базы с разделением данных требует отдельного адаптера областей.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КаталогИсточников()

	Каталог = Новый Массив;
	ДобавитьОбъекты(Каталог, Метаданные.Справочники);
	ДобавитьОбъекты(Каталог, Метаданные.Документы);
	ДобавитьОбъекты(Каталог, Метаданные.ПланыВидовХарактеристик);
	ДобавитьОбъекты(Каталог, Метаданные.ПланыСчетов);
	ДобавитьОбъекты(Каталог, Метаданные.ПланыВидовРасчета);
	ДобавитьОбъекты(Каталог, Метаданные.ПланыОбмена);
	ДобавитьОбъекты(Каталог, Метаданные.БизнесПроцессы);
	ДобавитьОбъекты(Каталог, Метаданные.Задачи);
	ДобавитьРегистрыОбфускации(Каталог, Метаданные.РегистрыСведений);
	ДобавитьРегистрыОбфускации(Каталог, Метаданные.РегистрыНакопления);
	ДобавитьРегистрыОбфускации(Каталог, Метаданные.РегистрыБухгалтерии);
	ДобавитьРегистрыОбфускации(Каталог, Метаданные.РегистрыРасчета);
	Для Каждого Описание Из Метаданные.Константы Цикл
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Часть,Описание",
			Описание.ПолноеИмя(), Описание.ПолноеИмя(), "Константа", "", Описание));
	КонецЦикла;
	Возврат Каталог;

КонецФункции

Процедура ДобавитьОбъекты(Каталог, Коллекция)

	Для Каждого Описание Из Коллекция Цикл
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Часть,Описание",
			Описание.ПолноеИмя(), Описание.ПолноеИмя(), "Объект", "", Описание));
		Для Каждого Часть Из Описание.ТабличныеЧасти Цикл
			Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Часть,Описание",
				Описание.ПолноеИмя() + "." + Часть.Имя, Описание.ПолноеИмя(), "Объект", Часть.Имя, Описание));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРегистрыОбфускации(Каталог, Коллекция)

	Для Каждого Описание Из Коллекция Цикл
		Если СтрНачинаетсяС(Описание.Имя, "Cutter3000_") Тогда
			Продолжить;
		КонецЕсли;
		Каталог.Добавить(Новый Структура("Имя,Корень,Вид,Часть,Описание",
			Описание.ПолноеИмя(), Описание.ПолноеИмя(), "Регистр", "", Описание));
	КонецЦикла;

КонецПроцедуры

Функция ПоляИсточника(Источник)

	Поля = Новый Массив;
	Описание = Источник.Описание;
	Если Источник.Вид = "Константа" Тогда
		Поля.Добавить(Новый Структура("Имя,Синоним,Тип", "Значение", Описание.Синоним, Описание.Тип));
	ИначеЕсли Источник.Часть <> "" Тогда
		Для Каждого Поле Из Описание.ТабличныеЧасти[Источник.Часть].Реквизиты Цикл
			Поля.Добавить(Поле);
		КонецЦикла;
	Иначе
		Если Источник.Вид = "Объект" Тогда
			Для Каждого Поле Из Описание.СтандартныеРеквизиты Цикл
				Если Поле.Имя = "Наименование" Тогда
					Поля.Добавить(Поле);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для Каждого Поле Из Описание.Измерения Цикл
				Поля.Добавить(Поле);
			КонецЦикла;
			Для Каждого Поле Из Описание.Ресурсы Цикл
				Поля.Добавить(Поле);
			КонецЦикла;
		КонецЕсли;
		Для Каждого Поле Из Описание.Реквизиты Цикл
			Поля.Добавить(Поле);
		КонецЦикла;
	КонецЕсли;
	Возврат Поля;

КонецФункции

Функция КатегорияПоля(Описание, Поле)
	Перем НазваниеОбъекта;

	Текст = НРег(Поле.Имя + " " + Поле.Синоним);
	НазваниеОбъекта = НРег(Описание.Имя);
	Если Поле.Тип.СодержитТип(Тип("Строка")) Тогда
		Если СтрНайти(Текст, "наименованиеорганизац") > 0 Или СтрНайти(Текст, "названиеорганизац") > 0
			Или ((СтрНайти(Текст, "наименование") > 0 Или СтрНайти(Текст, "название") > 0)
				И (СтрНайти(НазваниеОбъекта, "организац") > 0 Или СтрНайти(НазваниеОбъекта, "юридическиелица") > 0)) Тогда
			Возврат "Организация";
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(Текст, "снилс") > 0 Тогда
		Возврат "СНИЛС";
	ИначеЕсли Поле.Имя = "ИНН" Тогда
		Возврат "ИНН";
	ИначеЕсли СтрНайти(Текст, "телефон") > 0 Тогда
		Возврат "Телефон";
	ИначеЕсли СтрНайти(Текст, "почт") > 0 Или СтрНайти(Текст, "email") > 0 Тогда
		Возврат "Почта";
	ИначеЕсли СтрНайти(Текст, "адрес") > 0 Тогда
		Возврат "Адрес";
	ИначеЕсли СтрНайти(Текст, "рожден") > 0 Тогда
		Возврат "Дата рождения";
	ИначеЕсли СтрНайти(Текст, "паспорт") > 0 Или СтрНайти(Текст, "удостоверен") > 0 Тогда
		Возврат "Документ";
	ИначеЕсли СтрНайти(Текст, "фамил") > 0 Или СтрНайти(Текст, "отчеств") > 0
		Или СтрНайти(Текст, "фио") > 0 Или Поле.Имя = "Имя" Тогда
		Возврат "Персонаж";
	ИначеЕсли Поле.Имя = "Наименование" Тогда
		ИмяОбъекта = НРег(Описание.Имя);
		Если СтрНайти(ИмяОбъекта, "физическ") > 0 Или СтрНайти(ИмяОбъекта, "сотрудник") > 0
			Или СтрНайти(ИмяОбъекта, "контактныелиц") > 0 Или СтрНайти(ИмяОбъекта, "пользовател") > 0 Тогда
			Возврат "Персонаж";
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПоддержанТип(ОписаниеТипа)

	Типы = ОписаниеТипа.Типы();
	Если Типы.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Типы[0] = Тип("Строка") Или Типы[0] = Тип("Дата") Или Типы[0] = Тип("Число");

КонецФункции

Функция СсылкаНаСправочник(ОписаниеТипа)

	Типы = ОписаниеТипа.Типы();
	Если Типы.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Описание = Метаданные.НайтиПоТипу(Типы[0]);
	Возврат Описание <> Неопределено И СтрНачинаетсяС(Описание.ПолноеИмя(), "Справочник.");

КонецФункции

Функция ПроверитьСвязиСущностей(Настройки, Каталог)

	Результат = Новый Массив;
	Связи = Новый Массив;
	Настройки.Свойство("СвязиСущностей", Связи);
	Учтенные = Новый Соответствие;
	Для Каждого Связь Из Связи Цикл
		Если Не Связь.Подтверждено Тогда
			Продолжить;
		КонецЕсли;
		Источник = НайтиИсточник(Каталог, Связь.Источник);
		Поле = НайтиПоле(Источник, Связь.Поле);
		Если Поле = Неопределено Или Не СсылкаНаСправочник(Поле.Тип) Тогда
			ВызватьИсключение "Для представления нужна одна подтвержденная ссылка на справочник человека.";
		КонецЕсли;
		Если Учтенные.Получить(Источник.Имя) <> Неопределено Тогда
			ВызватьИсключение "Для одной таблицы указано несколько источников общего имени.";
		КонецЕсли;
		Учтенные.Вставить(Источник.Имя, Истина);
		Результат.Добавить(Новый Структура("Имя,Корень,Часть,Поле", Источник.Имя, Источник.Корень, Источник.Часть, Поле.Имя));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДополнитьЗащитуПоСвязям(Ссылки, Связи)

	ПредыдущееКоличество = -1;
	Запрос = Новый Запрос;
	Пока Ссылки.Количество() <> ПредыдущееКоличество Цикл
		ПредыдущееКоличество = Ссылки.Количество();
		Для Каждого Связь Из Связи Цикл
			Если Не СтрНачинаетсяС(Связь.Корень, "Справочник.") Или Связь.Часть <> "" Тогда
				Продолжить;
			КонецЕсли;
			Запрос.Текст = "ВЫБРАТЬ " + Связь.Поле + " КАК Ссылка ИЗ " + Связь.Корень
				+ " ГДЕ Ссылка В (&Защищенные)";
			Запрос.УстановитьПараметр("Защищенные", Ссылки);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Ссылка) И Ссылки.Найти(Выборка.Ссылка) = Неопределено Тогда
					Ссылки.Добавить(Выборка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КлючСущностиСтроки(СтрокаДанных, ИмяПоля, ЗапаснойКлюч)

	Если ИмяПоля <> Неопределено И ИмяПоля <> "" И ЗначениеЗаполнено(СтрокаДанных[ИмяПоля]) Тогда
		Возврат Строка(СтрокаДанных[ИмяПоля].УникальныйИдентификатор());
	КонецЕсли;
	Возврат ЗапаснойКлюч;

КонецФункции

Функция НепрозрачныйТип(ОписаниеТипа)

	Для Каждого ТипПоля Из ОписаниеТипа.Типы() Цикл
		Если ТипПоля = Тип("ХранилищеЗначения") Или ТипПоля = Тип("ТабличныйДокумент")
			Или ТипПоля = Тип("ДвоичныеДанные") Или ТипПоля = Тип("Картинка")
			Или СтрНайти(Строка(ТипПоля), "КомпоновкиДанных") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

