
#Область ПрограммныйИнтерфейс
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Подтверждает полный охват до изменения прикладных данных.
// Параметры:
//  Каталог - Массив из Структура - описания прикладных таблиц Cutter3000.
//  Запуск - Строка - идентификатор запуска либо пустая строка для отдельной проверки.
//  Публиковать - Булево - координатор сохраняет модель до запуска работников.
// Возвращаемое значение:
//  Структура, Неопределено - модель областей БСП либо отсутствие активного разделения.
//   Модель содержит серверный модуль БСП и не передаётся между сеансами целиком.
Функция ПодготовитьМодель(Каталог, Запуск = "", Публиковать = Ложь) Экспорт

	Разделители = Новый Массив;
	Для Каждого Реквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если Реквизит.РазделениеДанных =
			Метаданные.СвойстваОбъектов.РазделениеДанныхОбщегоРеквизита.НеИспользовать Тогда
			Продолжить;
		КонецЕсли;
		Если Не УсловиеВключено(Реквизит.УсловноеРазделение) Тогда
			Продолжить;
		КонецЕсли;
		Разделители.Добавить(Реквизит);
	КонецЦикла;
	Если Разделители.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Модель областей необходимо подготовить до начала транзакции удаления.";
	КонецЕсли;
	ПроверитьПолныеПраваОбластей();
	Основной = Метаданные.ОбщиеРеквизиты.Найти("ОбластьДанныхОсновныеДанные");
	Вспомогательный = Метаданные.ОбщиеРеквизиты.Найти("ОбластьДанныхВспомогательныеДанные");
	Реестр = Метаданные.РегистрыСведений.Найти("ОбластиДанных");
	Если Основной = Неопределено Или Вспомогательный = Неопределено Или Реестр = Неопределено
		Или Метаданные.ОбщиеМодули.Найти("РаботаВМоделиСервиса") = Неопределено Тогда
		ВызватьИсключение "Полный реестр областей активного разделения не подтверждён. "
			+ "Поддерживается схема областей данных БСП. Прикладные данные не изменены.";
	КонецЕсли;
	Если Основной.ИспользованиеРазделяемыхДанных <>
		Метаданные.СвойстваОбъектов.ИспользованиеРазделяемыхДанныхОбщегоРеквизита.Независимо
		Или Вспомогательный.ИспользованиеРазделяемыхДанных <>
		Метаданные.СвойстваОбъектов.ИспользованиеРазделяемыхДанныхОбщегоРеквизита.НезависимоИСовместно Тогда
		ВызватьИсключение "Режимы разделителей отличаются от поддерживаемой схемы БСП.";
	КонецЕсли;
	Если Основной.ЗначениеРазделенияДанных = Неопределено
		Или Основной.ИспользованиеРазделенияДанных = Неопределено Тогда
		ВызватьИсключение "У разделителя БСП не определены параметры сеанса.";
	КонецЕсли;
	Модель = Новый Структура("ПараметрЗначения,ПараметрИспользования,Таблицы,Области,МодульБСП",
		Основной.ЗначениеРазделенияДанных.Имя, Основной.ИспользованиеРазделенияДанных.Имя,
		Новый Соответствие, Новый Массив, Неопределено);
	ПрикладнаяОбласть = Неопределено;
	Если ПараметрыСеанса[Модель.ПараметрИспользования] Тогда
		ПрикладнаяОбласть = ПараметрыСеанса[Модель.ПараметрЗначения];
	КонецЕсли;
	Модель.Вставить("ПрикладнаяОбласть", ПрикладнаяОбласть);
	Для Каждого Реквизит Из Разделители Цикл
		Если (Реквизит <> Основной И Реквизит <> Вспомогательный)
			Или Реквизит.ЗначениеРазделенияДанных <> Основной.ЗначениеРазделенияДанных
			Или Реквизит.ИспользованиеРазделенияДанных <> Основной.ИспользованиеРазделенияДанных Тогда
			ВызватьИсключение "Не подтверждена дополнительная схема разделения: " + Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	СхемыРазделителей = ПодготовитьСоставыРазделителей(Разделители, Основной);
	Для Каждого Таблица Из Каталог Цикл
		Если Модель.Таблицы.Получить(Таблица.Корень) = Неопределено Тогда
			Модель.Таблицы.Вставить(Таблица.Корень, СхемаОбъекта(Таблица.Описание, СхемыРазделителей));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Описание Из Метаданные.Константы Цикл
		Модель.Таблицы.Вставить(Описание.ПолноеИмя(), СхемаОбъекта(Описание, СхемыРазделителей));
	КонецЦикла;
	СхемаРеестра = СхемаОбъекта(Реестр, СхемыРазделителей);
	Если СхемаРеестра.Независимая Или СхемаРеестра.Разделители.Найти(Вспомогательный.Имя) = Неопределено
		Или Реестр.Измерения.Количество() <> 0 Тогда
		ВызватьИсключение "Реестр областей БСП не соответствует поддерживаемой схеме.";
	КонецЕсли;
	ПроверитьСлужебныеРегистры(СхемыРазделителей);
	ОписаниеМодели = ОписаниеМоделиДляРаботника(Модель);
	СохраненнаяМодель = Неопределено;
	Если Запуск <> "" И Не Публиковать Тогда
		СохраненнаяМодель = ПрочитатьМодельЗапуска(Запуск);
		Если СохраненнаяМодель.Схема <> ОписаниеМодели.Схема Тогда
			ВызватьИсключение "Схема разделения работника отличается от модели координатора. Удаление не начато.";
		КонецЕсли;
	КонецЕсли;
	// Необязательный модуль нельзя связать статически в конфигурации без БСП.
	// Выражение фиксированное; входные данные не участвуют, вычисляется один раз на контекст.
	Модель.МодульБСП = Вычислить("РаботаВМоделиСервиса");
	Если СохраненнаяМодель = Неопределено Тогда
		Модель.Области = ПрочитатьРеестрОбластей(Модель);
	Иначе
		Модель.Области = СохраненнаяМодель.Области;
	КонецЕсли;
	ПроверитьЗначенияОбластей(Модель.Области);
	// Возможность переключения подтверждается до публикации модели и первого удаления.
	ПроверитьПереключениеОбластей(Модель);
	Если Запуск <> "" И Публиковать Тогда
		ОписаниеМодели.Области = Модель.Области;
		СохранитьМодельЗапуска(Запуск, ОписаниеМодели);
	КонецЕсли;
	Возврат Модель;

КонецФункции

// Создаёт описания чтения областей без копирования прикладных данных.
// Параметры:
//  Каталог - Массив из Структура - исходные описания.
//  Модель - Структура, Неопределено - подтверждённые области.
// Возвращаемое значение:
//  Массив из Структура - каталог с отдельными курсорами областей.
Функция КаталогОбластей(Каталог, Модель) Экспорт

	Результат = Новый Массив;
	Для Каждого Таблица Из Каталог Цикл
		Таблица.Вставить("Источник", Таблица.Имя);
		Если Модель = Неопределено Тогда
			Результат.Добавить(Таблица);
			Продолжить;
		КонецЕсли;
		Схема = Модель.Таблицы[Таблица.Корень];
		Если Схема.Разделители.Количество() = 0 Тогда
			Таблица.Вставить("МодельРазделения", Модель);
			Таблица.Вставить("Область", Неопределено);
			Результат.Добавить(Таблица);
			Продолжить;
		КонецЕсли;
		Для Каждого Область Из Модель.Области Цикл
			Копия = Новый Структура;
			Для Каждого Поле Из Таблица Цикл
				Копия.Вставить(Поле.Ключ, Поле.Значение);
			КонецЦикла;
			Копия.Вставить("МодельРазделения", Модель);
			Копия.Вставить("Область", Область);
			Копия.Имя = Таблица.Имя + "@" + Формат(Область, "ЧГ=0");
			Результат.Добавить(Копия);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Выполняет чистый запрос в области описания и возвращает исходные параметры.
// Параметры:
//  Запрос - Запрос - подготовленный запрос текущей страницы.
//  Таблица - Структура - описание с источником и, при разделении, областью.
//  Пакет - Булево - выполнить пакет запросов.
// Возвращаемое значение:
//  РезультатЗапроса, Массив из РезультатЗапроса - результат запроса либо пакета.
Функция ВыполнитьЗапросТаблицы(Запрос, Таблица, Пакет = Ложь) Экспорт

	Если Не Таблица.Свойство("МодельРазделения") Тогда
		Если Пакет Тогда
			Возврат Запрос.ВыполнитьПакет();
		КонецЕсли;
		Возврат Запрос.Выполнить();
	КонецЕсли;
	Модель = Таблица.МодельРазделения;
	Сохраненный = СохранитьКонтекст(Модель);
	Попытка
		УстановитьКонтекст(Модель, Таблица.Область);
		Если Пакет Тогда
			Результат = Запрос.ВыполнитьПакет();
		Иначе
			Результат = Запрос.Выполнить();
		КонецЕсли;
	Исключение
		Если Не ТранзакцияАктивна() Тогда
			ВосстановитьКонтекст(Модель, Сохраненный);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьКонтекст(Модель, Сохраненный);
	Возврат Результат;

КонецФункции

// Сохраняет параметры разделения без изменения сеанса.
// Параметры:
//  Модель - Структура - подтверждённая модель.
// Возвращаемое значение:
//  Структура - исходные значения параметров сеанса.
Функция СохранитьКонтекст(Модель) Экспорт

	Возврат Новый Структура("Использование,Значение",
		ПараметрыСеанса[Модель.ПараметрИспользования], ПараметрыСеанса[Модель.ПараметрЗначения]);

КонецФункции

// Устанавливает область на время операции; общий контекст передаётся как Неопределено.
// Параметры:
//  Модель - Структура - подтверждённая модель.
//  Область - Число, Неопределено - область либо общий контекст.
//  Прикладной - Булево - актуализировать прикладные параметры БСП.
Процедура УстановитьКонтекст(Модель, Область, Прикладной = Ложь) Экспорт

	Использование = Область <> Неопределено;
	ЗначениеОбласти = 0;
	Если Использование Тогда
		ЗначениеОбласти = Область;
	КонецЕсли;
	Если ПараметрыСеанса[Модель.ПараметрИспользования] <> Использование
		Или ПараметрыСеанса[Модель.ПараметрЗначения] <> ЗначениеОбласти Тогда
		ПараметрыСеанса[Модель.ПараметрИспользования] = Ложь;
		ПараметрыСеанса[Модель.ПараметрЗначения] = ЗначениеОбласти;
		ПараметрыСеанса[Модель.ПараметрИспользования] = Использование;
	КонецЕсли;
	// Чистые запросы и блокировки меняют только разделители, не прикладной кеш сеанса.
	Если Прикладной И Модель.ПрикладнаяОбласть <> Область Тогда
		// Обработчик БСП может изменить часть параметров и затем отказать.
		Модель.ПрикладнаяОбласть = "НеПодтверждена";
		Модель.МодульБСП.ПриИзмененииОбластиДанных();
		Модель.ПрикладнаяОбласть = Область;
	КонецЕсли;

КонецПроцедуры

// Восстанавливает исходные параметры после операции.
// Параметры:
//  Модель - Структура - подтверждённая модель.
//  Сохраненный - Структура - параметры до операции.
//  Прикладной - Булево - актуализировать прикладные параметры БСП.
Процедура ВосстановитьКонтекст(Модель, Сохраненный, Прикладной = Ложь) Экспорт

	ПараметрыСеанса[Модель.ПараметрИспользования] = Ложь;
	ПараметрыСеанса[Модель.ПараметрЗначения] = Сохраненный.Значение;
	ПараметрыСеанса[Модель.ПараметрИспользования] = Сохраненный.Использование;
	Если Прикладной Тогда
		Область = Неопределено;
		Если Сохраненный.Использование Тогда
			Область = Сохраненный.Значение;
		КонецЕсли;
		Если Модель.ПрикладнаяОбласть <> Область Тогда
			Модель.ПрикладнаяОбласть = "НеПодтверждена";
			Модель.МодульБСП.ПриИзмененииОбластиДанных();
			Модель.ПрикладнаяОбласть = Область;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Дополняет идентичность независимой ссылки областью.
// Параметры:
//  Модель - Структура - подтверждённая модель.
//  ОписаниеКлюча - Структура - кодированная ссылка; изменяется на месте.
//  Область - Число, Неопределено - контекст владельца ссылки.
Процедура КвалифицироватьСсылку(Модель, ОписаниеКлюча, Область) Экспорт

	Схема = Модель.Таблицы.Получить(ОписаниеКлюча.Метаданные);
	Если Схема = Неопределено Тогда
		ВызватьИсключение "Не подготовлена схема разделения типа ссылки: " + ОписаниеКлюча.Метаданные;
	КонецЕсли;
	Если Не Схема.Независимая Тогда
		Возврат;
	КонецЕсли;
	Если Область = Неопределено Тогда
		ВызватьИсключение "Не определена область независимой ссылки: " + ОписаниеКлюча.Метаданные;
	КонецЕсли;
	ОписаниеКлюча.Вставить("Область", Область);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПолныеПраваОбластей()

	// Чистое чтение меняет разделители без авторизации на каждой странице.
	// Поэтому частичный доступ и RLS не допускаются для охвата всех областей.
	ПолныеПрава = Метаданные.Роли.Найти("ПолныеПрава");
	Допущен = ПравоДоступа("Администрирование", Метаданные);
	Если Допущен Тогда
		Допущен = ПолныеПрава <> Неопределено И РольДоступна(ПолныеПрава);
		Если Не Допущен Тогда
			// В базе без пользователей платформа предоставляет все права, но РольДоступна возвращает Ложь.
			Допущен = ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() = 0;
		КонецЕсли;
	КонецЕсли;
	Если Не Допущен Тогда
		ВызватьИсключение "Обрезка всех областей требует роли ПолныеПрава и права администрирования "
			+ "информационной базы. Частичный доступ по областям не поддерживается. Прикладные данные не изменены.";
	КонецЕсли;

КонецПроцедуры

Функция ОписаниеМоделиДляРаботника(Модель)

	Схема = Новый Структура("ПараметрЗначения,ПараметрИспользования,Таблицы",
		Модель.ПараметрЗначения, Модель.ПараметрИспользования, Модель.Таблицы);
	Возврат Новый Структура("Версия,Схема,Области", 1, ЗначениеВСтрокуВнутр(Схема), Новый Массив);

КонецФункции

Процедура ПроверитьСлужебныеРегистры(СхемыРазделителей)

	Для Каждого Имя Из СтрРазделить("Cutter3000_Задания,Cutter3000_План,Cutter3000_Узлы,"
		+ "Cutter3000_Связи,Cutter3000_Ошибки,Cutter3000_Пакеты,Cutter3000_Очередь,Cutter3000_Управление", ",") Цикл
		Схема = СхемаОбъекта(Метаданные.РегистрыСведений[Имя], СхемыРазделителей);
		Если Схема.Разделители.Количество() > 0 Тогда
			ВызватьИсключение "Служебный регистр Cutter3000 не должен входить в разделение: " + Имя;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьРеестрОбластей(Модель)

	Результат = Новый Массив;
	Сохраненный = СохранитьКонтекст(Модель);
	Попытка
		УстановитьКонтекст(Модель, Неопределено);
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Реестр.ОбластьДанныхВспомогательныеДанные КАК Область
			|ИЗ РегистрСведений.ОбластиДанных КАК Реестр УПОРЯДОЧИТЬ ПО Область");
		Строки = Запрос.Выполнить().Выбрать();
		Пока Строки.Следующий() Цикл
			Результат.Добавить(Строки.Область);
		КонецЦикла;
	Исключение
		ВосстановитьКонтекст(Модель, Сохраненный);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьКонтекст(Модель, Сохраненный);
	Возврат Результат;

КонецФункции

Процедура ПроверитьЗначенияОбластей(Области)

	Если ТипЗнч(Области) <> Тип("Массив") Тогда
		ВызватьИсключение "Модель запуска не содержит списка областей.";
	КонецЕсли;
	Предыдущая = 0;
	Для Каждого Область Из Области Цикл
		Если ТипЗнч(Область) <> Тип("Число") Или Область <= Предыдущая Или Область <> Цел(Область) Тогда
			ВызватьИсключение "В реестре БСП обнаружено недопустимое или повторяющееся значение области данных.";
		КонецЕсли;
		Предыдущая = Область;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПереключениеОбластей(Модель)

	Сохраненный = СохранитьКонтекст(Модель);
	Попытка
		Для Каждого Область Из Модель.Области Цикл
			УстановитьКонтекст(Модель, Область);
		КонецЦикла;
		УстановитьКонтекст(Модель, Неопределено);
	Исключение
		ВосстановитьКонтекст(Модель, Сохраненный);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьКонтекст(Модель, Сохраненный);

КонецПроцедуры

Функция ПрочитатьМодельЗапуска(Запуск)

	Запись = РегистрыСведений.Cutter3000_Управление.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Работник = "Области";
	Запись.Прочитать();
	Если Не Запись.Выбран() Или Запись.Состояние <> "Готова" Тогда
		ВызватьИсключение "Координатор не подготовил модель областей запуска.";
	КонецЕсли;
	Модель = Запись.Данные.Получить();
	Версия = Неопределено;
	Если ТипЗнч(Модель) <> Тип("Структура") Или Не Модель.Свойство("Версия", Версия) Или Версия <> 1 Тогда
		ВызватьИсключение "Не поддерживается формат модели областей запуска.";
	КонецЕсли;
	Если Не Модель.Свойство("Области") Или Не Модель.Свойство("Схема") Тогда
		ВызватьИсключение "Повреждено описание областей запуска.";
	КонецЕсли;
	Возврат Модель;

КонецФункции

Процедура СохранитьМодельЗапуска(Запуск, Модель)

	Запись = РегистрыСведений.Cutter3000_Управление.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Работник = "Области";
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		ВызватьИсключение "Модель областей уже сохранена для этого запуска.";
	КонецЕсли;
	// Чтение отсутствующей записи сбрасывает ключ менеджера записи.
	Запись.Запуск = Запуск;
	Запись.Работник = "Области";
	Запись.Состояние = "Готова";
	Запись.Данные = Новый ХранилищеЗначения(Модель);
	Запись.Записать();

КонецПроцедуры

Функция УсловиеВключено(Знач Условие)

	Если Условие = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Условие) = Тип("Булево") Тогда
		Возврат Условие;
	КонецЕсли;
	Если Метаданные.Константы.Найти(Условие.Имя) <> Условие Тогда
		ВызватьИсключение "Условное разделение не задано константой конфигурации.";
	КонецЕсли;
	ЗначениеУсловия = Константы[Условие.Имя].Получить();
	Если ТипЗнч(ЗначениеУсловия) <> Тип("Булево") Тогда
		ВызватьИсключение "Константа условного разделения должна иметь тип Булево: " + Условие.Имя;
	КонецЕсли;
	Возврат ЗначениеУсловия;

КонецФункции

Функция ПодготовитьСоставыРазделителей(Разделители, Основной)

	Результат = Новый Массив;
	Условия = Новый Соответствие;
	Для Каждого Реквизит Из Разделители Цикл
		ПоУмолчанию = Реквизит.АвтоИспользование =
			Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
		Состав = Новый Соответствие;
		Для Каждого Элемент Из Реквизит.Состав Цикл
			Использование = ПоУмолчанию;
			Если Элемент.Использование <> Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто Тогда
				Использование = Элемент.Использование =
					Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать;
			КонецЕсли;
			Если Использование И Элемент.УсловноеРазделение <> Неопределено Тогда
				Условие = Элемент.УсловноеРазделение;
				Включено = Условия.Получить(Условие);
				Если Включено = Неопределено Тогда
					Включено = УсловиеВключено(Условие);
					Условия.Вставить(Условие, Включено);
				КонецЕсли;
				Использование = Включено;
			КонецЕсли;
			Состав.Вставить(Элемент.Метаданные.ПолноеИмя(), Использование);
		КонецЦикла;
		Результат.Добавить(Новый Структура("Имя,ПоУмолчанию,Состав,Независимый",
			Реквизит.Имя, ПоУмолчанию, Состав, Реквизит = Основной));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СхемаОбъекта(Описание, СхемыРазделителей)

	Результат = Новый Структура("Разделители,Независимая", Новый Массив, Ложь);
	Для Каждого Схема Из СхемыРазделителей Цикл
		Использование = Схема.Состав.Получить(Описание.ПолноеИмя());
		Если Использование = Неопределено Тогда
			Использование = Схема.ПоУмолчанию;
		КонецЕсли;
		Если Использование Тогда
			Результат.Разделители.Добавить(Схема.Имя);
			Результат.Независимая = Результат.Независимая Или Схема.Независимый;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
