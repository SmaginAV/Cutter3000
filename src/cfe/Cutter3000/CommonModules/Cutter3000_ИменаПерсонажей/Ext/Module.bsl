
#Область ПрограммныйИнтерфейс

// Читает встроенный словарь экранных названий и существительных без обращения к прикладным данным.
// Возвращаемое значение: Массив из Строка - разные названия для категории «Организация».
Функция СловарьОрганизаций() Экспорт
	Перем МакетСловаря, Названия, Название;
	МакетСловаря = Обработки.Cutter3000_ОбрезкаБазы.ПолучитьМакет("СловарьОрганизаций");
	Названия = Новый Массив;
	Для Каждого Название Из СтрРазделить(МакетСловаря.ПолучитьТекст(), Символы.ПС) Цикл
		Если СокрЛП(Название) <> "" Тогда
			Названия.Добавить(СокрЛП(Название));
		КонецЕсли;
	КонецЦикла;
	Возврат Названия;
КонецФункции

// Выбирает название по отпечатку запуска и технического ключа; исходное значение не сохраняется.
// Параметры:
//  Номер - Число - неотрицательный отпечаток соли и ключа.
//  Исходное - Строка - название, которое нельзя вернуть без изменения.
//  МаксимальнаяДлина - Число - 0 для неограниченной строки.
//  Словарь - Массив из Строка - встроенные названия.
// Возвращаемое значение: Строка - название с организационной формой и кавычками допустимой длины.
Функция НазваниеОрганизации(Номер, Исходное, МаксимальнаяДлина, Словарь) Экспорт
	Перем Количество, Смещение, Название, ИсходноеДляСравнения, ФормыОрганизаций, ФормаОрганизации;
	Количество = Словарь.Количество();
	ФормыОрганизаций = СтрРазделить("ООО|ЗАО|ОАО|АО|ПАО", "|");
	ФормаОрганизации = ФормыОрганизаций[Номер % ФормыОрганизаций.Количество()];
	ИсходноеДляСравнения = НРег(СокрЛП(Исходное));
	Для Смещение = 0 По Количество - 1 Цикл
		Название = СтрШаблон("%1 «%2»", ФормаОрганизации, Словарь[(Номер + Смещение) % Количество]);
		Если МаксимальнаяДлина > 0 И СтрДлина(Название) > МаксимальнаяДлина Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(Название) <> ИсходноеДляСравнения Тогда
			Возврат Название;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Словарь не содержит другого названия организации допустимой длины.";
КонецФункции

// Словарь компонентов вымышленных имен. В рабочем сеансе создается один раз и передается генератору.
// Возвращаемое значение: Структура - Имена и Фамилии (Массив), Дополнения (Массив).
Функция СловарьПерсонажей() Экспорт

	Имена = Новый Массив;
	Фамилии = Новый Массив;
	УчтенныеИмена = Новый Соответствие;
	УчтенныеФамилии = Новый Соответствие;
	Для Каждого СтрокаПерсонажа Из СтрРазделить(ПерсонажиФильмовИСериалов(), Символы.ПС) Цикл
		Части = СтрРазделить(СокрЛП(СтрокаПерсонажа), "|");
		Если Части.Количество() = 2 Тогда
			ДобавитьКомпонент(Имена, УчтенныеИмена, Части[0]);
			ДобавитьКомпонент(Фамилии, УчтенныеФамилии, Части[1]);
		КонецЕсли;
	КонецЦикла;
	Дополнения = СтрРазделить("Хогвартс|Шир|Гондор|Ривенделл|Рохан|Мордор|Нарния|Вестерос|Винтерфелл|Дорн"
		+ "|Браавос|Корусан|Татуин|Набу|Хот|Эндор|Мустафар|Алдераан|Мандалор|Беспин"
		+ "|Ваканда|Асгард|Готэм|Метрополис|Смолвиль|Криптон|Камар-Тадж|Ксандар|Зандара|Титан"
		+ "|Пандора|Арракис|Каладан|Гьеди-Прайм|Каэр-Морхен|Темерия|Редания|Скеллиге|Спрингфилд|Футурама"
		+ "|Дакбург|Зверополис|Монстрополис|Аренделл|Аграба|Атлантида|Земля-Ооо|Волшебный-лес|Кингслендинг|Хокинс"
		+ "|Старк-Тауэр|Гравити-Фолз|Сан-Франсокио|Кумандра|Мотунуи|Дальнее-Королевство|Остров-Берк|Город-Эмбер|Твин-Пикс|Сайлент-Хилл", "|");
	Возврат Новый Структура("Имена,Фамилии,Дополнения", Имена, Фамилии, Дополнения);

КонецФункции

// Перемешивает декартово произведение имен и фамилий без повторений до исчерпания словаря.
// Параметры:
//  Номер - Число - последовательный номер, начиная с 1.
//  Соль - Строка - UUID запуска.
//  МаксимальнаяДлина - Число - 0 для неограниченной строки.
//  Словарь - Структура - компоненты вымышленных имен.
// Возвращаемое значение: Строка - смешанное имя, при нехватке длины с уникальным техническим суффиксом.
Функция СмешанноеИмя(Номер, Соль, МаксимальнаяДлина, Словарь) Экспорт

	Вместимость = Словарь.Имена.Количество() * Словарь.Фамилии.Количество();
	Если Вместимость = 0 Или Номер < 1 Тогда
		ВызватьИсключение "Словарь персонажей пуст или номер имени некорректен.";
	КонецЕсли;
	Смещение = ОтпечатокЧислом(Соль + "Смещение") % Вместимость;
	Шаг = 1 + ОтпечатокЧислом(Соль + "Шаг") % (Вместимость - 1);
	Пока ОбщийДелитель(Шаг, Вместимость) <> 1 Цикл
		Шаг = Шаг + 1;
	КонецЦикла;
	Индекс = (((Номер - 1) % Вместимость) * Шаг + Смещение) % Вместимость;
	ИндексИмени = Индекс % Словарь.Имена.Количество();
	ИндексФамилии = Цел(Индекс / Словарь.Имена.Количество());
	Имя = Словарь.Имена[ИндексИмени] + " " + Словарь.Фамилии[ИндексФамилии];
	Группа = Цел((Номер - 1) / Вместимость);
	Если Группа > 0 И Группа <= Словарь.Дополнения.Количество() Тогда
		Имя = Имя + " из " + Словарь.Дополнения[Группа - 1];
	КонецЕсли;
	Если Группа > Словарь.Дополнения.Количество()
		Или (МаксимальнаяДлина > 0 И СтрДлина(Имя) > МаксимальнаяДлина) Тогда
		Суффикс = НомерВОсновании36(Номер);
		Если МаксимальнаяДлина > 0 Тогда
			Если МаксимальнаяДлина < СтрДлина(Суффикс) + 2 Тогда
				ВызватьИсключение "Поле слишком короткое для уникального вымышленного имени.";
			КонецЕсли;
			Имя = Лев(Имя, МаксимальнаяДлина - СтрДлина(Суффикс) - 1);
		КонецЕсли;
		Имя = СокрЛП(Имя) + " " + Суффикс;
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Создается единожды в транзакции допуска операции, до запуска работников.
// Параметры:
//  Запуск - Строка - UUID запуска.
Процедура ПодготовитьСчетчикИмен(Запуск) Экспорт

	Запись = ЗаписьИмен(Запуск, ХешСтроки("СчетчикИмен"));
	Если Не Запись.Выбран() Тогда
		Запись.Вид = "СчетчикИмен";
		Запись.Локатор = ЗначениеВСтрокуВнутр(Новый Структура("СледующийНомер", 1));
		Запись.Записать();
	КонецЕсли;

КонецПроцедуры

// Резервирует имя атомарно относительно других работников. Не принимает и не сохраняет исходное ФИО.
// Параметры:
//  Запуск - Строка - UUID запуска.
//  Ключ - Строка - технический ключ сущности, без исходного ФИО.
//  МаксимальнаяДлина - Число - 0 для неограниченной строки.
//  Словарь - Структура, Неопределено - компоненты имен, уже прочитанные работником.
//  ЗанятыеИмена - Соответствие, Неопределено - сохраненные имена исключений, только в памяти работника.
// Возвращаемое значение: Строка - ранее выданное или новое уникальное имя.
Функция ИмяСущности(Запуск, Ключ, МаксимальнаяДлина, Словарь = Неопределено, ЗанятыеИмена = Неопределено) Экспорт

	КлючСущности = ХешСтроки(Запуск + "|Сущность|" + Ключ);
	КлючВарианта = ХешСтроки("Вариант|" + КлючСущности + "|" + Формат(МаксимальнаяДлина, "ЧГ=0"));
	Вариант = ЗаписьИмен(Запуск, КлючВарианта);
	Если Вариант.Выбран() Тогда
		Данные = ЗначениеИзСтрокиВнутр(Вариант.Локатор);
		Возврат Данные.Имя;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		// Общий замок резервирования нельзя удерживать на время прикладной записи.
		ВызватьИсключение "Имя необходимо подготовить до начала прикладной транзакции.";
	КонецЕсли;
	Если Словарь = Неопределено Тогда
		Словарь = СловарьПерсонажей();
	КонецЕсли;
	НачатьТранзакцию(Cutter3000_ДанныеСервер.РежимБлокировок());
	Попытка
		ЗаблокироватьСчетчик(Запуск);
		Вариант = ЗаписьИмен(Запуск, КлючВарианта);
		Если Вариант.Выбран() Тогда
			Данные = ЗначениеИзСтрокиВнутр(Вариант.Локатор);
			Имя = Данные.Имя;
		Иначе
			Имя = ЗарезервироватьИмя(Запуск, КлючСущности, Вариант, МаксимальнаяДлина, Словарь, ЗанятыеИмена);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Имя;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗарезервироватьИмя(Запуск, КлючСущности, Вариант, МаксимальнаяДлина, Словарь, ЗанятыеИмена)

	Счетчик = ЗаписьИмен(Запуск, ХешСтроки("СчетчикИмен"));
	Если Не Счетчик.Выбран() Тогда
		ВызватьИсключение "Счетчик имен запуска не подготовлен.";
	КонецЕсли;
	СчетчикДанные = ЗначениеИзСтрокиВнутр(Счетчик.Локатор);
	Сущность = ЗаписьИмен(Запуск, КлючСущности);
	Если Сущность.Выбран() Тогда
		Данные = ЗначениеИзСтрокиВнутр(Сущность.Локатор);
		Номер = Данные.Номер;
	Иначе
		Номер = СчетчикДанные.СледующийНомер;
		СчетчикДанные.СледующийНомер = Номер + 1;
	КонецЕсли;
	Данные = ПодобратьСвободноеИмя(Запуск, КлючСущности, Номер, МаксимальнаяДлина, Словарь, СчетчикДанные, ЗанятыеИмена);
	Резерв = ЗаписьИмен(Запуск, ХешСтроки("Имя|" + НРег(Данные.Имя)));
	Резерв.Вид = "ПсевдонимИмя";
	Резерв.Локатор = ЗначениеВСтрокуВнутр(Данные);
	Резерв.Записать();
	Вариант.Вид = "ПсевдонимВариант";
	Вариант.Локатор = ЗначениеВСтрокуВнутр(Данные);
	Вариант.Записать();
	Если Не Сущность.Выбран() Тогда
		Сущность.Вид = "ПсевдонимСущность";
		Сущность.Локатор = ЗначениеВСтрокуВнутр(Данные);
		Сущность.Записать();
	КонецЕсли;
	Счетчик.Локатор = ЗначениеВСтрокуВнутр(СчетчикДанные);
	Счетчик.Записать();
	Возврат Данные.Имя;

КонецФункции

Функция ПодобратьСвободноеИмя(Запуск, КлючСущности, Знач Номер, МаксимальнаяДлина, Словарь, СчетчикДанные, ЗанятыеИмена)

	Для ПопыткаИмени = 1 По 256 Цикл
		Имя = СмешанноеИмя(Номер, Запуск, МаксимальнаяДлина, Словарь);
		Если ЗанятыеИмена <> Неопределено И ЗанятыеИмена.Получить(НРег(Имя)) <> Неопределено Тогда
			Номер = СчетчикДанные.СледующийНомер;
			СчетчикДанные.СледующийНомер = Номер + 1;
			Продолжить;
		КонецЕсли;
		Резерв = ЗаписьИмен(Запуск, ХешСтроки("Имя|" + НРег(Имя)));
		Если Не Резерв.Выбран() Тогда
			Возврат Новый Структура("Имя,Номер,КлючСущности", Имя, Номер, КлючСущности);
		КонецЕсли;
		ДанныеРезерва = ЗначениеИзСтрокиВнутр(Резерв.Локатор);
		Если ДанныеРезерва.КлючСущности = КлючСущности Тогда
			Возврат Новый Структура("Имя,Номер,КлючСущности", Имя, Номер, КлючСущности);
		КонецЕсли;
		Если ПопыткаИмени = 256 Тогда
			Прервать;
		КонецЕсли;
		Номер = СчетчикДанные.СледующийНомер;
		СчетчикДанные.СледующийНомер = Номер + 1;
	КонецЦикла;
	ВызватьИсключение "Не удалось подобрать свободное вымышленное имя заданной длины.";

КонецФункции

Функция ЗаписьИмен(Запуск, Узел)

	Запись = РегистрыСведений.Cutter3000_Узлы.СоздатьМенеджерЗаписи();
	Запись.Запуск = Запуск;
	Запись.Узел = Узел;
	Запись.Прочитать();
	Запись.Запуск = Запуск;
	Запись.Узел = Узел;
	Возврат Запись;

КонецФункции

Процедура ЗаблокироватьСчетчик(Запуск)

	КлючСчетчика = ХешСтроки("СчетчикИмен");
	Если Cutter3000_ДанныеСервер.РежимБлокировок() = РежимУправленияБлокировкойДанных.Автоматический Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Узел КАК Узел ИЗ РегистрСведений.Cutter3000_Узлы
			|ГДЕ Запуск = &Запуск И Узел = &Узел ДЛЯ ИЗМЕНЕНИЯ");
		Запрос.УстановитьПараметр("Запуск", Запуск);
		Запрос.УстановитьПараметр("Узел", КлючСчетчика);
		Запрос.Выполнить();
	Иначе
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Cutter3000_Узлы");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Запуск", Запуск);
		Элемент.УстановитьЗначение("Узел", КлючСчетчика);
		Блокировка.Заблокировать();
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКомпонент(Компоненты, Учтенные, Значение)

	Значение = СтрЗаменить(СокрЛП(Значение), " ", "-");
	Нормализованное = НРег(Значение);
	Если Значение <> "" И Учтенные.Получить(Нормализованное) = Неопределено Тогда
		Учтенные.Вставить(Нормализованное, Истина);
		Компоненты.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ХешСтроки(Текст)

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Текст);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма);

КонецФункции

Функция ОтпечатокЧислом(Текст)

	СтрокаХеша = ВРег(ХешСтроки(Текст));
	ЧисловойКод = 0;
	Для Индекс = 1 По 8 Цикл
		ЧисловойКод = ЧисловойКод * 16 + СтрНайти("0123456789ABCDEF", Сред(СтрокаХеша, Индекс, 1)) - 1;
	КонецЦикла;
	Возврат ЧисловойКод;

КонецФункции

Функция ОбщийДелитель(Знач Первое, Знач Второе)

	Пока Второе <> 0 Цикл
		Остаток = Первое % Второе;
		Первое = Второе;
		Второе = Остаток;
	КонецЦикла;
	Возврат Первое;

КонецФункции

Функция НомерВОсновании36(Знач Номер)

	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Результат = "";
	Пока Номер > 0 Цикл
		Результат = Сред(Алфавит, Номер % 36 + 1, 1) + Результат;
		Номер = Цел(Номер / 36);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена персонажей, а не имена актеров. Компоненты свободно перемешиваются между произведениями.
Функция ПерсонажиФильмовИСериалов()

	Возврат ПерсонажиЧасть1() + Символы.ПС
		+ ПерсонажиЧасть2() + Символы.ПС
		+ ПерсонажиЧасть3() + Символы.ПС
		+ ПерсонажиЧасть4() + Символы.ПС
		+ ПерсонажиЧасть5();

КонецФункции

Функция ПерсонажиЧасть1()

	Возврат "Гарри|Поттер
		|Гермиона|Грейнджер
		|Рон|Уизли
		|Джинни|Уизли
		|Фред|Уизли
		|Джордж|Уизли
		|Перси|Уизли
		|Артур|Уизли
		|Молли|Уизли
		|Невилл|Долгопупс
		|Полумна|Лавгуд
		|Драко|Малфой
		|Люциус|Малфой
		|Нарцисса|Малфой
		|Сириус|Блэк
		|Ремус|Люпин
