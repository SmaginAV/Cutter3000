#Область ОписаниеПеременных

&НаКлиенте
Перем СкрытаяПозицияПравил;

&НаКлиенте
Перем ПозицияВместоСкрытой;

&НаКлиенте
Перем ПозицииТаблицВыбора;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем Предложения, Категория;
	Предложения = Cutter3000_ОбфускацияСервер.ПредложитьНастройки();
	ЗаполнитьСтрокиНастроек(Правила, Предложения.Правила);
	УпорядочитьПравилаНаСервере();
	ЗаполнитьСтрокиНастроек(Профили, Предложения.Пользователи);
	ЗаполнитьСтрокиНастроек(КлассификацияРолей, Предложения.Роли);
	РучнойОхват = СтрСоединить(Предложения.Ручные, Символы.ПС);
	Команды.ПринятьОбфускацию.Картинка = БиблиотекаКартинок.Cutter3000_Обфускация;
	Команды.ОтметитьВсеПравила.Картинка = БиблиотекаКартинок.Cutter3000_ОтметитьВсе;
	Команды.СнятьОтметкиПравил.Картинка = БиблиотекаКартинок.Cutter3000_СнятьОтметки;
	Команды.ОтметитьВсехПользователей.Картинка = БиблиотекаКартинок.Cutter3000_ОтметитьВсе;
	Команды.СнятьОтметкиПользователей.Картинка = БиблиотекаКартинок.Cutter3000_СнятьОтметки;
	Команды.ОтметитьВсеРоли.Картинка = БиблиотекаКартинок.Cutter3000_ОтметитьВсе;
	Команды.СнятьОтметкиРолей.Картинка = БиблиотекаКартинок.Cutter3000_СнятьОтметки;
	Команды.ОткрытьСправкуОбфускации.Картинка = БиблиотекаКартинок.Cutter3000_Справка;
	Элементы.ТаблицаПравила.КартинкаСтрок = БиблиотекаКартинок.Cutter3000_ВидыОбъектов;
	Элементы.ТаблицаПравила.ПутьКДаннымКартинкиСтроки = "ДеревоПравил.ИндексКартинки";
	Элементы.ПрофилиИдентификатор.Видимость = Ложь;
	Для Каждого Категория Из СтрРазделить("Адрес|Дата рождения|Документ|ИНН|Организация|Очистить текст|Персонаж|Почта|СНИЛС|Телефон", "|") Цикл
		Элементы.ПравилаКатегория.СписокВыбора.Добавить(Категория);
	КонецЦикла;
	ПостроитьДеревоПравил(ДеревоПравил, Правила, ТолькоВыбранные);
	УстановитьПодготовкуИсключений(Ложь, "Исключения пользователей: подготовка поиска...");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СкрытаяПозицияПравил = "";
	ПозицияВместоСкрытой = "";
	ПозицииТаблицВыбора = Новый Соответствие;
	РазвернутьВетки(ДеревоПравил.ПолучитьЭлементы());
	НачатьПодготовкуИсключений();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ОтключитьОбработчикОжидания("ОпросПодготовкиИсключений");
	ОтменитьПодготовкуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПравила

&НаКлиенте
Процедура ПравилаВключеноПриИзменении(Элемент)
	Перем Узел, НомерПравила, Правило;
	Узел = Элементы.ТаблицаПравила.ТекущиеДанные;
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НомерПравила = 0;
	Для Каждого Правило Из Правила Цикл
		НомерПравила = НомерПравила + 1;
		Если Правило.Доступно И ПравилоВВетке(Правило, НомерПравила, Узел.Ключ) Тогда
			Правило.Включено = Узел.Отметка = 1;
		КонецЕсли;
	КонецЦикла;
	Если ТолькоВыбранные Тогда
		ОбновитьДеревоНаКлиенте();
	Иначе
		ОбновитьОтметкиДерева(ДеревоПравил.ПолучитьЭлементы(), СчетчикиПравил(Правила), Правила);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКатегорияПриИзменении(Элемент)
	Перем Узел;
	Узел = Элементы.ТаблицаПравила.ТекущиеДанные;
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Узел.НомерПравила > 0 И Узел.Доступно Тогда
		Правила[Узел.НомерПравила - 1].Категория = Узел.Категория;
	Иначе
		Узел.Категория = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПрофили

&НаКлиенте
Процедура ПрофилиСохранитьПриИзменении(Элемент)
	НачатьПодготовкуИсключений();
КонецПроцедуры

&НаКлиенте
Процедура ПрофилиЗаписьПриИзменении(Элемент)
	Перем Профиль;
	Профиль = Элементы.ТаблицаПрофили.ТекущиеДанные;
	Если Профиль <> Неопределено И ЗначениеЗаполнено(Профиль.Запись) Тогда
		Профиль.ЗаписиНет = Ложь;
	КонецЕсли;
	ОбновитьРучныеСвязиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПрофилиЗаписиНетПриИзменении(Элемент)
	Перем Профиль;
	Профиль = Элементы.ТаблицаПрофили.ТекущиеДанные;
	Если Профиль <> Неопределено И Профиль.ЗаписиНет Тогда
		Профиль.Запись = Неопределено;
	КонецЕсли;
	ОбновитьРучныеСвязиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКлассификацияРолей

&НаКлиенте
Процедура КлассификацияРолейПолныеПраваПриИзменении(Элемент)
	НачатьПодготовкуИсключений();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьСправкуОбфускации(Команда)
	Перем СтраницаСправки;
	СтраницаСправки = Элементы.Страницы.ТекущаяСтраница.Имя;
	ОткрытьФорму("Обработка.Cutter3000_ОбрезкаБазы.Форма.СправкаОбфускации",
		Новый Структура("Страница", СтраницаСправки), ЭтаФорма, СтраницаСправки);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеПравила(Команда)
	УстановитьВсеОтметки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиПравил(Команда)
	УстановитьВсеОтметки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВыбранныеПравила(Команда)
	ТолькоВыбранные = Не ТолькоВыбранные;
	Элементы.ТолькоВыбранныеПравилаКнопка.Пометка = ТолькоВыбранные;
	ОбновитьДеревоНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсехПользователей(Команда)
	УстановитьОтметкиПользователей(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиПользователей(Команда)
	УстановитьОтметкиПользователей(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВыбранныеПользователи(Команда)
	ОтборВыбранныхПользователей = Не ОтборВыбранныхПользователей;
	Элементы.ТолькоВыбранныеПользователиКнопка.Пометка = ОтборВыбранныхПользователей;
	ОбновитьОтборПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеРоли(Команда)
	УстановитьОтметкиРолей(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиРолей(Команда)
	УстановитьОтметкиРолей(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВыбранныеРоли(Команда)
	ОтборВыбранныхРолей = Не ОтборВыбранныхРолей;
	Элементы.ТолькоВыбранныеРолиКнопка.Пометка = ОтборВыбранныхРолей;
	ОбновитьОтборРолей();
КонецПроцедуры

&НаКлиенте
Процедура ПринятьОбфускацию(Команда)
	Перем Сообщение, ИдентификаторЗапуска, ПричинаОтказа;
	Если Не Подтверждено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Подтвердите правила, исключения пользователей и выбранную область очистки.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ПричинаОтказа = ПроверитьИсключенияНаСервере();
	Если ПричинаОтказа <> "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ПричинаОтказа;
		Сообщение.Сообщить();
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПользователи;
		Возврат;
	КонецЕсли;
	// Прикладной текст исключения не выводится: он может содержать персональные значения.
	Попытка
		ИдентификаторЗапуска = ПринятьНастройкиНаСервере();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Запуск отклонен: проверьте правила, типы полей и исключения; дождитесь завершения другой операции.";
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	Закрыть(ИдентификаторЗапуска);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НачатьПодготовкуИсключений()
	ОтключитьОбработчикОжидания("ОпросПодготовкиИсключений");
	НачатьПодготовкуНаСервере();
	ОбновитьОтборПользователей();
	ОбновитьОтборРолей();
	Если ЗаданиеПодготовкиИсключений <> "" Тогда
		ПодключитьОбработчикОжидания("ОпросПодготовкиИсключений", 1);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОпросПодготовкиИсключений()
	Если ПолучитьПодготовкуНаСервере() Тогда
		ОтключитьОбработчикОжидания("ОпросПодготовкиИсключений");
		ОбновитьОтборПользователей();
		ОбновитьОтборРолей();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьПодготовкуИсключений(Готово, ТекстСостояния)
	ПодготовкаИсключенийГотова = Готово;
	СостояниеПодготовкиИсключений = ТекстСостояния;
	Элементы.ПринятьОбфускациюКнопка.Доступность = Готово;
	Элементы.ТаблицаПрофили.Доступность = Готово;
	Элементы.ТаблицаКлассификацияРолей.Доступность = Готово;
	Элементы.ОтметитьВсехПользователейКнопка.Доступность = Готово;
	Элементы.СнятьОтметкиПользователейКнопка.Доступность = Готово;
	Элементы.ТолькоВыбранныеПользователиКнопка.Доступность = Готово;
	Элементы.ОтметитьВсеРолиКнопка.Доступность = Готово;
	Элементы.СнятьОтметкиРолейКнопка.Доступность = Готово;
	Элементы.ТолькоВыбранныеРолиКнопка.Доступность = Готово;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиПользователей(Выбрать)
	Перем Профиль, ОтметкаПрофиля, Изменено;
	Изменено = Ложь;
	Для Каждого Профиль Из Профили Цикл
		ОтметкаПрофиля = Выбрать Или Профиль.Обязательно;
		Если Профиль.Сохранить <> ОтметкаПрофиля Тогда
			Профиль.Сохранить = ОтметкаПрофиля;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	ОбновитьОтборПользователей();
	Если Изменено Тогда
		НачатьПодготовкуИсключений();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиРолей(Выбрать)
	Перем Классификация, Изменено;
	Изменено = Ложь;
	Для Каждого Классификация Из КлассификацияРолей Цикл
		Если Классификация.ПолныеПрава <> Выбрать Тогда
			Классификация.ПолныеПрава = Выбрать;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	ОбновитьОтборРолей();
	Если Изменено Тогда
		НачатьПодготовкуИсключений();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборПользователей()
	ОбновитьОтборТаблицы(Элементы.ТаблицаПрофили, Профили, "Сохранить", ОтборВыбранныхПользователей);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборРолей()
	ОбновитьОтборТаблицы(Элементы.ТаблицаКлассификацияРолей, КлассификацияРолей, "ПолныеПрава", ОтборВыбранныхРолей);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборТаблицы(ТаблицаВыбора, СтрокиВыбора, ИмяФлажка, ТолькоОтмеченные)
	Перем Позиция, СостояниеПозиции, СтрокаПозиции, ВидимаяСтрока, Кандидат;
	СостояниеПозиции = ПозицииТаблицВыбора.Получить(ТаблицаВыбора.Имя);
	Если СостояниеПозиции = Неопределено Тогда
		СостояниеПозиции = Новый Структура("Скрытая,Замена", Неопределено, Неопределено);
		ПозицииТаблицВыбора.Вставить(ТаблицаВыбора.Имя, СостояниеПозиции);
	КонецЕсли;
	Позиция = ТаблицаВыбора.ТекущаяСтрока;
	Если СостояниеПозиции.Скрытая <> Неопределено И Позиция = СостояниеПозиции.Замена Тогда
		Позиция = СостояниеПозиции.Скрытая;
	КонецЕсли;
	СтрокаПозиции = Неопределено;
	Если Позиция <> Неопределено Тогда
		СтрокаПозиции = СтрокиВыбора.НайтиПоИдентификатору(Позиция);
	КонецЕсли;
	Если ТолькоОтмеченные Тогда
		ТаблицаВыбора.ОтборСтрок = Новый ФиксированнаяСтруктура(ИмяФлажка, Истина);
	Иначе
		ТаблицаВыбора.ОтборСтрок = Неопределено;
	КонецЕсли;
	Если СтрокаПозиции <> Неопределено И (Не ТолькоОтмеченные Или СтрокаПозиции[ИмяФлажка]) Тогда
		ТаблицаВыбора.ТекущаяСтрока = Позиция;
		СостояниеПозиции.Скрытая = Неопределено;
		СостояниеПозиции.Замена = Неопределено;
		Возврат;
	КонецЕсли;
	ВидимаяСтрока = Неопределено;
	Для Каждого Кандидат Из СтрокиВыбора Цикл
		Если Не ТолькоОтмеченные Или Кандидат[ИмяФлажка] Тогда
			ВидимаяСтрока = Кандидат.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ТаблицаВыбора.ТекущаяСтрока = ВидимаяСтрока;
	СостояниеПозиции.Скрытая = Позиция;
	СостояниеПозиции.Замена = ВидимаяСтрока;
КонецПроцедуры

&НаСервере
Процедура НачатьПодготовкуНаСервере()
	Перем ПараметрыЗадания, НастройкиИсключений, Задание;
	ОтменитьПодготовкуНаСервере();
	УстановитьПодготовкуИсключений(Ложь, "Исключения пользователей: поиск прикладных записей в фоне. Правила доступны для просмотра и изменения.");
	// Для поиска не нужны тысячи строк правил и параметры очистки истории.
	НастройкиИсключений = Новый Структура("Пользователи,Роли",
		МассивСтрокНастроек(Профили, "Идентификатор,Сохранить"),
		МассивСтрокНастроек(КлассификацияРолей, "Имя,ПолныеПрава"));
	АдресПодготовкиИсключений = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(НастройкиИсключений);
	ПараметрыЗадания.Добавить(АдресПодготовкиИсключений);
	Попытка
		Задание = ФоновыеЗадания.Выполнить("Cutter3000_ОбфускацияСервер.ПодготовитьСвязиПользователей",
			ПараметрыЗадания, АдресПодготовкиИсключений, "Cutter3000: проверка исключений пользователей");
		ЗаданиеПодготовкиИсключений = Строка(Задание.УникальныйИдентификатор);
	Исключение
		УдалитьИзВременногоХранилища(АдресПодготовкиИсключений);
		АдресПодготовкиИсключений = "";
		ЗаписьЖурналаРегистрации("Cutter3000.ПроверкаИсключений", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось запустить проверку исключений пользователей; обфускация не запущена.");
		УстановитьПодготовкуИсключений(Ложь, "Не удалось запустить проверку исключений. Откройте настройки повторно; обфускация не запущена.");
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОтменитьПодготовкуНаСервере()
	Перем Задание;
	Если ЗаданиеПодготовкиИсключений <> "" Тогда
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЗаданиеПодготовкиИсключений));
		Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			// Только чтение: транзакций изменения в этом задании нет. Завершения не ожидаем.
			Задание.Отменить();
		Иначе
			Если АдресПодготовкиИсключений <> "" Тогда
				УдалитьИзВременногоХранилища(АдресПодготовкиИсключений);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Новый поиск получает новый адрес; поздний результат прежнего задания не применяется.
	// Адрес еще работающего задания принадлежит форме и освобождается при ее закрытии.
	ЗаданиеПодготовкиИсключений = "";
	АдресПодготовкиИсключений = "";
	ПодготовкаИсключенийГотова = Ложь;
