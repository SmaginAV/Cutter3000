&НаКлиенте
Функция ВидимыйПредокПозиции(КлючПозиции)
	Перем ИсточникПозиции, Части, КлючПредка, Предок, Корни;
	ИсточникПозиции = "";
	Если СтрНачинаетсяС(КлючПозиции, "Правило:") Тогда
		ИсточникПозиции = Правила[Число(Сред(КлючПозиции, СтрДлина("Правило:") + 1)) - 1].Источник;
	ИначеЕсли СтрНачинаетсяС(КлючПозиции, "Источник:") Тогда
		ИсточникПозиции = Сред(КлючПозиции, СтрДлина("Источник:") + 1);
	ИначеЕсли СтрНачинаетсяС(КлючПозиции, "Объект:") Тогда
		ИсточникПозиции = Сред(КлючПозиции, СтрДлина("Объект:") + 1);
	КонецЕсли;
	Если ИсточникПозиции <> "" Тогда
		Части = СтрРазделить(ИсточникПозиции, ".");
		Для Каждого КлючПредка Из СтрРазделить("Источник:" + ИсточникПозиции
			+ "|Объект:" + Части[0] + "." + Части[1] + "|Вид:" + Части[0], "|") Цикл
			Предок = УзелПоКлючу(ДеревоПравил.ПолучитьЭлементы(), КлючПредка);
			Если Предок <> Неопределено Тогда
				Возврат Предок;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Корни = ДеревоПравил.ПолучитьЭлементы();
	Если Корни.Количество() > 0 Тогда
		Возврат Корни[0];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура УпорядочитьПравилаНаСервере()
