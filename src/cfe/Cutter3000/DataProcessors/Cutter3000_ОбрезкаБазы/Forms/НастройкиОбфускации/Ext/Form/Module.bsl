		Возврат Новый Структура("Представление,Картинка", Вид, 0);
	КонецЕсли;
	Возврат Новый Структура("Представление,Картинка", Представления[Индекс], Индекс + 1);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетчикиПравил(ПолныйСписок)
	Перем Результат, Правило, Части, КлючВетки, Ключи, Счетчик;
	Результат = Новый Соответствие;
	Для Каждого Правило Из ПолныйСписок Цикл
		Части = СтрРазделить(Правило.Источник, ".");
		Ключи = Новый Массив;
		Ключи.Добавить("Вид:" + Части[0]);
		Ключи.Добавить("Объект:" + Части[0] + "." + Части[1]);
		Ключи.Добавить("Источник:" + Правило.Источник);
		Для Каждого КлючВетки Из Ключи Цикл
			Счетчик = Результат.Получить(КлючВетки);
			Если Счетчик = Неопределено Тогда
				Счетчик = Новый Структура("Всего,Выбрано", 0, 0);
				Результат.Вставить(КлючВетки, Счетчик);
			КонецЕсли;
			Если Правило.Доступно Тогда
				Счетчик.Всего = Счетчик.Всего + 1;
				Если Правило.Включено Тогда
					Счетчик.Выбрано = Счетчик.Выбрано + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтметкиДерева(Ветки, Счетчики, ПолныйСписок)
	Перем Ветка, Счетчик;
	// Трехпозиционный флажок платформы: 0 - снят, 1 - выбран, 2 - частичный выбор.
	Для Каждого Ветка Из Ветки Цикл
		Ветка.Отметка = 0;
		Если Ветка.НомерПравила > 0 Тогда
			Если ПолныйСписок[Ветка.НомерПравила - 1].Включено Тогда
				Ветка.Отметка = 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Счетчик = Счетчики.Получить(Ветка.Ключ);
		Ветка.Доступно = Счетчик.Всего > 0;
		ОбновитьОтметкиДерева(Ветка.ПолучитьЭлементы(), Счетчики, ПолныйСписок);
		Если Счетчик.Выбрано = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ветка.Отметка = 1;
		Если Счетчик.Выбрано < Счетчик.Всего Тогда
			Ветка.Отметка = 2;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПравилоВВетке(Правило, НомерПравила, КлючВетки)
	Перем Части;
	Части = СтрРазделить(Правило.Источник, ".");
	Возврат КлючВетки = "Правило:" + Строка(НомерПравила)
		Или КлючВетки = "Вид:" + Части[0]
		Или КлючВетки = "Объект:" + Части[0] + "." + Части[1]
		Или КлючВетки = "Источник:" + Правило.Источник;
КонецФункции

#КонецОбласти
