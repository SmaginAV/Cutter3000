	Если ЗаданиеПодготовкиИсключений = "" Тогда
		Возврат Истина;
	КонецЕсли;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЗаданиеПодготовкиИсключений));
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Ложь;
	КонецЕсли;
	РезультатПодготовки = ПолучитьИзВременногоХранилища(АдресПодготовкиИсключений);
	УдалитьИзВременногоХранилища(АдресПодготовкиИсключений);
	ЗаданиеПодготовкиИсключений = "";
	АдресПодготовкиИсключений = "";
	Успех = Ложь;
	Связи = Неопределено;
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Завершено
		И ТипЗнч(РезультатПодготовки) = Тип("Структура")
		И РезультатПодготовки.Свойство("Успех", Успех) И Успех
		И РезультатПодготовки.Свойство("Связи", Связи) И ТипЗнч(Связи) = Тип("Массив") Тогда
		ПрименитьСвязиНаСервере(Связи);
		УстановитьПодготовкуИсключений(Истина, "Поиск записей пользователей завершен. Проверьте исключения и подтвердите настройки перед запуском.");
	Иначе
		УстановитьПодготовкуИсключений(Ложь, "Проверка исключений не завершена. Откройте настройки повторно; обфускация не запущена.");
	КонецЕсли;
	Возврат Истина;
