	Если НайденнаяПозиция <> Неопределено Тогда
		Элементы.ТаблицаПравила.ТекущаяСтрока = НайденнаяПозиция.ПолучитьИдентификатор();
		СкрытаяПозицияПравил = "";
		ПозицияВместоСкрытой = "";
	Иначе
		// Скрытое поле не меняет сохраненную позицию; временно выбирается видимый предок.
		СкрытаяПозицияПравил = КлючПозиции;
		НайденнаяПозиция = ВидимыйПредокПозиции(КлючПозиции);
		ПозицияВместоСкрытой = "";
		Если НайденнаяПозиция <> Неопределено Тогда
