			ПутьПоля = ПутьПоля + "Табличная часть: " + Части[Части.Количество() - 1] + "|";
		КонецЕсли;
		Правило.ПорядокДерева = ПутьПоля + Правило.Поле;
	КонецЦикла;
	ПолныйСписок.Сортировать("ПорядокДерева");
	ПолныйСписок.Колонки.Удалить("ПорядокДерева");
