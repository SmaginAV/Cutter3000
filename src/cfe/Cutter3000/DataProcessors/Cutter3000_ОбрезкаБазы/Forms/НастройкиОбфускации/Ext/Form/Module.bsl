&НаКлиентеНаСервереБезКонтекста
Процедура ПостроитьДеревоПравил(Дерево, ПолныйСписок, ФильтрВыбранных)
	Перем ПоКлючам, НомерПравила, Правило, Части, Вид, Корень, Родитель, Узел;
	Дерево.ПолучитьЭлементы().Очистить();
	ПоКлючам = Новый Соответствие;
	НомерПравила = 0;
	Для Каждого Правило Из ПолныйСписок Цикл
		НомерПравила = НомерПравила + 1;
		Если ФильтрВыбранных И Не Правило.Включено Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Правило.Источник, ".");
		Вид = ОписаниеВида(Части[0]);
		Корень = Части[0] + "." + Части[1];
		Родитель = ГруппаПравил(Дерево.ПолучитьЭлементы(), ПоКлючам, "Вид:" + Части[0], Вид.Представление, Вид.Картинка);
		Родитель = ГруппаПравил(Родитель.ПолучитьЭлементы(), ПоКлючам, "Объект:" + Корень, Части[1], Вид.Картинка);
		Если Части.Количество() > 2 Тогда
			Родитель = ГруппаПравил(Родитель.ПолучитьЭлементы(), ПоКлючам, "Источник:" + Правило.Источник, "Табличная часть: " + Части[Части.Количество() - 1], 14);
		КонецЕсли;
		Узел = Родитель.ПолучитьЭлементы().Добавить();
		Узел.Ключ = "Правило:" + Строка(НомерПравила);
		Узел.НомерПравила = НомерПравила;
		Узел.Представление = Правило.Поле;
		Узел.Категория = Правило.Категория;
		Узел.Доступно = Правило.Доступно;
		Узел.Причина = Правило.Причина;
		Узел.ИндексКартинки = 15;
	КонецЦикла;
	ОбновитьОтметкиДерева(Дерево.ПолучитьЭлементы(), СчетчикиПравил(ПолныйСписок), ПолныйСписок);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ГруппаПравил(СтрокиДерева, ПоКлючам, КлючВетки, Представление, Картинка)
	Перем Ветка;
	Ветка = ПоКлючам.Получить(КлючВетки);
	Если Ветка = Неопределено Тогда
		Ветка = СтрокиДерева.Добавить();
		Ветка.Ключ = КлючВетки;
		Ветка.Представление = Представление;
		Ветка.ИндексКартинки = Картинка;
		ПоКлючам.Вставить(КлючВетки, Ветка);
	КонецЕсли;
	Возврат Ветка;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
