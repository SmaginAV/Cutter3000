		КонецЕсли;
		НайденнаяПозиция = УзелПоКлючу(Ветка.ПолучитьЭлементы(), КлючПозиции);
		Если НайденнаяПозиция <> Неопределено Тогда
			Возврат НайденнаяПозиция;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
