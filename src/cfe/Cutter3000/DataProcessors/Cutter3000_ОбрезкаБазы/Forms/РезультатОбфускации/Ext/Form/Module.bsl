#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ИтогЗапуска;
	ИтогЗапуска = Cutter3000_ЗаданияСервер.СостояниеОбрезки(Параметры.Запуск);
	Если ИтогЗапуска.ВидОперации = "Обфускация" Тогда
		Результат = ИтогЗапуска.ИтогОбфускации;
		Если Результат = "" Тогда
			Результат = "Обфускация: " + ИтогЗапуска.Состояние + "."
				+ Символы.ПС + "Подробности доступны в списке ошибок на основной форме.";
		КонецЕсли;
	Иначе
		Результат = "Результат обфускации для этого запуска отсутствует.";
	КонецЕсли;
КонецПроцедуры

