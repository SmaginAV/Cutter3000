#Область ОписаниеПеременных

&НаКлиенте
Перем ПрочитанныеСообщения;

&НаКлиенте
Перем ОпросПодключен;

&НаКлиенте
Перем ЗапускТаблицы;

&НаКлиенте
Перем СчетчикПодключен;

&НаКлиенте
Перем СекундыВыполнения;

&НаКлиенте
Перем ОтметкаСчетчика;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Команды.НачатьОбрезку.Картинка = БиблиотекаКартинок.Cutter3000_НачатьОбрезку;
	Команды.ОстановитьОбрезку.Картинка = БиблиотекаКартинок.Cutter3000_ОстановитьОбрезку;
	Команды.ОткрытьОшибки.Картинка = БиблиотекаКартинок.Cutter3000_Ошибки;
	Элементы.РаботыТаблица.КартинкаСтрок = БиблиотекаКартинок.Cutter3000_КартинкиРабот;
	Элементы.РаботыТаблица.ПутьКДаннымКартинкиСтроки = "Работы.ИндексКартинки";
	Состояние = Cutter3000_ЗаданияСервер.СостояниеОбрезки();
	Запуск = Состояние.Запуск;
	ДатаОбрезки = Состояние.Граница;
	РежимВыполнения = Состояние.Режим;
	ВремяВыполнения = ПредставлениеДлительности(Состояние.ПрошлоСекунд);
	Элементы.ОстановитьОбрезкуКнопка.Доступность = Состояние.МожноОстановить;
	Для Каждого Работа Из Состояние.Работы Цикл
		НоваяРабота = Работы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяРабота, Работа);
		НоваяРабота.ИндексКартинки = КартинкаРаботы(Работа.Идентификатор);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПрочитанныеСообщения = Новый Соответствие;
	ОпросПодключен = Ложь;
	СчетчикПодключен = Ложь;
	ЗапускТаблицы = Запуск;
	ПодключитьОпрос();
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	ОстановитьОпрос();

КонецПроцедуры

#КонецОбласти



#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаботы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НачатьОбрезку(Команда)

	Если Не ЗначениеЗаполнено(ДатаОбрезки) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите дату обрезки.";
		Сообщение.Поле = "ДатаОбрезки";
		Сообщение.Сообщить();
		Возврат;

	КонецЕсли;
	Запуск = ПринятьЗапускНаСервере(ДатаОбрезки);
	ПодключитьОпрос();
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОшибки(Команда)

	Работа = Элементы.РаботыТаблица.ТекущиеДанные;
	Если Работа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОшибок = Новый Структура("Запуск,Задание", Запуск, Работа.Идентификатор);
	ОткрытьФорму("Обработка.Cutter3000_ОбрезкаБазы.Форма.ФормаОшибок", ПараметрыОшибок, ЭтаФорма,
		Запуск + "|" + Работа.Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОбрезку(Команда)

	Элементы.ОстановитьОбрезкуКнопка.Доступность = Ложь;
	РезультатОстановки = ПринятьОстановкуНаСервере(Запуск);
	Если РезультатОстановки.Описание <> "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатОстановки.Описание;
		Сообщение.Сообщить();
	КонецЕсли;
	ПодключитьОпрос();
	ОбновитьСостояние();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьСостояние()

	ВыбраннаяСтрока = Элементы.РаботыТаблица.ТекущаяСтрока;
	// Граница удаленного вызова: при потере связи зафиксированное состояние сохраняется на форме.
	Попытка
		Состояние = СостояниеНаСервере(Запуск, ПрочитанныеСообщения);
	Исключение
		РежимВыполнения = "Состояние устарело: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ОбновитьСтрокиРабот(Состояние.Работы, ЗапускТаблицы = Состояние.Запуск);
	Запуск = Состояние.Запуск;
	ЗапускТаблицы = Запуск;
	РежимВыполнения = Состояние.Режим;
	Для Каждого Сообщение Из Состояние.Сообщения Цикл

		ПоследнийНомер = ПрочитанныеСообщения.Получить(Сообщение.Источник);
		Если ПоследнийНомер <> Неопределено И Сообщение.Номер <= ПоследнийНомер Тогда
			Продолжить;
		КонецЕсли;
		Данные = Сообщение.Данные;
		ЗафиксированоДо = Неопределено;
		Данные.Свойство("ЗафиксированоДо", ЗафиксированоДо);
		Для Каждого Работа Из Работы Цикл

			Если Работа.Идентификатор = Данные.Задание И Работа.Состояние = "Выполняется"
				И Работа.Зафиксировано = ЗафиксированоДо
				И Не (Работа.Идентификатор = "Запуск" И Состояние.ПланЗавершен) Тогда
				Работа.ТекущаяПопытка = Данные.Обработано;
				Работа.Этап = Данные.Этап;
			КонецЕсли;

		КонецЦикла;
		ПрочитанныеСообщения.Вставить(Сообщение.Источник, Сообщение.Номер);

	КонецЦикла;
	Для Каждого Работа Из Работы Цикл
		Если Работа.Состояние = "Завершено" Тогда
			Работа.Прогресс = 100;
		ИначеЕсли Работа.Всего > 0 Тогда
			Работа.Прогресс = Мин(99, 100 * (Работа.Зафиксировано + Работа.ТекущаяПопытка) / Работа.Всего);
		Иначе
			// Процент относится к опубликованному объему; до первой порции он неизвестен.
			Работа.Прогресс = 0;
		КонецЕсли;
	КонецЦикла;
	Активен = Состояние.Состояние = "Выполняется" Или Состояние.Состояние = "Ожидание"
		Или Состояние.Состояние = "Останавливается";
	ПрименитьВремяВыполнения(Состояние.ПрошлоСекунд, Активен);
	Элементы.НачатьОбрезкуКнопка.Доступность = Не Активен;
	Элементы.ДатаОбрезкиПоле.Доступность = Не Активен;
	Элементы.ОстановитьОбрезкуКнопка.Доступность = Состояние.МожноОстановить;
	Если Не Активен Тогда
		ОстановитьОпрос();
	КонецЕсли;
	Если ВыбраннаяСтрока <> Неопределено Тогда
		Элементы.РаботыТаблица.ТекущаяСтрока = ВыбраннаяСтрока;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокиРабот(РаботыСервера, СохранитьПопытки)

	ТекущиеПопытки = Новый Соответствие;
	СуществующиеРаботы = Новый Соответствие;
	Для Каждого Работа Из Работы Цикл
		СуществующиеРаботы.Вставить(Работа.Идентификатор, Работа);
		Если СохранитьПопытки И Работа.Состояние = "Выполняется" Тогда
			ТекущиеПопытки.Вставить(Работа.Идентификатор,
				Новый Структура("Обработано,Этап,Зафиксировано", Работа.ТекущаяПопытка,
					Работа.Этап, Работа.Зафиксировано));
		КонецЕсли;
	КонецЦикла;
	АктуальныеРаботы = Новый Соответствие;
	Для Каждого Работа Из РаботыСервера Цикл

		АктуальныеРаботы.Вставить(Работа.Идентификатор, Истина);
		НоваяРабота = СуществующиеРаботы.Получить(Работа.Идентификатор);
		Если НоваяРабота = Неопределено Тогда
			НоваяРабота = Работы.Добавить();
		КонецЕсли;
		НоваяРабота.ТекущаяПопытка = 0;
		НоваяРабота.Прогресс = 0;
		ЗаполнитьЗначенияСвойств(НоваяРабота, Работа);
		НоваяРабота.ИндексКартинки = КартинкаРаботы(Работа.Идентификатор);
		ПопыткаРаботы = ТекущиеПопытки.Получить(Работа.Идентификатор);
		Если Работа.Состояние = "Выполняется" И ПопыткаРаботы <> Неопределено
			И ПопыткаРаботы.Зафиксировано = Работа.Зафиксировано Тогда
			НоваяРабота.ТекущаяПопытка = ПопыткаРаботы.Обработано;
			НоваяРабота.Этап = ПопыткаРаботы.Этап;
		КонецЕсли;

	КонецЦикла;
	// Существующие строки сохраняют идентификаторы и выбранную пользователем позицию.
	Индекс = Работы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если АктуальныеРаботы.Получить(Работы[Индекс].Идентификатор) = Неопределено Тогда
			Работы.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпрос()

	Если Не ОпросПодключен Тогда
		ПодключитьОбработчикОжидания("ОбновитьСостояние", 2);
		ОпросПодключен = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОпрос()

	Если ОпросПодключен Тогда
		ОтключитьОбработчикОжидания("ОбновитьСостояние");
		ОпросПодключен = Ложь;
	КонецЕсли;
	ОстановитьСчетчик();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьВремяВыполнения(ПрошлоСекунд, Активен)

	СекундыВыполнения = ПрошлоСекунд;
	ОтметкаСчетчика = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьСчетчик();
	Если Активен Тогда
		Если Не СчетчикПодключен Тогда
			ПодключитьОбработчикОжидания("ОбновитьСчетчик", 1);
			СчетчикПодключен = Истина;
		КонецЕсли;
	Иначе
		ОстановитьСчетчик();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСчетчик()

	// Между опросами используем только часы клиента; время запуска задает сервер.
	ДобавочныеСекунды = Макс(0, Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ОтметкаСчетчика) / 1000));
	ВремяВыполнения = ПредставлениеДлительности(СекундыВыполнения + ДобавочныеСекунды);

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьСчетчик()

	Если СчетчикПодключен Тогда
		ОтключитьОбработчикОжидания("ОбновитьСчетчик");
		СчетчикПодключен = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДлительности(ПрошлоСекунд)

	Секунды = Макс(0, Цел(ПрошлоСекунд));
	Часы = Цел(Секунды / 3600);
	Минуты = Цел((Секунды % 3600) / 60);
	Секунды = Секунды % 60;
	ФорматСчетчика = "ЧГ=0;ЧДЦ=0;ЧН=0";
	Возврат СтрШаблон("%1 ч. %2 мин. %3 с.", Формат(Часы, ФорматСчетчика),
		Формат(Минуты, ФорматСчетчика), Формат(Секунды, ФорматСчетчика));

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КартинкаРаботы(Идентификатор)

	// Порядок в библиотечном наборе: чтение, удаление.
	Если Идентификатор = "Запуск" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат 1;

КонецФункции

&НаСервереБезКонтекста
Функция ПринятьЗапускНаСервере(Знач ДатаОбрезки)

	Возврат Cutter3000_ЗаданияСервер.НачатьОбрезку(ДатаОбрезки);

КонецФункции

&НаСервереБезКонтекста
Функция СостояниеНаСервере(Знач Запуск, Знач Прочитанные)

	Возврат Cutter3000_ЗаданияСервер.СостояниеОбрезки(Запуск, Прочитанные);

КонецФункции

&НаСервереБезКонтекста
Функция ПринятьОстановкуНаСервере(Знач Запуск)

	Возврат Cutter3000_ЗаданияСервер.ЗапроситьОстановку(Запуск);

КонецФункции

#КонецОбласти
