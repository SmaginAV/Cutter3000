#Область ОписаниеПеременных

&НаКлиенте
Перем ПрочитанныеСообщения;

&НаКлиенте
Перем ОпросПодключен;

&НаКлиенте
Перем ЗапускТаблицы;

&НаКлиенте
Перем СчетчикПодключен;

&НаКлиенте
Перем СекундыВыполнения;

&НаКлиенте
Перем ОтметкаСчетчика;

&НаКлиенте
Перем ОтслеживаемаяОбфускация;

&НаКлиенте
Перем ПоказанныйИтогОбфускации;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Команды.НачатьОбрезку.Картинка = БиблиотекаКартинок.Cutter3000_НачатьОбрезку;
	Команды.ОстановитьОбрезку.Картинка = БиблиотекаКартинок.Cutter3000_ОстановитьОбрезку;
	Команды.ОткрытьОшибки.Картинка = БиблиотекаКартинок.Cutter3000_Ошибки;
	Команды.НачатьОбфускацию.Картинка = БиблиотекаКартинок.Cutter3000_Обфускация;
	Команды.СохранитьТрассировку.Картинка = БиблиотекаКартинок.ЖурналРегистрации;
	Элементы.РаботыТаблица.КартинкаСтрок = БиблиотекаКартинок.Cutter3000_КартинкиРабот;
	Элементы.РаботыТаблица.ПутьКДаннымКартинкиСтроки = "Работы.ИндексКартинки";
	Состояние = Cutter3000_ЗаданияСервер.СостояниеОбрезки();
	Запуск = Состояние.Запуск;
	ДатаОбрезки = Состояние.Граница;
	Активен = Состояние.Состояние = "Выполняется" Или Состояние.Состояние = "Ожидание"
		Или Состояние.Состояние = "Останавливается";
	Если Активен Тогда
		УскоренныйРежим = Состояние.УскоренныйРежим;
		Трассировка = Состояние.Трассировка;
	КонецЕсли;
	Элементы.УскоренныйРежимПоле.Доступность = Не Активен;
	Элементы.ТрассировкаПоле.Доступность = Не Активен;
	Элементы.СохранитьТрассировкуКнопка.Доступность = Состояние.Запуск <> "" И Состояние.Трассировка;
	РежимВыполнения = Состояние.Режим;
	ПрименитьРаботниковУдаления(ЭтаФорма, Состояние, Активен);
	ВремяВыполнения = ПредставлениеДлительности(Состояние.ПрошлоСекунд);
	ИтогОбфускации = Состояние.ИтогОбфускации;
	Элементы.РезультатОбфускацииСсылка.Видимость = ИтогОбфускации <> "";
	Элементы.ОстановитьОбрезкуКнопка.Доступность = Состояние.МожноОстановить;
	ПрименитьВидОперации(ЭтаФорма, Состояние.ВидОперации);
	Для Каждого Работа Из Состояние.Работы Цикл
		НоваяРабота = Работы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяРабота, Работа);
		НоваяРабота.ИндексКартинки = КартинкаРаботы(Работа.Идентификатор, Работа.ВидОперации);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПрочитанныеСообщения = Новый Соответствие;
	ОпросПодключен = Ложь;
	СчетчикПодключен = Ложь;
	ЗапускТаблицы = Запуск;
	ОтслеживаемаяОбфускация = "";
	ПоказанныйИтогОбфускации = "";
	ПодключитьОпрос();
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	ОстановитьОпрос();

КонецПроцедуры

#КонецОбласти



#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТриРаботникаУдаленияПриИзменении(Элемент)

	РежимВыполнения = СтрШаблон("Серверная база: 2 читателя и %1 работника удаления",
		?(ТриРаботникаУдаления, 3, 2));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаботы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура СохранитьТрассировку(Команда)

	Если Запуск = "" Тогда
		Возврат;
	КонецЕсли;
	ПараметрыПолучения = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыПолучения.Заголовок = "Сохранить трассировку Cutter3000";
	ПараметрыПолучения.ВыборКаталога = Ложь;
	АдресТрассировки = ТрассировкаНаСервере(Запуск, УникальныйИдентификатор);
	Ждать ПолучитьФайлССервераАсинх(АдресТрассировки, "Cutter3000-trace-" + Запуск + ".xml",
		ПараметрыПолучения);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТрассировкаНаСервере(Знач ИдентификаторЗапуска, Знач ИдентификаторФормы)

	Возврат Cutter3000_ЗаданияСервер.ФайлТрассировки(ИдентификаторЗапуска, ИдентификаторФормы);

КонецФункции

&НаКлиенте
Процедура НачатьОбрезку(Команда)

	ОбновитьСостояние();
	Если Не Элементы.НачатьОбрезкуКнопка.Доступность Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаОбрезки) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите дату обрезки.";
		Сообщение.Поле = "ДатаОбрезки";
		Сообщение.Сообщить();
		Возврат;

	КонецЕсли;
	Если УскоренныйРежим Тогда
		ПараметрыЗапуска = Новый Структура("Граница", ДатаОбрезки);
		Оповещение = Новый ОписаниеОповещения("УскореннаяОбрезкаПодтверждена", ЭтаФорма, ПараметрыЗапуска);
		ПоказатьВопрос(Оповещение,
			"Ускоренная обрезка пропустит повторную проверку обычных входящих ссылок. "
			+ "Могут остаться битые ссылки. Первоначальное построение каскада сохраняется. Продолжить?",
			РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Ускоренная обрезка");
	Иначе
		ЗапуститьОбрезку(ДатаОбрезки, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УскореннаяОбрезкаПодтверждена(Ответ, ПараметрыЗапуска) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗапуститьОбрезку(ПараметрыЗапуска.Граница, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбрезку(Граница, Ускоренный)

	Запуск = ПринятьЗапускНаСервере(Граница, Ускоренный, Трассировка,
		?(ТриРаботникаУдаления, 3, 2));
	ПодключитьОпрос();
	ОбновитьСостояние();

КонецПроцедуры
&НаКлиенте
Процедура ОткрытьОшибки(Команда)

	Работа = Элементы.РаботыТаблица.ТекущиеДанные;
	Если Работа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОшибок = Новый Структура("Запуск,Задание", Запуск, Работа.Идентификатор);
	ОткрытьФорму("Обработка.Cutter3000_ОбрезкаБазы.Форма.ФормаОшибок", ПараметрыОшибок, ЭтаФорма,
		Запуск + "|" + Работа.Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура НачатьОбфускацию(Команда)

	ОбновитьСостояние();
	Если Не Элементы.НачатьОбфускациюКнопка.Доступность Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ОбфускацияПринята", ЭтаФорма);
	ОткрытьФорму("Обработка.Cutter3000_ОбрезкаБазы.Форма.НастройкиОбфускации", Новый Структура,
		ЭтаФорма, Неопределено, Неопределено, Неопределено, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ОбфускацияПринята(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> Неопределено Тогда
		Запуск = Результат;
		ОтслеживаемаяОбфускация = Запуск;
		ПодключитьОпрос();
		ОбновитьСостояние();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРезультатОбфускации(Команда)

	Если Запуск = "" Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Обработка.Cutter3000_ОбрезкаБазы.Форма.РезультатОбфускации",
		Новый Структура("Запуск", Запуск), ЭтаФорма, Запуск + "|Результат");

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОбрезку(Команда)

	Элементы.ОстановитьОбрезкуКнопка.Доступность = Ложь;
	РезультатОстановки = ПринятьОстановкуНаСервере(Запуск);
	Если РезультатОстановки.Описание <> "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатОстановки.Описание;
		Сообщение.Сообщить();
	КонецЕсли;
	ПодключитьОпрос();
	ОбновитьСостояние();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьСостояние()

	ВыбраннаяСтрока = Элементы.РаботыТаблица.ТекущаяСтрока;
	// Граница удаленного вызова: при потере связи зафиксированное состояние сохраняется на форме.
	Попытка
		Состояние = СостояниеНаСервере(Запуск, ПрочитанныеСообщения);
	Исключение
		РежимВыполнения = "Состояние устарело: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ОбновитьСтрокиРабот(Состояние.Работы, ЗапускТаблицы = Состояние.Запуск);
	Запуск = Состояние.Запуск;
	ЗапускТаблицы = Запуск;
	РежимВыполнения = Состояние.Режим;
	ИтогОбфускации = Состояние.ИтогОбфускации;
	Элементы.РезультатОбфускацииСсылка.Видимость = ИтогОбфускации <> "";
	Для Каждого Сообщение Из Состояние.Сообщения Цикл

		// Номер относится ко всему пакету: у подготовки и удаления он общий.
		Данные = Сообщение.Данные;
		Для Каждого Работа Из Работы Цикл

			Если СнимокСоответствуетРаботе(Работа, Данные, Состояние.ПланЗавершен) Тогда
				Работа.ТекущаяПопытка = Данные.Обработано;
				Работа.Этап = Данные.Этап;
			КонецЕсли;

		КонецЦикла;
		ПрочитанныеСообщения.Вставить(Сообщение.Источник, Сообщение.Номер);

	КонецЦикла;
	Для Каждого Работа Из Работы Цикл
		Если Работа.Состояние = "Завершено" Или Работа.Состояние = "Обезличивание неполное" Тогда
			Работа.Прогресс = 100;
		ИначеЕсли Работа.Всего > 0 Тогда
			Работа.Прогресс = Мин(99, 100 * (Работа.Зафиксировано + Работа.ТекущаяПопытка) / Работа.Всего);
		Иначе
			// Процент относится к опубликованному объему; до первой порции он неизвестен.
			Работа.Прогресс = 0;
		КонецЕсли;
	КонецЦикла;
	Активен = Состояние.Состояние = "Выполняется" Или Состояние.Состояние = "Ожидание"
		Или Состояние.Состояние = "Останавливается";
	ПрименитьВремяВыполнения(Состояние.ПрошлоСекунд, Активен);
	ПрименитьРаботниковУдаления(ЭтаФорма, Состояние, Активен);
	Элементы.НачатьОбрезкуКнопка.Доступность = Не Активен;
	Элементы.НачатьОбфускациюКнопка.Доступность = Не Активен;
	Элементы.ДатаОбрезкиПоле.Доступность = Не Активен;
	Элементы.УскоренныйРежимПоле.Доступность = Не Активен;
	Элементы.ТрассировкаПоле.Доступность = Не Активен;
	Элементы.СохранитьТрассировкуКнопка.Доступность = Состояние.Запуск <> "" И Состояние.Трассировка;
	Если Активен Тогда
		УскоренныйРежим = Состояние.УскоренныйРежим;
		Трассировка = Состояние.Трассировка;
	КонецЕсли;
	Элементы.ОстановитьОбрезкуКнопка.Доступность = Состояние.МожноОстановить;
	ПрименитьВидОперации(ЭтаФорма, Состояние.ВидОперации);
	Если Не Активен Тогда
		ОстановитьОпрос();
	КонецЕсли;
	Если ВыбраннаяСтрока <> Неопределено Тогда
		Элементы.РаботыТаблица.ТекущаяСтрока = ВыбраннаяСтрока;
	КонецЕсли;
	ПоказатьЗавершеннуюОбфускацию(Состояние.ВидОперации, Активен);

КонецПроцедуры

&НаКлиенте
Функция СнимокСоответствуетРаботе(Работа, Данные, ПланЗавершен)

	ЗафиксированоДо = Неопределено;
	Данные.Свойство("ЗафиксированоДо", ЗафиксированоДо);
	ОшибокДо = Неопределено;
	Данные.Свойство("ОшибокДо", ОшибокДо);
	Возврат Работа.Идентификатор = Данные.Задание И Работа.Состояние = "Выполняется"
		И Работа.Зафиксировано = ЗафиксированоДо
		И (ОшибокДо = Неопределено Или Работа.Ошибок = ОшибокДо)
		И Не (Работа.Идентификатор = "Запуск" И ПланЗавершен);

КонецФункции

&НаКлиенте
Процедура ПоказатьЗавершеннуюОбфускацию(ВидОперации, Активен)

	Если ВидОперации <> "Обфускация" Тогда
		Возврат;
	КонецЕсли;
	Если Активен Тогда
		ОтслеживаемаяОбфускация = Запуск;
	ИначеЕсли Запуск <> "" И ОтслеживаемаяОбфускация = Запуск
		И ПоказанныйИтогОбфускации <> Запуск Тогда
		// Отмечаем до открытия: повторный опрос не создаст второе окно.
		ПоказанныйИтогОбфускации = Запуск;
		ОткрытьРезультатОбфускации(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокиРабот(РаботыСервера, СохранитьПопытки)

	ТекущиеПопытки = Новый Соответствие;
	СуществующиеРаботы = Новый Соответствие;
	Для Каждого Работа Из Работы Цикл
		СуществующиеРаботы.Вставить(Работа.Идентификатор, Работа);
		Если СохранитьПопытки И Работа.Состояние = "Выполняется" Тогда
			ТекущиеПопытки.Вставить(Работа.Идентификатор,
				Новый Структура("Обработано,Этап,Зафиксировано,Ошибок", Работа.ТекущаяПопытка,
					Работа.Этап, Работа.Зафиксировано, Работа.Ошибок));
		КонецЕсли;
	КонецЦикла;
	АктуальныеРаботы = Новый Соответствие;
	Для Каждого Работа Из РаботыСервера Цикл

		АктуальныеРаботы.Вставить(Работа.Идентификатор, Истина);
		НоваяРабота = СуществующиеРаботы.Получить(Работа.Идентификатор);
		Если НоваяРабота = Неопределено Тогда
			НоваяРабота = Работы.Добавить();
		КонецЕсли;
		НоваяРабота.ТекущаяПопытка = 0;
		НоваяРабота.Прогресс = 0;
		ЗаполнитьЗначенияСвойств(НоваяРабота, Работа);
		НоваяРабота.ИндексКартинки = КартинкаРаботы(Работа.Идентификатор, Работа.ВидОперации);
		ПопыткаРаботы = ТекущиеПопытки.Получить(Работа.Идентификатор);
		Если Работа.Состояние = "Выполняется" И ПопыткаРаботы <> Неопределено
			И ПопыткаРаботы.Зафиксировано = Работа.Зафиксировано
			И ПопыткаРаботы.Ошибок = Работа.Ошибок Тогда
			НоваяРабота.ТекущаяПопытка = ПопыткаРаботы.Обработано;
			НоваяРабота.Этап = ПопыткаРаботы.Этап;
		КонецЕсли;

	КонецЦикла;
	// Существующие строки сохраняют идентификаторы и выбранную пользователем позицию.
	Индекс = Работы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если АктуальныеРаботы.Получить(Работы[Индекс].Идентификатор) = Неопределено Тогда
			Работы.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпрос()

	Если Не ОпросПодключен Тогда
		ПодключитьОбработчикОжидания("ОбновитьСостояние", 2);
		ОпросПодключен = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОпрос()

	Если ОпросПодключен Тогда
		ОтключитьОбработчикОжидания("ОбновитьСостояние");
		ОпросПодключен = Ложь;
	КонецЕсли;
	ОстановитьСчетчик();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьВремяВыполнения(ПрошлоСекунд, Активен)

	СекундыВыполнения = ПрошлоСекунд;
	ОтметкаСчетчика = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьСчетчик();
	Если Активен Тогда
		Если Не СчетчикПодключен Тогда
			ПодключитьОбработчикОжидания("ОбновитьСчетчик", 1);
			СчетчикПодключен = Истина;
		КонецЕсли;
	Иначе
		ОстановитьСчетчик();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСчетчик()

	// Между опросами используем только часы клиента; время запуска задает сервер.
	ДобавочныеСекунды = Макс(0, Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ОтметкаСчетчика) / 1000));
	ВремяВыполнения = ПредставлениеДлительности(СекундыВыполнения + ДобавочныеСекунды);

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьСчетчик()

	Если СчетчикПодключен Тогда
		ОтключитьОбработчикОжидания("ОбновитьСчетчик");
		СчетчикПодключен = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДлительности(ПрошлоСекунд)

	Секунды = Макс(0, Цел(ПрошлоСекунд));
	Часы = Цел(Секунды / 3600);
	Минуты = Цел((Секунды % 3600) / 60);
	Секунды = Секунды % 60;
	ФорматСчетчика = "ЧГ=0;ЧДЦ=0;ЧН=0";
	Возврат СтрШаблон("%1 ч. %2 мин. %3 с.", Формат(Часы, ФорматСчетчика),
		Формат(Минуты, ФорматСчетчика), Формат(Секунды, ФорматСчетчика));

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КартинкаРаботы(Идентификатор, ВидОперации = "")

	// Порядок в библиотечном наборе: чтение, удаление.
	Если Идентификатор = "Запуск" Или ВидОперации = "Обфускация" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат 1;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьВидОперации(Форма, ВидОперации)

	Если ВидОперации = "Обфускация" Тогда
		Форма.Элементы.ОстановитьОбрезкуКнопка.Заголовок = "Остановить обфускацию";
		Форма.Элементы.РаботыТаблица.КартинкаСтрок = БиблиотекаКартинок.Cutter3000_РаботникОбфускации;
	Иначе
		Форма.Элементы.ОстановитьОбрезкуКнопка.Заголовок = "Остановить обрезку";
		Форма.Элементы.РаботыТаблица.КартинкаСтрок = БиблиотекаКартинок.Cutter3000_КартинкиРабот;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПринятьЗапускНаСервере(Знач ДатаОбрезки, Знач УскоренныйРежим, Знач ТрассировкаЗапуска = Ложь,
	Знач КоличествоУдалений = 2)

	Возврат Cutter3000_ЗаданияСервер.НачатьОбрезку(ДатаОбрезки, УскоренныйРежим, ТрассировкаЗапуска,
		КоличествоУдалений);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьРаботниковУдаления(Форма, Состояние, Активен)

	Форма.Элементы.ТриРаботникаУдаленияПоле.Видимость = Состояние.КоличествоУдалений > 1;
	Форма.Элементы.ТриРаботникаУдаленияПоле.Доступность = Не Активен;
	Если Активен Тогда
		Форма.ТриРаботникаУдаления = Состояние.КоличествоУдалений = 3;
	КонецЕсли;
	Если Состояние.КоличествоУдалений > 1 Тогда
		Форма.РежимВыполнения = СтрШаблон("Серверная база: 2 читателя и %1 работника удаления",
			?(Форма.ТриРаботникаУдаления, 3, 2));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СостояниеНаСервере(Знач Запуск, Знач Прочитанные)

	Возврат Cutter3000_ЗаданияСервер.СостояниеОбрезки(Запуск, Прочитанные);

КонецФункции

&НаСервереБезКонтекста
Функция ПринятьОстановкуНаСервере(Знач Запуск)

	Возврат Cutter3000_ЗаданияСервер.ЗапроситьОстановку(Запуск);

КонецФункции

#КонецОбласти
