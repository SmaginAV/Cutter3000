@startuml
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 20
skinparam shadowing false
skinparam backgroundColor #F8FAFC
title Как составляется список для удаления
start
:Взять небольшую порцию старых данных;
repeat
  :Найти документы и записи, которые на них ссылаются;
  :Добавить найденное в группу;
repeat while (Нашлись новые связанные данные?) is (да)
if (Другой работник занят теми же данными?) then (да)
  :Пока отложить; заняться другой группой;
  :Вернуться позже и заново проверить данные;
else (нет)
  :План — что удалить вместе;
  :Узлы — какие документы и записи нашли;
  :Связи — кто на что ссылается;
  :Передать группу свободному работнику;
endif
stop
@enduml
