@startuml
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 20
skinparam shadowing false
skinparam backgroundColor #F8FAFC
title Зачем нужны шесть служебных регистров
class "Задания" {
  Время и результаты работы
  После завершения остаются
}
class "Ошибки" {
  Причины неудачных удалений
  После завершения остаются
}
class "Очередь" {
  Команды и ответы работников
  После завершения очищается
}
class "План" {
  Что нужно удалить вместе
  Выполненное убирается; остаток очищается
}
class "Узлы" {
  Какие документы и записи найдены
  После обработки временные записи очищаются
}
class "Связи" {
  Кто на что ссылается
  Очищаются вместе с узлами
}
@enduml
